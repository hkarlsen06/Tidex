{
  "name": "tidex",
  "private": true,
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "description": "Tidex monorepo - shift tracking for web and iOS",
  "scripts": {
    "dev": "pnpm --filter next dev",
    "dev:https": "pnpm --filter next dev:https",
    "build": "pnpm --filter next build",
    "start": "pnpm --filter next start",
    "lint": "pnpm --filter next lint",
    "test": "pnpm --filter next test",
    "open-ios": "open ios/Tidex.xcodeproj",
    "localize": "node ios/scripts/translate-xcstrings.mjs",
    "ios:l10n:add": "swift ios/Scripts/add-strings.swift",
    "ios:l10n:delete": "swift ios/Scripts/delete-strings.swift",
    "ios:l10n:search": "swift ios/Scripts/search-strings.swift",
    "ios:l10n:audit": "swift ios/Scripts/audit-strings.swift",
    "ios:l10n:validate": "swift ios/Scripts/validate-localization.swift",
    "screenshots": "./ios/ASConnectScreenshots/resize-screenshots.sh",
    "swiftlint": "sh -c 'for arg in \"$@\"; do if [ \"$arg\" = \"--fix\" ] || [ \"$arg\" = \"autocorrect\" ]; then echo \"swiftlint autocorrect is disabled in this repo. Use pnpm swift-format.\"; exit 1; fi; done; swiftlint lint \"$@\"' --",
    "swift-format": "xcrun swift-format format --configuration .swift-format --recursive ios/ --in-place --parallel",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "glob": "^11.0.4"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@vercel/speed-insights",
      "esbuild",
      "protobufjs",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
