# Optional: Override default JWT access token expiry (seconds)
# Default: 3600 (1 hour) - defined in supabase/config.toml
# Maximum: 604800 (1 week) per Supabase limits
# Only change this after monitoring session refresh metrics for 1-2 weeks
# AUTH_ACCESS_TTL_SECONDS=28800

# Optional: Override default auth cookie maxAge (seconds)
# Default: 604800 (7 days) - defined in lib/supabase/server.ts
# This controls how long users stay logged in without activity
# Recommended range: 604800 (7d) to 2592000 (30d)
# Monitor active user days before increasing beyond 7d
# AUTH_COOKIE_MAX_AGE_SECONDS=1209600
