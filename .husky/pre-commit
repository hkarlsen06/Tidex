STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=d -- '*.swift')

if [ -n "$STAGED_SWIFT_FILES" ]; then
  echo "$STAGED_SWIFT_FILES" | xargs xcrun swift-format format --configuration .swift-format --in-place --parallel
  echo "$STAGED_SWIFT_FILES" | xargs swiftlint lint --quiet
  SWIFTLINT_STATUS=$?
  echo "$STAGED_SWIFT_FILES" | xargs git add

  if [ $SWIFTLINT_STATUS -ne 0 ]; then
    echo "swiftlint found issues. Please fix them before committing."
    exit 1
  fi

  # A reminder only. It never fails the commit.
  if git diff --cached -U0 -- '*.swift' | grep '^+[^+]' |
    grep -qE 'withAnimation|\.animation\(|\.transition\(|MotionTokens\.|\.motionAnimation\('; then
    echo "This commit changes motion. Check the animation with scripts/motion-check report,"
    echo "as the Motion section of ios/docs/AGENT_VERIFICATION.md describes."
  fi
fi

STAGED_XCSTRINGS_FILES=$(git diff --cached --name-only --diff-filter=d -- 'ios/**/*.xcstrings')

if [ -n "$STAGED_XCSTRINGS_FILES" ]; then
  bun run localize -- $STAGED_XCSTRINGS_FILES
  echo "$STAGED_XCSTRINGS_FILES" | xargs git add
fi
