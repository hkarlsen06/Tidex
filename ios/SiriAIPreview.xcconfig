// Siri AI developer preview gate. See docs/SIRI_AI_PREVIEW.md.
//
// Files under a SiriAIPreview folder need the iOS 27.3 SDK, and Apple takes them from
// development and internal TestFlight builds only. They stay out of every build unless
// TIDEX_SIRI_AI_PREVIEW is exactly YES.

TIDEX_SIRI_AI_PREVIEW = NO

// A pattern's * stops at a slash, so each folder depth has its own pattern. The fourth
// reaches the SKILL.md files inside Skills.skillsbundle.
TIDEX_SIRI_AI_PREVIEW_FILES = */SiriAIPreview/* */SiriAIPreview/*/* */SiriAIPreview/*/*/* */SiriAIPreview/*/*/*/*
TIDEX_SIRI_AI_PREVIEW_INCLUDED_YES = $(TIDEX_SIRI_AI_PREVIEW_FILES)

// Xcode builds an excluded file only when an included pattern also matches it.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(TIDEX_SIRI_AI_PREVIEW_FILES)
INCLUDED_SOURCE_FILE_NAMES = $(inherited) $(TIDEX_SIRI_AI_PREVIEW_INCLUDED_$(TIDEX_SIRI_AI_PREVIEW))
