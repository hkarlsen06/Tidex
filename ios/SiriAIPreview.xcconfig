// Siri AI developer preview gate. See docs/SIRI_AI_PREVIEW.md.
//
// Files under a SiriAIPreview folder need the iOS 27.3 SDK, and Apple does not take them
// in App Store builds yet. Debug builds with Xcode 27.3 compile them. Release builds and
// builds with any other Xcode leave them out.

// Xcode 27.3 and its patch releases report 2730. Add a line for each later Xcode.
TIDEX_SIRI_AI_PREVIEW = $(TIDEX_SIRI_AI_PREVIEW_XCODE_$(XCODE_VERSION_MINOR))
TIDEX_SIRI_AI_PREVIEW_XCODE_2730 = YES

// A pattern's * stops at a slash, so each folder depth has its own pattern. The fourth
// reaches the SKILL.md files inside Skills.skillsbundle.
TIDEX_SIRI_AI_PREVIEW_FILES = */SiriAIPreview/* */SiriAIPreview/*/* */SiriAIPreview/*/*/* */SiriAIPreview/*/*/*/*
TIDEX_SIRI_AI_PREVIEW_INCLUDED_YES = $(TIDEX_SIRI_AI_PREVIEW_FILES)

// Xcode builds an excluded file only when an included pattern also matches it. Only Debug
// has an included pattern, so no value of the switch brings the files into a Release build.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(TIDEX_SIRI_AI_PREVIEW_FILES)
INCLUDED_SOURCE_FILE_NAMES[config=Debug] = $(inherited) $(TIDEX_SIRI_AI_PREVIEW_INCLUDED_$(TIDEX_SIRI_AI_PREVIEW))
