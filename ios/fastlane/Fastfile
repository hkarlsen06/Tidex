# frozen_string_literal: true

default_platform(:ios)

def tidex_release_version
  version = File.read(File.expand_path("../Version.xcconfig", __dir__))[/^MARKETING_VERSION\s*=\s*(\S+)/, 1]
  UI.user_error!("MARKETING_VERSION is missing from Version.xcconfig") unless version
  version
end

platform :ios do
  desc "Upload App Store metadata (no binary or screenshots)"
  lane :metadata do
    # Validate required environment variables
    required_env_vars = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH]
    missing_vars = required_env_vars.reject { |var| ENV[var] && !ENV[var].empty? }

    unless missing_vars.empty?
      UI.user_error!(
        "Missing required environment variables: #{missing_vars.join(', ')}\n" \
        "See fastlane/README.md for setup instructions."
      )
    end

    # Validate API key file exists
    key_path = ENV["ASC_KEY_PATH"]
    unless File.exist?(key_path)
      UI.user_error!("App Store Connect API key file not found at: #{key_path}")
    end

    # Generate localized metadata files from source JSON
    UI.message("Generating localized metadata files...")
    sh("bun", "../Scripts/generate-appstore-metadata.mjs")

    # Configure App Store Connect API authentication
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )

    # Upload metadata only (no binary, no screenshots)
    deliver(
      api_key: api_key,
      app_version: tidex_release_version,
      submit_for_review: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      metadata_path: "fastlane/metadata",
      precheck_include_in_app_purchases: false
    )

    UI.success("Metadata uploaded successfully!")
  end

  desc "Generate metadata files without uploading"
  lane :generate_metadata do
    UI.message("Generating localized metadata files...")
    sh("bun", "../Scripts/generate-appstore-metadata.mjs")
    UI.success("Metadata files generated in fastlane/metadata/")
  end

  desc "Upload existing metadata files (no generation)"
  lane :upload_metadata do
    # Validate required environment variables
    required_env_vars = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH]
    missing_vars = required_env_vars.reject { |var| ENV[var] && !ENV[var].empty? }

    unless missing_vars.empty?
      UI.user_error!(
        "Missing required environment variables: #{missing_vars.join(', ')}\n" \
        "See fastlane/README.md for setup instructions."
      )
    end

    # Validate API key file exists
    key_path = ENV["ASC_KEY_PATH"]
    unless File.exist?(key_path)
      UI.user_error!("App Store Connect API key file not found at: #{key_path}")
    end

    # Configure App Store Connect API authentication
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )

    # Upload metadata only (no binary, no screenshots)
    deliver(
      api_key: api_key,
      app_version: tidex_release_version,
      submit_for_review: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      metadata_path: "fastlane/metadata",
      precheck_include_in_app_purchases: false
    )

    UI.success("Metadata uploaded successfully!")
  end

  desc "Upload promotional text and App Review notes for the current version"
  lane :upload_review_metadata do
    missing_vars = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].reject { |name| ENV[name] && !ENV[name].empty? }
    UI.user_error!("Missing required environment variables: #{missing_vars.join(', ')}") unless missing_vars.empty?

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    app = Spaceship::ConnectAPI::App.find("no.tidex.app")
    UI.user_error!("Tidex was not found in App Store Connect") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS, includes: nil)
    expected = tidex_release_version
    unless version && version.version_string == expected
      UI.user_error!("Expected an editable #{expected} App Store version")
    end

    metadata_path = File.expand_path("metadata", __dir__)
    localizations = version.get_app_store_version_localizations(limit: 200)
    UI.user_error!("The App Store version has no localizations") if localizations.empty?
    promotional_texts = localizations.map do |localization|
      path = File.join(metadata_path, localization.locale, "promotional_text.txt")
      UI.user_error!("Missing promotional text for #{localization.locale}") unless File.file?(path)
      text = File.read(path).strip
      unless (1..170).cover?(text.length)
        UI.user_error!("Promotional text for #{localization.locale} must contain 1 to 170 characters")
      end
      [localization, text]
    end

    notes_path = File.join(metadata_path, "review_information", "notes.txt")
    UI.user_error!("Missing App Review notes at #{notes_path}") unless File.file?(notes_path)
    notes = File.read(notes_path).strip
    UI.user_error!("App Review notes must contain 1 to 4000 characters") unless (1..4000).cover?(notes.length)
    review = version.fetch_app_store_review_detail(includes: nil)
    UI.user_error!("App Review information must already exist on the draft") unless review

    UI.message("Uploading promotional text for #{promotional_texts.length} languages on #{expected}...")
    promotional_texts.each do |localization, text|
      localization.update(attributes: { promotional_text: text })
    end
    review.update(attributes: { notes: notes })
    UI.success("Promotional text and App Review notes uploaded for #{expected}")
  end

  desc "Replace App Store screenshots with ASConnectScreenshots/<version> (no metadata)"
  lane :upload_screenshots do
    version = tidex_release_version
    screenshots_path = File.expand_path("../ASConnectScreenshots/#{version}", __dir__)
    UI.user_error!("No screenshots at #{screenshots_path}") unless Dir.exist?(screenshots_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    # Deliver rejects unknown folders such as raw-dark, so stage one folder per locale: the 3D
    # iPhone renders for every locale, plus the flat iPad renders, which exist for en-US and no.
    # Deliver replaces all screenshots, iPad included, in each locale it uploads.
    require "tmpdir"
    Dir.mktmpdir("tidex-screenshots") do |staging|
      locales = Dir.children(File.join(screenshots_path, "3d"))
                   .select { |name| File.directory?(File.join(screenshots_path, "3d", name)) }
      UI.user_error!("No 3D screenshots at #{screenshots_path}/3d") if locales.empty?
      locales.each do |locale|
        FileUtils.mkdir_p(File.join(staging, locale))
        FileUtils.cp(Dir.glob(File.join(screenshots_path, "3d", locale, "iPhone-*.png")), File.join(staging, locale))
        FileUtils.cp(Dir.glob(File.join(screenshots_path, locale, "iPad-*.png")), File.join(staging, locale))
      end
      %w[en-US no].each do |locale|
        next if Dir.glob(File.join(staging, locale, "iPad-*.png")).any?

        UI.user_error!("Missing iPad screenshots for #{locale} in #{screenshots_path}/#{locale}")
      end

      deliver(
        api_key: api_key,
        app_version: version,
        submit_for_review: false,
        skip_binary_upload: true,
        skip_metadata: true,
        skip_screenshots: false,
        overwrite_screenshots: true,
        screenshots_path: staging,
        force: true,
        precheck_include_in_app_purchases: false
      )
    end

    UI.success("Screenshots uploaded successfully!")
  end

  desc "Validate metadata files (check lengths and required files)"
  lane :validate_metadata do
    UI.message("Validating metadata files...")
    sh("bun", "../Scripts/generate-appstore-metadata.mjs", "--validate-only")
    UI.success("Metadata validation passed!")
  end
end
