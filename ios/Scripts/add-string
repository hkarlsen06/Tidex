#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CATALOG="$REPO_ROOT/ios/Resources/Localization/App/Localizable.xcstrings"

declare -a KEYS=()
declare -a EN_VALUES=()
declare -a NB_VALUES=()
declare -a COMMENTS=()

CURRENT_KEY=""
CURRENT_EN=""
CURRENT_NB=""
CURRENT_COMMENT=""

usage() {
  cat >&2 <<EOF
Deprecated: add-string is kept only as a compatibility shim.

Use:
  ./scripts/xcstrings-set ios/Resources/Localization/App/Localizable.xcstrings feature.context.description \\
    --comment "Translator context" \\
    --en "English text" \\
    --nb "Norwegian text"

Legacy usage still accepted:
  add-string --key "feature.context.description" --en "English text" --nb "Norwegian text"
EOF
}

flush_entry() {
  if [ -z "$CURRENT_KEY" ]; then
    return
  fi

  if [ -z "$CURRENT_EN" ] || [ -z "$CURRENT_NB" ]; then
    echo "add-string: incomplete entry for '$CURRENT_KEY'; --en and --nb are required" >&2
    exit 2
  fi

  KEYS+=("$CURRENT_KEY")
  EN_VALUES+=("$CURRENT_EN")
  NB_VALUES+=("$CURRENT_NB")
  COMMENTS+=("$CURRENT_COMMENT")

  CURRENT_KEY=""
  CURRENT_EN=""
  CURRENT_NB=""
  CURRENT_COMMENT=""
}

while [ $# -gt 0 ]; do
  case "$1" in
    --)
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --key|-k)
      flush_entry
      [ $# -ge 2 ] || { echo "add-string: missing value for $1" >&2; exit 2; }
      CURRENT_KEY="$2"
      shift 2
      ;;
    --en|--english)
      [ $# -ge 2 ] || { echo "add-string: missing value for $1" >&2; exit 2; }
      CURRENT_EN="$2"
      shift 2
      ;;
    --nb|--norwegian)
      [ $# -ge 2 ] || { echo "add-string: missing value for $1" >&2; exit 2; }
      CURRENT_NB="$2"
      shift 2
      ;;
    --comment)
      [ $# -ge 2 ] || { echo "add-string: missing value for $1" >&2; exit 2; }
      CURRENT_COMMENT="$2"
      shift 2
      ;;
    --catalog|-c)
      [ $# -ge 2 ] || { echo "add-string: missing value for $1" >&2; exit 2; }
      CATALOG="$2"
      shift 2
      ;;
    *)
      echo "add-string: unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

flush_entry

if [ "${#KEYS[@]}" -eq 0 ]; then
  usage
  exit 2
fi

echo "Warning: add-string is deprecated. Use ./scripts/xcstrings-set for new work." >&2

for index in "${!KEYS[@]}"; do
  command=(
    "$REPO_ROOT/scripts/xcstrings-set"
    "$CATALOG"
    "${KEYS[$index]}"
    --en "${EN_VALUES[$index]}"
    --nb "${NB_VALUES[$index]}"
  )

  if [ -n "${COMMENTS[$index]}" ]; then
    command+=(--comment "${COMMENTS[$index]}")
  else
    command+=(--allow-missing-comment)
  fi

  "${command[@]}"
done
