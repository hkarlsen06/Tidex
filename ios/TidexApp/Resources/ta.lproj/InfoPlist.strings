"NSPhotoLibraryAddUsageDescription" = "Tidex பகிரப்பட்ட காலெண்டர், ஷிப்ட் மற்றும் அரட்டை படங்களை உங்கள் புகைப்பட நூலகத்தில் சேமிக்க அணுகல் தேவை.";

/* NSLocationWhenInUseUsageDescription */
"NSLocationWhenInUseUsageDescription" = "Tidex உங்கள் இருப்பிடத்தைப் பயன்படுத்தாது. அரட்டை நூலகத்தில் உள்ள இருப்பிடப் பகிர்வு அம்சம் Tidex-ல் முடக்கப்பட்டுள்ளது.";

/* Face ID usage description */
"NSFaceIDUsageDescription" = "Tidex-ஐப் பாதுகாப்பாகத் திறக்க Face ID-ஐப் பயன்படுத்த அனுமதிக்கவும்.";

/* Calendar access description */
"NSCalendarsFullAccessUsageDescription" = "உங்கள் வேலை ஷிப்டுகளை நாட்காட்டியில் சேர்க்கவும் புதுப்பிக்கவும் Tidex-க்கு முழு அணுகலை அனுமதிக்கவும்.";
