// Version Configuration
// Single source for the user-visible version across all apps and extensions.
// Change MARKETING_VERSION here, never in a target's Xcode build settings.
// The build script validates that targets and Info.plists inherit these values.
//
// MARKETING_VERSION = User-visible version (e.g., 2.0.0)
// CURRENT_PROJECT_VERSION = Generated at build time from BuildNumber.xcconfig (Europe/Oslo timestamp)

MARKETING_VERSION = 2.7.2

// Build number is generated at build time by the "Generate BuildNumber.xcconfig"
// Run Script phase. BuildNumber.xcconfig is git-ignored and never committed.
// Placeholder — overridden at build time by BuildNumber.xcconfig (git-ignored).
CURRENT_PROJECT_VERSION = 00000000.0000
#include? "BuildNumber.xcconfig"
