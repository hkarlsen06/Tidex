    "wagey.showcase.features.quickActions.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj, rediger eller slet vagter med en simpel besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Schichten mit einer einfachen Nachricht hinzu, bearbeite oder lösche sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add, edit, or delete shifts with a simple message."
          }
