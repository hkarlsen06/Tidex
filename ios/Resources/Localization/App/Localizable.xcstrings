    "supplements.deleteRuleMessage": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil fjerne dette tillæg?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher, dass du diesen Zuschlag entfernen möchtest?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε σίγουροι ότι θέλετε να αφαιρέσετε αυτό το συμπλήρωμα;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove this supplement?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar este suplemento?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa tämän lisän?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce supplément?"
          }
        },
