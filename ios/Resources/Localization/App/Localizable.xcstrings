      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستويات أجور الرسم تدعم فقط الاتفاقيات النرويجية بالكرونة النرويجية. العملات مثل ₹ غير مدعومة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарифната заплата поддържа само норвежки тарифни споразумения в kr. Валути като ₹ не се поддържат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্যারিফ মজুরি স্তর শুধুমাত্র নরওয়েজীয় ট্যারিফ kr তে সমর্থন করে। ₹ এর মতো মুদ্রা সমর্থিত নয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
