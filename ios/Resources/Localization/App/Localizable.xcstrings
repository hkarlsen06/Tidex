    "paywall.wageyLimit.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all your messages this month. Upgrade to continue chatting with Wagey."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt alle meldingene dine denne måneden. Oppgrader for å fortsette å chatte med Wagey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle deine Nachrichten diesen Monat verbraucht. Upgrade durchführen, um weiter mit Wagey zu chatten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizaste todos tus mensajes este mes. Actualiza para seguir chateando con Wagey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé tous vos messages ce mois-ci. Passez à la version premium pour continuer à discuter avec Wagey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のメッセージを使い切りました。Wagey とのチャットを続けるにはアップグレードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 메시지를 모두 사용했습니다. Wagey와 계속 대화하려면 업그레이드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou todas as suas mensagens este mês. Atualize para continuar conversando com Wagey."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали все сообщения в этом месяце. Обновитесь, чтобы продолжить общение с Wagey."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al je berichten deze maand gebruikt. Upgrade om door te gaan met chatten met Wagey."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har använt alla dina meddelanden denna månad. Uppgradera för att fortsätta chatta med Wagey."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brugt alle dine beskeder denne måned. Opgrader for at fortsætte chatten med Wagey."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai usato tutti i tuoi messaggi questo mese. Aggiorna per continuare a chattare con Wagey."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet käyttänyt kaikki viestisi tässä kuussa. Päivitä jatkaaksesi keskustelua Wageyn kanssa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczerpałeś wszystkie wiadomości w tym miesiącu. Uaktualnij, aby kontynuować rozmowę z Wagey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви використали всі свої повідомлення цього місяця. Оновіться, щоб продовжити спілкування з Wagey."
