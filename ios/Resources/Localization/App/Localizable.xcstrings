            "value": "Are you sure you want to delete this wage setting?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne lønnssettingen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Lohneinstellung wirklich löschen?"
          }
        },
