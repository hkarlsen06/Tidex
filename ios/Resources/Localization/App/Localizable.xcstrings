    "security.passkeys.sectionSubtitle" : {
      "comment" : "Subtitle of the passkeys section. Face ID and Touch ID are Apple product names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم Face ID أو Touch ID أو رمز مرور جهازك لتسجيل الدخول دون كلمة مرور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте Face ID, Touch ID или кода на устройството си, за да влезете без парола."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাসওয়ার্ড ছাড়া সাইন ইন করতে Face ID, Touch ID বা আপনার ডিভাইসের পাসকোড ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir Face ID, Touch ID o el codi del dispositiu per iniciar sessió sense contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro přihlášení bez hesla použijte Face ID, Touch ID nebo kód zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Face ID, Touch ID eller din enhedskode til at logge ind uden en adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Face ID, Touch ID oder den Gerätecode, um dich ohne Passwort anzumelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε Face ID, Touch ID ή τον κωδικό της συσκευής σας για σύνδεση χωρίς κωδικό πρόσβασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID, Touch ID, or your device passcode to sign in without a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID, Touch ID o el código de tu dispositivo para iniciar sesión sin contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasuta Face ID-d, Touch ID-d või seadme pääsukoodi, et sisse logida ilma paroolita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ورود بدون رمز عبور، از Face ID، Touch ID یا رمز دستگاه خود استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu ilman salasanaa Face ID:llä, Touch ID:llä tai laitteesi pääsykoodilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang Face ID, Touch ID, o passcode ng device mo para mag-sign in nang walang password."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID, Touch ID ou le code de votre appareil pour vous connecter sans mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש/י ב-Face ID, ‏Touch ID או בקוד הגישה של המכשיר כדי להתחבר בלי סיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना पासवर्ड साइन इन करने के लिए Face ID, Touch ID या अपने डिवाइस का पासकोड इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite Face ID, Touch ID ili šifru uređaja za prijavu bez lozinke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használj Face ID-t, Touch ID-t vagy a készüléked jelkódját a jelszó nélküli bejelentkezéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan Face ID, Touch ID, atau kode sandi perangkat untuk masuk tanpa kata sandi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notaðu Face ID, Touch ID eða aðgangskóða tækisins til að skrá þig inn án lykilorðs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID, Touch ID o il codice del dispositivo per accedere senza password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID、Touch ID、またはデバイスのパスコードを使って、パスワードなしでサインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID, Touch ID 또는 기기 암호를 사용해 비밀번호 없이 로그인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudokite Face ID, Touch ID arba įrenginio kodą prisijungti be slaptažodžio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmantojiet Face ID, Touch ID vai ierīces piekļuves kodu, lai pierakstītos bez paroles."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk Face ID, Touch ID eller enhetskoden din for å logge inn uten passord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Face ID, Touch ID of de toegangscode van je apparaat om zonder wachtwoord in te loggen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk Face ID, Touch ID eller einingskoden din for å logge inn utan passord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj Face ID, Touch ID lub kodu urządzenia, aby zalogować się bez hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID, Touch ID ou o código do dispositivo para entrar sem senha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește Face ID, Touch ID sau codul dispozitivului pentru a te autentifica fără parolă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Face ID, Touch ID или код-пароль устройства, чтобы входить без пароля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na prihlásenie bez hesla použite Face ID, Touch ID alebo kód zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za prijavo brez gesla uporabite Face ID, Touch ID ali geslo naprave."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite Face ID, Touch ID ili šifru uređaja za prijavu bez lozinke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd Face ID, Touch ID eller enhetens lösenkod för att logga in utan lösenord."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumia Face ID, Touch ID, au msimbo wa kifaa chako kuingia bila nenosiri."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடவுச்சொல் இல்லாமல் உள்நுழைய Face ID, Touch ID அல்லது உங்கள் சாதன கடவுக்குறியீட்டை பயன்படுத்தவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ Face ID, Touch ID หรือรหัสอุปกรณ์เพื่อลงชื่อเข้าใช้โดยไม่ต้องใช้รหัสผ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolasız giriş için Face ID, Touch ID veya cihaz parolanızı kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте Face ID, Touch ID або код доступу пристрою, щоб увійти без пароля."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پاس ورڈ کے بغیر سائن اِن کرنے کے لیے Face ID، Touch ID یا اپنے ڈیوائس کا پاس کوڈ استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Face ID, Touch ID hoặc mã khóa thiết bị để đăng nhập không cần mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID、Touch ID 或设备密码，无需密码即可登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID、Touch ID 或裝置密碼，免密碼登入。"
          }
        }
      }
    },
