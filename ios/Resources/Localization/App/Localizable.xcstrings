          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke starte Google-innlogging. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon Google-inloggen niet starten. Probeer het later opnieuw."
          }
        },
        "pl": {
