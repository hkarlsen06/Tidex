    "settings.pay.setup.finishDescription" : {
      "comment" : "Description in pay settings for a job that has no baseline wage yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أجرًا أساسيًا قبل إنشاء ورديات لهذه الوظيفة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете основна заплата, преди да създавате смени за тази работа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কাজের জন্য শিফট তৈরি করার আগে একটি মৌলিক মজুরি যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix un sou base abans de crear torns per a aquesta feina."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
