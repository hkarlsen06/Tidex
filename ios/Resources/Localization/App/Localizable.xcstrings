          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako biste nastavili, morate pročitati i prihvatiti naše Uvjete korištenja i Politiku privatnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folytatáshoz el kell olvasnod és el kell fogadnod a Szolgáltatási Feltételeket és az Adatvédelmi Szabályzatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk melanjutkan, Anda harus membaca dan menerima Syarat Layanan dan Kebijakan Privasi kami."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að halda áfram verður þú að lesa og samþykkja okkar skilmála fyrir notkun og persónuverndarstefnu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per continuare, devi leggere e accettare i nostri Termini di servizio e l'Informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行するには、利用規約およびプライバシーポリシーを読んで同意する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하려면 서비스 약관 및 개인정보 보호정책을 읽고 동의해야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norėdami tęsti, turite perskaityti ir priimti mūsų naudojimosi sąlygas ir privatumo politiką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai turpinātu, jums jāizlasa un jāpieņem mūsu Pakalpojuma noteikumi un Privātuma politika."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å fortsette må du lese og godta våre vilkår for bruk og personvernerklæring."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om verder te gaan, moet je onze gebruiksvoorwaarden en ons privacybeleid lezen en accepteren."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å fortsette må du lese og godta våre vilkår for bruk og personvernerklæring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby kontynuować, musisz przeczytać i zaakceptować nasze Warunki świadczenia usług i Politykę prywatności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar, você deve ler e aceitar nossos Termos de Serviço e Política de Privacidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a continua, trebuie să citești și să accepți Termenii de utilizare și Politica de confidențialitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для продолжения вы должны прочитать и принять наши Условия обслуживания и Политику конфиденциальности."
          }
