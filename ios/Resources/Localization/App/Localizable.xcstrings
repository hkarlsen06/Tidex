    "resetPassword.errors.phoneUnavailable" : {
      "comment" : "Error when the user tries to reset a password by phone number but SMS is unavailable. Keep the support email address unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
