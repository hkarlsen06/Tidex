    "shifts.excludeConfirmMessage" : {
      "comment" : "Message in the confirmation alert when removing one date of a recurring shift. Only that date is removed; the recurring shift keeps its other dates.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إزالة هذا التاريخ فقط. وتبقى بقية الوردية المتكررة كما هي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премахва се само тази дата. Останалата част от повтарящата се смяна остава без промяна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু এই তারিখটি সরানো হবে। পুনরাবৃত্ত শিফটের বাকি অংশ আগের মতোই থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només s'elimina aquesta data. La resta del torn recurrent es manté igual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní se pouze toto datum. Zbytek opakující se směny zůstane beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun denne dato fjernes. Resten af den gentagne vagt forbliver, som den er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieses Datum wird entfernt. Der Rest der wiederkehrenden Schicht bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρείται μόνο αυτή η ημερομηνία. Η υπόλοιπη επαναλαμβανόμενη βάρδια παραμένει ως έχει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only this date is removed. The rest of the recurring shift stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se elimina esta fecha. El resto del turno recurrente permanece igual."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eemaldatakse ainult see kuupäev. Korduv vahetus jääb muus osas samaks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط این تاریخ حذف می‌شود. بقیه شیفت تکرارشونده بدون تغییر باقی می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain tämä päivämäärä poistetaan. Muu toistuva työvuoro säilyy ennallaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang petsang ito lamang ang aalisin. Mananatili ang iba pang petsa ng paulit-ulit na shift."
