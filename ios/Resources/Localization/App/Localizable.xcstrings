    "wagey.limitReached.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all your messages this month. Resets in %d days."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt alle meldingene dine denne måneden. Nullstilles om %d dager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle deine Nachrichten diesen Monat aufgebraucht. Wird in %d Tagen zurückgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé tous vos messages ce mois-ci. Réinitialisation dans %d jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado todos tus mensajes este mes. Se reinicia en %d días."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai utilizzato tutti i tuoi messaggi questo mese. Ripristino tra %d giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt alle meldingene dine denne måneden. Nullstilles om %d dager."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou todas as suas mensagens este mês. Será redefinido em %d dias."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har använt alla dina meddelanden denna månad. Återställs om %d dagar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brugt alle dine beskeder denne måned. Nulstilles om %d dage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet käyttänyt kaikki viestit tässä kuussa. Nollautuu %d päivässä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczerpałeś wszystkie wiadomości w tym miesiącu. Resetowanie za %d dni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали все сообщения в этом месяце. Сброс через %d дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви використали всі свої повідомлення цього місяця. Скидання через %d днів."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のメッセージをすべて使用しました。%d日後にリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 메시지를 모두 사용했습니다. %d일 후에 초기화됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您本月的消息已用完。将在%d天后重置。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้ข้อความทั้งหมดของคุณในเดือนนี้แล้ว รีเซ็ตใน %d วัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết tất cả tin nhắn của mình trong tháng này. Sẽ đặt lại trong %d ngày."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brukt alle meldingane dine denne månaden. Nullstilles om %d dagar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay tüm mesajlarınızı kullandınız. %d gün içinde sıfırlanacak."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε χρησιμοποιήσει όλα τα μηνύματά σας αυτό το μήνα. Επαναφορά σε %d ημέρες."
          }
        },
        "ro": {
          "stringUnit": {
