    "wagey.consent.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Wagey بواسطة Claude، وهو نموذج ذكاء اصطناعي من Anthropic. لاستخدام Wagey، سيتم إرسال بعض بياناتك إلى Anthropic للمعالجة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey работи на Claude, модел на AI от Anthropic. За да използвате Wagey, някои от вашите данни ще бъдат изпратени на Anthropic за обработка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey Claude দ্বারা চালিত, যা Anthropic-এর একটি AI মডেল। Wagey ব্যবহার করতে আপনার কিছু ডেটা প্রক্রিয়াকরণের জন্য Anthropic-এ পাঠানো হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey funciona amb Claude, un model d'IA d'Anthropic. Per utilitzar Wagey, algunas de les teves dades s'enviaran a Anthropic per al seu processament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey je poháněn Claude, AI modelem od Anthropic. Chcete-li používat Wagey, budou některá vaše data odeslána do Anthropic ke zpracování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey drives af Claude, en AI-model fra Anthropic. For at bruge Wagey vil nogle af dine data blive sendt til Anthropic til behandling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey wird von Claude, einem KI-Modell von Anthropic, betrieben. Um Wagey zu nutzen, werden einige deiner Daten an Anthropic zur Verarbeitung gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Wagey λειτουργεί με το Claude, ένα μοντέλο AI της Anthropic. Για να χρησιμοποιήσετε το Wagey, ορισμένα από τα δεδομένα σας θα αποσταλούν στην Anthropic για επεξεργασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey is powered by Claude from Anthropic. To use Wagey, some of your data will be sent to Anthropic, which processes it on behalf of Tidex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey funciona con Claude, un modelo de IA de Anthropic. Para usar Wagey, algunos de tus datos se enviarán a Anthropic para su procesamiento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey töötab Claude'il, mis on Anthropicu AI-mudel. Wagey kasutamiseks saadetakse osa teie andmetest Anthropicu töötlemiseks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey توسط Claude، مدل هوش مصنوعی Anthropic، راه‌اندازی شده است. برای استفاده از Wagey، برخی از داده‌های شما به Anthropic برای پردازش ارسال خواهد شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey toimii Claude-tekoälymallilla, jonka on kehittänyt Anthropic. Wagey-palvelun käyttämiseksi joitakin tietojasi lähetetään Anthropicille käsiteltäväksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Wagey ay pinapagana ng Claude, isang AI model ng Anthropic. Upang gamitin ang Wagey, ang ilan sa iyong data ay ipapadala sa Anthropic para sa pagproseso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey est alimenté par Claude, un modèle IA d'Anthropic. Pour utiliser Wagey, certaines de vos données seront envoyées à Anthropic pour traitement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey מופעל על ידי Claude, מודל AI של Anthropic. כדי להשתמש ב-Wagey, חלק מהנתונים שלך יישלח ל-Anthropic לעיבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey को Claude द्वारा संचालित किया जाता है, जो Anthropic का एक AI मॉडल है। Wagey का उपयोग करने के लिए, आपके कुछ डेटा को Anthropic को भेजा जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey je pokrenut s Claude-om, AI modelom kompanije Anthropic. Za korištenje Wageya, neki od vaših podataka bit će poslani Anthropicu na obradu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Wagey-t a Claude hajtja végre, amely az Anthropic AI-modellje. A Wagey használatához néhány adatod el lesz küldve az Anthropic-nak feldolgozásra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey didukung oleh Claude, model AI dari Anthropic. Untuk menggunakan Wagey, beberapa data Anda akan dikirim ke Anthropic untuk diproses."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey er knúið af Claude, AI-líkani frá Anthropic. Til að nota Wagey verður að senda hluta af gögnum þínum til Anthropic til vinnslu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey è basato su Claude, un modello AI di Anthropic. Per utilizzare Wagey, alcuni dei tuoi dati verranno inviati ad Anthropic per l'elaborazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagey は Anthropic の AI モデル Claude によって提供されています。Wagey を使用するには、お客様のデータの一部が Anthropic に送信され、処理されます。"
