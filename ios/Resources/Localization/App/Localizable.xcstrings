    "signup.emailSent.instructions": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på linket i emailen for at bekræfte din konto. Tjek også din spam-mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf den Link in der E-Mail, um Ihr Konto zu bestätigen. Überprüfen Sie auch Ihren Spam-Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the link in the email to confirm your account. Check your spam folder too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el enlace del correo electrónico para confirmar tu cuenta. Verifica también tu carpeta de spam."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta sähköpostissa olevaa linkkiä vahvistaaksesi tilisi. Tarkista myös roskapostikansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le lien dans l'e-mail pour confirmer votre compte. Vérifiez également votre dossier spam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca il link nell'email per confermare il tuo account. Controlla anche la cartella spam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール内のリンクをクリックしてアカウントを確認します。迷惑メールフォルダも確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일의 링크를 클릭하여 계정을 확인하세요. 스팸 폴더도 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på lenken i e-posten for å bekrefte kontoen din. Sjekk også spam-mappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de link in de e-mail om je account te bevestigen. Controleer ook je spammap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij link w e-mailu, aby potwierdzić swoje konto. Sprawdź też folder spam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no link no e-mail para confirmar sua conta. Verifique também sua pasta de spam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на ссылку в письме для подтверждения аккаунта. Проверьте также папку спама."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på länken i e-postmeddelandet för att bekräfta ditt konto. Kontrollera även din skräppostmapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกลิงก์ในอีเมลเพื่อยืนยันบัญชีของคุณ ตรวจสอบโฟลเดอร์สแปมด้วย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть посилання в email для підтвердження облікового запису. Перевірте папку спаму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào liên kết trong email để xác nhận tài khoản của bạn. Kiểm tra cả thư mục spam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击邮件中的链接确认您的账户。也请检查垃圾邮件文件夹。"
          }
        }
      }
    },
