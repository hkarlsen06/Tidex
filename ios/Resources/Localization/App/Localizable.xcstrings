    "wagey.showcase.hero.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الورديات، تحقق من أرباحك، واحصل على إجابات للأسئلة – كل ذلك باللغة الطبيعية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавяйте смени, проверявайте приходите си и получавайте отговори на въпроси – всичко с естествен език."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শিফট যোগ করুন, আপনার আয় পরীক্ষা করুন এবং প্রশ্নের উত্তর পান – সবকিছু প্রাকৃতিক ভাষার মাধ্যমে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix torns, comprova els teus ingressos i obtén respostes a preguntes – tot amb llenguatge natural."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávejte směny, sledujte své příjmy a získejte odpovědi na otázky – vše pomocí přirozeného jazyka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj vagter, tjek din indkomst og få svar på spørgsmål – alt med naturligt sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Schichten hinzu, überprüfe deine Verdienste und erhalte Antworten auf Fragen – alles in natürlicher Sprache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε βάρδιες, ελέγξτε τα κέρδη σας και λάβετε απαντήσεις σε ερωτήσεις – όλα με φυσική γλώσσα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add shifts, check your earnings, and get answers to questions – all with natural language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade turnos, revisa tus ganancias y obtén respuestas a preguntas – todo con lenguaje natural."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisage vahetusi, kontrollige oma sissetulekut ja saage vastused küsimustele – kõik loomuliku keelega."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیفت‌ها را اضافه کنید، درآمد خود را بررسی کنید و به سؤالات پاسخ دهید – همه با زبان طبیعی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää vuoroja, tarkista tulosi ja saa vastauksia kysymyksiin – kaikki luonnollisella kielellä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng shifts, suriin ang iyong kita, at makakuha ng mga sagot sa mga tanong – lahat gamit ang natural na wika."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des vakts, vérifiez vos gains et obtenez des réponses – tout en langage naturel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף משמרות, בדוק את הרווחים שלך וקבל תשובות לשאלות – הכל בשפה טבעית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शिफ्ट जोड़ें, अपनी कमाई जांचें, और प्रश्नों के उत्तर प्राप्त करें – सब कुछ प्राकृतिक भाषा के साथ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte smjene, provjerite svoju zaradu i dobijte odgovore na pitanja – sve s prirodnim jezikom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaktok hozzáadása, jövedelem ellenőrzése és kérdésekre válaszok – mindez természetes nyelvvel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah vakat, periksa penghasilan Anda, dan dapatkan jawaban atas pertanyaan – semua dengan bahasa alami."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bættu við vöktum, athugaðu tekjur þínar og fáðu svör við spurningum – allt með náttúrulegri málnotkun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi turni, controlla i tuoi guadagni e ottieni risposte alle domande – tutto con linguaggio naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シフトを追加し、収入を確認し、質問への回答を得る—すべて自然言語で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근무를 추가하고, 수입을 확인하고, 질문에 답하세요 – 모두 자연어로."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridėkite vardus, patikrinkite savo uždarbį ir gaukite atsakymus į klausimus – viskas natūralia kalba."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievienojiet maiņas, pārbaudiet savus ienākumus un saņemiet atbildes uz jautājumiem – viss ar dabiskā valodā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til vakter, sjekk inntekten din og få svar på spørsmål – alt med naturlig språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til vakter, sjekk inntekten din og få svar på spørsmål – alt med naturlig språk."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til vakter, sjekk inntekta di og få svar på spørsmål – alt med naturleg språk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj zmiany, sprawdzaj swoje zarobki i uzyskuj odpowiedzi na pytania – wszystko w języku naturalnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione turnos, verifique seus ganhos e obtenha respostas – tudo com linguagem natural."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă schimburi, verifică câștigurile și obține răspunsuri la întrebări – totul cu limbaj natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте смены, проверяйте доход и получайте ответы на вопросы – всё с естественным языком."
