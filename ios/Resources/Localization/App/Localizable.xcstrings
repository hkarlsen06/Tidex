    "profile.emailChange.oauthOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggede ind med Google/Apple. For at ændre din e-mail skal du først angive en adgangskode i sikkerhedsindstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich mit Google/Apple angemeldet. Um deine E-Mail zu ändern, lege zuerst ein Passwort in den Sicherheitseinstellungen fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθήκατε με Google/Apple. Για να αλλάξετε το email, ορίστε πρώτα έναν κωδικό πρόσβασης στις ρυθμίσεις ασφαλείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in with Google/Apple. To change your email, first set a password in security settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciaste sesión con Google/Apple. Para cambiar tu correo, primero establece una contraseña en la configuración de seguridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduit sisään Google/Applen kautta. Vaihtaaksesi sähköpostia, aseta ensin salasana turva-asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous êtes connecté avec Google/Apple. Pour changer votre e-mail, définissez d'abord un mot de passe dans les paramètres de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai effettuato l'accesso con Google/Apple. Per cambiare email, prima imposta una password nelle impostazioni di sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google/Appleでサインインしました。メールアドレスを変更するには、まずセキュリティ設定でパスワードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google/Apple로 로그인했습니다. 이메일을 변경하려면 먼저 보안 설정에서 비밀번호를 설정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du logget inn med Google/Apple. For å endre e-post må du først sette et passord i sikkerhetsinnstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je aangemeld met Google/Apple. Om je e-mail te wijzigen, stel je eerst een wachtwoord in via beveiligingsinstellingen."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Du logga inn med Google/Apple. For å endre e-post må du først setja eit passord i sikkerhetsinnstillingane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowałeś się przez Google/Apple. Aby zmienić e-mail, najpierw ustaw hasło w ustawieniach bezpieczeństwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se conectou com Google/Apple. Para alterar seu email, primeiro defina uma senha nas configurações de segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "V-ați conectat cu Google/Apple. Pentru a schimba e-mailul, setați mai întâi o parolă în setările de securitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вошли через Google/Apple. Чтобы изменить электронную почту, сначала установите пароль в параметрах безопасности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggade in med Google/Apple. För att ändra e-post måste du först ställa in ett lösenord i säkerhetsinställningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเข้าสู่ระบบด้วย Google/Apple หากต้องการเปลี่ยนอีเมล ให้ตั้งรหัสผ่านในการตั้งค่าความปลอดภัยก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google/Apple ile giriş yaptınız. E-postayı değiştirmek için önce güvenlik ayarlarında bir şifre belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви увійшли через Google/Apple. Щоб змінити електронну пошту, спочатку встановіть пароль у параметрах безпеки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đăng nhập bằng Google/Apple. Để thay đổi email, trước tiên hãy đặt mật khẩu trong cài đặt bảo mật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您使用 Google/Apple 登录。要更改电子邮件，请先在安全设置中设置密码。"
          }
        }
      }
    },
