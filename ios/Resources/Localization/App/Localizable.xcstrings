    "recurring.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette dette tilbagevendende skift? Alle fremtidige forekomster vil blive fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie diese wiederkehrende Schicht löschen möchten? Alle zukünftigen Vorkommen werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this recurring shift? All future occurrences will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que deseas eliminar este turno recurrente? Se eliminarán todas las futuras repeticiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa tämän toistuvan vuoron? Kaikki tulevat esiintymät poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce quart récurrent ? Toutes les occurrences futures seront supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare questo turno ricorrente? Tutte le occorrenze future verranno rimosse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この定期シフトを削除してもよろしいですか？今後のすべての発生が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 근무를 삭제하시겠습니까? 앞으로의 모든 근무가 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne faste vakten? Alle fremtidige vakter vil bli fjernet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u deze terugkerende dienst wilt verwijderen? Alle toekomstige voorvallen worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć tę zmianę powtarzającą się? Wszystkie przyszłe wystąpienia zostaną usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que deseja excluir este turno recorrente? Todas as ocorrências futuras serão removidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эту повторяющуюся смену? Все будущие повторения будут удалены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort detta återkommande skift? Alla framtida förekomster tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือว่าต้องการลบกะแบบซ้ำนี้? การเกิดขึ้นในอนาคตทั้งหมดจะถูกลบออก"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цю повторювану зміну? Усі майбутні повторення будуть видалені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa ca làm việc lặp lại này không? Tất cả các lần xuất hiện trong tương lai sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要删除此定期班次吗？所有未来的班次都将被删除。"
          }
        }
      }
    },
