        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridávajte zmeny, kontrolujte svoje príjmy a získavajte odpovede na otázky – všetko v prirodzenom jazyku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte izmene, preverite svoje zaslužke in dobite odgovore na vprašanja – vse z naravnim jezikom."
