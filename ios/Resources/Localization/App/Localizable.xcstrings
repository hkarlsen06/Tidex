    "sharing.manageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك وردياتك مع الأصدقاء والزملاء حتى يتمكنوا من رؤية موعد عملك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Споделете смените си с приятели и колеги, така че да видят кога работите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার শিফট বন্ধু এবং সহকর্মীদের সাথে শেয়ার করুন যাতে তারা দেখতে পারে আপনি কখন কাজ করেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparteix els teus torns amb amics i col·legues perquè puguin veure quan treballes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte své směny s přáteli a kolegy, aby viděli, kdy pracujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del dine vakter med venner og kolleger, så de kan se, hvornår du arbejder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen Sie Ihre Schichten mit Freunden und Kollegen, damit diese sehen können, wann Sie arbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοινοποιήστε τις βάρδιες σας με φίλους και συναδέλφους ώστε να μπορούν να δουν πότε εργάζεστε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your shifts with friends and colleagues so they can see when you work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tus turnos con amigos y colegas para que vean cuándo trabajas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga oma vahte sõprade ja kolleegidega, et nad saaksid näha, millal sa töötad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیفت‌های خود را با دوستان و همکاران به اشتراک بگذارید تا ببینند چه زمانی کار می‌کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa vuorosi ystävien ja kollegoiden kanssa, jotta he näkevät milloin työskentelet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibahagi ang iyong mga shift sa mga kaibigan at kasosyo upang makita nila kung kailan ka nagtatrabaho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez vos vagues avec vos amis et collègues pour qu'ils voient quand vous travaillez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתף את משמרותיך עם חברים וקולגות כדי שיוכלו לראות כשאתה עובד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी शिफ्ट को दोस्तों और सहकर्मियों के साथ शेयर करें ताकि वे देख सकें कि आप कब काम करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podijeli svoje smjene s prijateljima i kolegama kako bi vidjeli kada radiš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszd meg a műszakaidat barátaiddal és kollégáiddal, hogy lássák, mikor dolgozol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan shift Anda dengan teman dan rekan kerja sehingga mereka dapat melihat kapan Anda bekerja."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deildu vöktum þínum með vinum og samstarfsmönnum svo þeir geti séð hvenær þú vinnur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi le tue vature con amici e colleghi in modo che possano vedere quando lavori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友人や同僚とシフトをシェアして、いつ仕事をしているかを確認できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구 및 동료와 근무를 공유하여 언제 일하는지 알 수 있도록 하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bendrinkite savo pamainas su draugais ir kolegomis, kad jie matytų, kada jūs dirbate."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koplietojiet savas maiņas ar draugiem un kolēģiem, lai viņi redzētu, kad jūs strādājat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del vaktene dine med venner og kolleger slik at de kan følge med på når du jobber."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del vaktene dine med venner og kolleger slik at de kan følge med på når du jobber."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del vaktene dine med venner og kolleger slik at dei kan sjå når du jobbar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępniaj swoje wakt ze znajomymi i kolegami, aby mogli widzieć, kiedy pracujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe seus turnos com amigos e colegas para que vejam quando você trabalha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partajați-vă schimburile cu prietenii și colegii pentru ca aceștia să vadă când lucrați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делитесь своими сменами с друзьями и коллегами, чтобы они видели, когда вы работаете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdieľajte svoje zmeny s priateľmi a kolegami, aby videli, kedy pracujete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deli svoje izmene s prijatelji in sodelavci, da vidijo, kdaj delaš."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delite svoje smene sa prijateljima i kolegama kako bi vidjeli kada radite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela dina vakter med vänner och kollegor så de kan se när du arbetar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisa zamu zako na rafiki na wenzako ili waweze kuona lini unavyofanya kazi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீ எப்போது வேலை செய்கிறாய் என்பதைக் காணக் கூடும் வகையில் உன் ஷிப்டுகளை நண்பர்கள் மற்றும் சக ஊழியர்களுடன் பகிர்ந்துகொள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์เวรของคุณกับเพื่อนและเพื่อนร่วมงาน เพื่อให้พวกเขาเห็นว่าคุณทำงานเมื่อใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vardiyalarınızı arkadaşlar ve meslektaşlarınızla paylaşın, böylece ne zaman çalıştığınızı görebilirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділіться своїми змінами з друзями та колегами, щоб вони могли бачити, коли ви працюєте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی شفٹوں کو دوستوں اور ساتھیوں کے ساتھ شیئر کریں تاکہ وہ دیکھ سکیں کہ آپ کب کام کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ ca làm việc của bạn với bạn bè và đồng nghiệp để họ có thể xem khi bạn làm việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与朋友和同事分享您的班次，让他们了解您的工作时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與朋友和同事分享你的班次，讓他們了解你何時工作。"
          }
        }
      }
