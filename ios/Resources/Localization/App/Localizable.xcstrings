    "profile.dangerZone.deleteAccount.description" : {
      "comment" : "Footer under the delete account button in profile settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف حسابك وجميع بيانتك بشكل دائم"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трайно изтриване на вашия акаунт и всички данни"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্ট এবং সমস্ত ডেটা স্থায়ীভাবে মুছুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimeix permanentment el teu compte i totes les dades"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale smazat svůj účet a všechna data"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet din konto og alle data permanent"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle Daten dauerhaft löschen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάγραψε μόνιμα τον λογαριασμό σου και όλα τα δεδομένα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete your account and all data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tu cuenta y todos los datos permanentemente"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kustuta oma konto ja kõik andmed jäädavalt"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب و تمام داده‌های خود را به‌طور دائمی حذف کنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista tilisi ja kaikki tiedot pysyvästi"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanenteng burahin ang iyong account at lahat ng data"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez définitivement votre compte et toutes les données"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחק את חשבונך וכל הנתונים שלך באופן קבוע"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने खाते और सभी डेटा को स्थायी रूप से हटाएं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajno obriši svoj račun i sve podatke"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Véglegesen törölje fiókját és az összes adatát"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus akun Anda dan semua data secara permanen"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyðu reikningnum þínum og öllum gögnum fyrir alltaf"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente il tuo account e tutti i dati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントと全データを永久に削除します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 및 모든 데이터 영구 삭제"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negrįžtamai ištrinti savo paskyrą ir visus duomenis"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neatgriezeniski dzēst savu kontu un visus datus"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slett kontoen din og alle data permanent"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder je account en alle gegevens permanent"
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slett kontoen din og alle data permanent"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usuń swoje konto i wszystkie dane"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletar sua conta e todos os dados permanentemente"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge permanent contul și toate datele"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безвозвратно удалить ваш аккаунт и все данные"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natrvalo vymazať váš účet a všetky údaje"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajno izbriši svoj račun in vse podatke"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajno obriši svoj račun i sve podatke"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta permanent bort ditt konto och all data"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futa akaunti yako na data yote kwa njia ya kudumu"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கணக்கு மற்றும் அனைத்து தரவை நிரந்தரமாக நீக்கு"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบบัญชีของคุณและข้อมูลทั้งหมดอย่างถาวร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı ve tüm verilerinizi kalıcı olarak silin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постійно видаліть свій обліковий запис і всі дані"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے اکاؤنٹ اور تمام ڈیٹا کو مستقل طور پر حذف کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa vĩnh viễn tài khoản và tất cả dữ liệu của bạn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除你的账户和所有数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除你的帳戶及所有資料"
          }
        }
      }
    },
    "profile.dangerZone.deleteAccount.dialogDescription" : {
      "comment" : "Message in the Delete account dialog. DELETE/SLETT must match profile.dangerZone.deleteAccount.confirmText.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب «حذف» للتأكيد. سيتم حذف جميع البيانات نهائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете ИЗТРИЙ, за да потвърдите. Всички данни ще бъдат изтрити завинаги."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত করতে DELETE লিখুন। সব ডেটা স্থায়ীভাবে মুছে ফেলা হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu ELIMINA per confirmar. Totes les dades s’eliminaran permanentment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro potvrzení zadejte SMAZAT. Všechna data budou trvale odstraněna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv SLET for at bekræfte. Alle data slettes permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib LÖSCHEN zur Bestätigung ein. Alle Daten werden dauerhaft gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολογήστε ΔΙΑΓΡΑΦΗ για επιβεβαίωση. Όλα τα δεδομένα θα διαγραφούν οριστικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type DELETE to confirm. All data will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe ELIMINAR para confirmar. Todos los datos se eliminarán de forma permanente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisesta kinnitamiseks KUSTUTA. Kõik andmed kustutatakse jäädavalt."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تأیید، DELETE را وارد کنید. همه داده‌ها برای همیشه حذف خواهند شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista kirjoittamalla POISTA. Kaikki tiedot poistetaan pysyvästi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-type ang DELETE para kumpirmahin. Permanenteng mabubura ang lahat ng data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez SUPPRIMER pour confirmer. Toutes les données seront définitivement supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלד מחק כדי לאשר. כל הנתונים יימחקו לצמיתות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुष्टि करने के लिए DELETE टाइप करें। सारा डेटा हमेशा के लिए हटा दिया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upišite OBRIŠI za potvrdu. Svi će podaci biti trajno izbrisani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megerősítéshez írd be: TÖRLÉS. Minden adat véglegesen törlődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik HAPUS untuk mengonfirmasi. Semua data akan dihapus secara permanen."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sláðu inn EYÐA til að staðfesta. Öllum gögnum verður eytt varanlega."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita ELIMINA per confermare. Tutti i dati verranno eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「削除」と入力して確認してください。すべてのデータは完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인하려면 삭제를 입력하세요. 모든 데이터가 영구적으로 삭제됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite IŠTRINTI, kad patvirtintumėte. Visi duomenys bus ištrinti visam laikui."
          }
        },
        "lv" : {
