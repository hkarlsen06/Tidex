    "dashboard.clock.error.maxDurationExceeded" : {
      "comment" : "Error when saving a clocked shift that lasts 24 hours or more. Shifts store only start and end times, so they must be shorter than a day.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون الوردية المسجّلة أقصر من 24 ساعة. أضف الورديات الأطول يدويًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смяна, отчетена с часовник, трябва да е по-кратка от 24 часа. По-дългите смени добавяйте ръчно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঘড়িতে রেকর্ড করা শিফট ২৪ ঘণ্টার চেয়ে কম হতে হবে। দীর্ঘ শিফট ম্যানুয়ালি যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un torn registrat ha de durar menys de 24 hores. Afegeix manualment els torns més llargs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Směna zaznamenaná pomocí časovače musí být kratší než 24 hodin. Delší směny přidejte ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stemplet vagt skal være kortere end 24 timer. Tilføj længere vagter manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erfasste Schicht muss kürzer als 24 Stunden sein. Längere Schichten manuell hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια χρονομετρημένη βάρδια πρέπει να είναι μικρότερη από 24 ώρες. Προσθέστε μεγαλύτερες βάρδιες χειροκίνητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clocked shift must be shorter than 24 hours. Add longer shifts manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un turno registrado debe durar menos de 24 horas. Añade los turnos más largos manualmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tööajaarvestusega vahetus peab kestma alla 24 tunni. Pikemad vahetused lisa käsitsi."
