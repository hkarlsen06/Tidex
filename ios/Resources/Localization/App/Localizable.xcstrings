    "friends.chat.blockedReadOnly" : {
      "comment" : "Notice at the bottom of a chat with a user the person has blocked. It replaces the message field.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
