    "notifications.shared.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخطرني عندما يغيّر الأصدقاء وردياتهم"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известете ме когато приятелите ми променят своите смени"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যখন বন্ধুরা তাদের শিফট পরিবর্তন করে তখন আমাকে জানান"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica'm quan els amics canvien els seus torns"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorni mě, když přátelé změní své směny"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsle mig når venner ændrer deres vakter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtige mich, wenn Freunde ihre Schichten ändern"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να με ειδοποιήσεις όταν οι φίλοι μου αλλάξουν τις βάρδιές τους"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify me when friends change their shifts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificarme cuando amigos cambien sus turnos"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teata mulle, kui sõbrad muudavad oma vahte"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی دوستان شیفت‌های خود را تغییر دهند به من اطلاع دهید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoita minulle, kun ystävät muuttavat vuorojaan"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paalalahtuhin ako kapag nagbago ang mga shift ng mga kaibigan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me notifier quand mes amis changent leurs horaires"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודע לי כשחברים משנים את המשמרות שלהם"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दोस्त अपनी शिफ्ट बदलें तो मुझे सचेत करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijesti me kada prijatelji promijene svoje smjene"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értesítsd meg, amikor barátaid megváltoztatják a műszakjaikat"
