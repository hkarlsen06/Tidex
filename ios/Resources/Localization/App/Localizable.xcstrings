            "value": "Impossibile ripristinare gli acquisti. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon aankopen niet terugzetten. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar as compras. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte återställa köp. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gendanne køb. Prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoja ei voitu palauttaa. Yritä uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przywrócić zakupów. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить покупки. Попробуйте еще раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити покупки. Спробуйте ще раз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
