    "settings.pay.currencyChangeTariffError": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke ændre valuta når du bruger løntakst-indstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Währung kann nicht geändert werden, wenn Tarifvergütungseinstellungen verwendet werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορείτε να αλλάξετε το νόμισμα όταν χρησιμοποιείτε ρυθμίσεις τιμολογίου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change currency when using tariff wage settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar la moneda al usar configuración de salario tarifario"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi muuttaa valuuttaa käyttäessäsi palkkaryhmien asetuksia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer la devise avec les paramètres de salaire conventionnel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi cambiare valuta quando utilizzi impostazioni di salario tariffario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与表を使用している場合は通貨を変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여 테이블 설정을 사용 중일 때는 통화를 변경할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke endre valuta når du har lønnstrinn-innstillinger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de valuta niet wijzigen bij tariefloontabellen"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikkje endre valuta når du har lønnstrinn-innstillingar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić walutę przy ustawieniach płacy taryfowej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível alterar a moeda ao usar configurações de salário por tabela"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu poți schimba valuta când folosești setări de salariu pe bază de tarif"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно изменить валюту при использовании параметров тарифной оплаты"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte ändra valuta när du använder lönetrappinställningar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปลี่ยนสกุลเงินเมื่อใช้การตั้งค่าเงินเดือนตามอัตราค่าจ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarife maaş ayarları kullanılırken para birimi değiştirilemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна змінити валюту при використанні тарифної системи оплати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi tiền tệ khi sử dụng cài đặt lương theo bảng lương"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用薪资等级设置时无法更改货币"
          }
        }
      }
    },
    "settings.pay.currencyTariffWarning": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta kan ikke ændres når du bruger løntakst, da den er bundet til danske kroner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Währung kann nicht geändert werden, wenn Tarifvergütung verwendet wird, da sie an norwegische Kronen gebunden ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το νόμισμα δεν μπορεί να αλλάξει όταν χρησιμοποιείτε τιμολόγιο, καθώς είναι δεμένο στη νορβηγική κορόνα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency cannot be changed when using tariff wage settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La moneda no se puede cambiar cuando usas salario tarifario, ya que está vinculado a coronas noruegas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuuttaa ei voi muuttaa käytettäessä palkkaryhmien asetuksia, koska se on sidottu Norjan kruunuun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La devise ne peut pas être modifiée avec les paramètres de salaire conventionnel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La valuta non può essere modificata quando utilizzi salario tariffario, poiché è legata a corone norvegesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与表を使用している場合、通貨を変更することはできません（ノルウェークローネに固定されています）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여 테이블을 사용 중일 때는 통화를 변경할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta kan ikke endres når du har tariff-lønn, siden den er bundet til norske kroner"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta kan niet worden gewijzigd bij tariefloontabellen, omdat deze aan Noorse kronen is gebonden"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta kan ikkje endrast når du har tariff-lønn, sidan ho er bunden til norske kroner"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić walutę przy ustawieniach płacy taryfowej, ponieważ jest powiązana z norweskimi koronami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A moeda não pode ser alterada ao usar salário por tabela, pois está vinculada ao real"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta nu poate fi schimbată când folosești salariu pe bază de tarif, deoarece este legată de coroana norvegian"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта не может быть изменена при использовании тарифной оплаты, так как она привязана к норвежским кронам"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valutan kan inte ändras när du använder lönetrappinställningar, eftersom den är bunden till svenska kronor"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปลี่ยนสกุลเงินเมื่อใช้เงินเดือนตามอัตราค่าจ้าง เนื่องจากมีการผูกมัดกับสกุลเงินโครนนอร์เวย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarife maaş ayarları kullanılırken para birimi değiştirilemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюту не можна змінити при використанні тарифної системи оплати, оскільки вона прив'язана до норвезької крони"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi tiền tệ khi sử dụng bảng lương, vì nó được liên kết với krone Na Uy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用薪资等级设置时无法更改货币，因为它与挪威克朗绑定"
          }
        }
      }
    },
