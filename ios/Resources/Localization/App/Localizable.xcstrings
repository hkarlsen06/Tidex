      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingsprocenten beregnes ud fra dine arbejdstimer sammenlignet med en %@-timers arbejdsuge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anstellungsquote wird berechnet aus deinen Arbeitsstunden im Vergleich zu einer %@-Stunden-Arbeitswoche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ποσοστιαία απασχόληση υπολογίζεται από τις ώρες εργασίας σας σε σχέση με μια %@-ωρη εργάσιμη εβδομάδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Employment percentage is calculated from your work hours compared to a %@-hour work week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje de contratación se calcula a partir de tus horas de trabajo en comparación con una semana laboral de %@ horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingsprosentin laskemisena käytetään työtuneistasi verrattuna %@-tunnin työviikkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage de poste est calculé à partir de vos heures de travail par rapport à une semaine de travail de %@ heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale di impiego è calcolata in base alle tue ore di lavoro rispetto a una settimana lavorativa di %@ ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雇用率は、%@時間の労働週と比較した実際の労働時間から計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고용 비율은 주당 %@시간 근무와 비교하여 근무 시간으로부터 계산됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingsprosent beregnes ut fra dine arbeidstimer sammenlignet med en %@-timers arbeidsuke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het dienstverband wordt berekend op basis van je werkuren vergeleken met een %@-urige werkweek."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingsprosent bereknas ut frå dine arbeidstimar samanligna med ein %@-timars arbeidsuke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent zatrudnienia jest obliczany na podstawie Twoich godzin pracy w porównaniu z %@-godzinnym tygodniem pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O percentual de contratação é calculado a partir de suas horas de trabalho em comparação com uma semana de trabalho de %@ horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Procentul de angajare este calculat din orele tale de muncă comparate cu o săptămână de lucru de %@ ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент занятости рассчитывается на основе ваших рабочих часов в сравнении с %@-часовой рабочей неделей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anställningsprocenten beräknas från dina arbetstimmar jämfört med en %@-timmars arbetsvecka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปอร์เซ็นต์ตำแหน่งคำนวณจากชั่วโมงการทำงานของคุณเทียบกับสัปดาห์ทำงาน %@ ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstihdam yüzdesi, çalışma saatlerinizin %@-saatlik bir iş haftasına kıyasla hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток зайнятості розраховується на основі ваших робочих годин у порівнянні з %@-годинним робочим тижнем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần trăm vị trí được tính toán từ giờ làm việc của bạn so với tuần làm việc %@ giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作岗位百分比是根据您的工作时数与 %@ 小时工作周进行比较计算的。"
          }
        }
      }
    },
