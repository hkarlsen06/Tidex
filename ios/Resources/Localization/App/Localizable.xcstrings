        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange din nya e-postadress. Vi skickar en bekräftelse till både din gamla och nya adress."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingiza anwani yako mpya ya barua pepe. Tutakutumia uthibitisho kwa anwani yako ya zamani na mpya."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் புதிய மின்னஞ்சல் முகவரியை உள்ளிடவும். உங்கள் பழைய மற்றும் புதிய முகவரிக்கு உறுதிப்படுத்தல் அனுப்பப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนที่อยู่อีเมลใหม่ของคุณ เราจะส่งการยืนยันไปยังทั้งที่อยู่เก่าและใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni e-posta adresinizi girin. Eski ve yeni adresinize bir onay göndereceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть вашу нову адресу електронної пошти. Ми надішлемо підтвердження на стару й нову адресу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا نیا ای میل پتہ درج کریں۔ ہم آپ کے پرانے اور نئے دونوں پتوں پر تصدیق بھیجیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập địa chỉ email mới của bạn. Chúng tôi sẽ gửi xác nhận đến cả địa chỉ cũ và mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入您的新电子邮件地址。我们将向您的旧地址和新地址发送确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入你的新電郵地址。我們會向你的舊電郵和新電郵地址發送確認。"
          }
        }
      }
    },
