    "dashboard.payrollDetails.adjustmentGrossTaxableHelp" : {
      "comment" : "Help text under the gross, tax estimated option of a pay adjustment.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضاف إلى الإجمالي ويُقدَّر الضريبة من شهر الصرف هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавя се към брутното възнаграждение и се изчислява данък за този месец на плащане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মোট বেতনে যোগ হয় এবং এই পেমেন্ট মাসের জন্য কর অনুমান করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'afegeix al sou brut i calcula l'impost d'aquest mes de pagament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přičte se k hrubé mzdě a odhadne se daň z tohoto výplatního měsíce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lægges til bruttoløn og beregner skat ud fra denne udbetalingsmåned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird zum Bruttolohn addiert und die Steuer für diesen Auszahlungsmonat geschätzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστίθεται στις μικτές αποδοχές και υπολογίζει εκτιμώμενο φόρο για αυτόν τον μήνα πληρωμής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds to gross pay and estimates tax from this payout month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se suma al salario bruto y estima el impuesto de este mes de pago."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisab brutopalgale ja hindab maksu selle väljamaksekuu järgi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به پرداخت ناخالص اضافه می‌شود و مالیات از ماه پرداختِ این مبلغ برآورد می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää bruttopalkkaa ja arvioi veron tästä maksukuukaudesta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idinadagdag sa gross pay at tinatantya ang buwis mula sa buwang ito ng payout."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute au brut et estime l’impôt de ce mois de paie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נוסף לשכר ברוטו ומחשב מס משוער לפי חודש התשלום הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सकल वेतन में जोड़ता है और इस भुगतान महीने से कर का अनुमान लगाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje se bruto plaći i procjenjuje porez za ovaj mjesec isplate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozzáadódik a bruttó bérhez, és ebből a kifizetési hónapból becsli az adót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan ke gaji bruto dan memperkirakan pajak dari bulan pembayaran ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bætist við brúttólaun og skattur er áætlaður út frá þessum útborgunarmánuði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge alla retribuzione lorda e stima le tasse da questo mese di pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "総支給に加算し、この支給月の税額を見積もります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총지급액에 추가되며, 이번 지급 월 기준으로 세금이 추정됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridedama prie bruto atlygio ir apskaičiuojamas šio išmokėjimo mėnesio mokesčio įvertis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskaita bruto algai un aprēķina nodokli no šī izmaksas mēneša."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legges til brutto og beregner skatt fra denne utbetalingsmåneden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt toe aan brutoloon en schat belasting voor deze uitbetalingsmaand."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir lagd til brutto og reknar ut skatt frå denne utbetalingsmånaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje do kwoty brutto i szacuje podatek z tego miesiąca wypłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona ao bruto e estima o imposto deste mês de pagamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se adaugă la brut și estimează impozitul pentru luna acestei plăți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляется к начисленной сумме, налог оценивается для этого месяца выплаты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripočíta sa k hrubej mzde a odhadne sa daň z tohto výplatného mesiaca."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doda se bruto plači, davek pa se oceni za ta izplačilni mesec."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje se na bruto platu i procenjuje porez za ovaj mesec isplate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läggs till bruttolönen och beräknar skatt från denna utbetalningsmånad."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huongeza kwenye malipo ghafi na kukadiria kodi kutoka mwezi huu wa malipo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மொத்த ஊதியத்தில் சேர்க்கப்பட்டு, இந்த கொடுப்பனவு மாதத்திற்கான வரி கணிக்கப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มในยอดจ่ายขั้นต้นและประเมินภาษีจากเดือนที่จ่ายนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brüt ücrete eklenir ve bu ödeme ayından vergi tahmin edilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додається до валової зарплати, а податок оцінюється за цей місяць виплати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموعی تنخواہ میں شامل ہوتا ہے اور اسی ادائیگی کے مہینے سے ٹیکس کا اندازہ لگاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cộng vào lương gộp và ước tính thuế từ tháng chi trả này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计入税前工资，并按本发薪月估算税额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加到稅前薪資，並依本發薪月份估算稅額。"
          }
        }
      }
    },
