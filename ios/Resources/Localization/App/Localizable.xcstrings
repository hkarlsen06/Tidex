    "notifications.permission.deniedHint": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at modtage meddelelser skal du aktivere dem i appen Indstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Benachrichtigungen zu erhalten, aktiviere sie in der Einstellungen-App"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να λαμβάνετε ειδοποιήσεις, ενεργοποιήστε τις στην εφαρμογή Ρυθμίσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, enable them in the Settings app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, actívalas en la app Configuración"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ilmoitukset käyttöön Asetuksissa saadaksesi ilmoituksia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez-les dans l'application Paramètres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere notifiche, abilitale nell'app Impostazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取るには、設定アプリで有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 설정 앱에서 활성화하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å motta varsler må du aktivere dem i Innstillinger-appen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je meldingen wilt ontvangen, schakel ze in via de Instellingen-app"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "For å motta varsler må du aktivere dem i Innstillingar-appen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby otrzymywać powiadomienia, włącz je w aplikacji Ustawienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative-as no app Configurações"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a primi notificări, activați-le în aplicația Setări"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получать уведомления, включите их в приложении Настройки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att ta emot aviseringar måste du aktivera dem i Inställningar-appen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการรับการแจ้งเตือน ให้เปิดใช้งานในแอป \"การตั้งค่า\""
