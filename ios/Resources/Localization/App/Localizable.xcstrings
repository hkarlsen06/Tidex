    "shifts.pause.editor.emptyState" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أوقات استراحة دقيقة لتجاوز قاعدة الاستراحة التلقائية لهذه الوردية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете точни паузи, за да замените автоматичното правило за почивка за тази смяна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শিফটের জন্য স্বয়ংক্রিয় বিরতি নিয়ম ওভাররাইড করতে নির্দিষ্ট বিরতির সময়সীমা যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix pauses exactes per substituir la regla automàtica de descans d'aquest torn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte přesné časy pauz, pokud chcete pro tuto směnu přepsat automatické pravidlo přestávky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj præcise pausetider for at tilsidesætte den automatiske pauseregel for denne vagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge genaue Pausenfenster hinzu, um die automatische Pausenregel für diese Schicht zu überschreiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ακριβή διαστήματα διαλείμματος για να παρακάμψετε τον αυτόματο κανόνα διαλείμματος για αυτή τη βάρδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add exact pause windows to override the automatic break rule for this shift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade pausas exactas para anular la regla automática de descanso de este turno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa täpsed pausiajad, et tühistada selle vahetuse automaatne pausireegel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای این شیفت، بازه‌های دقیق استراحت را اضافه کنید تا قانون خودکار کسر استراحت نادیده گرفته شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tarkat taukoajat ohittaaksesi tämän vuoron automaattisen taukosäännön."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng eksaktong oras ng pahinga para i-override ang awtomatikong tuntunin ng pahinga para sa shift na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des pauses exactes pour remplacer la règle de pause automatique pour ce service."
          }
        },
