        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে আপনার সেটিংস সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut desar la configuració en aquest dispositiu. Torna-ho a provar."
