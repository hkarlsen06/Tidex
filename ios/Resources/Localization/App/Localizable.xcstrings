    "wagey.emptyState.welcomeSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب بشكل طبيعي. يمكن لـ Wagey إضافة الورديات وتقدير الراتب والحفاظ على جدولك منظماً."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишете естествено. Wagey може да добави смени, да прецени заплатата и да поддържа вашия график в ред."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বাভাবিকভাবে লিখুন। Wagey শিফট যোগ করতে, বেতন অনুমান করতে এবং আপনার সময়সূচী সংগঠিত রাখতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu naturalment. Wagey pot afegir torns, estimar el sou i mantenir el teu horari en ordre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pište přirozeně. Wagey může přidávat směny, odhadovat plat a udržovat váš rozvrh v pořádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv naturligt. Wagey kan tilføje vakter, estimere løn og holde styr på dit skema."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreiben Sie natürlich. Wagey kann Schichten hinzufügen, Löhne berechnen und Ihren Zeitplan organisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε φυσικά. Το Wagey μπορεί να προσθέσει βάρδιες, να υπολογίσει το εισόδημα και να διατηρήσει το πρόγραμμά σας σε τάξη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write naturally. Wagey can add shifts, estimate pay, and keep your schedule in order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe naturalmente. Wagey puede agregar turnos, estimar tu paga y mantener tu horario en orden."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjuta loomulikult. Wagey saab lisada vahetusi, hinnata palka ja hoida sinu graafikut korras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به طور طبیعی بنویسید. Wagey می‌تواند شیفت‌ها را اضافه کند، حقوق را تخمین بزند و برنامه شما را منظم نگه دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita luonnollisesti. Wagey voi lisätä vuoroja, laskea palkkaa ja pitää aikataulusi järjestyksessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsulat nang natural. Ang Wagey ay maaaring magdagdag ng shifts, tantiyahin ang bayad, at panatilihing maayos ang iyong iskedyul."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez naturellement. Wagey peut ajouter des vagues, estimer votre salaire et organiser votre emploi du temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתוב בצורה טבעית. Wagey יכול להוסיף משמרות, להעריך שכר ולשמור על סדר בלוח הזמנים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वाभाविक रूप से लिखें। Wagey शिफ्ट जोड़ सकता है, वेतन का अनुमान लगा सकता है, और आपके शेड्यूल को व्यवस्थित रख सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pišite prirodno. Wagey može dodati smjene, procijeniti plaću i održati redoslijed vašeg rasporeda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írj természetesen. A Wagey képes váltásokat hozzáadni, a fizetést becsülni és a munkarendedet rendben tartani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis secara alami. Wagey dapat menambahkan shift, memperkirakan gaji, dan menjaga jadwal Anda tetap rapi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifaðu náttúrulega. Wagey getur bætt við vöktum, metið laun og haldið dagskrá þinni í lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi naturalmente. Wagey può aggiungere turni, stimare lo stipendio e mantenere ordinato il tuo calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然に書いてください。Wageyはシフトの追加、給与の計算、スケジュール管理ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자연스럽게 작성하세요. Wagey는 근무 시간을 추가하고, 급여를 계산하며, 일정을 정리할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rašykite natūraliai. Wagey gali pridėti pamainas, apskaičiuoti atlyginimą ir palaikyti jūsų grafiką tvarkoje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakstiet dabiski. Wagey var pievienot maiņas, aprēķināt algu un kārtot jūsu grafiku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv naturlig. Wagey kan legge til vakter, beregne lønn og holde orden på timeplanen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf natuurlijk. Wagey kan diensten toevoegen, loon berekenen en je rooster organiseren."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv naturlig. Wagey kan legge til vakter, beregne lønn og holde orden på timeplanen din."
          }
