    "data.export.about.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحسين تقرير PDF لصيغة A4 بالعرض الطولي ويتضمن أرقام صفحات تلقائية وطابع زمني للإنشاء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF докладът е оптимизиран за формат A4 портретен и включва автоматични номера на страниците и времеви печат на генериране."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পিডিএফ রিপোর্ট এ৪ পোর্ট্রেট ফর্ম্যাটের জন্য অপ্টিমাইজ করা হয়েছে এবং স্বয়ংক্রিয় পৃষ্ঠা সংখ্যা এবং প্রজন্ম টাইমস্ট্যাম্প অন্তর্ভুক্ত করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'informe PDF està optimitzat per a format A4 vertical i inclou números de pàgina automàtics i marca de temps de generació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpráva PDF je optimalizována pro formát A4 na výšku a zahrnuje automatická čísla stránek a čas generování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF-rapporten er optimeret til A4-stående format og inkluderer automatiske sidetal og genereringstidspunkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der PDF-Bericht ist für das A4-Hochformat optimiert und enthält automatische Seitenzahlen und einen Generierungszeitstempel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναφορά PDF είναι βελτιστοποιημένη για μορφή A4 σε κατακόρυφο προσανατολισμό και περιλαμβάνει αυτόματους αριθμούς σελίδας και χρονοσφραγίδα δημιουργίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PDF report is optimized for A4 portrait format and includes automatic page numbers and generation timestamp."
          }
        },
        "es" : {
