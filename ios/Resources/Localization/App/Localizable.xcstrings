    "onboarding.success.friend_only.reassurance" : {
      "comment" : "Note on the final onboarding screen for users who skipped work setup.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعِدّ العمل لاحقًا إذا أردت الرواتب والإحصاءات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте работата по-късно, ако искате заплата и статистика."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেরোল আর পরিসংখ্যান চাইলে পরে কাজ সেট আপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura la feina més tard si vols nòmina i estadístiques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práci si můžete nastavit později, pokud chcete mzdu a statistiky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt arbejde op senere, hvis du vil have løn og statistik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Arbeit später ein, wenn du Lohn und Statistiken willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίστε την εργασία αργότερα αν θέλετε μισθοδοσία και στατιστικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up work later if you want payroll and stats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura el trabajo más tarde si quieres nómina y estadísticas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadista töö hiljem, kui soovid palka ja statistikat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر حقوق و آمار می‌خواهید، بعداً کار را تنظیم کنید."
          }
        },
        "fi" : {
