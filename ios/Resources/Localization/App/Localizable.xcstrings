        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিরতি প্রথমে মূল বেতন থেকে, তারপর প্রয়োজন হলে সর্বনিম্ন ভাতা থেকে কাটা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
