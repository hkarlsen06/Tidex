    "settings.pay.editor.breakDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically deduct break time from shifts over a certain length"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk automatisk pause fra vakter over en viss lengde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausenzeit automatisch von Schichten über einer bestimmten Länge abziehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduire automatiquement le temps de pause des quarts de plus d'une certaine durée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deducir automáticamente el tiempo de descanso de turnos superiores a cierta duración"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detrai automaticamente la pausa dai turni oltre una certa durata"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek automatisch pauzetijd af van diensten die langer zijn dan een bepaalde duur"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descontar automaticamente o tempo de pausa de turnos acima de certo comprimento"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra automatiskt av paustid från skift över en viss längd"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk automatisk pause fra vakter over en viss længde"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähennä automaattisesti tauko pitkistä vuoroista"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie potrącaj przerwę z dyżurów powyżej określonej długości"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически вычитать время перерыва из смен определённой длительности"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично вираховувати час перерви зі змін понад певну довжину"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
