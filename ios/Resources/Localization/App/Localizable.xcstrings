    "recurring.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this recurring shift? All future occurrences will be removed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne faste vakten? Alle fremtidige vakter vil bli fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie diese wiederkehrende Schicht löschen möchten? Alle zukünftigen Vorkommen werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que deseas eliminar este turno recurrente? Se eliminarán todas las futuras repeticiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce quart récurrent ? Toutes les occurrences futures seront supprimées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この定期シフトを削除してもよろしいですか？今後のすべての発生が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 근무를 삭제하시겠습니까? 앞으로의 모든 근무가 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que deseja excluir este turno recorrente? Todas as ocorrências futuras serão removidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эту повторяющуюся смену? Все будущие повторения будут удалены."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u deze terugkerende dienst wilt verwijderen? Alle toekomstige voorvallen worden verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort detta återkommande skift? Alla framtida förekomster tas bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette dette tilbagevendende skift? Alle fremtidige forekomster vil blive fjernet."
          }
        }
      }
    },
