    "supplements.editorHint": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg beregnes baseret på vaktens tidspunkt. Ændringer her gælder kun for denne vagt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge werden basierend auf Schichtzeiten berechnet. Änderungen gelten nur für diese Schicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα συμπληρώματα υπολογίζονται με βάση τα χρονικά όρια της βάρδιας. Οι αλλαγές εδώ ισχύουν μόνο για αυτήν τη βάρδια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements are calculated based on shift times. Changes here apply only to this shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los suplementos se calculan según el horario del turno. Los cambios aquí aplican solo a este turno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisät lasketaan vuoron aikojen perusteella. Tässä tehdyt muutokset koskevat vain tätä vuoroa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments sont calculés en fonction des heures de travail. Les modifications ici s'appliquent uniquement à ce quart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi vengono calcolati in base all'orario del turno. Le modifiche qui si applicano solo a questo turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補足はシフト時間に基づいて計算されます。ここでの変更はこのシフトにのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 근무 시간을 기준으로 계산됩니다. 여기서의 변경사항은 이 근무에만 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg beregnes basert på vaktens tid. Endringer her gjelder kun for denne vakten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements worden berekend op basis van vachttijden. Wijzigingen hier gelden alleen voor deze vacht."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg beregnes basert på vaktens tid. Endringer her gjelder kun for denne vakten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki obliczane są na podstawie czasu zmiany. Zmiany tutaj dotyczą tylko tej zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os suplementos são calculados com base no horário do turno. As alterações aqui se aplicam apenas a este turno."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplimentele se calculează pe baza orelor schimbului. Modificările aici se aplică doar acestui schimb."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки рассчитываются на основе времени смены. Изменения здесь применяются только к этой смене."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg beräknas baserat på skifttider. Ändringar här gäller endast för detta skift."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนเสริมคำนวณจากเวลากะ การเปลี่ยนแปลงที่นี่ใช้ได้เฉพาะกะนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekler vardiya saatlerine göre hesaplanır. Buradaki değişiklikler yalnızca bu vardiyaya uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки розраховуються на основі часу зміни. Зміни тут стосуються лише цієї зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ cấp được tính dựa trên thời gian ca làm việc. Những thay đổi ở đây chỉ áp dụng cho ca này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补充根据班次时间计算。此处的更改仅适用于此班次。"
          }
        }
      }
    },
