    "shifts.deleteConfirmRecurringNote" : {
      "comment" : "Sentence added to the delete confirmation when the selected days include a recurring shift. Only the selected dates of the recurring shift are removed; its other dates stay.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُزال الورديات المتكررة إلا في التواريخ المحددة. تبقى تواريخها الأخرى كما هي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повтарящите се смени се премахват само на избраните дати. Останалите им дати остават непроменени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুনরাবৃত্ত শিফটগুলি শুধু নির্বাচিত তারিখগুলোতেই সরানো হবে। অন্য তারিখগুলো আগের মতোই থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els torns recurrents només s'eliminen de les dates seleccionades. Les altres dates es mantenen igual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakující se směny se odstraní pouze ve vybraných dnech. V ostatních dnech zůstanou beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentagne vagter fjernes kun på de valgte datoer. De øvrige datoer forbliver uændrede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederkehrende Schichten werden nur an den ausgewählten Tagen entfernt. An den anderen Tagen bleiben sie bestehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επαναλαμβανόμενες βάρδιες διαγράφονται μόνο για τις επιλεγμένες ημερομηνίες. Οι βάρδιες στις υπόλοιπες ημερομηνίες παραμένουν ως έχουν."
