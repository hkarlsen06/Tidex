    "settings.pay.editor.createImpact" : {
      "comment" : "Explanation at the top of the new wage entry sheet about what a new entry starts from and changes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ بإعدادات هذا التاريخ. غيّر فقط ما يختلف في شروط أجرك الجديدة. تحتفظ الفترات السابقة بإعداداتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Започва с настройките за тази дата. Променете само това, което е различно в новите ви условия за заплащане. По-ранните периоди запазват настройките си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই তারিখের সেটিংস দিয়ে শুরু হয়। আপনার নতুন বেতন-শর্তে যা আলাদা, শুধু তা পরিবর্তন করুন। আগের সময়কালগুলো তাদের সেটিংস ধরে রাখে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comença amb la configuració d'aquesta data. Canvia només el que sigui diferent en les teves noves condicions salarials. Els períodes anteriors mantenen la seva configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začíná nastavením pro toto datum. V nových mzdových podmínkách změňte jen to, co se liší. Předchozí období si zachovají svá nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starter med indstillingerne for denne dato. Rediger kun det, der er anderledes i dine nye lønvilkår. Tidligere perioder beholder deres indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnt mit den Einstellungen für dieses Datum. Ändere nur, was in deinen neuen Vergütungsbedingungen anders ist. Frühere Zeiträume behalten ihre Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινά με τις ρυθμίσεις για αυτή την ημερομηνία. Αλλάξτε μόνο ό,τι διαφέρει στους νέους όρους αμοιβής σας. Οι προηγούμενες περίοδοι διατηρούν τις ρυθμίσεις τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts with the settings for this date. Change only what is different in your new pay terms. Earlier periods keep their settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienza con la configuración de esta fecha. Cambie solo lo que sea diferente en sus nuevas condiciones salariales. Los períodos anteriores conservan su configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alustatakse selle kuupäeva seadetest. Muuda ainult seda, mis on uutes palgatingimustes erinev. Varasemad perioodid säilitavad oma seaded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با تنظیمات این تاریخ شروع می‌شود. فقط موارد متفاوت در شرایط پرداخت جدیدتان را تغییر دهید. دوره‌های قبلی تنظیمات خود را حفظ می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aluksi käytetään tämän päivämäärän asetuksia. Muuta vain se, mikä uusissa palkkaehdoissasi on erilaista. Aiemmat jaksot säilyttävät asetuksensa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagsisimula ito sa mga setting para sa petsang ito. Baguhin lamang ang naiiba sa bago mong mga tuntunin sa sahod. Mananatili ang mga setting ng naunang panahon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence avec les réglages de cette date. Modifiez uniquement ce qui diffère dans vos nouvelles conditions de rémunération. Les périodes antérieures conservent leurs réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחיל בהגדרות של תאריך זה. שנו רק את מה ששונה בתנאי השכר החדשים שלכם. תקופות קודמות שומרות על ההגדרות שלהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इस तारीख की सेटिंग्स से शुरू होता है। अपनी नई वेतन शर्तों में केवल जो अलग है, उसे बदलें। पहले की अवधियाँ अपनी सेटिंग्स बनाए रखेंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počinje s postavkama za ovaj datum. Promijenite samo ono što se razlikuje u vašim novim uvjetima plaće. Ranija razdoblja zadržavaju svoje postavke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adott dátum beállításaival kezdődik. Az új bérezési feltételeidnél csak az eltérő értékeket módosítsd. A korábbi időszakok megtartják a beállításaikat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimulai dengan pengaturan untuk tanggal ini. Ubah hanya yang berbeda dalam ketentuan gaji baru Anda. Periode sebelumnya mempertahankan pengaturannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byrjar með stillingunum fyrir þessa dagsetningu. Breyttu aðeins því sem er öðruvísi í nýju launakjörunum þínum. Eldri tímabil halda stillingum sínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia con le impostazioni per questa data. Modifica solo ciò che è diverso nelle tue nuove condizioni retributive. I periodi precedenti mantengono le proprie impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日付の設定から開始します。新しい給与条件で異なる部分だけを変更してください。以前の期間は設定を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 날짜의 설정으로 시작합니다. 새 급여 조건에서 달라진 부분만 변경하세요. 이전 기간은 기존 설정을 유지합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pradedama nuo šiai datai taikomų nustatymų. Pakeiskite tik tai, kas skiriasi jūsų naujose atlygio sąlygose. Ankstesni laikotarpiai išsaugo savo nustatymus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sākas ar šī datuma iestatījumiem. Maini tikai to, kas atšķiras tavos jaunajos samaksas nosacījumos. Iepriekšējie periodi saglabā savus iestatījumus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starter med innstillingene for denne datoen. Endre det som er nytt i lønnsvilkårene dine. Tidligere perioder beholder innstillingene sine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begint met de instellingen voor deze datum. Wijzig alleen wat anders is in je nieuwe loonvoorwaarden. Eerdere perioden behouden hun instellingen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar med innstillingane for denne datoen. Endre berre det som er annleis i dei nye lønnsvilkåra dine. Tidlegare periodar beheld innstillingane sine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczyna się od ustawień dla tej daty. Zmień tylko to, co różni się w nowych warunkach wynagrodzenia. Wcześniejsze okresy zachowają swoje ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa com as configurações desta data. Altere apenas o que for diferente nos seus novos termos salariais. Os períodos anteriores mantêm suas configurações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începe cu setările pentru această dată. Modifică doar ceea ce diferă în noile tale condiții salariale. Perioadele anterioare își păstrează setările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинается с настроек для этой даты. Измените только то, что отличается в новых условиях оплаты. Предыдущие периоды сохранят свои настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začína nastaveniami platnými pre tento dátum. Zmeňte len to, čo sa líši vo vašich nových mzdových podmienkach. Skoršie obdobia si zachovajú svoje nastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začne se z nastavitvami za ta datum. Spremenite le, kar je drugače v novih pogojih plačila. Prejšnja obdobja ohranijo svoje nastavitve."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počinje sa podešavanjima za ovaj datum. Promenite samo ono što se razlikuje u vašim novim uslovima zarade. Raniji periodi zadržavaju svoja podešavanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börjar med inställningarna för detta datum. Ändra bara det som skiljer sig i dina nya lönevillkor. Tidigare perioder behåller sina inställningar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huanzia na mipangilio ya tarehe hii. Badilisha tu kilicho tofauti katika masharti yako mapya ya malipo. Vipindi vya awali vitaendelea na mipangilio yake."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தேதிக்கான அமைப்புகளுடன் தொடங்குகிறது. உங்கள் புதிய ஊதிய விதிமுறைகளில் மாறியவற்றை மட்டும் மாற்றவும். முந்தைய காலங்கள் தங்கள் அமைப்புகளைத் தக்கவைத்துக் கொள்கின்றன."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มต้นด้วยการตั้งค่าสำหรับวันที่นี้ เปลี่ยนเฉพาะสิ่งที่แตกต่างในเงื่อนไขค่าจ้างใหม่ของคุณ ช่วงเวลาก่อนหน้านี้จะคงการตั้งค่าเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tarih için geçerli ayarlarla başlar. Yeni ücret koşullarınızdan yalnızca farklı olanları değiştirin. Önceki dönemler ayarlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Починається з налаштувань для цієї дати. Змініть лише те, що відрізняється у ваших нових умовах оплати. Попередні періоди збережуть свої налаштування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اس تاریخ کی ترتیبات سے شروع ہوتا ہے۔ اپنی نئی اجرت کی شرائط میں صرف مختلف چیزیں تبدیل کریں۔ پچھلی مدتیں اپنی ترتیبات برقرار رکھیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu với các cài đặt cho ngày này. Chỉ thay đổi những gì khác trong điều khoản lương mới của bạn. Các kỳ trước vẫn giữ cài đặt cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此日期的设置开始。只更改新薪资条款中不同的部分。更早的期间保留其设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會從此日期的設定開始。只變更新薪資條件中不同的部分。更早期間會保留原設定。"
          }
        }
      }
    },
