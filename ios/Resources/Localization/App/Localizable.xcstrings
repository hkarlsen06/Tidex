    "calendar.subscription.error.missing_token" : {
      "comment" : "Error when this device no longer has the calendar subscription link. The user can create a new one.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا الجهاز يحتوي على رابط التقويم. أنشئ رابط تقويم جديدًا لفتحه مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство вече няма календарния линк. Създайте нов календарен линк, за да го отворите отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে আর ক্যালেন্ডার লিংকটি নেই। আবার খুলতে নতুন ক্যালেন্ডার লিংক তৈরি করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest dispositiu ja no té l'enllaç del calendari. Crea un enllaç de calendari nou per tornar-lo a obrir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení už nemá odkaz na kalendář. Vytvořte nový odkaz kalendáře a znovu ho otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed har ikke længere kalenderlinket. Opret et nyt kalenderlink for at åbne det igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat den Kalenderlink nicht mehr. Erstelle einen neuen Kalenderlink, um ihn erneut zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν έχει πλέον τον σύνδεσμο ημερολογίου. Δημιουργήστε νέο σύνδεσμο ημερολογίου για να τον ανοίξετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device no longer has the calendar link. Create a new calendar link to open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo ya no tiene el enlace del calendario. Crea un nuevo enlace de calendario para abrirlo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selles seadmes pole enam kalendriviidet. Selle uuesti avamiseks loo uus kalendriviide."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این دستگاه دیگر لینک تقویم را ندارد. برای باز کردن دوباره آن، یک لینک تقویم جدید ایجاد کنید."
