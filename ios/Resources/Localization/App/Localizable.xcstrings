          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkluderar vaktöversikt, summor per typ och lönesummering."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inajumuisha muhtasari wa zamu, jumla kwa aina, na muhtasari wa mshahara."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வேலை கண்ணோட்டம், வகையின்படி மொத்தங்கள் மற்றும் சம்பள சுருக்கம் உள்ளடக்கியது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมภาพรวมกะ ผลรวมตามประเภท และสรุปเงินเดือน"
