    "dashboard.payrollDetails.adjustmentEarnedRangeHelp" : {
      "comment" : "Help text under the earned from and earned to dates of a pay adjustment.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة اختيارية عن الفترة التي يخصها التعديل. لا يغيّر موعد الصرف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незадължителна бележка за периода, към който се отнася корекцията. Не променя плащането."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাডজাস্টমেন্টটি কোন সময়ের জন্য তা বোঝাতে ঐচ্ছিক নোট। এটি পেমেন্ট সরায় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota opcional del període al qual correspon l'ajust. No mou el pagament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volitelná poznámka k období, kterého se úprava týká. Výplatu neposune."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfri note om, hvilken periode justeringen gælder. Den flytter ikke udbetalingen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Notiz, für welchen Zeitraum die Anpassung gilt. Die Auszahlung wird nicht verschoben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προαιρετική σημείωση για την περίοδο στην οποία ανήκει η προσαρμογή. Δεν μετακινεί την πληρωμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional note for what period the adjustment belongs to. It does not move the payout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota opcional sobre el período al que corresponde el ajuste. No mueve el pago."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valikuline märkus, millise perioodi kohta korrigeering käib. See ei muuda väljamakset."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادداشت اختیاری برای دوره‌ای که این تعدیل مربوط به آن است. زمان پرداخت را جابه‌جا نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnainen huomio ajanjaksosta, johon korjaus kuuluu. Se ei siirrä maksua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsyonal na tala kung saang panahon nabibilang ang adjustment. Hindi nito inililipat ang payout."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note facultative sur la période concernée par l’ajustement. Ne change pas le paiement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הערה אופציונלית לגבי התקופה שההתאמה שייכת אליה. היא לא משנה את מועד התשלום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समायोजन किस अवधि का है, इसके लिए वैकल्पिक नोट। इससे भुगतान नहीं बदलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neobavezna bilješka za razdoblje kojem prilagodba pripada. Ne mijenja isplatu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionális megjegyzés arról, melyik időszakhoz tartozik a korrekció. Nem módosítja a kifizetést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan opsional untuk periode penyesuaian ini berlaku. Ini tidak menggeser pembayaran."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfrjáls athugasemd um hvaða tímabil leiðréttingin tilheyrir. Hún færir ekki útborgunina."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota facoltativa sul periodo a cui appartiene la rettifica. Non sposta il pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整の対象期間の任意メモです。支給日は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조정이 해당하는 기간에 대한 선택 메모입니다. 지급일은 이동되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirenkama pastaba, kuriam laikotarpiui priklauso koregavimas. Išmokėjimo ji neperkelia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
