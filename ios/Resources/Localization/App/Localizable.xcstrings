          }
        }
      }
    },
    "onboarding.wage.tariffOffline" : {
      "comment" : "Hint under the tariff list on the onboarding wage screen when tariff data can't be loaded. The app falls back to built-in standard rates.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل أحدث معدلات الأجور. تُعرض المعدلات القياسية. اتصل بالإنترنت للتحديث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последните ставки не можаха да се заредят. Показват се стандартните ставки. Свържете се с интернет, за да ги обновите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সর্বশেষ হার লোড করা যায়নি। প্রচলিত হার দেখানো হচ্ছে। আপডেট করতে ইন্টারনেটে সংযুক্ত হন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut carregar les tarifes més recents. Es mostren les tarifes estàndard. Connecta't a internet per actualitzar-les."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejnovější sazby se nepodařilo načíst. Zobrazují se standardní sazby. Pro aktualizaci se připojte k internetu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nyeste satser kunne ikke hentes. Viser standardsatser. Opret forbindelse til internettet for at opdatere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Tarife konnten nicht geladen werden. Standardtarife werden angezeigt. Verbinde dich zum Aktualisieren mit dem Internet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση των πιο πρόσφατων τιμών. Εμφανίζονται οι βασικές τιμές. Συνδεθείτε στο διαδίκτυο για ενημέρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load the latest rates. Showing standard rates. Connect to the internet to update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar las tarifas más recientes. Se muestran las tarifas estándar. Conéctate a internet para actualizarlas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusimaid määrasid ei õnnestunud laadida. Kuvatakse standardmäärad. Uuendamiseks loo internetiühendus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخرین نرخ‌ها بارگیری نشد. نرخ‌های استاندارد نمایش داده می‌شوند. برای به‌روزرسانی به اینترنت وصل شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusimpia palkkoja ei voitu ladata. Näytetään vakiopalkat. Päivitä muodostamalla internetyhteys."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakuha ang pinakabagong rate. Ipinapakita ang karaniwang rate. Kumonekta sa internet para mag-update."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les derniers taux. Taux standards affichés. Connectez-vous à Internet pour les actualiser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לטעון את התעריפים העדכניים. מוצגים תעריפים רגילים. יש להתחבר לאינטרנט כדי לעדכן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नवीनतम दरें लोड नहीं हो सकीं। मानक दरें दिखाई जा रही हैं। अपडेट करने के लिए इंटरनेट से जुड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće učitati najnovije satnice. Prikazane su standardne satnice. Povežite se s internetom za ažuriranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni a legfrissebb díjszabásokat. Az alapdíjszabások láthatók. A frissítéshez csatlakozz az internethez."
          }
        },
        "id" : {
