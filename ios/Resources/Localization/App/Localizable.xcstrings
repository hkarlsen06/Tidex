    "acceptTerms.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, you must read and accept our Terms of Service and Privacy Policy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fortsette må du lese og godta våre vilkår for bruk og personvernerklæring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fortzufahren, müssen Sie unsere Nutzungsbedingungen und Datenschutzrichtlinie lesen und akzeptieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, vous devez lire et accepter nos conditions d'utilisation et notre politique de confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, debes leer y aceptar nuestros Términos de servicio y Política de privacidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare, devi leggere e accettare i nostri Termini di servizio e l'Informativa sulla privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fortsette må du lese og godta våre vilkår for bruk og personvernerklæring."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, você deve ler e aceitar nossos Termos de Serviço e Política de Privacidade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att fortsätta måste du läsa och godkänna våra användarvillkor och integritetspolicy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at fortsætte skal du læse og acceptere vores servicevilkår og privatlivspolitik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkaaksesi sinun on luettava ja hyväksyttävä palveluehdot ja tietosuojakäytäntö."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, musisz przeczytać i zaakceptować nasze Warunki świadczenia usług i Politykę prywatności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для продолжения вы должны прочитать и принять наши Условия обслуживания и Политику конфиденциальности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, ви повинні прочитати й прийняти наші Умови використання та Політику конфіденційності."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するには、利用規約およびプライバシーポリシーを読んで同意する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 서비스 약관 및 개인정보 보호정책을 읽고 동의해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要继续，您必须阅读并接受我们的服务条款和隐私政策。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการดำเนินการต่อ คุณต้องอ่านและยอมรับเงื่อนไขการใช้งานและนโยบายความเป็นส่วนตัวของเรา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tiếp tục, bạn phải đọc và chấp nhận Điều khoản dịch vụ và Chính sách quyền riêng tư của chúng tôi."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fortsette må du lese og godta våre vilkår for bruk og personvernerklæring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için Hizmet Şartlarımızı ve Gizlilik Politikamızı okumalı ve kabul etmelisiniz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να συνεχίσετε, πρέπει να διαβάσετε και να αποδεχτείτε τους Όρους Υπηρεσίας και την Πολιτική Απορρήτου."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a continua, trebuie să citești și să accepți Termenii de utilizare și Politica de confidențialitate."
          }
        }
      }
    },
