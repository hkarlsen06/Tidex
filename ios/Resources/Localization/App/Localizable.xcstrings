        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo dos cosas rápidas y ya estás dentro"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaid kaks kiiret asja ja siis oled sisse"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط دو چیز سریع، سپس وارد می‌شوی"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
