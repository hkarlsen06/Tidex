    "monthLimit.deleteExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add shifts in %@, shifts in %@ must be deleted."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til vakter i %@, må vaktene i %@ slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Schichten in %@ hinzuzufügen, müssen Schichten in %@ gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar turnos en %@, deben eliminarse turnos en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter des quarts en %@, les quarts en %@ doivent être supprimés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にシフトを追加するには、%@ のシフトを削除する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 근무를 추가하려면 %@의 근무를 삭제해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar turnos em %@, turnos em %@ devem ser deletados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить смены в %@, смены в %@ должны быть удалены."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om diensten in %@ toe te voegen, moeten diensten in %@ worden verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att lägga till skift i %@ måste skift i %@ tas bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tilføje skift i %@, skal skift i %@ slettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere turni in %@, i turni in %@ devono essere eliminati."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuorojen lisäämiseksi %@:ssa vuorot %@:ssa on poistettava."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać zmiany w %@, zmiany w %@ muszą zostać usunięte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб додати зміни в %@, зміни в %@ необхідно видалити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在%@添加班次，必须删除%@的班次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเพิ่มกะใน %@ ต้องลบกะใน %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thêm ca làm việc trong %@, phải xóa ca làm việc trong %@."
          }
        }
      }
    },
