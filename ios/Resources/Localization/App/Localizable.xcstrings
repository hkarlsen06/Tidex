        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere notifiche, abilitale nell'app Impostazioni"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je meldingen wilt ontvangen, schakel ze in via de Instellingen-app"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative-as no app Configurações"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att ta emot aviseringar måste du aktivera dem i Inställningar-appen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at modtage meddelelser skal du aktivere dem i appen Indstillinger"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ilmoitukset käyttöön Asetuksissa saadaksesi ilmoituksia"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby otrzymywać powiadomienia, włącz je w aplikacji Ustawienia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получать уведомления, включите их в приложении Настройки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримувати сповіщення, увімкніть їх у програмі Параметри"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取るには、設定アプリで有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 설정 앱에서 활성화하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收通知，请在设置应用中启用通知"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการรับการแจ้งเตือน ให้เปิดใช้งานในแอป \"การตั้งค่า\""
