        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Többé nem látod %@ megosztott műszakjait. Ő továbbra is láthatja a vele megosztott műszakjaidat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan berhenti melihat shift yang dibagikan %@. Mereka tetap bisa melihat shift yang Anda bagikan dengan mereka."
