    "settings.pay.currencyChangeTariffError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change currency when using tariff wage settings"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke endre valuta når du har lønnstrinn-innstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Währung kann nicht geändert werden, wenn Tarifabgeltungseinstellungen verwendet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar la moneda al usar configuración de salario por tarifa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer la devise avec les paramètres de salaire tarifaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関税賃金設定を使用している場合は通貨を変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요금 급여 설정 사용 시 통화를 변경할 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível alterar a moeda ao usar configurações de salário por tabela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно изменить валюту при использовании тарифных настроек зарплаты"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan munteenheid niet wijzigen bij tarieflooninstelling"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte ändra valuta när tarifflönesinställningar används"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke ændre valuta ved brug af tariflønindstillinger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile cambiare valuta con impostazioni stipendio tariffario"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuuttaa ei voi muuttaa käytettäessä tariffipalkkaasetuksia"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić waluty przy użyciu ustawień wynagrodzeń taryfowych"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо змінити валюту при використанні тарифних параметрів оплати"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用关税薪资设置时无法更改货币"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปลี่ยนสกุลเงินเมื่อใช้การตั้งค่าเงินเดือนแบบอัตราค่าจ้าง"
