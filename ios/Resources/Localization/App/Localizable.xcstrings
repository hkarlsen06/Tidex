          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காலண்டரை தானாகத் திறக்க முடியவில்லை. சந்தா இணைப்பை நகலெடுத்து கைமுறையாகச் சேர்க்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
