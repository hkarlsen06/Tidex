            "value": "Poista tilisi ja kaikki tiedot pysyvästi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuń swoje konto i wszystkie dane"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди видаліть ваш акаунт і всі дані"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除您的账户和所有数据"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีและข้อมูลของคุณอย่างถาวร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
