    "sharing.offline.actionsUnavailable" : {
      "comment" : "Banner on the friends screen when offline. Saved friends stay visible but cannot be changed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالإنترنت لإدارة المشاركة. سيظل أصدقاؤك المحفوظون ظاهرين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свържете се с интернет, за да управлявате споделянето. Запазените приятели остават видими."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেয়ারিং পরিচালনা করতে ইন্টারনেটে সংযুক্ত হন। সেভ করা বন্ধুরা দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecta't a internet per gestionar la compartició. Els amics desats continuen visibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro správu sdílení se připojte k internetu. Uložení přátelé zůstanou viditelní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret forbindelse til internettet for at administrere deling. Dine gemte venner er stadig synlige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle eine Internetverbindung her, um Teilen zu verwalten. Gespeicherte Freunde bleiben sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε στο διαδίκτυο για διαχείριση κοινοποίησης. Οι αποθηκευμένοι φίλοι παραμένουν ορατοί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to the internet to manage sharing. Your saved friends stay visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a internet para gestionar el uso compartido. Tus amigos guardados seguirán visibles."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühenduge internetiga, et hallata jagamist. Salvestatud sõbrad jäävad nähtavaks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای مدیریت اشتراک‌گذاری به اینترنت وصل شوید. دوستان ذخیره‌شده همچنان نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä internetiin hallitaksesi jakamista. Tallennetut ystävät näkyvät edelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumonekta sa internet para pamahalaan ang pagbabahagi. Makikita pa rin ang mga naka-save na kaibigan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à Internet pour gérer le partage. Vos amis enregistrés restent visibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחברו לאינטרנט כדי לנהל שיתוף. החברים השמורים יישארו גלויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेयरिंग प्रबंधित करने के लिए इंटरनेट से कनेक्ट करें। आपके सहेजे गए दोस्त दिखते रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povežite se s internetom za upravljanje dijeljenjem. Spremljeni prijatelji ostaju vidljivi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozz az internethez a megosztás kezeléséhez. A mentett ismerősök továbbra is láthatók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
