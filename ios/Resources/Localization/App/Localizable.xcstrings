          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали все сообщения в этом месяце. Обновитесь, чтобы продолжить общение с Wagey."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al je berichten deze maand gebruikt. Upgrade om door te gaan met chatten met Wagey."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
