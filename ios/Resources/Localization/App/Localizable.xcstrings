    "resetPassword.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your email or phone to reset your password"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn e-post eller telefonnummer for å tilbakestille passordet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre E-Mail oder Telefonnummer ein, um Ihr Passwort zurückzusetzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez votre e-mail ou numéro de téléphone pour réinitialiser votre mot de passe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
