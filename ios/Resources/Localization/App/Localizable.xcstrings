    "shifts.virtualConversionInfo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes will create a new shift and exclude this date from the recurring shift"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer oppretter en ny vakt og ekskluderer denne datoen fra den faste vakten"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen erstellen eine neue Schicht und schließen dieses Datum aus der wiederkehrenden Schicht aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios crearán un nuevo turno y excluirán esta fecha del turno recurrente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications créeront un nouveau quart et excluront cette date du quart récurrent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更により新しいシフトが作成され、この日付は繰り返しシフトから除外されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경하면 새 근무가 생성되고 이 날짜가 반복 근무에서 제외됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações criarão um novo turno e excluirão esta data do turno recorrente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения создадут новую смену и исключат эту дату из повторяющейся смены"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen creëren een nieuwe shift en sluiten deze datum uit van de terugkerende shift"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar kommer att skapa ett nytt skift och exkludera detta datum från det återkommande skiftet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer vil oprette et nyt skift og udelukke denne dato fra det tilbagevendende skift"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche creeranno un nuovo turno ed escluderanno questa data dal turno ricorrente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset luovat uuden vuoron ja poistavat tämän päivämäärän toistuvasta vuorosta"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany utworzą nowy dyżur i wykluczą tę datę z dyżuru powtarzającego się"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни створять нову зміну та виключать цю дату з повторюваної зміни"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改将创建新班次并将此日期从循环班次中排除"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงจะสร้างกะการทำงานใหม่และ除外วันนี้จากกะการทำงานที่เกิดซ้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những thay đổi sẽ tạo một ca làm việc mới và loại trừ ngày này khỏi ca làm việc định kỳ"
          }
        }
      }
    },
