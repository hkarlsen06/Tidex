    "settings.pay.editor.baselineHelp" : {
      "comment" : "Help text under the baseline wage entry. Shifts before the first dated entry use the baseline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم استخدام الأساس للورديات قبل أي إدخالات مؤرخة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Базовата линия се използва за смени преди всички датирани записи"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেসলাইন যেকোনো তারিখ সহ এন্ট্রির আগে শিফটের জন্য ব্যবহৃত হয়"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línia de base s'utilitza per a torns anteriors a qualsevol entrada datada"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grunnlinie se používá pro směny před jinými datovanými položkami"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundlinjen bruges til skift før andre daterede poster"
