    "settings.pay.error.deletionRefreshFailed" : {
      "comment" : "Shown when a job was deleted but the app could not refresh afterwards.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف الوظيفة. أعد الاتصال بالإنترنت ثم حدّث بياناتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работата беше изтрита. Свържете се отново с интернет и опреснете, за да актуализирате данните си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাকরিটি মুছে ফেলা হয়েছে। আপনার ডেটা আপডেট করতে ইন্টারনেটে পুনরায় সংযোগ করুন এবং রিফ্রেশ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La feina s’ha eliminat. Torna a connectar-te i actualitza per posar les dades al dia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaměstnání bylo smazáno. Znovu se připojte k internetu a aktualizujte data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbet blev slettet. Opret forbindelse igen, og opdatér for at opdatere dine data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Job wurde gelöscht. Stelle die Internetverbindung wieder her und aktualisiere, um deine Daten zu aktualisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εργασία διαγράφηκε. Συνδεθείτε ξανά και ανανεώστε για να ενημερωθούν τα δεδομένα σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The job was deleted. Reconnect and refresh to update your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El empleo se ha eliminado. Vuelve a conectarte y actualiza para actualizar tus datos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töökoht kustutati. Andmete värskendamiseks loo internetiühendus ja värskenda andmeid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغل حذف شد. برای به‌روزرسانی داده‌ها، دوباره به اینترنت متصل شوید و تازه‌سازی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työpaikka poistettiin. Muodosta yhteys uudelleen ja päivitä tietosi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabura ang trabaho. Kumonekta muli sa internet at i-refresh upang ma-update ang iyong data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'emploi a été supprimé. Connectez-vous à Internet et actualisez pour mettre vos données à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחבר לאינטרנט ורענן כדי לעדכן את הנתונים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नौकरी हटा दी गई। अपना डेटा अपडेट करने के लिए इंटरनेट से फिर कनेक्ट करें और रिफ्रेश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posao je izbrisan. Ponovno se povežite s internetom i osvježite podatke kako biste ih ažurirali."
          }
        },
        "hu" : {
          "stringUnit" : {
