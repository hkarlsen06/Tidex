    "onboarding.personalize.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun to hurtige ting, så er du klar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zwei schnelle Dinge, dann bist du dabei"
