          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a baseline wage before creating shifts for this job."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un salario base antes de crear turnos para este trabajo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
