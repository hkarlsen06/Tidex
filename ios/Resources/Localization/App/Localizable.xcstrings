    "alerts.storageIssue.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save data to device storage. Your changes will not be saved when the app closes. Please restart the app or check your device storage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke lagre data til enhetslagring. Endringene dine blir ikke lagret når appen lukkes. Start appen på nytt eller sjekk enhetslagringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten konnten nicht auf dem Gerät gespeichert werden. Deine Änderungen werden nicht gespeichert, wenn die App geschlossen wird. Bitte starte die App neu oder überprüfe deinen Gerätespeicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden guardar los datos en el almacenamiento del dispositivo. Tus cambios no se guardarán cuando cierres la app. Reinicia la app o verifica el almacenamiento del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les données sur le stockage de l'appareil. Vos modifications ne seront pas enregistrées à la fermeture de l'application. Veuillez redémarrer l'application ou vérifier le stockage de votre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスストレージにデータを保存できません。アプリを閉じると変更は保存されません。アプリを再起動するか、デバイスストレージを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 저장소에 데이터를 저장할 수 없습니다. 앱을 종료하면 변경사항이 저장되지 않습니다. 앱을 다시 시작하거나 기기 저장소를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar dados no armazenamento do dispositivo. Suas alterações não serão salvas quando o app fechar. Reinicie o app ou verifique o armazenamento do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить данные на устройстве. Ваши изменения не будут сохранены при закрытии приложения. Пожалуйста, перезагрузите приложение или проверьте хранилище устройства."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan gegevens niet opslaan op apparaatopslag. Wijzigingen worden niet opgeslagen wanneer de app wordt gesloten. Start de app opnieuw of controleer je apparaatopslag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att spara data till enhetens lagring. Dina ändringar sparas inte när appen stängs. Starta om appen eller kontrollera enhetens lagring."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke gemme data til enhedens lager. Dine ændringer gemmes ikke når appen lukkes. Genstart appen eller kontroller dit enhedslager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i dati nell'archivio del dispositivo. Le modifiche non verranno salvate alla chiusura dell'app. Riavvia l'app o controlla lo spazio di archiviazione del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietoja ei voida tallentaa laitteen muistiin. Muutoksia ei tallenneta, kun sovellus suljetaan. Käynnistä sovellus uudelleen tai tarkista laitteesi muisti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać danych na urządzeniu. Zmiany nie zostaną zapisane po zamknięciu aplikacji. Uruchom aplikację ponownie lub sprawdź pamięć urządzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти дані на пристрій. Ваші зміни не будуть збережені при закритті програми. Перезавантажте програму або перевірте місце для зберігання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存数据到设备存储。应用关闭时您的更改将不会被保存。请重启应用或检查您的设备存储。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกข้อมูลลงในที่เก็บอุปกรณ์ได้ การเปลี่ยนแปลงของคุณจะไม่ถูกบันทึกเมื่อปิดแอป โปรดรีสตาร์ทแอปหรือตรวจสอบที่เก็บอุปกรณ์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dữ liệu vào bộ nhớ thiết bị. Những thay đổi của bạn sẽ không được lưu khi ứng dụng đóng. Vui lòng khởi động lại ứng dụng hoặc kiểm tra bộ nhớ thiết bị."
          }
        }
      }
    },
