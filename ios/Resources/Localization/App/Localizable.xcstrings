    "paywall.wageyLimit.message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har brugt alle dine beskeder denne måned. Opgrader for at fortsætte chat med Wagey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle deine Nachrichten diesen Monat aufgebraucht. Upgrade, um weiter mit Wagey zu chatten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήσατε όλα τα μηνύματα αυτό τον μήνα. Αναβαθμίστε για να συνεχίσετε την κουβέντα με το Wagey."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all your messages this month. Upgrade to continue chatting with Wagey."
          }
        },
        "es": {
