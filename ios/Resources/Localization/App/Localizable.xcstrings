    "onboarding.settings.tax.hint" : {
      "comment" : "Hint on the onboarding tax setting. Keep the Norwegian words skattetrekk and skattekort as is so immigrant workers can match them to their payslip and tax card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخصم الضريبة من الأجر المحسوب. تُسمى في قسائم الرواتب النرويجية skattetrekk، وتجد النسبة في بطاقتك الضريبية (skattekort)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приспада данък от изчислената заплата. В норвежките фишове за заплата това се нарича skattetrekk, а процентът е в данъчната ви карта (skattekort)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হিসাব করা বেতন থেকে কর কাটে। নরওয়ের বেতন স্লিপে একে skattetrekk বলা হয়, আর শতাংশটি আপনার ট্যাক্স কার্ডে (skattekort) থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedueix impostos del sou calculat. A les nòmines noruegues es diu skattetrekk, i el percentatge surt a la teva targeta fiscal (skattekort)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odečte daň z vypočtené mzdy. Na norských výplatních páskách se to jmenuje skattetrekk a procento najdete na své daňové kartě (skattekort)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trækker skat fra beregnet løn. På norske lønsedler hedder det skattetrekk, og procentsatsen står på dit norske skattekort (skattekort)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieht Steuern vom berechneten Lohn ab. Auf norwegischen Lohnabrechnungen heißt das skattetrekk, und den Prozentsatz findest du auf deiner Steuerkarte (skattekort)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τον φόρο από τον υπολογισμένο μισθό. Στις νορβηγικές μισθοδοσίες λέγεται skattetrekk και το ποσοστό αναγράφεται στη φορολογική σας κάρτα (skattekort)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deducts tax from calculated pay. Norwegian payslips call this skattetrekk, and the percentage is on your tax card (skattekort)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descuenta impuestos del salario calculado. En las nóminas noruegas se llama skattetrekk, y el porcentaje aparece en tu tarjeta fiscal (skattekort)."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvestab arvutatud palgast maha maksu. Norra palgalehtedel nimetatakse seda skattetrekk ja protsent on sinu maksukaardil (skattekort)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مالیات را از دستمزد محاسبه‌شده کم می‌کند. در فیش‌های حقوقی نروژی به آن skattetrekk می‌گویند و درصد آن روی کارت مالیاتی شما (skattekort) آمده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähentää veron lasketusta palkasta. Norjalaisissa palkkalaskelmissa sen nimi on skattetrekk, ja prosentti näkyy verokortissasi (skattekort)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibinabawas ang buwis sa kinalkulang sahod. Sa mga payslip sa Norway, tinatawag itong skattetrekk, at nasa iyong tax card (skattekort) ang porsiyento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déduit l'impôt de la rémunération calculée. Sur les fiches de paie norvégiennes, cela s'appelle skattetrekk, et le pourcentage figure sur votre carte fiscale (skattekort)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנכה מס מהשכר המחושב. בתלושי שכר נורווגיים זה נקרא skattetrekk, והאחוז מופיע בכרטיס המס שלך (skattekort)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गणना किए गए वेतन से टैक्स काटता है। नॉर्वे की सैलरी स्लिप पर इसे skattetrekk कहते हैं, और प्रतिशत आपके टैक्स कार्ड (skattekort) पर होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oduzima porez od izračunate plaće. Na norveškim platnim listama to se zove skattetrekk, a postotak je na vašoj poreznoj kartici (skattekort)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levonja az adót a számított fizetésből. A norvég bérpapíron ennek neve skattetrekk, a százalékot pedig az adókártyádon (skattekort) találod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memotong pajak dari gaji yang dihitung. Di slip gaji Norwegia, namanya skattetrekk, dan persentasenya ada di kartu pajak Anda (skattekort)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dregur skatt frá reiknuðum launum. Á norskum launaseðlum heitir það skattetrekk og prósentan er á skattkortinu þínu (skattekort)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deduce le tasse dallo stipendio calcolato. Nelle buste paga norvegesi si chiama skattetrekk e la percentuale è sulla tua tessera fiscale (skattekort)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算された給与から税金を差し引きます。ノルウェーの給与明細では skattetrekk と呼ばれ、税率は税カード（skattekort）に記載されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계산된 급여에서 세금을 공제합니다. 노르웨이 급여 명세서에서는 skattetrekk라고 하며, 세율은 세금 카드(skattekort)에 나와 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaito mokestį iš apskaičiuoto atlyginimo. Norvegijos atlyginimo lapeliuose tai vadinama skattetrekk, o procentas nurodytas jūsų mokesčių kortelėje (skattekort)."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskaita nodokli no aprēķinātās algas. Norvēģijas algas lapiņās to sauc par skattetrekk, un procents ir norādīts jūsu nodokļu kartē (skattekort)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekker skatt fra beregnet lønn"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekt belasting af van het berekende loon. Op Noorse loonstroken heet dit skattetrekk, en het percentage staat op je belastingkaart (skattekort)."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekker skatt fra beregnet lønn"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odlicza podatek od obliczonego wynagrodzenia. Na norweskich paskach płacowych nazywa się to skattetrekk, a procent znajdziesz na swojej karcie podatkowej (skattekort)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconta impostos da remuneração calculada. Nos contracheques noruegueses isso se chama skattetrekk, e a porcentagem está no seu cartão fiscal (skattekort)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scade impozitul din salariul calculat. Pe fluturașii de salariu norvegieni se numește skattetrekk, iar procentul este pe cardul tău fiscal (skattekort)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вычитает налог из рассчитанной зарплаты. В норвежских расчётных листках это называется skattetrekk, а процент указан в вашей налоговой карточке (skattekort)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpočíta daň z vypočítanej mzdy. Na nórskych výplatných páskach sa to volá skattetrekk a percento nájdete na svojej daňovej karte (skattekort)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odšteje davek od izračunane plače. Na norveških plačilnih listah se to imenuje skattetrekk, odstotek pa je na vaši davčni kartici (skattekort)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oduzima porez od izračunate plate. Na norveškim platnim listićima to se zove skattetrekk, a procenat je na vašoj poreskoj kartici (skattekort)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drar av skatt från beräknad lön. På norska lönebesked heter det skattetrekk, och procentsatsen står på ditt norska skattekort (skattekort)."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukata kodi kutoka kwenye mshahara uliokokotolewa. Kwenye hati za mishahara za Norwe inaitwa skattetrekk, na asilimia iko kwenye kadi yako ya kodi (skattekort)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணக்கிடப்பட்ட சம்பளத்திலிருந்து வரியைக் கழிக்கிறது. நார்வே சம்பளச் சீட்டுகளில் இது skattetrekk எனப்படும், சதவீதம் உங்கள் வரி அட்டையில் (skattekort) இருக்கும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หักภาษีจากค่าจ้างที่คำนวณได้ ในสลิปเงินเดือนของนอร์เวย์เรียกว่า skattetrekk และเปอร์เซ็นต์อยู่ในบัตรภาษีของคุณ (skattekort)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplanan maaştan vergiyi düşer. Norveç maaş bordrolarında buna skattetrekk denir ve oran vergi kartınızda (skattekort) yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримує податок із розрахованої зарплати. У норвезьких розрахункових листках це називається skattetrekk, а відсоток вказано у вашій податковій картці (skattekort)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب شدہ تنخواہ سے ٹیکس کاٹتا ہے۔ ناروے کی تنخواہ کی پرچی پر اسے skattetrekk کہتے ہیں، اور شرح آپ کے ٹیکس کارڈ (skattekort) پر ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trừ thuế từ lương đã tính. Trên phiếu lương ở Na Uy, khoản này gọi là skattetrekk, và tỷ lệ phần trăm ghi trên thẻ thuế của bạn (skattekort)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从计算出的工资中扣除税款。挪威工资单上称为 skattetrekk，税率写在你的税卡（skattekort）上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從計算出的薪資中扣除稅款。挪威薪資單上稱為 skattetrekk，稅率寫在你的稅卡（skattekort）上。"
          }
        }
      }
    },
