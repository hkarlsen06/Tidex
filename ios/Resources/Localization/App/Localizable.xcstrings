    "recurring.deleteConfirmMessage" : {
      "comment" : "Message in the Delete recurring shift dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في حذف هذه الوردية المتكررة؟ سيتم حذف جميع التكرارات المستقبلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурни ли сте, че искате да изтриете тази повтаряща се смяна? Всички бъдещи смени ще бъдат изтрити."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পুনরাবৃত্ত শিফটটি মুছে ফেলতে চান? ভবিষ্যতের সব শিফট মুছে ফেলা হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segur que vols eliminar aquest torn recurrent? S’eliminaran tots els torns futurs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete tuto opakovanou směnu smazat? Všechny budoucí výskyty budou smazány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil slette denne tilbagevendende vagt? Alle fremtidige vagter slettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du diese wiederkehrende Schicht löschen möchtest? Alle zukünftigen Vorkommen werden gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε βέβαιοι ότι θέλετε να διαγράψετε αυτή την επαναλαμβανόμενη βάρδια; Θα διαγραφούν όλες οι μελλοντικές βάρδιες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this recurring shift? All future occurrences will be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres eliminar este turno recurrente? Se eliminarán todas las ocurrencias futuras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas oled kindel, et soovid selle korduva vahetuse kustutada? Kõik tulevased vahetused kustutatakse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئنید می‌خواهید این شیفت تکرارشونده را حذف کنید؟ همه موارد آینده حذف خواهند شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti poistaa tämän toistuvan työvuoron? Kaikki tulevat työvuorot poistetaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurado ka bang gusto mong burahin ang paulit-ulit na shift na ito? Mabubura ang lahat ng susunod na pag-ulit nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer ce service récurrent\n? Tous les services à venir seront supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שברצונך למחוק את המשמרת החוזרת הזו? כל המשמרות העתידיות יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई इस दोहराई जाने वाली शिफ्ट को हटाना चाहते हैं? भविष्य की सभी शिफ्ट हटा दी जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li sigurni da želite izbrisati ovu ponavljajuću smjenu? Sve će buduće smjene biti izbrisane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan törölni szeretnéd ezt az ismétlődő műszakot? A jövőben ütemezett összes műszak törlődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakin ingin menghapus shift berulang ini? Semua shift berikutnya akan dihapus."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ertu viss um að þú viljir eyða þessari endurteknu vakt? Öllum framtíðarvöktum verður eytt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler eliminare questo turno ricorrente? Tutti i turni futuri verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この繰り返しシフトを削除してもよろしいですか？今後のすべてのシフトも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 반복 근무를 삭제하시겠습니까? 이후의 모든 근무가 삭제됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar tikrai norite ištrinti šią pasikartojančią pamainą? Visos būsimos pamainos bus ištrintos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai tiešām vēlaties dzēst šo atkārtoto maiņu? Visas turpmākās maiņas tiks dzēstas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette denne faste vakten? Alle fremtidige vakter blir slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je deze terugkerende dienst wilt verwijderen? Alle toekomstige diensten worden verwijderd."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
