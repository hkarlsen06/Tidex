    "shifts.pause.section.summary.addHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أوقات استراحة دقيقة إذا أردت أن تستخدم هذه الوردية فترات الاستراحة المحفوظة بدلًا من قاعدة الاستراحة التلقائية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете точни паузи, ако искате тази смяна да ползва запазени паузи вместо автоматичното правило за почивка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শিফটে স্বয়ংক্রিয় বিরতি নিয়মের বদলে সংরক্ষিত বিরতি ব্যবহার করতে চাইলে নির্দিষ্ট বিরতির সময়সীমা যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix pauses exactes si vols que aquest torn faci servir pauses desades en lloc de la regla automàtica de descans."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte přesné časy pauz, pokud má tato směna použít uložené pauzy místo automatického pravidla přestávky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj præcise pausetider, hvis denne vagt skal bruge gemte pauser i stedet for den automatiske pauseregel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge genaue Pausenfenster hinzu, wenn diese Schicht gespeicherte Pausen statt der automatischen Pausenregel verwenden soll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ακριβή διαστήματα διαλείμματος αν θέλετε αυτή η βάρδια να χρησιμοποιεί αποθηκευμένα διαλείμματα αντί για τον αυτόματο κανόνα διαλείμματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add exact pause windows if you want this shift to use saved pauses instead of the automatic break rule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade pausas exactas si quieres que este turno use pausas guardadas en lugar de la regla automática de descanso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa täpsed pausiajad, kui soovid, et see vahetus kasutaks automaatse pausireegli asemel salvestatud pause."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر می‌خواهید این شیفت به‌جای قانون خودکار کسر استراحت از استراحت‌های ذخیره‌شده استفاده کند، بازه‌های دقیق استراحت را اضافه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tarkat taukoajat, jos haluat tämän vuoron käyttävän tallennettuja taukoja automaattisen taukosäännön sijaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng eksaktong oras ng pahinga kung gusto mong gamitin ng shift na ito ang mga naka-save na pahinga sa halip na ang awtomatikong tuntunin ng pahinga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des pauses exactes si vous voulez que ce service utilise les pauses enregistrées au lieu de la règle de pause automatique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף זמני הפסקה מדויקים אם ברצונך שהמשמרת הזו תשתמש בהפסקות שמורות במקום בכלל הניכוי האוטומטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप चाहते हैं कि यह शिफ्ट स्वचालित ब्रेक नियम के बजाय सहेजे गए विराम इस्तेमाल करे, तो सटीक विराम समय जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte točne intervale pauze ako želite da ova smjena koristi spremljene pauze umjesto automatskog pravila pauze."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon meg pontos szünetidőket, ha azt szeretné, hogy ez a műszak a mentett szüneteket használja az automatikus szünetszabály helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan waktu jeda yang tepat jika Anda ingin shift ini memakai jeda tersimpan, bukan aturan istirahat otomatis."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bættu við nákvæmum pásutímum ef þú vilt að þessi vakt noti vistaðar pásur í stað sjálfvirku pásureglunnar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi fasce di pausa esatte se vuoi che questo turno usi le pause salvate invece della regola automatica della pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このシフトで自動休憩ルールではなく保存済み休憩を使う場合は、正確な休憩時間を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 근무에 자동 휴게 규칙 대신 저장된 휴게를 사용하려면 정확한 휴게 시간을 추가하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridėkite tikslius pertraukos laikus, jei norite, kad ši pamaina naudotų išsaugotas pertraukas vietoj automatinės pertraukų taisyklės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievienojiet precīzus pauzes laikus, ja vēlaties, lai šī maiņa izmantotu saglabātās pauzes automātiskā pārtraukuma noteikuma vietā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til eksakte pausetider hvis du vil at denne vakten skal bruke lagrede pauser i stedet for den automatiske pauseregelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg exacte pauzetijden toe als je wilt dat deze dienst opgeslagen pauzes gebruikt in plaats van de automatische pauzeregel."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til eksakte pausetider viss du vil at denne vakta skal bruke lagra pausar i staden for den automatiske pauseregelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj dokładne okna przerw, jeśli chcesz, aby ta zmiana używała zapisanych przerw zamiast automatycznej reguły przerw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione pausas exatas se quiser que este turno use pausas salvas em vez da regra automática de intervalo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă intervale exacte de pauză dacă vrei ca această tură să folosească pauzele salvate în locul regulii automate de pauză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте точные интервалы перерыва, если хотите, чтобы для этой смены использовались сохранённые перерывы вместо автоматического правила перерыва."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte presné časy prestávok, ak má táto zmena použiť uložené prestávky namiesto automatického pravidla prestávky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte točne intervale odmora, če želite, da ta izmena uporablja shranjene odmore namesto samodejnega pravila odmora."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj tačna vremena pauze ako želiš da ova smena koristi sačuvane pauze umesto automatskog pravila pauze."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till exakta paustider om du vill att detta pass ska använda sparade pauser i stället för den automatiska pausregeln."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeza nyakati halisi za pausa ikiwa unataka zamu hii itumie pausa zilizohifadhiwa badala ya sheria ya mapumziko ya kiotomatiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த ஷிப்ட் தானியங்கி இடைவேளை விதிக்கு பதிலாக சேமித்த இடைவேளைகளைப் பயன்படுத்த வேண்டுமெனில், துல்லியமான இடைவேளை நேரங்களைச் சேர்க்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
