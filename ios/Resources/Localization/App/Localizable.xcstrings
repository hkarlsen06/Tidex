    "security.mfa.unenrollDialog.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikke længere kunne bruge denne app til to-faktor godkendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese App nicht mehr für die Zwei-Faktor-Authentifizierung verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν θα μπορείτε πλέον να χρησιμοποιήσετε αυτήν την εφαρμογή για ταυτοποίηση δύο παραγόντων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer be able to use this app for two-factor authentication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrás usar esta aplicación para la autenticación de dos factores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi enää käyttää tätä sovellusta kaksivaiheiseen autentikointiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus utiliser cette app pour l'authentification à deux facteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrai più usare questa app per l'autenticazione a due fattori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリを二要素認証に使用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱을 더 이상 이중 인증에 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikke lenger kunne bruke denne appen for to-faktor autentisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt deze app niet langer gebruiken voor twee-factor authenticatie."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikkje lenger kunne bruke denne appen for to-faktor autentisering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będziesz już mógł używać tej aplikacji do uwierzytelniania dwuskładnikowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não poderá mais usar este app para autenticação de dois fatores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vei mai putea folosi această aplicație pentru autentificarea cu doi factori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не сможете использовать это приложение для двухфакторной аутентификации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer inte längre att kunna använda den här appen för tvåfaktorsautentisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่สามารถใช้แอปนี้สำหรับการตรวจสอบสิทธิ์แบบสองขั้นได้อีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı artık iki faktörlü kimlik doğrulama için kullanamayacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви більше не зможете використовувати цю програму для двофакторної автентифікації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không còn có thể sử dụng ứng dụng này cho xác thực hai yếu tố."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将无法再使用此应用进行双因素认证。"
          }
        }
      }
    },
