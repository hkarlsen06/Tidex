          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo nuovo indirizzo email. Ti invieremo una conferma sia al vecchio che al nuovo indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメールアドレスを入力してください。古いアドレスと新しいアドレスの両方に確認メールを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이메일 주소를 입력하세요. 기존 주소와 새 주소 모두에 확인을 보내드립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn din nye e-postadresse. Vi sender en bekreftelse til både den gamle og nye adressen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je nieuwe e-mailadres in. We sturen een bevestiging naar je oude en nieuwe adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nowy adres e-mail. Wyślemy potwierdzenie na stary i nowy adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu novo endereço de email. Enviaremos uma confirmação para seu endereço antigo e novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите новый адрес электронной почты. Мы отправим подтверждение на оба адреса."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange din nya e-postadress. Vi skickar en bekräftelse till både din gamla och nya adress."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนที่อยู่อีเมลใหม่ของคุณ เราจะส่งการยืนยันไปยังที่อยู่เก่าและใหม่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть вашу нову адресу електронної пошти. Ми надішлемо підтвердження на обидві адреси."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ email mới. Chúng tôi sẽ gửi xác nhận đến cả địa chỉ cũ và mới của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您的新电子邮件地址。我们将向您的旧地址和新地址发送确认。"
          }
        }
      }
    },
