    "paywall.shiftLimit.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسمح الخطة المجانية بالورديات في شهر واحد في كل مرة. قم بالترقية لتتبع الورديات عبر عدة أشهر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безплатният план позволява вакти в продължение на един месец. Надстройте, за да проследявате вакти за няколко месеца."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিনামূল্যে পরিকল্পনা একবারে এক মাসের জন্য শিফট অনুমতি দেয়। একাধিক মাস জুড়ে শিফট ট্র্যাক করতে আপগ্রেড করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pla gratuït permet vagues d'un mes a la vegada. Actualitza per fer un seguiment de les vagues en múltiples mesos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatný plán umožňuje směny v jednom měsíci najednou. Upgradujte, abyste mohli sledovat směny přes více měsíců."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis-planen tillader vakter i én måned ad gangen. Opgrader for at spore vakter over flere måneder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Plan ermöglicht Schichten in einem Monat gleichzeitig. Upgrade, um Schichten über mehrere Monate zu verfolgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δωρεάν σχέδιο επιτρέπει βάρδιες σε έναν μήνα τη φορά. Αναβαθμίστε για να παρακολουθείτε βάρδιες σε πολλούς μήνες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free plan allows shifts in one month at a time. Upgrade to track shifts across multiple months."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan gratuito permite vueltas en un mes a la vez. Actualiza para rastrear vueltas en varios meses."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasuta plaan lubab vakteid ühe kuu kaupa. Täiendage, et jälgida vakteid mitme kuu jooksul."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طرح رایگان اجازه می‌دهد تا وقایع را در یک ماه ردیابی کنید. برای ردیابی وقایع در چند ماه، به نسخه پیشرفته ارتقا دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen suunnitelma sallii vuoroja yhdessä kuukaudessa kerrallaan. Päivitä seurataksesi vuoroja useiden kuukausien aikana."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang libreng plano ay nagpapahintulot ng mga shift sa loob ng isang buwan lamang. Mag-upgrade upang subaybayan ang mga shift sa maraming buwan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan gratuit permet les quarts dans un mois à la fois. Passez à la version premium pour suivre les quarts sur plusieurs mois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התוכנית החינמית מאפשרת vaktim בחודש אחד בכל פעם. שדרג כדי לעקוב אחרי vaktim על פני חודשים מרובים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुफ्त योजना एक बार में एक महीने के शिफ्ट की अनुमति देती है। कई महीनों में शिफ्ट ट्रैक करने के लिए अपग्रेड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besplatni plan omogućava vakte u jednom mjesecu odjednom. Nadogradi se kako bi pratila vakte tijekom više mjeseci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ingyenes csomag lehetővé teszi egy hónapos műszakokat. Frissítsd fel, hogy több hónapos műszakokat követhess nyomon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket gratis memungkinkan vakat dalam satu bulan sekaligus. Tingkatkan untuk melacak vakat di beberapa bulan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ókeypis áætlun gerir kleift að skrá vaktir í einn mánuð í einu. Uppfærðu til að fylgjast með vöktum yfir marga mánuði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano gratuito consente vakte in un mese alla volta. Effettua l'upgrade per tracciare vakte su più mesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランでは1度に1ヶ月分のシフトを記録できます。複数月のシフトを追跡するにはアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 요금제는 한 번에 한 달의 근무만 허용합니다. 업그레이드하여 여러 달에 걸친 근무를 추적하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemokamas planas leidžia sekti pamainą viename mėnesyje vienu metu. Pasirinkite pasiūlymą, jei norite sekti pamainas keliuose mėnesiuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezmaksas plāns ļauj pārvaldīt maiņas vienu mēnesi vienlaikus. Jauniniet, lai izsekotu maiņas vairākos mēnešos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis-planen tillater vakter i én måned om gangen. Oppgrader for å spore vakter over flere måneder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gratis abonnement biedt diensten in één maand tegelijk. Upgrade om diensten over meerdere maanden bij te houden."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis-planen tillèt vakter i éin månad om gongen. Oppgrader for å sporé vakter over fleire månader."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan darmowy pozwala na śledzenie wakt w jednym miesiącu na raz. Przejdź na plan płatny, aby śledzić wakty przez wiele miesięcy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano gratuito permite vakt em um mês por vez. Atualize para rastrear vakt em vários meses."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planul gratuit permite vachete într-o lună la un moment dat. Fă upgrade pentru a urmări vachete pe mai multe luni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатный план позволяет отслеживать смены в течение одного месяца. Обновитесь, чтобы отслеживать смены за несколько месяцев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatný plán umožňuje v管tracked vakt v jednom mesiaci naraz. Upgradujte na sledovanie vakt naprieč viacerou mesiacmi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brezplačni načrt omogoča vakte v enem mesecu naenkrat. Nadgradite za sledenje vaktam čez več mesecev."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besplatni plan dozvoljava vakte u jednom mesecu odjednom. Nadogradi se da pratite vakte preko više meseci."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis-planen tillåter vakter under en månad i taget. Uppgradera för att spåra vakter över flera månader."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mpango wa bure unakuruhusu vipande katika mwezi mmoja kwa wakati. Boresha kuufuatilia vipande kwa miezi kadhaa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিনামূল্যে পরিকল্পনা এক সময়ে এক মাসের শিফট অনুমতি দেয়। একাধিক মাসে শিফট ট্র্যাক করতে আপগ্রেড করুন।"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนฟรีอนุญาตให้บันทึกวัคติในหนึ่งเดือนต่อครั้ง อัปเกรดเพื่อติดตามวัคติหลายเดือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz plan bir defada bir aylık vakt takibi sağlar. Birden fazla ay boyunca vakt takibi yapmak için yükselt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безплатний план дозволяє вакти протягом одного місяця за раз. Оновіться, щоб стежити вакти протягом кількох місяців."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفت منصوبہ ایک وقت میں ایک مہینے کے لیے شفٹ کی اجازت دیتا ہے۔ متعدد مہینوں میں شفٹ ٹریک کرنے کے لیے اپ گریڈ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói miễn phí cho phép ca làm việc trong một tháng. Nâng cấp để theo dõi ca làm việc trên nhiều tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费计划允许一次追踪一个月的班次。升级后可追踪多个月份的班次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費計畫一次只能追蹤一個月的班次。升級以追蹤多個月的班次。"
          }
        }
      }
    },
