    "shifts.excludeConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne datoen blir ekskludert fra den faste vakten. Vakten vil ikke lenger vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Datum wird aus der wiederkehrenden Schicht ausgeschlossen. Die Schicht wird nicht mehr angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ημερομηνία θα εξαιρεθεί από την επαναλαμβανόμενη βάρδια. Η βάρδια δεν θα εμφανίζεται πλέον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This date will be excluded from the recurring shift. The shift will no longer appear."
