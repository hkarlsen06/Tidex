    "onboarding.mfa.benefit1.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if someone gets your password, they still need your phone"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv om noen får tak i passordet ditt, trenger de også telefonen din"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst wenn jemand dein Passwort erhält, benötigt er noch dein Telefon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso si alguien obtiene tu contraseña, aún necesita tu teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si quelqu'un obtient votre mot de passe, il a toujours besoin de votre téléphone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがパスワードを取得しても、電話が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 암호를 얻더라도 휴대폰이 필요합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que alguém obtenha sua senha, ainda precisa do seu telefone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже если кто-то узнает ваш пароль, ему все еще нужен ваш телефон"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs als iemand je wachtwoord krijgt, hebben zij je telefoon nog nodig"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även om någon får ditt lösenord behöver de fortfarande din telefon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvom nogen får dit adgangskode, har de stadig brug for din telefon"
