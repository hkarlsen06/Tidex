    "settings.pay.editor.fromDateHelp" : {
      "comment" : "Help text under the effective date picker in the wage entry editor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسري إعدادات العمل من هذا التاريخ حتى التغيير المحفوظ التالي. وتسري تغييرات الضرائب على أيام صرف الرواتب المجدولة خلال تلك الفترة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройките за работа важат от тази дата до следващата запазена промяна. Промените в данъците важат за планираните дни за изплащане в този период."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাজের সেটিংস এই তারিখ থেকে পরবর্তী সংরক্ষিত পরিবর্তন পর্যন্ত প্রযোজ্য। করের পরিবর্তন ওই সময়ের নির্ধারিত বেতনপ্রদানের দিনগুলোর ক্ষেত্রে প্রযোজ্য।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració laboral s'aplica des d'aquesta data fins al següent canvi desat. Els canvis fiscals s'apliquen als dies de pagament programats d'aquest període."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení práce platí od tohoto data do další uložené změny. Změny daní platí pro naplánované výplatní dny v tomto období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejdsindstillinger gælder fra denne dato indtil den næste gemte ændring. Skatteændringer gælder planlagte lønningsdage i denne periode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Arbeitseinstellungen gelten ab diesem Datum bis zur nächsten gespeicherten Änderung. Steueränderungen gelten für die geplanten Zahltage in diesem Zeitraum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις εργασίας ισχύουν από αυτή την ημερομηνία έως την επόμενη αποθηκευμένη αλλαγή. Οι φορολογικές αλλαγές ισχύουν για τις προγραμματισμένες ημέρες πληρωμής κατά την περίοδο αυτή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work settings apply from this date until the next saved change. Tax changes apply to scheduled paydays in that period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración laboral se aplica desde esta fecha hasta el próximo cambio guardado. Los cambios fiscales se aplican a los días de pago programados de ese período."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tööseaded kehtivad alates sellest kuupäevast kuni järgmise salvestatud muudatuseni. Maksumuudatused kehtivad sel perioodil kavandatud palgapäevadele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیمات کاری از این تاریخ تا تغییر ذخیره‌شده بعدی اعمال می‌شوند. تغییرات مالیاتی برای روزهای پرداخت برنامه‌ریزی‌شده در آن بازه اعمال می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työasetukset ovat voimassa tästä päivämäärästä seuraavaan tallennettuun muutokseen asti. Veromuutokset koskevat kyseisen ajanjakson suunniteltuja palkanmaksupäiviä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalalapat ang mga setting ng trabaho mula sa petsang ito hanggang sa susunod na naka-save na pagbabago. Nalalapat ang mga pagbabago sa buwis sa mga nakaiskedyul na araw ng sahod sa panahong iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres de travail s’appliquent à partir de cette date jusqu’à la prochaine modification enregistrée. Les modifications fiscales s’appliquent aux jours de paie prévus pendant cette période."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות העבודה חלות מתאריך זה ועד לשינוי השמור הבא. שינויים במס חלים על ימי התשלום המתוכננים בתקופה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्य सेटिंग इस तारीख से अगले सहेजे गए बदलाव तक लागू होती हैं। कर में बदलाव उस अवधि में निर्धारित वेतन-दिवसों पर लागू होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke rada vrijede od ovog datuma do sljedeće spremljene promjene. Porezne promjene primjenjuju se na planirane dane isplate u tom razdoblju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkabeállítások ettől a dátumtól a következő mentett módosításig érvényesek. Az adómódosítások az ebben az időszakban esedékes fizetési napokra vonatkoznak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan kerja berlaku mulai tanggal ini hingga perubahan tersimpan berikutnya. Perubahan pajak berlaku untuk hari pembayaran terjadwal dalam periode tersebut."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinnustillingar gilda frá þessari dagsetningu þar til næsta vistaða breyting tekur gildi. Skattbreytingar gilda á áætluðum launadögum á því tímabili."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni di lavoro si applicano da questa data fino alla prossima modifica salvata. Le modifiche fiscali si applicano ai giorni di paga previsti in quel periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勤務設定はこの日付から次に保存された変更まで適用されます。税の変更は、その期間に予定されている給与支給日に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근무 설정은 이 날짜부터 다음 저장된 변경 시점까지 적용됩니다. 세금 변경은 해당 기간의 예정된 급여일에 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbo nustatymai taikomi nuo šios datos iki kito išsaugoto pakeitimo. Mokesčių pakeitimai taikomi suplanuotoms atlyginimo mokėjimo dienoms tuo laikotarpiu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darba iestatījumi ir spēkā no šī datuma līdz nākamajām saglabātajām izmaiņām. Nodokļu izmaiņas attiecas uz šajā periodā plānotajām algas izmaksas dienām."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeidsinnstillingene gjelder fra denne datoen til neste lagrede endring. Skatteendringer gjelder planlagte lønningsdager i perioden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkinstellingen gelden vanaf deze datum tot de volgende opgeslagen wijziging. Belastingwijzigingen gelden voor geplande betaaldagen in die periode."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeidsinnstillingane gjeld frå denne datoen til neste lagra endring. Skatteendringar gjeld planlagde lønningsdagar i denne perioden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia pracy obowiązują od tej daty do następnej zapisanej zmiany. Zmiany podatkowe dotyczą zaplanowanych dni wypłaty w tym okresie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações de trabalho valem a partir desta data até a próxima alteração salva. As alterações de impostos valem para os dias de pagamento programados nesse período."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setările de lucru se aplică de la această dată până la următoarea modificare salvată. Modificările fiscale se aplică zilelor de plată programate din perioada respectivă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочие настройки действуют с этой даты до следующего сохранённого изменения. Изменения налоговых настроек применяются к запланированным дням выплаты за этот период."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracovné nastavenia platia od tohto dátumu do nasledujúcej uloženej zmeny. Daňové zmeny sa vzťahujú na plánované výplatné dni v tomto období."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavitve dela veljajo od tega datuma do naslednje shranjene spremembe. Davčne spremembe veljajo za načrtovane dneve izplačila v tem obdobju."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podešavanja rada važe od ovog datuma do sledeće sačuvane promene. Promene poreza važe za zakazane dane isplate u tom periodu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbetsinställningarna gäller från detta datum till nästa sparade ändring. Skatteändringar gäller planerade lönedagar under den perioden."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mipangilio ya kazi inatumika kuanzia tarehe hii hadi mabadiliko yanayofuata yaliyohifadhiwa. Mabadiliko ya kodi yanatumika kwenye siku za malipo zilizopangwa katika kipindi hicho."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பணி அமைப்புகள் இந்தத் தேதியிலிருந்து அடுத்த சேமிக்கப்பட்ட மாற்றம் வரை பொருந்தும். வரி மாற்றங்கள் அந்தக் காலத்தில் திட்டமிடப்பட்ட சம்பள நாட்களுக்குப் பொருந்தும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าการทำงานมีผลตั้งแต่วันที่นี้จนถึงการเปลี่ยนแปลงที่บันทึกไว้ครั้งถัดไป การเปลี่ยนแปลงภาษีมีผลกับวันจ่ายเงินที่กำหนดไว้ในช่วงเวลาดังกล่าว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma ayarları bu tarihten bir sonraki kaydedilmiş değişikliğe kadar geçerlidir. Vergi değişiklikleri, bu dönemdeki planlanan ödeme günlerine uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування роботи застосовуються від цієї дати до наступної збереженої зміни. Зміни податків застосовуються до запланованих днів виплати в цьому періоді."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کام کی ترتیبات اس تاریخ سے اگلی محفوظ شدہ تبدیلی تک لاگو رہیں گی۔ ٹیکس کی تبدیلیاں اس مدت میں مقررہ ادائیگی کے دنوں پر لاگو ہوں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt công việc áp dụng từ ngày này cho đến lần thay đổi đã lưu tiếp theo. Các thay đổi về thuế áp dụng cho các ngày trả lương đã lên lịch trong khoảng thời gian đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作设置从此日期起生效，直到下一次保存的更改。税费更改适用于该期间内计划的发薪日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作設定自此日期起生效，直到下一次儲存的變更。稅務變更適用於該期間的排定發薪日。"
          }
        }
      }
    },
