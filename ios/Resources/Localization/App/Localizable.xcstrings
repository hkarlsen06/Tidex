        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slīdējiet uz augšu un uz leju starp mēnešiem"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glir opp og ned mellom måneder"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuif omhoog en omlaag tussen maanden"
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glir opp og ned mellom månader"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwaj w górę i w dół między miesiącami"
