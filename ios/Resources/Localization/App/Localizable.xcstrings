    "notifications.permission.deniedHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, enable them in the Settings app"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å motta varsler må du aktivere dem i Innstillinger-appen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Benachrichtigungen zu erhalten, aktiviere sie in der Einstellungen-App"
