    "acceptTerms.updated.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have updated our Terms of Service and Privacy Policy. Please review the changes and accept the new terms to continue using Tidex."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har oppdatert våre vilkår for bruk og personvernerklæring. Vennligst les gjennom endringene og godta de nye vilkårene for å fortsette å bruke Tidex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben unsere Nutzungsbedingungen und Datenschutzrichtlinie aktualisiert. Bitte überprüfen Sie die Änderungen und akzeptieren Sie die neuen Bedingungen, um Tidex weiter zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons mis à jour nos conditions d'utilisation et notre politique de confidentialité. Veuillez examiner les modifications et accepter les nouvelles conditions pour continuer à utiliser Tidex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos actualizado nuestros Términos de servicio y Política de privacidad. Por favor, revisa los cambios y acepta los nuevos términos para seguir usando Tidex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo aggiornato i nostri Termini di servizio e l'Informativa sulla privacy. Esamina le modifiche e accetta i nuovi termini per continuare a usare Tidex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har oppdatert våre vilkår for bruk og personvernerklæring. Vennligst les gjennom endringene og godta de nye vilkårene for å fortsette å bruke Tidex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizamos nossos Termos de Serviço e Política de Privacidade. Analise as alterações e aceite os novos termos para continuar usando o Tidex."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har uppdaterat våra användarvillkor och integritetspolicy. Granska ändringarna och godkänn de nya villkoren för att fortsätta använda Tidex."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har opdateret vores servicevilkår og privatlivspolitik. Gennemse ændringerne og accepter de nye vilkår for at fortsætte med at bruge Tidex."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olemme päivittäneet palveluehtomme ja tietosuojakäytäntömme. Tarkista muutokset ja hyväksy uudet ehdot jatkaaksesi Tidexin käyttöä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizowaliśmy nasze Warunki świadczenia usług i Politykę prywatności. Zapoznaj się ze zmianami i zaakceptuj nowe warunki, aby kontynuować korzystanie z Tidex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы обновили наши Условия обслуживания и Политику конфиденциальности. Пожалуйста, ознакомьтесь с изменениями и примите новые условия для продолжения использования Tidex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми оновили наші Умови використання та Політику конфіденційності. Будь ласка, перегляньте зміни й прийміть нові умови, щоб продовжити користування Tidex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約とプライバシーポリシーを更新しました。変更内容をご確認いただき、新しい利用規約に同意してTidexの使用を続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스 약관 및 개인정보 보호정책을 업데이트했습니다. 변경사항을 검토하고 새로운 약관에 동의하여 Tidex를 계속 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已更新服务条款和隐私政策。请审查更改并接受新条款以继续使用 Tidex。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราได้อัปเดตเงื่อนไขการใช้งานและนโยบายความเป็นส่วนตัวของเรา โปรดตรวจสอบการเปลี่ยนแปลงและยอมรับเงื่อนไขใหม่เพื่อใช้ Tidex ต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã cập nhật Điều khoản dịch vụ và Chính sách quyền riêng tư. Vui lòng xem xét các thay đổi và chấp nhận các điều khoản mới để tiếp tục sử dụng Tidex."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har oppdatert våre vilkår for bruk og personvernerklæring. Vennlegst les gjennom endringane og godta dei nye vilkåra for å fortsette å bruke Tidex."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet Şartlarımızı ve Gizlilik Politikamızı güncelledik. Lütfen değişiklikleri inceleyin ve Tidex kullanmaya devam etmek için yeni şartları kabul edin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχουμε ενημερώσει τους Όρους Υπηρεσίας και την Πολιτική Απορρήτου. Παρακαλώ ελέγξτε τις αλλαγές και αποδεχτείτε τους νέους όρους για να συνεχίσετε να χρησιμοποιείτε το Tidex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am actualizat Termenii de utilizare și Politica de confidențialitate. Te rugăm să revizuiești modificările și să accepți noii termeni pentru a continua folosirea Tidex."
          }
        }
      }
    },
