    "wagey.entitlementSync.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not sync subscription. Try restoring purchases in settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke synkronisere abonnement. Prøv å gjenopprette kjøp i innstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement konnte nicht synchronisiert werden. Versuche, Käufe in den Einstellungen wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo sincronizar la suscripción. Intenta restaurar compras en configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de synchroniser l'abonnement. Essayez de restaurer les achats dans les paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションを同期できませんでした。設定で購入を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독을 동기화할 수 없습니다. 설정에서 구매를 복원해보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível sincronizar assinatura. Tente restaurar compras nas configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось синхронизировать подписку. Попробуйте восстановить покупки в настройках."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon abonnement niet synchroniseren. Probeer aankopen in instellingen te herstellen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte synkronisera prenumeration. Försök att återställa köp i inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke synkronisere abonnement. Prøv at gendanne køb i indstillinger."
          }
        }
      }
    },
