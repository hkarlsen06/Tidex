        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চিন্তাভাবনা শেয়ার করে আমাদের উন্নত করতে সাহায্য করুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda'ns a millorar compartint els teus pensaments"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomozte nám zlepšit se sdílením svých myšlenek"
