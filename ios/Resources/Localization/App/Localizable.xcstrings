          "stringUnit": {
            "state": "translated",
            "value": "Scrivi come parli. Wagey comprende tutte le lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すように書いてください。Wageyはすべての言語を理解します。"
