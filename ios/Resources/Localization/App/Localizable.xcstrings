        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πόσο νωρίτερα θέλετε να ειδοποιηθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how long before your event you want to be notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto antes de tu evento quieres recibir una notificación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali, kui kaua enne sündmust soovid teavitust saada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشخص کنید چه مدت قبل از رویداد اعلان دریافت کنید."
