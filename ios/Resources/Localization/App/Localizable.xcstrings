    "onboarding.success.errorMessage" : {
      "comment" : "Error banner on the onboarding success screen when saving settings on the device fails.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ إعداداتك على هذا الجهاز. حاول مجددًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройките ви не можаха да се запазят на това устройство. Опитайте отново."
          }
