    "onboarding.personalize.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just two quick things, then you're in"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare to raske ting, så er du inne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zwei schnelle Dinge, dann bist du dabei"
          }
