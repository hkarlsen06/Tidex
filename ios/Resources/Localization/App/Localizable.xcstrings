    "wagey.emptyState.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed mig om at tilføje skift, beregne løn eller administrere dit arbejdsskema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte mich, Schichten hinzuzufügen, Löhne zu berechnen oder deinen Zeitplan zu verwalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητήστε μου να προσθέσω βάρδιες, να υπολογίσω μισθούς ή να διαχειριστώ το χronοδιάγραμμά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me to add shifts, calculate wages, or manage your schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídeme que agregue turnos, calcule salarios o administre tu horario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä minua lisäämään vuoroja, laskemaan palkkaa tai hallinnoimaan aikatauluasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi d'ajouter des quarts, de calculer les salaires ou de gérer votre emploi du temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedimi di aggiungere turni, calcolare stipendi o gestire il tuo calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトの追加、給与計算、またはスケジュール管理をお願いしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 일정 추가, 급여 계산 또는 일정 관리를 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør meg om å legge til vakter, beregne lønn eller administrere timeplanen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør meg om å legge til vakter, beregne lønn eller administrere timeplanen din."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør meg om å legge til vakter, beregne lønn eller administrere timeplanen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś mnie o dodanie wacht, obliczenie wynagrodzeń lub zarządzanie planem pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça-me para adicionar turnos, calcular salários ou gerenciar sua agenda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreabă-mă să adaug vacte, să calculez salariul sau să-ți administrez programul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите меня добавить смены, рассчитать зарплату или управлять расписанием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be mig att lägga till skift, beräkna löner eller hantera ditt schema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ฉันเพิ่มเวลาทำงาน คำนวณค่าจ้าง หรือจัดการตารางเวลาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana vakt ekleme, ücret hesaplama veya zaman çizelgenizi yönetme hakkında sor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросіть мене додати зміни, розрахувати зарплату або керувати вашим графіком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu tôi thêm ca làm việc, tính lương hoặc quản lý lịch làm việc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求我添加班次、计算工资或管理您的日程。"
          }
        }
      }
    },
