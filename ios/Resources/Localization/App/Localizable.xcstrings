    "verification.online.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify your subscription. Please try again or restore your purchases."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekrefte abonnementet ditt. Prøv igjen eller gjenopprett kjøpene dine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten dein Abonnement nicht überprüfen. Bitte versuche es erneut oder stelle deine Käufe wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu vérifier votre abonnement. Veuillez réessayer ou restaurer vos achats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar tu suscripción. Intenta de nuevo o restaura tus compras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo potuto verificare il tuo abbonamento. Riprova o ripristina gli acquisti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekrefte abonnementet ditt. Prøv igjen eller gjenopprett kjøpene dine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos verificar sua assinatura. Tente novamente ou restaure suas compras."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte verifiera din prenumeration. Försök igen eller återställ dina köp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekræfte dit abonnement. Prøv igen eller gendan dine køb."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme voineet vahvistaa tilaustasi. Yritä uudelleen tai palauta ostoksesi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogliśmy zweryfikować Twojej subskrypcji. Spróbuj ponownie lub przywróć swoje zakupy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подписку. Попробуйте еще раз или восстановите покупки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити вашу підписку. Спробуйте ще раз або відновіть свої покупки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションを確認できませんでした。もう一度お試しいただくか、購入を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독을 확인할 수 없습니다. 다시 시도하거나 구매를 복구하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证您的订阅。请重试或恢复您的购买。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันการสมัครสมาชิกของคุณได้ โปรดลองอีกครั้งหรือคืนค่าการซื้อของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không thể xác minh đăng ký của bạn. Vui lòng thử lại hoặc khôi phục các lần mua của bạn."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekrefte abonnementet ditt. Prøv igjen eller gjenopprett kjøpene dine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliğiniz doğrulanamadı. Lütfen tekrar deneyin veya satın almalarınızı geri yükleyin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση της συνδρομής σας. Δοκιμάστε ξανά ή επαναφέρετε τις αγορές σας."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut verifica abonamentul tău. Te rog încearcă din nou sau restaurează achizițiile tale."
          }
        }
      }
    },
