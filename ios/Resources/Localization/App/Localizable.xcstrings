    "calendar.subscription.disable.message" : {
      "comment" : "Message in the confirmation for turning off calendar sync.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف تطبيق التقويم عن تلقي التحديثات من Tidex. يمكنك إعداده مرة أخرى لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложението ви за календар ще спре да получава обновявания от Tidex. Може да го настроите отново по-късно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ক্যালেন্ডার অ্যাপ আর Tidex থেকে আপডেট পাবে না। আপনি পরে আবার এটি সেট আপ করতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La teva app de calendari deixarà de rebre actualitzacions de Tidex. Ho podràs tornar a configurar més endavant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše aplikace Kalendář přestane dostávat aktualizace z Tidexu. Později ji můžete znovu nastavit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kalenderapp modtager ikke længere opdateringer fra Tidex. Du kan sætte det op igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kalender-App erhält keine Updates mehr von Tidex. Du kannst es später erneut einrichten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή ημερολογίου σας θα σταματήσει να λαμβάνει ενημερώσεις από το Tidex. Μπορείτε να το ρυθμίσετε ξανά αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calendar app will stop receiving updates from Tidex. You can set it up again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu app de calendario dejará de recibir actualizaciones de Tidex. Podrás configurarla de nuevo más tarde."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu kalendrirakendus ei saa enam Tidexilt uuendusi. Saad selle hiljem uuesti seadistada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه تقویم شما دیگر به‌روزرسانی‌های Tidex را دریافت نخواهد کرد. می‌توانید بعداً دوباره آن را تنظیم کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenterisovelluksesi ei enää vastaanota päivityksiä Tidexiltä. Voit ottaa sen käyttöön myöhemmin uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hihinto sa pagtanggap ng updates mula sa Tidex ang iyong calendar app. Maaari mo itong i-set up muli mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
