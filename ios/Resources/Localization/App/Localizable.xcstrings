        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs vairs neredzēsiet %@ kopīgotās maiņas. Viņi joprojām varēs redzēt maiņas, ko jūs kopīgojat ar viņiem."
