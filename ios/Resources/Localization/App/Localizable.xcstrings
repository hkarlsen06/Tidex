    "calendarImport.intro" : {
      "comment" : "Explains the calendar link import screen",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق رابط التقويم الشخصي من تطبيق جدول عملك. يقرأ Tidex مناوباتك مرة واحدة ويضيفها إلى وظيفتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставете личната връзка към календара от приложението за работния ви график. Tidex прочита смените ви еднократно и ги добавя към работата ви."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কাজের সময়সূচির অ্যাপ থেকে ব্যক্তিগত ক্যালেন্ডার লিঙ্কটি পেস্ট করুন। Tidex একবার আপনার শিফটগুলো পড়ে চাকরিতে যোগ করবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enganxa l'enllaç personal del calendari de l'app dels teus horaris de feina. Tidex llegeix els torns una sola vegada i els afegeix a la teva feina."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložte osobní odkaz na kalendář z aplikace s pracovním rozvrhem. Tidex jednorázově načte vaše směny a přidá je k vaší práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsæt det personlige kalenderlink fra din vagtplan-app. Tidex læser dine vagter én gang og føjer dem til dit job."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den persönlichen Kalenderlink aus deiner Dienstplan-App ein. Tidex liest deine Schichten einmalig aus und fügt sie deinem Job hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικολλήστε τον προσωπικό σύνδεσμο ημερολογίου από την εφαρμογή προγράμματος εργασίας σας. Το Tidex διαβάζει τις βάρδιές σας μία φορά και τις προσθέτει στην εργασία σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the personal calendar link from your work schedule app. Tidex reads your shifts once and adds them to your job."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el enlace personal del calendario de tu app de turnos. Tidex leerá tus turnos una vez y los añadirá a tu trabajo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleebi oma töögraafiku rakenduse isiklik kalendrilink. Tidex loeb su vahetused ühe korra ja lisab need sinu töökoha alla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لینک تقویم شخصی را از برنامهٔ شیفت‌های کاری‌تان جای‌گذاری کنید. Tidex شیفت‌هایتان را یک‌بار می‌خواند و به شغلتان اضافه می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä työvuorosovelluksesi henkilökohtainen kalenterilinkki. Tidex lukee työvuorosi kerran ja lisää ne työhösi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-paste ang personal na link ng kalendaryo mula sa app ng iskedyul mo sa trabaho. Minsang babasahin ng Tidex ang mga shift mo at idaragdag ang mga ito sa trabaho mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez le lien personnel du calendrier de votre application de planning. Tidex lit vos horaires une seule fois et les ajoute à votre emploi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדביקו את הקישור האישי ליומן מאפליקציית סידור העבודה. Tidex תקרא את המשמרות שלכם פעם אחת ותוסיף אותן למקום העבודה שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने कार्य शेड्यूल ऐप का निजी कैलेंडर लिंक पेस्ट करें। Tidex आपकी शिफ्ट एक बार पढ़कर उन्हें आपकी नौकरी में जोड़ देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalijepite osobnu poveznicu na kalendar iz aplikacije za raspored smjena. Tidex će jednom pročitati vaše smjene i dodati ih vašem poslu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illeszd be a beosztáskezelő alkalmazásod személyes naptárhivatkozását. A Tidex egyszer beolvassa a műszakjaidat, és hozzáadja őket a munkádhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel tautan kalender pribadi dari aplikasi jadwal kerja Anda. Tidex membaca shift Anda sekali dan menambahkannya ke pekerjaan Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límdu inn persónulega dagatalstengilinn úr vaktaplaninu í vinnunni. Tidex les vaktirnar þínar einu sinni og bætir þeim við starfið þitt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla il link personale del calendario dalla tua app dei turni. Tidex legge i tuoi turni una sola volta e li aggiunge al tuo lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勤務表アプリの個人用カレンダーリンクを貼り付けてください。Tidexがシフトを一度読み取り、勤務先に追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근무 일정 앱의 개인 캘린더 링크를 붙여넣으세요. Tidex가 근무 일정을 한 번 읽고 내 일자리에 추가합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įklijuokite asmeninę kalendoriaus nuorodą iš darbo grafiko programėlės. „Tidex“ vieną kartą nuskaitys jūsų pamainas ir pridės jas prie jūsų darbo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ielīmējiet personīgo kalendāra saiti no darba grafika lietotnes. Tidex vienreiz nolasa jūsu maiņas un pievieno tās darbam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lim inn den personlige kalenderlenken fra vaktplanappen på jobben. Tidex leser vaktene dine én gang og legger dem til jobben din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak de persoonlijke agendalink uit je roosterapp. Tidex leest je diensten één keer en voegt ze toe aan je baan."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lim inn den personlege kalenderlenkja frå vaktplanappen på jobben. Tidex les vaktene dine éin gong og legg dei til jobben din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej osobisty link do kalendarza z aplikacji z grafikiem pracy. Tidex jednorazowo odczyta Twoje zmiany i doda je do Twojej pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole o link pessoal do calendário do seu app de escala de trabalho. O Tidex lê seus turnos uma vez e os adiciona ao seu trabalho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lipește linkul personal al calendarului din aplicația cu programul de lucru. Tidex îți citește turele o singură dată și le adaugă la locul tău de muncă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте личную ссылку на календарь из приложения с рабочим расписанием. Tidex однократно считает ваши смены и добавит их к вашей работе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložte osobný odkaz na kalendár z aplikácie s pracovným rozvrhom. Tidex jednorazovo načíta vaše zmeny a pridá ich k vašej práci."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilepite osebno povezavo do koledarja iz aplikacije za urnik dela. Tidex enkrat prebere vaše izmene in jih doda k vaši zaposlitvi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalepite lični link kalendara iz aplikacije za raspored rada. Tidex će jednom učitati vaše smene i dodati ih vašem poslu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klistra in den personliga kalenderlänken från din schemaläggningsapp. Tidex läser dina pass en gång och lägger till dem i ditt jobb."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandika kiungo chako binafsi cha kalenda kutoka kwenye programu ya ratiba ya kazi. Tidex husoma zamu zako mara moja na kuziongeza kwenye kazi yako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வேலை அட்டவணை செயலியிலுள்ள தனிப்பட்ட காலண்டர் இணைப்பை ஒட்டுங்கள். Tidex உங்கள் ஷிப்டுகளை ஒருமுறை படித்து, உங்கள் வேலையில் சேர்க்கும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางลิงก์ปฏิทินส่วนตัวจากแอปตารางงานของคุณ Tidex จะอ่านกะของคุณครั้งเดียวแล้วเพิ่มลงในงานของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş programı uygulamanızdaki kişisel takvim bağlantısını yapıştırın. Tidex vardiyalarınızı bir kez okur ve işinize ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставте особисте посилання на календар із застосунку робочого графіка. Tidex один раз зчитає ваші зміни й додасть їх до вашої роботи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی کام کی شیڈول ایپ سے ذاتی کیلنڈر لنک پیسٹ کریں۔ Tidex آپ کی شفٹیں ایک بار پڑھ کر آپ کی ملازمت میں شامل کر دے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán liên kết lịch cá nhân từ ứng dụng lịch làm việc. Tidex đọc các ca làm của bạn một lần và thêm vào công việc của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴排班应用中的个人日历链接。Tidex 会读取一次您的班次并添加到您的工作中。"
