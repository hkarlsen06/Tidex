    "sharing.offline.actionFailed" : {
      "comment" : "Error when a sharing action fails because the device is offline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب إجراء المشاركة هذا اتصالاً بالإنترنت. حاول مرة أخرى عند عودتك للاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това действие за споделяне изисква интернет връзка. Опитайте отново, когато сте онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শেয়ারিং কাজের জন্য ইন্টারনেট সংযোগ দরকার। আবার অনলাইনে এলে আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta acció de compartició necessita connexió a internet. Torna-ho a provar quan estiguis en línia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato akce sdílení vyžaduje připojení k internetu. Zkuste to znovu, až budete online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne delingshandling kræver internetforbindelse. Prøv igen, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Teilen-Aktion erfordert eine Internetverbindung. Versuche es erneut, wenn du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ενέργεια κοινοποίησης χρειάζεται σύνδεση στο διαδίκτυο. Δοκιμάστε ξανά όταν συνδεθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sharing action needs an internet connection. Try again when you are back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción de compartir necesita conexión a internet. Inténtalo de nuevo cuando vuelvas a estar en línea."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See jagamistoiming vajab internetiühendust. Proovige uuesti, kui olete taas võrgus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این عمل اشتراک‌گذاری به اتصال اینترنت نیاز دارد. وقتی دوباره آنلاین شدید، دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä jakotoiminto vaatii internetyhteyden. Yritä uudelleen, kun olet taas verkossa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng internet ang pagbabahaging ito. Subukang muli kapag online ka na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action de partage nécessite une connexion Internet. Réessayez quand vous serez de nouveau en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולת השיתוף הזו דורשת חיבור לאינטרנט. נסו שוב כשתהיו מחוברים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस शेयरिंग कार्रवाई के लिए इंटरनेट कनेक्शन चाहिए। ऑनलाइन होने पर फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova radnja dijeljenja treba internetsku vezu. Pokušajte ponovno kad budete na mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehhez a megosztási művelethez internetkapcsolat kell. Próbáld újra, ha újra online leszel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi berbagi ini memerlukan koneksi internet. Coba lagi saat Anda kembali online."
