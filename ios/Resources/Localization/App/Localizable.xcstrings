        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više nećete videti smene koje %@ deli. Oni i dalje mogu da vide smene koje delite sa njima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommer att sluta se pass %@ delar. De kan fortfarande se pass du delar med dem."
