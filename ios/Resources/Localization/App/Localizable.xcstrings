    "settings.pay.editor.baselineHelp": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundlinjen bruges til skift før andre daterede poster"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grundlinie wird für Schichten vor anderen datierten Einträgen verwendet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βασική γραμμή χρησιμοποιείται για βάρδιες πριν από οποιεσδήποτε ημερομηνημένες καταχωρίσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The baseline is used for shifts before any dated entries"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea base se utiliza para turnos anteriores a otras entradas fechadas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustasoa käytetään vuoroille ennen muita päivämäärällä merkittyjä kirjauksia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne de base est utilisée pour les journées avant toute autre entrée datée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La base viene utilizzata per i turni prima di altre voci con data"
