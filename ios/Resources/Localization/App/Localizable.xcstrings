    "sharing.manageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your shifts with friends and colleagues so they can see when you work."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del vaktene dine med venner og kolleger slik at de kan følge med på når du jobber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie Ihre Schichten mit Freunden und Kollegen, damit diese sehen können, wann Sie arbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez vos vagues avec vos amis et collègues pour qu'ils voient quand vous travaillez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tus turnos con amigos y colegas para que vean cuándo trabajas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi le tue vature con amici e colleghi in modo che possano vedere quando lavori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Del vaktene dine med venner og kolleger slik at de kan følge med på når du jobber."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seus turnos com amigos e colegas para que vejam quando você trabalha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela dina vakter med vänner och kollegor så de kan se när du arbetar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dine vakter med venner og kolleger, så de kan se, hvornår du arbejder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa vuorosi ystävien ja kollegoiden kanssa, jotta he näkevät milloin työskentelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj swoje wakt ze znajomymi i kolegami, aby mogli widzieć, kiedy pracujesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делитесь своими сменами с друзьями и коллегами, чтобы они видели, когда вы работаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться своїми змінами з друзями та колегами, щоб вони могли бачити, коли ви працюєте."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友人や同僚とシフトをシェアして、いつ仕事をしているかを確認できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 및 동료와 근무를 공유하여 언제 일하는지 알 수 있도록 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与朋友和同事分享您的班次，让他们了解您的工作时间。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์เวรของคุณกับเพื่อนและเพื่อนร่วมงาน เพื่อให้พวกเขาเห็นว่าคุณทำงานเมื่อใด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ ca làm việc của bạn với bạn bè và đồng nghiệp để họ có thể xem khi bạn làm việc."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Del vaktene dine med venner og kolleger slik at dei kan sjå når du jobbar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardiyalarınızı arkadaşlar ve meslektaşlarınızla paylaşın, böylece ne zaman çalıştığınızı görebilirler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοινοποιήστε τις βάρδιες σας με φίλους και συναδέλφους ώστε να μπορούν να δουν πότε εργάζεστε."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajați-vă schimburile cu prietenii și colegii pentru ca aceștia să vadă când lucrați."
          }
        }
      }
    },
