    "subscription.offline.storeKitUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالإنترنت لإدارة الاشتراكات أو الاشتراك أو استعادة المشتريات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свържете се с интернет, за да управлявате, да се абонирате или да възстановите покупки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেনাকাটা পরিচালনা, সদস্যতা নেওয়া বা পুনরুদ্ধার করতে ইন্টারনেটে সংযুক্ত হন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecta't a internet per gestionar, subscriure't o restaurar compres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro správu, předplatné nebo obnovení nákupů se připojte k internetu."
