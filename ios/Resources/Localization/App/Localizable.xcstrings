    "security.password.setWithPhoneInstructions": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en kode til din telefon for at bekræfte din identitet, før du angiver en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden dir einen Code auf dein Telefon, um deine Identität zu bestätigen, bevor du ein Passwort setzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα σας στείλουμε έναν κωδικό στο τηλέφωνό σας για να επιβεβαιώσετε την ταυτότητά σας πριν ορίσετε έναν κωδικό πρόσβασης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll send a code to your phone to verify your identity before setting a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos un código a tu teléfono para verificar tu identidad antes de establecer una contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetämme koodin puhelimeesi vahvistaaksemme henkilöllisyytesi ennen salasanan asettamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un code à votre téléphone pour vérifier votre identité avant de définir un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti invieremo un codice sul telefono per verificare la tua identità prima di impostare una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを設定する前に、本人確認のためコードを電話に送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호를 설정하기 전에 신원을 확인하기 위해 휴대전화로 코드를 보내드립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en kode til telefonen din for å bekrefte identiteten din før du setter et passord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We verzenden een code naar je telefoon om je identiteit te verifiëren voordat je een wachtwoord instelt."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en kode til telefonen din for å bekrefte identiteten din før du setter et passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślemy kod na Twój telefon, aby potwierdzić Twoją tożsamość przed ustawieniem hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um código para seu telefone para verificar sua identidade antes de definir uma senha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți vom trimite un cod la telefon pentru a-ți verifica identitatea înainte de a seta o parolă."
          }
        },
        "ru": {
