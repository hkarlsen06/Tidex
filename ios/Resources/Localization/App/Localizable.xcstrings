          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aangepaste toeslagen. Tik + om toe te voegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum adicional personalizado. Toque + para adicionar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga anpassade tillägg. Tryck + för att lägga till."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egendefinerede tillæg. Tryk + for at tilføje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mukautettuja lisäyksiä. Lisää painamalla +."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak niestandardowych dodatków. Naciśnij +, aby dodać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет пользовательских надбавок. Нажмите +, чтобы добавить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає власних надбавок. Натисніть +, щоб додати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム手当がありません。+をタップして追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 정의 수당이 없습니다. +를 눌러 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无自定义补贴。点击 + 添加。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเบี้ยเพิ่มเติมแบบกำหนดเอง แตะ + เพื่อเพิ่ม"
