    "sharing.profile.orderAndVisibilityFooter" : {
      "comment" : "Footer under Move to bottom and Hide from the friends list on a friend's profile. %@ is the friend's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقل إلى الأسفل يغيّر الترتيب فقط. يؤدي الإخفاء إلى إزالة %@ من قائمة الأصدقاء حتى تُظهره مرة أخرى. ولا يوقف أيٌّ منهما المشاركة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преместването най-долу променя само подредбата. Скриването премахва %@ от списъка с приятели, докато не отмените скриването. Нито едното не спира споделянето."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিচে সরানো শুধু ক্রম পরিবর্তন করে। লুকিয়ে রাখলে আবার দেখানো পর্যন্ত %@-কে বন্ধুদের তালিকা থেকে সরিয়ে রাখা হয়। কোনোটিই শেয়ার করা বন্ধ করে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moure al final només canvia l'ordre. Amagar elimina %@ de la llista d'amics fins que el tornis a fer visible. Cap de les dues opcions atura la compartició."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesun dolů mění pouze pořadí. Skrytí odebere %@ ze seznamu přátel až do opětovného zobrazení. Ani jedna možnost nezastaví sdílení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt til bunden ændrer kun rækkefølgen. Skjul fjerner %@ fra vennelisten, indtil du viser personen igen. Ingen af delene stopper delingen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach unten verschieben ändert nur die Reihenfolge. Ausblenden entfernt %@ aus der Freundesliste, bis du die Person wieder einblendest. Keine der beiden Optionen beendet die Freigabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετακίνηση στο κάτω μέρος αλλάζει μόνο τη σειρά. Η απόκρυψη αφαιρεί το άτομο %@ από τη λίστα φίλων μέχρι να το εμφανίσεις ξανά. Κανένα από τα δύο δεν διακόπτει την κοινοποίηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to bottom only changes the order. Hiding removes %@ from the friends list until you show them again. Neither one stops sharing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover al final solo cambia el orden. Ocultar elimina a %@ de la lista de amigos hasta que vuelvas a mostrar a esa persona. Ninguna de las dos opciones detiene el uso compartido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla liigutamine muudab ainult järjekorda. Peitmine eemaldab %@ sõprade loendist, kuni ta uuesti kuvatakse. Kumbki ei peata jagamist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقال به پایین فقط ترتیب را تغییر می‌دهد. مخفی‌کردن، %@ را تا زمانی که دوباره نشانش دهید، از فهرست دوستان حذف می‌کند. هیچ‌کدام اشتراک‌گذاری را متوقف نمی‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä alimmaksi muuttaa vain järjestystä. Piilottaminen poistaa henkilön %@ ystävälistalta, kunnes tuot hänet taas näkyviin. Kumpikaan ei lopeta jakamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang paglipat sa ibaba ay binabago lang ang pagkakasunod-sunod. Itinatago si %@ sa listahan ng mga kaibigan hanggang sa ipakita mo siyang muli. Hindi pinipigilan ng alinman sa mga ito ang pagbabahagi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer en bas ne change que l’ordre. Masquer retire %@ de la liste d’amis jusqu’à ce que vous l’affichiez à nouveau. Aucun des deux n’arrête le partage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העברה לתחתית משנה רק את הסדר. הסתרה מסירה את %@ מרשימת החברים עד להצגה מחדש. אף אחת מהפעולות לא מפסיקה את השיתוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे ले जाने से केवल क्रम बदलता है। छिपाने पर %@ मित्र सूची से तब तक हट जाता है, जब तक आप उसे फिर से न दिखाएँ। इनमें से कोई भी शेयर करना बंद नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premještanje na dno mijenja samo redoslijed. Skrivanje uklanja %@ s popisa prijatelja dok tu osobu ponovno ne prikažeš. Nijedna opcija ne zaustavlja dijeljenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alulra helyezés csak a sorrendet módosítja. Az elrejtés miatt %@ eltűnik a barátlistáról, amíg újra meg nem jeleníted. Egyik sem állítja le a megosztást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindahkan ke bawah hanya mengubah urutan. Menyembunyikan akan menghapus %@ dari daftar teman sampai Anda menampilkannya lagi. Keduanya tidak menghentikan berbagi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að færa neðst breytir aðeins röðinni. Að fela fjarlægir %@ af vinalistanum þar til þú sýnir viðkomandi aftur. Hvorugt stöðvar deilingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare in fondo cambia solo l'ordine. Nascondere rimuove %@ dall'elenco degli amici finché non lo rendi di nuovo visibile. Nessuna delle due interrompe la condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下に移動しても順番が変わるだけです。非表示にすると、再表示するまで%@は友達リストに表示されません。どちらも共有を停止するものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 아래로 이동은 순서만 변경합니다. 숨기면 %@님이 다시 표시할 때까지 친구 목록에서 사라집니다. 어느 쪽도 공유를 중지하지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkėlimas į apačią keičia tik tvarką. Paslėpus %@, asmuo pašalinamas iš draugų sąrašo, kol vėl bus rodomas. Nė vienas iš šių veiksmų nenutraukia bendrinimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārvietošana uz apakšu maina tikai secību. Paslēpjot %@, persona tiks noņemta no draugu saraksta, līdz to atkal parādīsi. Neviena no šīm darbībām nepārtrauc kopīgošanu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt til bunnen endrer bare rekkefølgen. Skjul fjerner %@ fra vennelisten til du viser personen igjen. Ingen av delene stopper delingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naar onderaan verplaatsen verandert alleen de volgorde. Verbergen verwijdert %@ uit de vriendenlijst totdat je diegene weer toont. Geen van beide stopt het delen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt til botnen endrar berre rekkjefølgja. Skjul fjernar %@ frå vennelista til du viser personen igjen. Ingen av delane stoppar delinga."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeniesienie na dół zmienia tylko kolejność. Ukrycie usuwa %@ z listy znajomych do czasu ponownego wyświetlenia. Żadna z tych opcji nie przerywa udostępniania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover para o fim apenas altera a ordem. Ocultar remove %@ da lista de amigos até que você o mostre novamente. Nenhuma das duas opções interrompe o compartilhamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutarea la final schimbă doar ordinea. Ascunderea elimină %@ din lista de prieteni până la reafișare. Niciuna dintre ele nu oprește partajarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещение вниз меняет только порядок. Скрытие удаляет %@ из списка друзей, пока вы снова его не покажете. Ни одно из действий не прекращает доступ к вашим сменам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presunutie na koniec zmení iba poradie. Skrytie odstráni %@ zo zoznamu priateľov, kým túto osobu znova nezobrazíte. Ani jedna z možností nezastaví zdieľanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premik na dno spremeni le vrstni red. Skrivanje odstrani %@ s seznama prijateljev do ponovnega prikaza. Nobena od možnosti ne ustavi deljenja."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premeštanje na dno samo menja redosled. Sakrivanje uklanja osobu %@ sa liste prijatelja dok je ponovo ne prikažeš. Nijedna opcija ne prekida deljenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att flytta längst ned ändrar bara ordningen. Att dölja tar bort %@ från vänlistan tills du visar personen igen. Inget av detta stoppar delningen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupeleka chini hubadilisha mpangilio pekee. Kumficha %@ humwondoa kwenye orodha ya marafiki hadi umuonyeshe tena. Hakuna kati ya hayo mawili kinachositisha kushiriki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கீழே நகர்த்துவது வரிசையை மட்டுமே மாற்றும். மறைப்பது, நீங்கள் மீண்டும் காட்டும் வரை, நண்பர்கள் பட்டியலிலிருந்து %@-ஐ அகற்றும். இரண்டுமே பகிர்வதை நிறுத்தாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายไปด้านล่างจะเปลี่ยนแค่ลำดับ การซ่อนจะนำ %@ ออกจากรายชื่อเพื่อนจนกว่าคุณจะแสดงอีกครั้ง ทั้งสองอย่างไม่หยุดการแชร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En alta taşıma yalnızca sıralamayı değiştirir. Gizleme, siz tekrar gösterene kadar %@ adlı kişiyi arkadaş listesinden kaldırır. Hiçbiri paylaşımı durdurmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщення вниз змінює лише порядок. Приховування вилучає %@ зі списку друзів, доки ви знову не покажете цю особу. Жодна з цих дій не припиняє спільний доступ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیچے منتقل کرنا صرف ترتیب بدلتا ہے۔ چھپانے سے %@ دوستوں کی فہرست سے اس وقت تک ہٹ جاتا ہے جب تک آپ اسے دوبارہ نہ دکھائیں۔ ان میں سے کوئی بھی شیئرنگ نہیں روکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển xuống cuối chỉ thay đổi thứ tự. Ẩn sẽ xóa %@ khỏi danh sách bạn bè cho đến khi bạn hiển thị lại. Cả hai đều không dừng chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移至底部只会改变顺序。隐藏会将 %@ 从好友列表中移除，直到你再次显示对方。这两种操作都不会停止分享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移至底部只會變更順序。隱藏會將 %@ 從好友列表中移除，直到你再次顯示對方。這兩者都不會停止分享。"
          }
        }
      }
    },
