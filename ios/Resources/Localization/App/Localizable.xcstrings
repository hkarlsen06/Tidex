    "data.export.pdf.description" : {
      "comment" : "Description under the PDF export button in the data export settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن نظرة عامة على النوبات والمجاميع حسب النوع وملخص الأجور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включва преглед на смяна, суми по тип и обобщение на заплатата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শিফট সারাংশ, ধরন অনুযায়ী মোট এবং বেতন সারাংশ অন্তর্ভুক্ত করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclou visió general de vakts, totals per tipus i resum salarial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsahuje přehled vakt, součty podle typu a přehled mezd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkluderer vaktuoversigt, summer efter type og totale lontal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält Schichtübersicht, Summen nach Typ und Lohnzusammenfassung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιλαμβάνει επισκόπηση βάρδιας, σύνολα ανά τύπο και περίληψη μισθών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes shift overview, totals by type, and wage summary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye resumen de vacas, totales por tipo y resumen salarial."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisaldab vahetuste ülevaadet, summasid tüübi järgi ja palgakokkuvõtet."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شامل خلاصه شیفت، مجموع‌های حسب نوع، و خلاصه دستمزد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältää vuorojen yleiskatsauksen, tyypin mukaiset summat ja palkkiyhteenvedon."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May kasamang shift overview, totals by type, at wage summary."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut l'aperçu des vagues, les totaux par type et le résumé salarial."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כולל סקירת משמרות, סכומים לפי סוג וסיכום שכר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शिफ्ट अवलोकन, प्रकार के अनुसार कुल, और वेतन सारांश शामिल है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključuje pregled vakti, zbrojeve po vrsti i sažetak plaća."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartalmaz műszak-áttekintést, típusonkénti összesítéseket és fizetési összefoglalót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termasuk ringkasan vakt, total per jenis, dan ringkasan gaji."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inniheldur vaktyfirlýsingu, samtölur eftir gerð og launasamantekt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include panoramica turni, totali per tipo e riepilogo stipendiale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シフト概要、タイプ別の合計、および賃金サマリーが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교대 근무 개요, 유형별 합계 및 급여 요약이 포함됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apima pamainu apžvalgą, sumas pagal tipą ir atlyginimo santraką."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ietver maiņu pārskatu, kopsummas pēc veida un algas kopsavilkumu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejmuje przegląd zmian, sumy według typu i podsumowanie wynagrodzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
