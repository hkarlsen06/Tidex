        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยเราปรับปรุงโดยแบ่งปันความคิดของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
