        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg følger tariffavtalen og kan ikke endres manuelt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen volgen de cao en kunnen niet handmatig worden gewijzigd"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg følgjer tariffavtalen og kan ikkje endrast manuelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki wynikają z umowy taryfowej i nie można ich zmienić ręcznie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os adicionais seguem o acordo tarifário e não podem ser alterados manualmente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplimentele urmăresc acordul tarifar și nu pot fi modificate manual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки следуют тарифному соглашению и не могут быть изменены вручную"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg följer kollektivavtalet och kan inte ändras manuellt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบี้ยเพิ่มเติมปฏิบัติตามข้อตกลงอัตราค่าจ้างและไม่สามารถเปลี่ยนแปลงได้ด้วยตนเอง"
