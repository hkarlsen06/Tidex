    "security.passkeys.deleteDialog.description" : {
      "comment" : "Message in the delete passkey confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتمكن مفتاح المرور هذا بعد الآن من تسجيل الدخول إلى حسابك في Tidex."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този ключ за достъп повече няма да може да се използва за вход в профила ви в Tidex."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পাসকি আর আপনার Tidex অ্যাকাউন্টে সাইন ইন করতে পারবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta clau d'accés ja no es podrà fer servir per iniciar sessió al teu compte de Tidex."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento přístupový klíč už nebude možné použít k přihlášení k vašemu účtu Tidex."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne adgangsnøgle kan ikke længere bruges til at logge ind på din Tidex-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Passkey kannst du dich nicht mehr bei deinem Tidex-Konto anmelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το κλειδί πρόσβασης δεν θα μπορεί πλέον να συνδέεται στον λογαριασμό σας στο Tidex."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This passkey will no longer be able to sign in to your Tidex account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave de acceso ya no podrá iniciar sesión en tu cuenta de Tidex."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle pääsuvõtmega ei saa enam sinu Tidexi kontole sisse logida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کلید عبور دیگر نمی‌تواند به حساب Tidex شما وارد شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä passiavaimella ei voi enää kirjautua Tidex-tilillesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na magagamit ang passkey na ito para mag-sign in sa iyong Tidex account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé d’accès ne pourra plus se connecter à votre compte Tidex."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא יהיה יותר אפשר להשתמש במפתח הגישה הזה כדי להתחבר לחשבון Tidex שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पासकी अब आपके Tidex खाते में साइन इन नहीं कर पाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj pristupni ključ više se neće moći koristiti za prijavu na vaš Tidex račun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel a jelszókulccsal többé nem lehet bejelentkezni a Tidex-fiókodba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci sandi ini tidak lagi dapat digunakan untuk masuk ke akun Tidex Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki verður lengur hægt að skrá sig inn á Tidex-aðganginn þinn með þessum aðgangslykli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa passkey non potrà più accedere al tuo account Tidex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスキーはTidexアカウントへのサインインに使えなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패스키는 더 이상 Tidex 계정에 로그인하는 데 사용할 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiuo prieigos raktu nebebus galima prisijungti prie jūsų Tidex paskyros."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šo piekļuves atslēgu vairs nevarēs izmantot, lai pierakstītos jūsu Tidex kontā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne passnøkkelen kan ikke lenger brukes til å logge inn på Tidex-kontoen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze toegangssleutel kun je niet meer inloggen op je Tidex-account."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne passnøkkelen kan ikkje lenger brukast til å logge inn på Tidex-kontoen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten klucz dostępu nie będzie już mógł służyć do logowania do Twojego konta Tidex."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta chave de acesso não poderá mais entrar na sua conta Tidex."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cheie de acces nu va mai putea fi folosită pentru autentificare în contul tău Tidex."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот ключ доступа больше не сможет использоваться для входа в ваш аккаунт Tidex."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento prístupový kľúč sa už nebude dať použiť na prihlásenie do vášho účtu Tidex."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem ključem za prijavo se ne bo več mogoče prijaviti v vaš račun Tidex."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj ključ za pristup više neće moći da se koristi za prijavu na vaš Tidex nalog."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här passnyckeln kommer inte längre att kunna logga in på ditt Tidex-konto."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufunguo huu wa siri hautaweza tena kuingia kwenye akaunti yako ya Tidex."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த பாஸ்கீ இனி உங்கள் Tidex கணக்கில் உள்நுழைய பயன்படாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พาสคีย์นี้จะไม่สามารถใช้ลงชื่อเข้าใช้บัญชี Tidex ของคุณได้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu geçiş anahtarı artık Tidex hesabınızda oturum açmak için kullanılamayacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей ключ доступу більше не зможе входити до вашого облікового запису Tidex."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ پاسکی اب آپ کے Tidex اکاؤنٹ میں سائن اِن نہیں کر سکے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passkey này sẽ không còn dùng để đăng nhập vào tài khoản Tidex của bạn nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通行密钥将无法再登录你的 Tidex 账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通行金鑰將無法再登入你的 Tidex 帳戶。"
          }
        }
      }
    },
