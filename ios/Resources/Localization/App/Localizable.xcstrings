        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett tidstämplat arbetspass måste vara kortare än 24 timmar. Lägg in längre pass manuellt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamu iliyorekodiwa kwa saa lazima iwe chini ya saa 24. Ongeza zamu ndefu wewe mwenyewe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பதிவுசெய்யப்பட்ட பணி நேரம் 24 மணிநேரத்திற்கும் குறைவாக இருக்க வேண்டும். நீண்ட பணி நேரங்களை கைமுறையாகச் சேர்க்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กะที่ลงเวลาต้องสั้นกว่า 24 ชั่วโมง โปรดเพิ่มกะที่ยาวกว่านี้ด้วยตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatle kaydedilen bir vardiya 24 saatten kısa olmalıdır. Daha uzun vardiyaları manuel olarak ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміна, зафіксована таймером, має тривати менше 24 годин. Довші зміни додавайте вручну."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلاک کی گئی شفٹ 24 گھنٹے سے کم ہونی چاہیے۔ طویل شفٹیں دستی طور پر شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca được chấm công phải ngắn hơn 24 giờ. Hãy thêm các ca dài hơn theo cách thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打卡班次必须少于24小时。更长的班次请手动添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已打卡的班次必須少於 24 小時。較長的班次請手動新增。"
          }
        }
      }
    },
