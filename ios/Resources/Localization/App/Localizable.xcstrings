    "notifications.permission.deniedHint": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at modtage notifikationer skal du aktivere dem i Indstillinger-appen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Benachrichtigungen in den Einstellungen"
