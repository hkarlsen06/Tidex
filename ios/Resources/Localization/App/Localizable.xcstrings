    "settings.pay.editor.supplementsTariff": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg følger takstaftalen og kan ikke ændres manuelt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge folgen dem Tarifvertrag und können nicht manuell geändert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements follow the tariff agreement and cannot be changed manually"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los complementos siguen el acuerdo salarial y no se pueden cambiar manualmente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisät noudattavat työehtosopimusta eikä niitä voi muuttaa manuaalisesti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments suivent la convention tarifaire et ne peuvent pas être modifiés manuellement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi seguono l'accordo tariffario e non possono essere modificati manualmente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当は労働協約に従い、手動で変更することはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 단체협약을 따르므로 수동으로 변경할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg følger tariffavtalen og kan ikke endres manuelt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen volgen de cao en kunnen niet handmatig worden gewijzigd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki wynikają z umowy taryfowej i nie mogą być zmieniane ręcznie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os adicionais seguem o acordo tarifário e não podem ser alterados manualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки соответствуют тарифному соглашению и не могут быть изменены вручную"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg följer avtalet och kan inte ändras manuellt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าตอบแทนปฏิบัติตามข้อตกลงอัตราค่าจ้างและไม่สามารถเปลี่ยนแปลงด้วยตนเองได้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки відповідають тарифній угоді та не можуть змінюватися вручну"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ cấp tuân theo thỏa thuận biểu giá và không thể thay đổi thủ công"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补加工资遵循关税协议，无法手动更改"
          }
        }
      }
    },
