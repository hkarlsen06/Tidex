          "stringUnit" : {
            "state" : "translated",
            "value" : "Lönposter bestämmer vilken lön och tillägg som gäller för skift under olika perioder."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingizo la mshahara linaamua ni malipo na ziada gani yanatumika kwa zamu katika kipindi tofauti."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சம்பள உள்ளீடுகள் வெவ்வேறு காலங்களில் மாற்றங்களுக்கு எந்த சம்பளம் மற்றும் சப்ளிமெண்ட் பொருந்தும் என்பதை நির்ణயிக்கிறது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการเงินเดือนกำหนดว่าเงินเดือนและเบี้ยประกอบใดที่ใช้กับกะในช่วงเวลาต่างๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücret girişleri, farklı dönemlerde vardiyalara hangi ücret ve eklerin uygulanacağını belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи про зарплату визначають, яка заробітна плата та надбавки застосовуються до змін у різні періоди."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنخواہ کی ترتیبات یہ طے کرتی ہیں کہ مختلف مدتوں میں شفٹوں پر کون سی تنخواہ اور اضافی رقم لاگو ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục lương xác định lương và phụ cấp nào áp dụng cho ca làm việc trong các khoảng thời gian khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薪资记录确定在不同时期班次适用的薪资和补贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薪資記錄決定了不同時期班次適用的薪資和津貼。"
          }
        }
      }
    },
