    "onboarding.supplements.hint": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg bruges til at beregne ekstra løn for arbejde på ubekvemme tidspunkter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge werden verwendet, um Extravergütung für ungünstige Arbeitszeiten zu berechnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επιδόματα χρησιμοποιούνται για τον υπολογισμό επιπλέον μισθού για ενοχλητικές ώρες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements are used to calculate extra pay for inconvenient hours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los suplementos se utilizan para calcular el pago adicional por horas inconvenientes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisäyksiä käytetään lasketaan ylimääräistä palkkaa epäkäytännöllisillä tunneilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments sont utilisés pour calculer la rémunération supplémentaire pour les heures inconvenantes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi vengono utilizzati per calcolare la retribuzione aggiuntiva per orari scomodi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当は不便な時間帯の追加給与を計算するために使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 불편한 시간대의 추가 급여를 계산하는 데 사용됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg brukes til å beregne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg brukes til å beregne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg blir brukt til å berekne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki służą do obliczania dodatkowego wynagrodzenia za pracę w niewygodnych godzinach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionais são usados para calcular pagamento extra por horários inconvenientes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplimentele sunt folosite pentru a calcula plata suplimentară pentru ore incomode"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки используются для расчета дополнительной оплаты за неудобное время работы"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg används för att beräkna extralön för arbete på opraktiska tider"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบี้ยเพิ่มเติมใช้ในการคำนวณค่าจ้างพิเศษสำหรับเวลาที่ไม่สะดวก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek ödemeler uygunsuz saatlerde ekstra ücret hesaplamak için kullanılır"
