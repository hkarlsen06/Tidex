    "wagey.emptyState.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed mig om at tilføje vagter, beregne løn eller styre din tidsplan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte mich, Schichten hinzuzufügen, Löhne zu berechnen oder deinen Plan zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me to add shifts, calculate wages, or manage your schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídeme que añada turnos, calcule salarios o gestione tu horario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä minua lisäämään vuoroja, laskemaan palkkaa tai hallinnoimaan aikatauluasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi d'ajouter des postes, de calculer les salaires ou de gérer votre emploi du temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi di aggiungere turni, calcolare salari o gestire il calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
