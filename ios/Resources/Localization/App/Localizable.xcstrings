        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 대로 쓰세요. Wagey는 모든 언어를 이해합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du snakker. Wagey forstår alle språk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du snakker. Wagey forstår alle språk."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du snakkar. Wagey forstår alle språk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz jak mówisz. Wagey rozumie wszystkie języki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva como fala. Wagey entende todos os idiomas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie așa cum vorbești. Wagey înțelege toate limbile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите так, как вы говорите. Wagey понимает все языки."
