        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai utilizzato tutti i tuoi messaggi Wagey questo mese. I messaggi si ripristinano all'inizio del mese prossimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月のWageyメッセージをすべて使用しました。メッセージは来月の開始時にリセットされます。"
