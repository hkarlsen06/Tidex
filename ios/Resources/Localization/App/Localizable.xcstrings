    "onboarding.supplements.hint" : {
      "comment" : "Hint on the onboarding supplements step. Keep the Norwegian word tillegg as is so immigrant workers can match it to their payslip.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإضافات أجر إضافي مقابل العمل في أوقات غير مريحة. تُسمى في قسائم الرواتب النرويجية tillegg."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавките са допълнително заплащане за работа в неудобни часове. В норвежките фишове за заплата се наричат tillegg."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাপ্লিমেন্ট হলো অসুবিধাজনক সময়ে কাজের জন্য অতিরিক্ত বেতন। নরওয়ের বেতন স্লিপে এগুলোকে tillegg বলা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els complements són una paga extra per a hores incòmodes. A les nòmines noruegues es diuen tillegg."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příplatky jsou mzda navíc za práci v nepříznivou dobu. Na norských výplatních páskách se jmenují tillegg."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillæg er ekstra løn for arbejde på ubekvemme tidspunkter. På norske lønsedler hedder de tillegg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuschläge sind Extravergütung für ungünstige Arbeitszeiten. Auf norwegischen Lohnabrechnungen heißen sie tillegg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα επιδόματα είναι επιπλέον αμοιβή για εργασία σε άβολες ώρες. Στις νορβηγικές μισθοδοσίες ονομάζονται tillegg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supplements are extra pay for inconvenient hours. Norwegian payslips call them tillegg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los suplementos son pagos extra por trabajar en horarios incómodos. En las nóminas noruegas se llaman tillegg."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisatasud on lisapalk ebamugavatel aegadel tehtud töö eest. Norra palgalehtedel nimetatakse neid tillegg."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمک‌هزینه‌ها دستمزد اضافی برای کار در ساعات نامناسب است. در فیش‌های حقوقی نروژی به آن tillegg می‌گویند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisät ovat lisäpalkkaa epämukavina aikoina tehdystä työstä. Norjalaisissa palkkalaskelmissa niitä kutsutaan nimellä tillegg."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga dagdag ay dagdag na bayad para sa trabaho sa hindi komportableng oras. Sa mga payslip sa Norway, tinatawag itong tillegg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suppléments sont une rémunération en plus pour les horaires décalés. Sur les fiches de paie norvégiennes, ils s'appellent tillegg."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוספות הן תשלום נוסף על עבודה בשעות לא נוחות. בתלושי שכר נורווגיים הן נקראות tillegg."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भत्ते असुविधाजनक समय पर काम के लिए अतिरिक्त वेतन हैं। नॉर्वे की सैलरी स्लिप पर इन्हें tillegg कहा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaci su dodatna plaća za rad u nepovoljno vrijeme. Na norveškim platnim listama zovu se tillegg."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pótlékok extra fizetést jelentenek a kényelmetlen időpontokban végzett munkáért. A norvég bérpapíron tillegg a nevük."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjangan adalah bayaran tambahan untuk jam kerja yang tidak nyaman. Di slip gaji Norwegia, namanya tillegg."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álag er aukagreiðsla fyrir vinnu á óþægilegum tímum. Á norskum launaseðlum heitir það tillegg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I supplementi sono una retribuzione extra per gli orari scomodi. Nelle buste paga norvegesi si chiamano tillegg."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手当は、不便な時間帯の勤務に対する追加の給与です。ノルウェーの給与明細では tillegg と呼ばれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수당은 불편한 시간대 근무에 대한 추가 급여입니다. 노르웨이 급여 명세서에서는 tillegg라고 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priedai yra papildomas atlyginimas už darbą nepatogiu metu. Norvegijos atlyginimo lapeliuose jie vadinami tillegg."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piemaksas ir papildu samaksa par darbu neērtā laikā. Norvēģijas algas lapiņās tās sauc par tillegg."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillegg brukes til å beregne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toeslagen zijn extra loon voor ongunstige uren. Op Noorse loonstroken heten ze tillegg."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillegg blir brukt til å berekne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatki to dodatkowe wynagrodzenie za pracę w niedogodnych godzinach. Na norweskich paskach płacowych nazywają się tillegg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionais são pagamentos extras por horários inconvenientes. Nos contracheques noruegueses, eles se chamam tillegg."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporurile sunt plată în plus pentru orele incomode. Pe fluturașii de salariu norvegieni se numesc tillegg."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавки начисляются за работу в неудобное время. В норвежских расчётных листках они называются tillegg."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príplatky sú mzda navyše za prácu v nevýhodnom čase. Na nórskych výplatných páskach sa volajú tillegg."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatki so dodatno plačilo za delo ob neugodnih urah. Na norveških plačilnih listah se imenujejo tillegg."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaci su dodatna zarada za rad u nepovoljno vreme. Na norveškim platnim listićima zovu se tillegg."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillägg är extra lön för arbete på obekväma tider. På norska lönebesked heter de tillegg."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyongeza ni malipo ya ziada kwa kazi katika saa zisizofaa. Kwenye hati za mishahara za Norwe zinaitwa tillegg."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சலுகைகள் என்பவை சிரமமான நேரங்களில் செய்யும் வேலைக்கான கூடுதல் ஊதியம். நார்வே சம்பளச் சீட்டுகளில் இவை tillegg என அழைக்கப்படுகின்றன."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เบี้ยเพิ่มเติมคือค่าจ้างพิเศษสำหรับการทำงานในเวลาที่ไม่สะดวก ในสลิปเงินเดือนของนอร์เวย์เรียกว่า tillegg"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek ödemeler, uygunsuz saatlerde çalışma için verilen ek ücrettir. Norveç maaş bordrolarında adı tillegg'dir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавки нараховуються за роботу в незручний час. У норвезьких розрахункових листках вони називаються tillegg."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سپلیمنٹ ناموزوں اوقات میں کام کی اضافی تنخواہ ہے۔ ناروے کی تنخواہ کی پرچی پر اسے tillegg کہا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ cấp là tiền lương thêm cho giờ làm việc bất tiện. Trên phiếu lương ở Na Uy, khoản này gọi là tillegg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "补贴是在不便时段工作的额外工资。挪威工资单上称为 tillegg。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補貼是在不便時段工作的額外報酬。挪威薪資單上稱為 tillegg。"
          }
        }
      }
    },
