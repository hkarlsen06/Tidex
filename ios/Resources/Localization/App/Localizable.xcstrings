    "notifications.reminders.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv mig besked før mine vagter starter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtige mich, bevor meine Schichten beginnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ειδοποίησέ με πριν ξεκινήσουν οι βάρδιές μου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me before my shifts start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifícame antes de que comience mis vakts"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoita minulle ennen vuoroiden alkua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me notifier avant mes vakts"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvertimi prima che inizino i miei turni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト開始前に通知を受け取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 시작 전에 알려주기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsle meg før vaktene mine starter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinner me voordat mijn vachten beginnen"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsle meg før vaktene mine startar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadom mnie przed rozpoczęciem moich vaktów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifique-me antes dos meus turnos começarem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunțați-mă înainte ca turile mele să înceapă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять меня перед началом смены"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddela mig innan mina pass börjar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนฉันก่อนเข้างาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardiyalarım başlamadan önce beni uyar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщуйте мене перед початком моїх змін"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo cho tôi trước khi ca làm việc của tôi bắt đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在班次开始前通知我"
          }
        }
      }
    },
