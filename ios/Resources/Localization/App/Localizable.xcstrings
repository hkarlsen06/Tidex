        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveri nabiralnik za oba e-poštna naslova. Klikniti moraš na povezave v obeh e-poštnih sporočilih, da dokončaš spremembo."
          }
