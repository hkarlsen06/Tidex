    "userMenu.logoutEverywhereConfirmDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger dig ud fra alle enheder, herunder denne. Du skal logge ind igen på hver enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies meldet dich auf allen Geräten ab, auch auf diesem. Du musst dich dann auf jedem Gerät erneut anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will sign you out from all devices, including this one. You will need to log in again on each device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará tu sesión en todos los dispositivos, incluido este. Deberás iniciar sesión nuevamente en cada dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa sinut ulos kaikista laitteista, myös tästä. Sinun on kirjauduttava uudelleen jokaiselle laitteelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnectera de tous vos appareils, y compris celui-ci. Vous devrez vous reconnecter sur chaque appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrai disconnesso da tutti i dispositivi, incluso questo. Dovrai accedere di nuovo su ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスからログアウトされます。各デバイスで再度ログインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃되며, 각 기기에서 다시 로그인해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut fra alle enheter, inkludert denne. Du må logge inn igjen på hver enhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal je afmelden op alle apparaten, inclusief dit toestel. Je zult je opnieuw moeten aanmelden op elk apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogujesz się ze wszystkich urządzeń, w tym tego. Będziesz musiał zalogować się ponownie na każdym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso o desconectará de todos os dispositivos, incluindo este. Você precisará fazer login novamente em cada dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете со всех устройств, включая это. Вам нужно будет снова войти на каждое устройство."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer att loggas ut från alla enheter, inklusive denna. Du måste logga in igen på varje enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะออกจากระบบคุณจากทุกอุปกรณ์ รวมถึงอุปกรณ์นี้ คุณจะต้องเข้าสู่ระบบใหม่ในแต่ละอุปกรณ์"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вийдете зі всіх пристроїв, включаючи цей. Вам потрібно буде повторно увійти на кожному пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được đăng xuất từ tất cả các thiết bị, bao gồm cái này. Bạn sẽ cần đăng nhập lại trên mỗi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将在所有设备上登出您，包括此设备。您需要在每个设备上重新登录。"
          }
        }
      }
    },
