    "wagey.showcase.features.naturalLanguage.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du taler. Wagey forstår alle sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib, wie du sprichst. Wagey versteht alle Sprachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write as you speak. Wagey understands all languages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe como hablas. Wagey entiende todos los idiomas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita niin kuin puhuisit. Wagey ymmärtää kaikki kielet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez comme vous parlez. Wagey comprend toutes les langues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi come parli. Wagey comprende tutte le lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すように書いてください。Wageyはすべての言語を理解します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 대로 작성하세요. Wagey는 모든 언어를 이해합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du snakker. Wagey forstår alle språk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf zoals je spreekt. Wagey begrijpt alle talen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz jak mówisz. Wagey rozumie wszystkie języki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva como fala. Wagey entende todos os idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите как говорите. Wagey понимает все языки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du talar. Wagey förstår alla språk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนตามธรรมชาติ Wagey เข้าใจทุกภาษา"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишіть так, як говорите. Wagey розуміє всі мови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết như bạn nói. Wagey hiểu tất cả các ngôn ngữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照您说话的方式写。Wagey 理解所有语言。"
