            "value": "Passez à la version Premium pour débloquer toutes les fonctionnalités"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui l'upgrade per sbloccare tutte le funzioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能をアンロックするためにアップグレード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
