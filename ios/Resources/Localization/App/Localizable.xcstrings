        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ பகிரும் பணிப்பகுதிகளை நீங்கள் இனி பார்க்க மாட்டீர்கள். நீங்கள் அவர்களுடன் பகிரும் பணிப்பகுதிகளை அவர்கள் இன்னும் பார்க்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะหยุดดูกะที่ %@ แชร์ แต่พวกเขายังเห็นกะที่คุณแชร์กับพวกเขาได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adlı kişinin paylaştığı vardiyaları görmeyi bırakacaksın. Onlar yine de senin onlarla paylaştığın vardiyaları görebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви перестанете бачити зміни, якими ділиться %@. Вони й далі бачитимуть зміни, якими ви ділитеся з ними."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ %@ کی شیئر کردہ شفٹیں دیکھنا بند کر دیں گے۔ وہ پھر بھی وہ شفٹیں دیکھ سکیں گے جو آپ ان کے ساتھ شیئر کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ ngừng xem ca làm mà %@ chia sẻ. Họ vẫn có thể xem ca làm bạn chia sẻ với họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将停止查看%@共享的班次。他们仍可查看你与他们共享的班次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將停止查看%@分享的班次。他們仍可看見你與他們分享的班次。"
          }
        }
      }
    },
