    "settings.pay.editor.breakDescription" : {
      "comment" : "Description under the break deduction toggle in the wage entry editor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخصم وقت الفترة تلقائياً من الورديات التي تتجاوز طول معين"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично приспаждане на времето за почивка от смени над определена дължина"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি নির্দিষ্ট দৈর্ঘ্যের চেয়ে বেশি শিফট থেকে স্বয়ংক্রিয়ভাবে বিরতি সময় কেটে নিন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedueix automàticament el temps de pausa dels torns més llargs que una certa durada"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky odečíst čas přestávky ze směn delších než určitou dobu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekk automatisk pause fra vakter over en viss længde"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausenzeit automatisch von Schichten über einer bestimmten Länge abziehen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρέστε αυτόματα το χρόνο διαλείμματος από βάρδιες που υπερβαίνουν ένα ορισμένο μήκος"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically deduct break time from shifts over a certain length"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deducir automáticamente el tiempo de descanso de turnos superiores a cierta duración"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaatselt arvesta paus vahetustest, mis ületavad teatud pikkust"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسر خودکار زمان استراحت از شیفت‌های بیش از طول معینی"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähennä automaattisesti tauko pitkistä vuoroista"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awtomatikong diskwento ng break time mula sa shifts na higit sa isang tiyak na haba"
          }
        },
        "fr" : {
