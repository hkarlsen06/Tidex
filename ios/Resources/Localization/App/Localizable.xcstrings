            "state": "translated",
            "value": "この日付は繰り返しシフトから除外されます。シフトは表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜는 반복 근무에서 제외됩니다. 근무가 더 이상 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta data será excluída do turno recorrente. O turno não aparecerá mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта дата будет исключена из повторяющейся смены. Смена больше не будет отображаться."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze datum wordt uitgesloten van de terugkerende shift. De shift verschijnt niet meer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta datum kommer att uteslutas från det återkommande skiftet. Skiftet visas inte längre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne dato udelukkes fra det tilbagevendende skift. Skiftet vises ikke længere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa data verrà esclusa dal turno ricorrente. Il turno non apparirà più."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä päivämäärä poistetaan toistuvasta vuorosta. Vuoro ei enää näy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta data zostanie wykluczona z powtarzającego się dyżuru. Dyżur nie będzie już widoczny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дата буде виключена з повторюваної зміни. Змін більше не буде видно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日期将从循环班次中排除。班次将不再显示。"
