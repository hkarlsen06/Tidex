        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি আগে থেকেই শিফট পরিকল্পনা করতে পারেন, অথবা পুনরাবৃত্ত শিফট সেট আপ করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pots planificar vagas amb anticipació, o configurar vagas recurrents."
          }
