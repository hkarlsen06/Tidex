    "dashboard.payrollDetails.mixedBasisNote" : {
      "comment" : "Note under the total in payout details when some jobs have tax estimation on and others do not.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع صافي الأجر للوظائف التي لديها ضريبة، والأجر قبل الضريبة للوظائف التي لا توجد لديها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Събира нетното възнаграждение за работните места с данъци и възнаграждението преди данъци за работните места без данъци."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কর হিসাবসহ কাজের নেট বেতন এবং কর হিসাববিহীন কাজের কর-পূর্ব বেতন যোগ করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma el sou net dels treballs amb estimació d'impostos i el sou abans d'impostos dels que no en tenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sčítá čistou mzdu za směny se zdaněním a mzdu před zdaněním za směny bez něj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lægger nettoløn for jobs med skat sammen med løn før skat for jobs uden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addiert den Nettolohn für Jobs mit Steuerschätzung und den Lohn vor Steuern für Jobs ohne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει την καθαρή αμοιβή για εργασίες με φόρο και την αμοιβή προ φόρων για εργασίες χωρίς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds net pay for jobs with tax and pay before tax for jobs without."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma el salario neto de los trabajos con impuestos y el salario antes de impuestos de los que no los tienen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liidab kokku maksuarvestusega tööde netotasu ja maksuarvestuseta tööde maksueelse tasu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای کارهای دارای مالیات، درآمد خالص و برای کارهای بدون مالیات، درآمد پیش از مالیات را جمع می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee yhteen nettopalkan töistä, joissa verolaskenta on käytössä, ja palkan ennen veroja muista töistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinagsasama ang netong kita ng mga trabahong may buwis at ang kita bago ang buwis ng mga trabahong wala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Additionne le salaire net des emplois avec estimation fiscale et le salaire avant impôts des emplois sans estimation fiscale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כולל שכר נטו עבור עבודות עם חישוב מס ושכר לפני מס עבור עבודות ללא חישוב מס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन कामों में कर अनुमान है उनका शुद्ध भुगतान और जिनमें नहीं है उनका कर-पूर्व भुगतान जोड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbraja neto iznose za poslove s procjenom poreza i iznose prije poreza za poslove bez procjene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adóbecsléses munkák nettó bérét, az adóbecslés nélküliek adózás előtti bérét adja össze."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjumlahkan penghasilan bersih untuk pekerjaan dengan pajak dan penghasilan sebelum pajak untuk pekerjaan tanpa pajak."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggur saman nettólaun fyrir störf með skattmati og laun fyrir skatt fyrir störf án skattmats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somma il netto dei lavori con tasse e l'importo prima delle tasse per quelli senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "税計算ありの勤務の手取りと、税計算なしの勤務の税引き前金額を合算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세금이 적용된 근무의 순수입과 그렇지 않은 근무의 세전 금액을 합산합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudedamas atlyginimas po mokesčių už darbus, kuriems taikomi mokesčiai, ir atlyginimas prieš mokesčius už darbus, kuriems jie netaikomi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskaita neto algu darbiem ar nodokļu aprēķinu un algu pirms nodokļiem — darbiem bez tā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger sammen netto for jobber med skatt og beløp før skatt for jobber uten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt het nettoloon op voor banen met belastingberekening en het brutoloon voor banen zonder belastingberekening."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger saman netto for jobber med skatt og beløp før skatt for jobber utan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumuje wynagrodzenie netto za pracę z podatkiem oraz wynagrodzenie przed opodatkowaniem za pracę bez podatku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma o pagamento líquido dos trabalhos com impostos e o pagamento antes dos impostos dos demais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Însumează venitul net pentru joburile cu impozit și venitul înainte de impozit pentru cele fără."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суммирует чистый доход для работ с налогами и доход до налогов для работ без них."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sčítava čistú mzdu za práce s odhadom dane a mzdu pred zdanením za práce bez odhadu dane."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sešteva neto plačilo za opravila z davkom in plačilo pred davkom za opravila brez njega."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obuhvata neto zaradu za poslove sa obračunom poreza i zaradu pre poreza za poslove bez njega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summerar nettolön för jobb med skatt och lön före skatt för jobb utan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huongeza malipo halisi ya kazi zenye kodi na malipo kabla ya kodi ya kazi zisizo na kodi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரி கணக்கீடு உள்ள வேலைகளுக்கான நிகர ஊதியத்தையும், அது இல்லாத வேலைகளுக்கான வரிக்கு முந்தைய ஊதியத்தையும் கூட்டுகிறது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมค่าจ้างสุทธิสำหรับงานที่มีการคำนวณภาษี และค่าจ้างก่อนหักภาษีสำหรับงานที่ไม่มี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergi uygulanan işler için net ücreti, uygulanmayan işler için vergi öncesi ücreti toplar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підсумовує чистий заробіток за роботи з податками та заробіток до оподаткування за роботи без них."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹیکس والے کاموں کی خالص تنخواہ اور بغیر ٹیکس والے کاموں کی ٹیکس سے پہلے کی تنخواہ جمع کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cộng tiền thực nhận của các công việc có tính thuế và tiền trước thuế của các công việc không tính thuế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将启用税费估算的工作按净收入计入，未启用的按税前收入计入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加總已設定稅務估算工作的淨收入，以及未設定工作的稅前收入。"
          }
        }
      }
    },
