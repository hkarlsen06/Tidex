    "sharing.manageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your shifts with friends and colleagues so they can see when you work."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del vaktene dine med venner og kolleger slik at de kan følge med på når du jobber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie Ihre Schichten mit Freunden und Kollegen, damit sie sehen können, wenn Sie arbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tus turnos con amigos y compañeros para que vean cuándo trabajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez vos quarts de travail avec des amis et des collègues pour qu'ils voient quand vous travaillez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトを友人や同僚と共有して、いつ働くかを見てもらいましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 및 동료와 근무를 공유하여 언제 일하는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seus turnos com amigos e colegas para que vejam quando você trabalha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь своим расписанием со друзьями и коллегами, чтобы они видели, когда вы работаете."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je shifts met vrienden en collega's zodat zij kunnen zien wanneer je werkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela dina pass med vänner och kollegor så de kan se när du arbetar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dine skift med venner og kollegaer saa de kan se, naar du arbejder."
          }
        }
      }
    },
