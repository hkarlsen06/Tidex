    "onboarding.supplements.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements are used to calculate extra pay for inconvenient hours"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg brukes til å beregne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge werden zur Berechnung von Zusatzverdiensten für ungünstige Stunden verwendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los suplementos se utilizan para calcular pago extra por horas inconvenientes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments servent à calculer la rémunération supplémentaire pour les heures inconvenantes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当は不都合な時間帯の追加給与の計算に使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 불편한 시간에 대한 추가 급여를 계산하는 데 사용됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionais são usados para calcular pagamento extra por horas inconvenientes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки используются для расчёта доплаты за неудобные часы"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen worden gebruikt om extra betaling voor ongunstige uren te berekenen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg används för att beräkna extra lön för opraktiska timmar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg bruges til at beregne ekstra løn for ubelejlige timer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi vengono utilizzati per calcolare la paga extra per orari scomodi"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisien avulla lasketaan lisäkorvaus epäkätevälle työajalle"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki służą do obliczenia dodatkowej płacy za trudne godziny"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки використовуються для розрахунку додаткової оплати за невзручні години"
