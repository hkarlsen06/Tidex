    "profile.emailChange.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your new email address. We'll send a confirmation to both your old and new address."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn din nye e-postadresse. Vi sender en bekreftelse til både den gamle og nye adressen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre neue E-Mail-Adresse ein. Wir senden eine Bestätigung an beide Adressen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu nueva dirección de correo. Enviaremos una confirmación a ambas direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez votre nouvelle adresse e-mail. Nous enverrons une confirmation aux deux adresses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメールアドレスを入力してください。古いアドレスと新しいアドレスの両方に確認メールを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이메일 주소를 입력하세요. 기존 주소와 새 주소 모두에 확인을 보내드립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu novo endereço de email. Enviaremos uma confirmação para seu endereço antigo e novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите новый адрес электронной почты. Мы отправим подтверждение на оба адреса."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je nieuwe e-mailadres in. We sturen een bevestiging naar je oude en nieuwe adres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange din nya e-postadress. Vi skickar en bekräftelse till både din gamla och nya adress."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din nye mailadresse. Vi sender en bekræftelse til både din gamle og nye adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo nuovo indirizzo email. Ti invieremo una conferma sia al vecchio che al nuovo indirizzo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä uusi sähköpostiosoitteesi. Lähetämme vahvistuksen sekä vanhaan että uuteen osoitteeseen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nowy adres e-mail. Wyślemy potwierdzenie na stary i nowy adres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть вашу нову адресу електронної пошти. Ми надішлемо підтвердження на обидві адреси."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您的新电子邮件地址。我们将向您的旧地址和新地址发送确认。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนที่อยู่อีเมลใหม่ของคุณ เราจะส่งการยืนยันไปยังที่อยู่เก่าและใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ email mới. Chúng tôi sẽ gửi xác nhận đến cả địa chỉ cũ và mới của bạn."
          }
        }
      }
    },
