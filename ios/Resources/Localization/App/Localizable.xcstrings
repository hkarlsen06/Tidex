    "sharing.blockedUsers.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقَى المستخدمون المحظورون خارج الأصدقاء والدردشة حتى تلغي حظرهم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокираните потребители остават извън приятели и чат, докато не ги отблокирате."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আনব্লক না করা পর্যন্ত ব্লক করা ব্যবহারকারীরা বন্ধু ও চ্যাটের বাইরে থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els usuaris bloquejats queden fora dels amics i del xat fins que els desbloquegis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokovaní uživatelé zůstanou mimo přátele a chat, dokud je neodblokujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokerede brugere holdes ude af venner og chat, indtil du fjerner blokeringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockierte Nutzer bleiben aus Freunden und Chat raus, bis du sie entsperrst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αποκλεισμένοι χρήστες μένουν εκτός φίλων και συνομιλίας μέχρι να άρεις τον αποκλεισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocked users stay out of friends and chat until you unblock them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios bloqueados quedan fuera de amigos y chat hasta que los desbloquees."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokeeritud kasutajad jäävad sõpradest ja vestlusest eemale, kuni nad vabastad."
