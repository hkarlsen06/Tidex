    "widget.intent.friendShift.description" : {
      "comment" : "Description in the friend shift widget settings, where the user picks which friend to show.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر صديقًا لعرض نوبته"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете приятел, за да видите неговата смяна"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তাদের শিফট প্রদর্শনের জন্য একজন বন্ধু নির্বাচন করুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un amic per mostrar la seva vakt"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrat přítele pro zobrazení jejich směny"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en ven for at vise deres vagt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Freund, um deren Schicht anzuzeigen"
