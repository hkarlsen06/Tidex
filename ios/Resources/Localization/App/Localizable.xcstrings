    "settings.pay.review.taxOff" : {
      "comment" : "Note in payroll details when the tax estimate is turned off.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير الضريبة متوقف. تُعرض المبالغ قبل الضريبة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозният данък е изключен. Сумите са показани преди данъци."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কর অনুমান বন্ধ। পরিমাণগুলো কর কাটার আগের হিসেবে দেখানো হচ্ছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'estimació dels impostos està desactivada. Els imports es mostren abans d'impostos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
