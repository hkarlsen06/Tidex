    "acceptTerms.updated.explanation" : {
      "comment" : "Body text on the terms screen shown to existing users after the terms or privacy policy changed. The documents are links below it.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد تغيّرت شروط الخدمة وسياسة الخصوصية. افتح المستندات أدناه، ثم وافق عندما تكون جاهزًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условията за ползване и Политиката за поверителност са променени. Отворете документите по-долу и приемете, когато сте готови."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেবার শর্তাবলি ও গোপনীয়তা নীতি পরিবর্তিত হয়েছে। নিচের নথিগুলো খুলুন, তারপর প্রস্তুত হলে গ্রহণ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Condicions del servei i la Política de privadesa han canviat. Obre els documents de sota i accepta quan estiguis a punt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podmínky služby a zásady ochrany osobních údajů se změnily. Otevřete níže uvedené dokumenty a až budete připraveni, přijměte je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servicevilkårene og privatlivspolitikken er ændret. Åbn dokumenterne nedenfor, og acceptér, når du er klar."
