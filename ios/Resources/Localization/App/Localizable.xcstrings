        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 아직 데이터가 없습니다. 동기화가 완료될 때까지 기다려 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
