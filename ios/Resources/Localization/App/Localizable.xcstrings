    "acceptTerms.explanation" : {
      "comment" : "Body text on the first-time terms acceptance screen, above the links to the legal documents.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للمتابعة، يجب عليك قراءة وقبول شروط الخدمة وسياسة الخصوصية الخاصة بنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да продължите, трябва да прочетете и приемете нашите условия за ползване и политика за личните данни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যেতে আপনাকে আমাদের সেবার শর্তাবলী এবং গোপনীয়তা নীতি পড়তে এবং গ্রহণ করতে হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per continuar, has de llegir i acceptar els nostres Termes de servei i la Política de privacitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li pokračovat, musíte si přečíst a přijmout naše Podmínky služby a Zásady ochrany osobních údajů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at fortsætte skal du læse og acceptere vores servicevilkår og privatlivspolitik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um fortzufahren, müssen Sie unsere Nutzungsbedingungen und Datenschutzrichtlinie lesen und akzeptieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να συνεχίσετε, πρέπει να διαβάσετε και να αποδεχτείτε τους Όρους Υπηρεσίας και την Πολιτική Απορρήτου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To continue, you must read and accept our Terms of Service and Privacy Policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar, debes leer y aceptar nuestros Términos de servicio y Política de privacidad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätkamiseks pead lugema ja nõustuma meie teenusetingimustega ja privaatsuseeskirjaga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ادامه باید شرایط خدمات و سیاست حریم خصوصی ما را بخوانید و بپذیرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkaaksesi sinun on luettava ja hyväksyttävä palveluehdot ja tietosuojakäytäntö."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upang magpatuloy, dapat mong basahin at tanggapin ang aming Mga Kondisyon ng Serbisyo at Patakaran sa Privacy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour continuer, vous devez lire et accepter nos conditions d'utilisation et notre politique de confidentialité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להמשיך, עליך לקרוא ולקבל את תנאי השירות ומדיניות הפרטיות שלנו."
          }
        },
        "hi" : {
