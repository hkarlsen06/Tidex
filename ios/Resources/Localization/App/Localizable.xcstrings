    "sharing.noSharersDescription" : {
      "comment" : "Empty state text under the no sharers title on the friends screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يشارك شخص ما وردياته معك، ستظهر هنا"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато някой споделя смените си с вас, те ще се появят тук"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যখন কেউ তাদের শিফট আপনার সাথে শেয়ার করে, তখন সেগুলি এখানে প্রদর্শিত হবে"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan algú comparteixi els seus torns amb tu, apareixeran aquí"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když si někdo sdílí své směny s vámi, zobrazí se zde"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når nogen deler deres vakter med dig, vises de her"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn jemand seine Schichten mit Ihnen teilt, werden diese hier angezeigt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν κάποιος κοινοποιεί τις βάρδιες του με εσάς, θα εμφανίζονται εδώ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When someone shares their shifts with you, they will appear here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien comparta sus turnos contigo, aparecerán aquí"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui keegi jagab sinuga oma vahte, kuvatakse need siin"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگامی که کسی شیفت‌های خود را با شما به اشتراک بگذارد، اینجا نمایش داده می‌شود"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun joku jakaa vuoronsa sinulle, ne näkyvät täällä"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag may nagbahagi ng kanilang mga shift sa iyo, lilitaw sila dito"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelqu'un partage ses vagues avec vous, elles apparaîtront ici"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר מישהו משתף איתך את משמרותיו, הם יופיעו כאן"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई आपके साथ अपनी शिफ्ट शेयर करता है, तो वह यहां दिखाई देगी"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada netko podijeli svoje smjene s tobom, pojavit će se ovdje"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor valaki megosztja a műszakait veled, itt fognak megjelenni"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika seseorang membagikan shift mereka dengan Anda, mereka akan muncul di sini"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þegar einhver deilir vöktum sínum með þér munu þær birtast hér"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando qualcuno condivide le sue vature con te, appariranno qui"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがシフトをあなたとシェアすると、ここに表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 근무를 당신과 공유하면 여기에 표시됩니다"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai kas nors bendrina savo pamainas su tavimi, jos bus rodomos čia"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad kāds ar jums koplietos savas maiņas, tās parādīsies šeit"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når noen deler vaktene sine med deg, vil de vises her"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når noen deler vaktene sine med deg, vil de vises her"
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når nokon deler vaktene sine med deg, vil dei vislast her"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ktoś udostępni z tobą swoje wakt, pojawią się tutaj"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando alguém compartilhar seus turnos com você, eles aparecerão aqui"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când cineva vă partajează schimburile sale cu dumneavoastră, vor apărea aici"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда кто-то делится своими сменами с вами, они появятся здесь"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď si niekto zdieli svoje zmeny s vami, objavia sa tu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko nekdo deli svoje izmene s tabo, se bodo prikazale tukaj"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada neko podeli svoje smene sa vama, pojaviće se ovde"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När någon delar sina vakter med dig visas de här"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakati mtu yeyote anahisa zamu zake na wewe, zitaonekana hapa"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "யாரேனும் தங்கள் ஷிப்டுகளை உனக்குப் பகிர்ந்துகொள்ளும் போது, அவை இங்கே தோன்றும்"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อใครบางคนแชร์เวรของพวกเขากับคุณ จะปรากฏที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri vardiyalarını seninle paylaştığında, buraya görünecekler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли хтось поділиться своїми змінами з вами, вони з'являться тут"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب کوئی اپنی شفٹوں کو آپ کے ساتھ شیئر کرے گا، وہ یہاں دکھائی دیں گی"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ai đó chia sẻ ca làm việc của họ với bạn, chúng sẽ xuất hiện ở đây"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当有人与您分享他们的班次时，将显示在这里"
          }
