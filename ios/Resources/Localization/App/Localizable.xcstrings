    "push.failure.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift reminders won't work until this is resolved. Check your notification settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktpåminnelser vil ikke fungere før dette er løst. Sjekk varslingsinnstillingene dine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schichterinnerungen funktionieren erst nach der Behebung dieses Problems. Überprüfen Sie Ihre Benachrichtigungseinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels de quart ne fonctionneront pas tant que ce problème n'est pas résolu. Vérifiez vos paramètres de notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de turnos no funcionarán hasta que se resuelva esto. Comprueba tu configuración de notificaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria dei turni non funzioneranno finché questo non sarà risolto. Controlla le tue impostazioni di notifica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienstrappels werken niet totdat dit is opgelost. Controleer uw meldingsinstellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de turno não funcionarão até que isso seja resolvido. Verifique suas configurações de notificação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiftpåminnelser fungerar inte förrän detta är löst. Kontrollera dina aviseringsinställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktpåmindelser vil ikke fungere før dette er løst. Kontroller dine meddelelsesindstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoron muistutukset eivät toimi ennen kuin tämä on ratkaistu. Tarkista ilmoitusasetuksesi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia o zmianach nie będą działać do czasu rozwiązania tego problemu. Sprawdź ustawienia powiadomień."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания о смене не будут работать, пока это не будет решено. Проверьте настройки уведомлений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування про зміни не працюватимуть, поки це не буде вирішено. Перевірте параметри сповіщень."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが解決されるまでシフトリマインダーは機能しません。通知設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문제가 해결될 때까지 근무 알림이 작동하지 않습니다. 알림 설정을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在解决此问题之前，班次提醒将无法正常工作。请检查您的通知设置。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนกะจะไม่ทำงานจนกว่าแก้ไขปัญหานี้ได้ โปรดตรวจสอบการตั้งค่าการแจ้งเตือนของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo ca làm việc sẽ không hoạt động cho đến khi vấn đề này được giải quyết. Kiểm tra cài đặt thông báo của bạn."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktpåminnelser vil ikke fungere før dette er løst. Sjekk varslingsinnstillingane dine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardiya hatırlatmaları bu sorun çözülene kadar çalışmaz. Bildirim ayarlarınızı kontrol edin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπενθυμίσεις βάρδιας δεν θα λειτουργούν μέχρι να επιλυθεί αυτό. Ελέγξτε τις ρυθμίσεις ειδοποιήσεών σας."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările de schimb nu vor funcționa până când aceasta nu este rezolvată. Verifică setările de notificări."
          }
        }
      }
    },
