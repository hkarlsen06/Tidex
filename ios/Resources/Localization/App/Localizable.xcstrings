    "userMenu.logoutEverywhereConfirmDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will sign you out from all devices, including this one. You will need to log in again on each device."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut fra alle enheter, inkludert denne. Du må logge inn igjen på hver enhet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies meldet dich auf allen Geräten ab, auch auf diesem. Du musst dich dann auf jedem Gerät erneut anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará tu sesión en todos los dispositivos, incluido este. Deberás iniciar sesión nuevamente en cada dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnectera de tous vos appareils, y compris celui-ci. Vous devrez vous reconnecter sur chaque appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスからログアウトされます。各デバイスで再度ログインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃되며, 각 기기에서 다시 로그인해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso o desconectará de todos os dispositivos, incluindo este. Você precisará fazer login novamente em cada dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете со всех устройств, включая это. Вам нужно будет снова войти на каждое устройство."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal je afmelden op alle apparaten, inclusief dit toestel. Je zult je opnieuw moeten aanmelden op elk apparaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer att loggas ut från alla enheter, inklusive denna. Du måste logga in igen på varje enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger dig ud fra alle enheder, herunder denne. Du skal logge ind igen på hver enhed."
          }
        }
      }
    },
