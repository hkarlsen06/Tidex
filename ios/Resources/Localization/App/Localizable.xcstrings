    "profile.dangerZone.deleteAccount.dialogDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب حذف للتأكيد. سيتم حذف جميع البيانات بشكل دائم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишете ИЗТРИВАНЕ за потвърждение. Всички данни ще бъдат премахнати трайно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত করতে মুছুন টাইপ করুন। সমস্ত ডেটা স্থায়ীভাবে সরানো হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu SUPRIMEIX per confirmar. Totes les dades s'eliminaran permanentment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte SMAZAT pro potvrzení. Všechna data budou trvale odstraněna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv SLET for at bekræfte. Alle data vil blive fjernet permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib LÖSCHEN ein zur Bestätigung. Alle Daten werden dauerhaft gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολόγησε ΔΙΑΓΡΑΦΗ για επιβεβαίωση. Όλα τα δεδομένα θα αφαιρεθούν μόνιμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type DELETE to confirm. All data will be permanently removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe ELIMINAR para confirmar. Todos los datos se eliminarán permanentemente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjuta KUSTUTA kinnituseks. Kõik andmed kustutatakse jäädavalt."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تأیید، DELETE را تایپ کنید. تمام داده‌ها به‌طور دائمی حذف خواهند شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita POISTA vahvistaaksesi. Kaikki tiedot poistetaan pysyvästi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-type ng DELETE upang kumpirmahin. Lahat ng data ay permanenteng matatanggal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez SUPPRIMER pour confirmer. Toutes les données seront supprimées définitivement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלד מחק לאישור. כל הנתונים יוסרו באופן קבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुष्टि करने के लिए DELETE टाइप करें। सभी डेटा स्थायी रूप से हटा दिए जाएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upišite OBRIŠI za potvrdu. Svi podaci će biti trajno izbrisani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írja be a TÖRLÉS szöveget a megerősítéshez. Minden adat véglegesen eltávolításra kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
