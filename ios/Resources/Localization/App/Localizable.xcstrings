          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke slette vakter. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke slette vakter. Prøv igjen."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke slette vakter. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
