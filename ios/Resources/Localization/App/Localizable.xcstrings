    "onboarding.mfa.benefit1.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if someone gets your password, they still need your phone"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv om noen får tak i passordet ditt, trenger de også telefonen din"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst wenn jemand dein Passwort erhält, benötigt er noch dein Telefon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso si alguien obtiene tu contraseña, aún necesita tu teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si quelqu'un obtient votre mot de passe, il a toujours besoin de votre téléphone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがパスワードを取得しても、電話が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 암호를 얻더라도 휴대폰이 필요합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que alguém obtenha sua senha, ainda precisa do seu telefone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже если кто-то узнает ваш пароль, ему все еще нужен ваш телефон"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs als iemand je wachtwoord krijgt, hebben zij je telefoon nog nodig"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även om någon får ditt lösenord behöver de fortfarande din telefon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvom nogen får dit adgangskode, har de stadig brug for din telefon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche se qualcuno ottiene la tua password, ha comunque bisogno del tuo telefono"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikka joku saisi salasanasi, hän tarvitsee silti puhelimesi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet jeśli ktoś uzyska Twoje hasło, nadal potrzebuje Twojego telefonu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть якщо хтось дізнається ваш пароль, йому все одно потрібен ваш телефон"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使有人获得了你的密码，他们仍需要你的手机"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ว่าใครบางคนได้รหัสผ่านของคุณ พวกเขายังต้องใช้โทรศัพท์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi ai đó có mật khẩu của bạn, họ vẫn cần điện thoại của bạn"
          }
        }
      }
    },
