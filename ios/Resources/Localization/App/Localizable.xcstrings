    "shifts.breakDeduction.expandAccessibilityHint" : {
      "comment" : "VoiceOver hint on the break deduction row in shift details. Tapping shows or hides the breakdown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين لتوسيع أو طي تفاصيل الخصم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете два пъти, за да покажете или скриете разбивката на удръжката."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কর্তনের বিবরণ বড় বা ছোট করতে দুবার ট্যাপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dues vegades per ampliar o replegar el desglossament de la deducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojitým klepnutím rozbalíte nebo sbalíte rozpis srážky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttryk for at udvide eller skjule oversigten over fradraget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Erweitern oder Reduzieren der Abzugsdetails doppeltippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε δύο φορές για επέκταση ή σύμπτυξη της ανάλυσης αφαίρεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap to expand or collapse the deduction breakdown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para expandir o contraer el desglose de la deducción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topeltpuuduta, et näha või peita mahaarvamise üksikasju."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای باز یا بسته کردن جزئیات کسر، دو بار ضربه بزنید."
