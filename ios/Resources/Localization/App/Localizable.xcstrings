    "appearance.calendarContentColor.workplaceDescription" : {
      "comment" : "Description for the 'Job colors' calendar appearance option.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم لون كل وظيفة في خلايا التقويم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте цвета на всяко работно място в клетките на календара."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যালেন্ডারের ঘরে প্রতিটি চাকরির রং ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza el color de cada feina a les cel·les del calendari."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používat barvu každého zaměstnání v buňkách kalendáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug farven for hvert job i kalenderfelterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Farbe jedes Jobs in den Kalenderzellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήση του χρώματος κάθε εργασίας στα κελιά του ημερολογίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use each job's color in calendar cells."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el color de cada empleo en las celdas del calendario."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasuta kalendrilahtrites iga töökoha värvi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از رنگ هر شغل در سلول‌های تقویم استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä kunkin työpaikan väriä kalenterisoluissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang kulay ng bawat trabaho sa mga cell ng kalendaryo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser la couleur de chaque emploi dans les cellules du calendrier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש בצבע של כל מקום עבודה בתאי לוח השנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलेंडर सेल में हर नौकरी का रंग इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi boju svakog posla u ćelijama kalendara."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használd az egyes munkahelyek színét a naptárcellákban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan warna tiap pekerjaan pada sel kalender."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notaðu lit hvers starfs í dagatalsreitunum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il colore di ogni lavoro nelle celle del calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各勤務先の色をカレンダーセルに使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 직장의 색상을 캘린더 셀에 사용합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
