    "security.password.setWithPhoneInstructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll send a code to your phone to verify your identity before setting a password."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en kode til telefonen din for å bekrefte identiteten din før du setter et passord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden einen Code an Ihr Telefon, um Ihre Identität zu bestätigen, bevor Sie ein Passwort setzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviaremos un código a tu teléfono para verificar tu identidad antes de establecer una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un code à votre téléphone pour vérifier votre identité avant de définir un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを設定する前に、本人確認のためコードを電話番号に送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호 설정 전에 신원 확인을 위해 휴대폰으로 코드를 전송합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um código para seu telefone para verificar sua identidade antes de definir uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправим код на ваш телефон для проверки личности перед установкой пароля."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We verzenden een code naar je telefoon om je identiteit te verifiëren voordat je een wachtwoord instelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skickar en kod till din telefon för att verifiera din identitet innan du ställer in ett lösenord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en kode til din telefon for at bekræfte din identitet, før du angiver en adgangskode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti invieremo un codice al telefono per verificare la tua identità prima di impostare una password."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetämme koodin puhelimeesi vahvistaaksemme henkilöllisyysi ennen salasanan asettamista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślemy kod na Twój telefon, aby zweryfikować Twoją tożsamość przed ustawieniem hasła."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми надішлемо код на ваш телефон, щоб перевірити вашу особистість перед встановленням пароля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们将向您的手机发送代码，以在设置密码前验证您的身份。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะส่งรหัสไปยังโทรศัพท์ของคุณเพื่อยืนยันตัวตนก่อนตั้งรหัสผ่าน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ gửi mã đến điện thoại của bạn để xác minh danh tính trước khi đặt mật khẩu."
          }
        }
      }
    },
