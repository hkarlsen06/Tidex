    "feedback.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us improve by sharing your thoughts"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp oss å bli bedre ved å dele dine tanker"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf uns zu verbessern, indem du deine Gedanken teilst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdanos a mejorar compartiendo tus ideas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez-nous à nous améliorer en partageant vos idées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見をお聞かせいただき、改善にご協力ください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 공유하여 개선을 도와주세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos ajude a melhorar compartilhando suas ideias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите нам улучшиться, поделившись своим мнением"
