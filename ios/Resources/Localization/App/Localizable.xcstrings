    "settings.pay.manageJobs.footer" : {
      "comment" : "Footer under the job list in the Manage jobs sheet. Explains that tapping opens pay history and that swiping or long-pressing shows row actions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على وظيفة لعرض سجل أجورها. اسحب الوظيفة أو اضغط عليها مطولًا لمزيد من الخيارات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете работа, за да видите историята на заплащането ѝ. Плъзнете или задръжте за още опции."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেতনের ইতিহাস দেখতে কোনো চাকরিতে ট্যাপ করুন। আরও বিকল্পের জন্য চাকরিটি সোয়াইপ করুন বা চেপে ধরে রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una feina per veure'n l'historial salarial. Llisca-la o mantén-la premuda per veure més opcions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na práci zobrazíte historii výdělků. Přejetím nebo podržením zobrazíte další možnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et job for at se lønhistorikken. Stryg på et job, eller tryk og hold for flere muligheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Job für den Lohnverlauf. Wische über einen Job oder halte ihn gedrückt, um weitere Optionen zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε μια εργασία για το ιστορικό αμοιβών της. Σύρετε ή κρατήστε πατημένη μια εργασία για περισσότερες επιλογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a job to see its pay history. Swipe or touch and hold a job for more options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un empleo para ver el historial de pagos. Desliza o mantén pulsado un empleo para ver más opciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta töökohta, et näha palgaajalugu. Rohkemate valikute jaoks nipsa töökohta või hoia seda all."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای دیدن سابقهٔ دستمزد، روی شغل بزنید. برای گزینه‌های بیشتر، روی شغل بکشید یا آن را لمس کرده و نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä työn palkkahistoria napauttamalla sitä. Lisää toimintoja saat pyyhkäisemällä työtä tai pitämällä sitä painettuna."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap ang trabaho para makita ang kasaysayan ng sahod. I-swipe o pindutin nang matagal para sa iba pang opsyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un emploi pour voir l’historique de rémunération. Balayez-le ou maintenez le doigt dessus pour plus d’options."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו על מקום עבודה כדי לראות את היסטוריית השכר שלו. החליקו או לחצו לחיצה ארוכה לאפשרויות נוספות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेतन इतिहास देखने के लिए किसी नौकरी पर टैप करें। और विकल्पों के लिए स्वाइप करें या नौकरी को दबाकर रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite posao za povijest plaće. Povucite ga ili dugo pritisnite za više opcija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints egy munkára a fizetési előzményekért. További lehetőségekért húzd el vagy tartsd lenyomva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk pekerjaan untuk melihat riwayat upah. Geser atau tekan lama untuk opsi lainnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikkaðu á starf til að sjá launasögu. Strjúktu yfir starf eða haltu því inni til að sjá fleiri valkosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un lavoro per vedere lo storico delle retribuzioni. Scorri o tieni premuto un lavoro per altre opzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事をタップすると給与履歴を表示します。スワイプまたは長押しでその他の操作を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직장을 탭하면 급여 내역을 볼 수 있습니다. 더 많은 옵션을 보려면 밀거나 길게 누르세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakstelėkite darbą, kad matytumėte atlygio istoriją. Braukite per darbą arba jį palaikykite, kad matytumėte daugiau parinkčių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskarieties darbavietai, lai skatītu atalgojuma vēsturi. Pavelciet to vai turiet nospiestu, lai skatītu citas iespējas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en jobb for å se lønnshistorikken. Sveip eller hold inne på en jobb for flere valg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een baan voor de loonhistorie. Veeg over een baan of houd deze ingedrukt voor meer opties."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på ein jobb for å sjå lønnshistoria. Sveip eller trykk og hald på ein jobb for fleire val."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij stanowiska, aby zobaczyć historię wynagrodzenia. Przesuń je lub przytrzymaj, aby zobaczyć więcej opcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um trabalho para ver o histórico de pagamentos. Deslize ou toque e segure para ver mais opções."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge un loc de muncă pentru istoricul salariilor. Glisează sau ține apăsat pentru mai multe opțiuni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на работу, чтобы посмотреть историю оплаты. Проведите по работе или удерживайте её, чтобы увидеть другие действия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknite na prácu a zobrazte históriu odmien. Potiahnutím alebo podržaním práce zobrazíte ďalšie možnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapnite delovno mesto za zgodovino plačil. Za več možnosti podrsnite po njem ali ga pridržite."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite posao za istoriju zarade. Prevucite ili zadržite prst na poslu za više opcija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ett jobb för att se lönehistoriken. Svep eller håll ned ett jobb för fler alternativ."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa kazi kuona historia ya malipo. Telezesha au bonyeza na ushikilie kazi kwa chaguo zaidi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஊதிய வரலாற்றைக் காண பணியைத் தட்டவும். கூடுதல் விருப்பங்களுக்கு பணியை ஸ்வைப் செய்யவும் அல்லது அழுத்திப் பிடிக்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะงานเพื่อดูประวัติค่าจ้าง ปัดหรือแตะงานค้างไว้เพื่อดูตัวเลือกเพิ่มเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücret geçmişini görmek için bir işe dokunun. Diğer seçenekler için işi kaydırın veya basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться роботи, щоб переглянути історію оплати. Проведіть по ній або утримуйте, щоб побачити інші дії."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنخواہ کی تاریخ دیکھنے کے لیے کسی ملازمت پر ٹیپ کریں۔ مزید اختیارات کے لیے سوائپ کریں یا دبا کر رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào công việc để xem lịch sử lương. Vuốt hoặc nhấn giữ để xem thêm tùy chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按工作查看薪资历史。轻扫或长按工作查看更多选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按工作可查看薪資紀錄。滑動或長按工作可查看更多選項。"
          }
        }
      }
    },
