    "supplements.editorHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements are calculated based on shift times. Changes here apply only to this shift."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg beregnes basert på vaktens tid. Endringer her gjelder kun for denne vakten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge werden basierend auf Schichtzeiten berechnet. Änderungen gelten nur für diese Schicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los suplementos se calculan según el horario del turno. Los cambios aquí aplican solo a este turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments sont calculés en fonction des heures de quart. Les modifications ne s'appliquent qu'à ce quart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補給金はシフト時間に基づいて計算されます。ここでの変更はこのシフトにのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 근무 시간을 기준으로 계산됩니다. 변경 사항은 이 근무에만 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As adições são calculadas com base nos horários dos turnos. As alterações aqui se aplicam apenas a este turno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки рассчитываются на основе времени смены. Изменения применяются только к этой смене."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen worden berekend op basis van diensten. Wijzigingen hier gelden alleen voor deze dienst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg beräknas baserat på skifttider. Ändringar här gäller endast detta skift."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg beregnes ud fra skifttider. Ændringer her gælder kun for dette skift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi sono calcolati in base agli orari del turno. Le modifiche qui si applicano solo a questo turno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisät lasketaan vuoron aikojen perusteella. Tässä tehdyt muutokset koskevat vain tätä vuoroa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki są obliczane na podstawie czasu zmiany. Zmiany tutaj dotyczą tylko tej zmiany."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки розраховуються на основі часу зміни. Зміни тут застосовуються лише до цієї зміни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
