            "state": "translated",
            "value": "Bare to hurtige ting, så er du klar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kaksi nopeaa asiaa, sitten olet sisällä"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
