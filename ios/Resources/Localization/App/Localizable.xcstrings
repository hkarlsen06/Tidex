    "alerts.storageIssue.message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke gemme data til enhedslager. Dine ændringer gemmes ikke, når appen lukkes. Genstarten appen eller kontroller dit enhedslager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten können nicht auf dem Gerät gespeichert werden. Deine Änderungen werden nicht gespeichert, wenn die App geschlossen wird. Starten Sie die App neu oder überprüfen Sie den Gerätespeicher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η αποθήκευση δεδομένων στο χώρο αποθήκευσης της συσκευής. Οι αλλαγές σας δεν θα αποθηκευτούν όταν κλείνει η εφαρμογή. Επανεκκινήστε την εφαρμογή ή ελέγξτε το χώρο αποθήκευσης της συσκευής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save data to device storage. Your changes will not be saved when the app closes. Please restart the app or check your device storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden guardar los datos en el almacenamiento del dispositivo. Los cambios no se guardarán cuando cierres la aplicación. Reinicia la aplicación o verifica el almacenamiento del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietoja ei voi tallentaa laitteen tallennustilaan. Muutoksiasi ei tallenneta, kun sovellus suljetaan. Käynnistä sovellus uudelleen tai tarkista laitteen tallennustila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les données sur le stockage de l'appareil. Vos modifications ne seront pas sauvegardées à la fermeture de l'application. Redémarrez l'application ou vérifiez le stockage de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i dati nell'archivio del dispositivo. Le tue modifiche non verranno salvate quando l'app si chiude. Riavvia l'app o controlla l'archivio del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスストレージにデータを保存できません。アプリを閉じるときに変更が保存されません。アプリを再起動するか、デバイスストレージを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 저장소에 데이터를 저장할 수 없습니다. 앱을 닫을 때 변경 사항이 저장되지 않습니다. 앱을 다시 시작하거나 기기 저장소를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke lagre data til enhetslagring. Endringene dine blir ikke lagret når appen lukkes. Start appen på nytt eller sjekk enhetslagringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan gegevens niet opslaan in apparaatopslag. Uw wijzigingen worden niet opgeslagen wanneer de app sluit. Start de app opnieuw op of controleer uw apparaatopslag."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikkje lagre data til einingslager. Endringane dine blir ikkje lagra når appen lukkar. Start appen på nytt eller sjekk einingslager."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać danych do pamięci urządzenia. Zmiany nie będą zapisane po zamknięciu aplikacji. Uruchom ponownie aplikację lub sprawdź pamięć urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar dados no armazenamento do dispositivo. Suas alterações não serão salvas quando o aplicativo fechar. Reinicie o aplicativo ou verifique o armazenamento do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se pot salva datele în memoria dispozitivului. Modificările tale nu vor fi salvate când se închide aplicația. Repornește aplicația sau verifică memoria dispozitivului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается сохранить данные в хранилище устройства. Ваши изменения не будут сохранены при закрытии приложения. Перезагрузите приложение или проверьте хранилище устройства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte spara data till enhetens lagring. Dina ändringar sparas inte när appen stängs. Starta om appen eller kontrollera enhetens lagring."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกข้อมูลลงในที่จัดเก็บของอุปกรณ์ได้ การเปลี่ยนแปลงของคุณจะไม่ถูกบันทึกเมื่อปิดแอป โปรดเปิดแอปใหม่หรือตรวจสอบที่จัดเก็บของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler cihaz depolama alanına kaydedilemiyor. Uygulama kapandığında değişiklikleriniz kaydedilmeyecektir. Lütfen uygulamayı yeniden başlatın veya cihaz depolama alanınızı kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається зберегти дані у сховище пристрою. Ваші зміни не будуть збережені при закритті програми. Перезавантажте програму або перевірте сховище пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dữ liệu vào bộ nhớ thiết bị. Các thay đổi của bạn sẽ không được lưu khi ứng dụng đóng. Vui lòng khởi động lại ứng dụng hoặc kiểm tra bộ nhớ thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将数据保存到设备存储。应用关闭时更改不会被保存。请重新启动应用或检查您的设备存储。"
          }
        }
      }
    },
