        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu e-mail ou telefone para redefinir sua senha"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange din e-post eller telefonnummer för att återställa ditt lösenord"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din e-mail eller telefonnummer for at nulstille dit password"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä sähköpostiosoitteesi tai puhelinnumerosi salasanan nollaamiseksi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz email lub numer telefonu, aby zresetować hasło"
