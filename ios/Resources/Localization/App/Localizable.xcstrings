        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pause wird zuerst vom Grundlohn abgezogen, dann bei Bedarf vom niedrigsten Zuschlag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το διάλειμμα αφαιρείται πρώτα από τη βασική αμοιβή και μετά, αν χρειάζεται, από το χαμηλότερο επίδομα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The break is deducted from base pay first, then from the lowest supplement if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pausa se descuenta primero del salario base y, si hace falta, del complemento más bajo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paus arvatakse esmalt põhipalgast maha, seejärel vajadusel väikseimast lisatasust."
          }
