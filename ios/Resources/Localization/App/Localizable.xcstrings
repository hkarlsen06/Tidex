    "sharing.confirm.stopSeeingTheirShifts.incomingOnly" : {
      "comment" : "Message in the confirmation for no longer seeing a friend's shifts, when the friend does not see the user's. %@ is the friend's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوف تتوقف عن رؤية نوبات %@ المشتركة. ستتم إزالته من هذه القائمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще спреш да виждаш споделените смени на %@. Те ще бъдат премахнати от този списък."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি %@-এর শেয়ার করা শিফট দেখা বন্ধ করবেন। তাদের এই তালিকা থেকে সরানো হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixaràs de veure els torns compartits de %@. Se suprimiran d'aquesta llista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestanete vidět směny sdílené uživatelem %@. Budou odebráni z tohoto seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stopper med at se de vagter, %@ deler. De bliver fjernet fra denne liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst %@'s geteilte Schichten nicht mehr sehen. Sie werden aus dieser Liste entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σταματήσετε να βλέπετε τις βάρδιες που κοινοποιεί ο/η %@. Θα αφαιρεθεί από αυτή τη λίστα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will stop seeing %@'s shared shifts. They will be removed from this list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejarás de ver los turnos compartidos de %@. Se eliminará de esta lista."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa lõpetad %@ jagatud vahetuste nägemise. Nad eemaldatakse sellest loendist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیگر شیفت‌های اشتراک‌گذاشته‌شدهٔ %@ را نمی‌بینید. آن‌ها از این فهرست حذف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et enää näe käyttäjän %@ jakamia vuoroja. Hänet poistetaan tältä listalta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mo na makikita ang mga shift na ibinabahagi ni %@. Aalisin sila sa listahang ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne verrez plus les shifts partagés par %@. Ils seront retirés de cette liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תפסיק לראות את המשמרות ש-%@ משתף. הם יוסרו מהרשימה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप %@ की साझा की गई शिफ्ट देखना बंद कर देंगे। उन्हें इस सूची से हटा दिया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više nećete vidjeti smjene koje dijeli %@. Bit će uklonjeni s ovog popisa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Többé nem látod %@ megosztott műszakjait. El lesz távolítva erről a listáról."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan berhenti melihat shift yang dibagikan %@. Mereka akan dihapus dari daftar ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú hættir að sjá vaktir sem %@ deilir. Þau verða fjarlægð af þessum lista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetterai di vedere i turni condivisi di %@. Verranno rimossi da questo elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が共有したシフトは表示されなくなります。相手はこのリストから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님이 공유한 근무를 더 이상 볼 수 없습니다. 이 목록에서 삭제됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebematysite %@ bendrinamų pamainų. Jie bus pašalinti iš šio sąrašo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs vairs neredzēsiet %@ kopīgotās maiņas. Viņi tiks noņemti no šī saraksta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du slutter å se vaktene %@ deler. De fjernes fra denne listen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet de gedeelde diensten van %@ niet meer. Ze worden uit deze lijst verwijderd."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil slutte å sjå vaktene %@ deler. Dei blir fjerna frå denne lista."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestaniesz widzieć zmiany udostępnione przez %@. Zostanie usunięty z tej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vai parar de ver os turnos compartilhados por %@. A pessoa será removida desta lista."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu vei mai vedea turele partajate de %@. Va fi eliminat din această listă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы перестанете видеть смены, которыми делится %@. Они будут удалены из этого списка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prestanete vidieť zdieľané zmeny používateľa %@. Bude odstránený z tohto zoznamu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehal(a) boš gledati izmene, ki jih deli %@. Odstranjen(a) bo s tega seznama."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više nećete videti smene koje %@ deli. Biće uklonjeni sa ove liste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommer att sluta se pass %@ delar. De tas bort från listan."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utaacha kuona zamu za %@ walizoshiriki. Wataondolewa kwenye orodha hii."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ பகிரும் பணிப்பகுதிகளை நீங்கள் இனி பார்க்க மாட்டீர்கள். அவர்கள் இந்தப் பட்டியலில் இருந்து அகற்றப்படுவார்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะหยุดดูกะที่ %@ แชร์ และพวกเขาจะถูกลบออกจากรายการนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adlı kişinin paylaştığı vardiyaları görmeyi bırakacaksın. Bu listeden kaldırılacaklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви перестанете бачити зміни, якими ділиться %@. Їх буде видалено з цього списку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ %@ کی شیئر کردہ شفٹیں دیکھنا بند کر دیں گے۔ وہ اس فہرست سے ہٹا دیے جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ ngừng xem ca làm mà %@ chia sẻ. Họ sẽ bị xóa khỏi danh sách này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将停止查看%@共享的班次。他们将从此列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將停止查看%@分享的班次。他們將從此清單移除。"
          }
        }
      }
    },
    "sharing.confirm.stopSeeingTheirShifts.mutual" : {
      "comment" : "Message in the confirmation for no longer seeing a friend's shifts, when sharing goes both ways. %@ is the friend's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوف تتوقف عن رؤية نوبات %@ المشتركة. سيظل بإمكانه رؤية النوبات التي تشاركها معه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще спреш да виждаш споделените смени на %@. Те все още ще могат да виждат смените, които споделяш с тях."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি %@-এর শেয়ার করা শিফট দেখা বন্ধ করবেন। তারা এখনও আপনার সাথে শেয়ার করা শিফট দেখতে পারবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixaràs de veure els torns compartits de %@. Encara poden veure els torns que comparteixes amb ells."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestanete vidět směny sdílené uživatelem %@. Vaše sdílené směny stále uvidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stopper med at se de vagter, %@ deler. De kan stadig se vagter, du deler med dem."
