    "settings.pay.editor.supplementsTariff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements follow the tariff agreement and cannot be changed manually"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg følger tariffavtalen og kan ikke endres manuelt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge folgen dem Tarifvertrag und können nicht manuell geändert werden"
