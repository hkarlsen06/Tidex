    "appearance.calendarContentColor.monochromeDescription" : {
      "comment" : "Description under the black or white calendar color option in the appearance settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض محتوى التقويم بالأسود أو الأبيض حسب المظهر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показвай съдържанието на календара в черно или бяло според изгледа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চেহারা অনুযায়ী ক্যালেন্ডারের বিষয়বস্তু কালো বা সাদায় দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra el contingut del calendari en negre o blanc, segons l'aparença."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit obsah kalendáře černě nebo bíle podle vzhledu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis kalenderindhold i sort eller hvid, afhængigt af udseende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderinhalte je nach Erscheinungsbild in Schwarz oder Weiß anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση περιεχομένων ημερολογίου σε μαύρο ή λευκό, ανάλογα με την εμφάνιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show calendar contents in black or white, depending on appearance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el contenido del calendario en negro o blanco, según la apariencia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva kalendri sisu musta või valgena, olenevalt välimusest."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتوای تقویم را بسته به ظاهر، سیاه یا سفید نشان بده."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä kalenterin sisältö mustana tai valkoisena ulkoasun mukaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipakita ang laman ng kalendaryo sa itim o puti, batay sa hitsura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le contenu du calendrier en noir ou blanc, selon l’apparence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג את תוכן היומן בשחור או בלבן, בהתאם למראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखावट के अनुसार कैलेंडर सामग्री काले या सफेद में दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži sadržaj kalendara crno ili bijelo, ovisno o izgledu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naptár tartalma fekete vagy fehér legyen, a megjelenéstől függően."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan isi kalender dalam hitam atau putih, sesuai tampilan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sýna innihald dagatals í svörtu eða hvítu eftir útliti."
          }
