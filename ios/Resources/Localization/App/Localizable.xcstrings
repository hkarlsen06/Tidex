    "feedback.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعدنا على التحسن بمشاركة آرائك"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогни ни да се подобрим, като споделиш своите мисли"
