    "syncConflicts.intro" : {
      "comment" : "Footer on the sync conflicts screen. Each item is a change made offline that clashed with the server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت مزامنة هذه التغييرات. اختر النسخة التي تريد الاحتفاظ بها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези промени не можаха да се синхронизират. Изберете коя версия да запазите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পরিবর্তনগুলো সিঙ্ক করা যায়নি। কোন সংস্করণটি রাখবেন তা বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut sincronitzar aquests canvis. Tria quina versió vols conservar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto změny se nepodařilo synchronizovat. Vyberte, kterou verzi zachovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse ændringer kunne ikke synkroniseres. Vælg, hvilken version du vil beholde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderungen konnten nicht synchronisiert werden. Wähle, welche Version du behalten möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατός ο συγχρονισμός αυτών των αλλαγών. Επιλέξτε ποια έκδοση θα κρατήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These changes couldn't be synced. Choose which version to keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron sincronizar estos cambios. Elige qué versión conservar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neid muudatusi ei õnnestunud sünkroonida. Vali, milline versioon alles jätta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این تغییرات همگام‌سازی نشدند. انتخاب کنید کدام نسخه حفظ شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitä muutoksia ei voitu synkronoida. Valitse säilytettävä versio."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na-sync ang mga pagbabagong ito. Piliin kung aling bersyon ang pananatilihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces modifications n’ont pas pu être synchronisées. Choisissez la version à conserver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לסנכרן את השינויים האלה. יש לבחור איזו גרסה לשמור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये बदलाव सिंक नहीं हो सके। चुनें कि कौन-सा संस्करण रखना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ove promjene nije bilo moguće sinkronizirati. Odaberite koju verziju želite zadržati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeket a módosításokat nem sikerült szinkronizálni. Válaszd ki, melyik verzió maradjon meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan ini tidak dapat disinkronkan. Pilih versi yang ingin disimpan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
