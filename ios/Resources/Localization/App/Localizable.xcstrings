    "friends.chat.blockConfirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن من إرسال الرسائل، وستُخفى المناوبات المشتركة في كلا الاتجاهين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма да можете да изпращате съобщения, а споделените смени ще бъдат скрити и в двете посоки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি বার্তা পাঠাতে পারবেন না, এবং শেয়ার করা শিফট উভয় দিকেই লুকানো থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podràs enviar missatges i els torns compartits s'ocultaran en ambdues direccions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebudete moci posílat zprávy a sdílené směny se skryjí oběma směry."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke sende beskeder, og delte vagter skjules begge veje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst keine Nachrichten senden, und geteilte Schichten werden in beide Richtungen ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θα μπορείτε να στέλνετε μηνύματα και οι κοινόχρηστες βάρδιες θα κρυφτούν και προς τις δύο κατευθύνσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won't be able to send messages, and shared shifts will be hidden in both directions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podrás enviar mensajes y los turnos compartidos se ocultarán en ambos sentidos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei saa sõnumeid saata ja jagatud vahetused peidetakse mõlemal suunal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیگر نمی‌توانید پیام بفرستید و شیفت‌های اشتراکی در هر دو جهت پنهان می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi lähettää viestejä, ja jaetut vuorot piilotetaan molempiin suuntiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ka na makakapagpadala ng mga mensahe, at itatago ang mga naibahaging shift sa magkabilang panig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez plus envoyer de messages, et les shifts partagés seront masqués dans les deux sens."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא תוכל/י לשלוח הודעות, ומשמרות משותפות יוסתרו לשני הצדדים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप संदेश नहीं भेज पाएंगे, और साझा शिफ्टें दोनों तरफ छिप जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nećete moći slati poruke, a dijeljene smjene bit će skrivene u oba smjera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem tudsz majd üzenetet küldeni, és a megosztott műszakok mindkét irányban rejtve lesznek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak akan bisa mengirim pesan, dan shift yang dibagikan akan disembunyikan di kedua arah."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú getur ekki sent skilaboð og sameiginlegar vaktir verða faldar í báðar áttir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrai inviare messaggi e i turni condivisi saranno nascosti in entrambe le direzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを送れなくなり、共有シフトは双方で非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 보낼 수 없으며, 공유된 근무는 양쪽에서 숨겨집니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negalėsite siųsti žinučių, o bendros pamainos bus paslėptos abiem kryptimis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs nevarēsiet sūtīt ziņas, un koplietotās maiņas būs paslēptas abos virzienos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke sende meldinger, og delte vakter skjules i begge retninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt geen berichten sturen en gedeelde diensten worden in beide richtingen verborgen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikkje sende meldingar, og delte vakter blir skjulte begge vegar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będzie można wysyłać wiadomości, a udostępnione zmiany zostaną ukryte w obu kierunkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não poderá enviar mensagens, e os turnos compartilhados ficarão ocultos para ambos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu vei putea trimite mesaje, iar turele partajate vor fi ascunse în ambele sensuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не сможете отправлять сообщения, а общие смены будут скрыты в обе стороны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebudete môcť posielať správy a zdieľané zmeny budú skryté oboma smermi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne boste mogli pošiljati sporočil, deljene izmene pa bodo skrite v obe smeri."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nećete moći da šaljete poruke, a deljene smene biće skrivene u oba smera."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kommer inte att kunna skicka meddelanden, och delade pass döljs i båda riktningarna."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hutaweza kutuma ujumbe, na zamu zilizoshirikiwa zitafichwa kwa pande zote mbili."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் செய்திகளை அனுப்ப முடியாது, மேலும் பகிரப்பட்ட ஷிப்ட்கள் இரு திசைகளிலும் மறைக்கப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะส่งข้อความไม่ได้ และกะงานที่แชร์จะถูกซ่อนทั้งสองฝ่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaj gönderemezsiniz ve paylaşılan vardiyalar iki yönde de gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не зможете надсилати повідомлення, а спільні зміни буде приховано в обох напрямках."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ پیغامات نہیں بھیج سکیں گے، اور مشترکہ شفٹس دونوں طرف سے چھپی رہیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ không thể gửi tin nhắn và ca làm chung sẽ bị ẩn cho cả hai bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将无法发送消息，双方共享的班次也将被隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將無法傳送訊息，且雙方共享的班次都會被隱藏。"
          }
        }
      }
    },
