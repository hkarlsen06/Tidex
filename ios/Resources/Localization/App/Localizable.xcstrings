    "shifts.excludeConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This date will be excluded from the recurring shift. The shift will no longer appear."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne datoen blir ekskludert fra den faste vakten. Vakten vil ikke lenger vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Datum wird von der wiederkehrenden Schicht ausgeschlossen. Die Schicht wird nicht mehr angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fecha se excluirá del turno recurrente. El turno ya no aparecerá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette date sera exclue du quart récurrent. Le quart n'apparaîtra plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付は繰り返しシフトから除外されます。シフトは表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜는 반복 근무에서 제외됩니다. 근무가 더 이상 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta data será excluída do turno recorrente. O turno não aparecerá mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта дата будет исключена из повторяющейся смены. Смена больше не будет отображаться."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze datum wordt uitgesloten van de terugkerende shift. De shift verschijnt niet meer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta datum kommer att uteslutas från det återkommande skiftet. Skiftet visas inte längre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne dato udelukkes fra det tilbagevendende skift. Skiftet vises ikke længere."
          }
        }
