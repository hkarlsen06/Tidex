          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt alle Wagey-meldingene dine denne måneden. Meldingene tilbakestilles ved starten av neste måned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt al je Wagey-berichten deze maand gebruikt. Berichten worden opnieuw ingesteld aan het begin van volgende maand."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt alle Wagey-meldingane dine denne månaden. Meldingane blir tilbakestilte ved starten av neste månad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystałeś wszystkie wiadomości Wagey w tym miesiącu. Wiadomości zostaną zresetowane na początku następnego miesiąca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou todas as suas mensagens Wagey este mês. As mensagens são redefinidas no início do próximo mês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai folosit toate mesajele Wagey din această lună. Mesajele se resetează la începutul lunii următoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы использовали все сообщения Wagey в этом месяце. Сообщения сбрасываются в начале следующего месяца."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento mesiac ste použili všetky svoje správy Wagey. Správy sa vrátia na začiatok budúceho mesiaca."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabil si vsa Wagey sporočila tega meseca. Sporočila se ponastavi na začetku naslednjega meseca."
