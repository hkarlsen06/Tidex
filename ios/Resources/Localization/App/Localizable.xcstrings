    "screenshotShare.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك تقويمك كصورة مصقولة باستخدام زر المشاركة في شريط الأدوات. يمكنك اختيار إظهار أو إخفاء أرباحك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Споделете календара си като полиран образ с бутона за споделяне в лентата с инструменти. Можете да изберете да показвате или скривате своите приходи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টুলবারের শেয়ার বোতামের সাথে আপনার ক্যালেন্ডার একটি পরিমার্জিত ছবি হিসেবে শেয়ার করুন। আপনি আপনার আয় দেখাতে বা লুকাতে বেছে নিতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparteix el teu calendari com a imatge polida amb el botó de compartir a la barra d'eines. Pots triar mostrar o amagar els teus guanys."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte svůj kalendář jako vyleštěný obrázek pomocí tlačítka sdílení v panelu nástrojů. Můžete si vybrat, zda chcete zobrazit nebo skrýt své příjmy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del din kalender som et poleret billede med delingsknappen i værktøjslinjen. Du kan vælge at vise eller skjule dine indtægter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deinen Kalender als poliertes Bild mit der Schaltfläche „Teilen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιράσου το ημερολόγιό σου ως ένα γυαλισμένο εικόνα με το κουμπί κοινοποίησης στη γραμμή εργαλείων. Μπορείς να επιλέξεις να εμφανίσεις ή να αποκρύψεις τα κέρδη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your calendar as a polished image with the share button in the toolbar. You can choose to show or hide your earnings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu calendario como una imagen pulida con el botón de compartir en la barra de herramientas. Puedes elegir mostrar u ocultar tus ganancias."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga oma kalendrit kaunistatud pildina jagamisnupu abil tööriistariba. Saad valida, kas näidata või peita oma sissetulekud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقویم خود را با دکمه اشتراک‌گذاری در نوار ابزار به‌عنوان یک تصویر پولیش‌شده اشتراک‌گذاری کنید. می‌توانید درآمدهای خود را نمایش یا پنهان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa kalenterisi kiillotettu kuva jakonapilla työkalurivissä. Voit valita, näytetäänkö vai piilotetaanko tulosi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibahagi ang iyong calendar bilang isang polished na larawan gamit ang share button sa toolbar. Maaari mong piliin na ipakita o itago ang iyong kita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez votre calendrier comme une image soignée avec le bouton de partage dans la barre d'outils. Vous pouvez choisir d'afficher ou de masquer vos revenus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתף את הלוח השנתי שלך כתמונה מעוצבת באמצעות כפתור השיתוף בסרגל הכלים. אתה יכול לבחור להציג או להסתיר את הרווחים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टूलबार में शेयर बटन के साथ अपने कैलेंडर को एक पॉलिश की गई इमेज के रूप में साझा करें। आप अपनी आय दिखाने या छिपाने का विकल्प चुन सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podijeli svoj календar kao poliranu sliku s gumbom za dijeljenje u alatnoj traci. Možeš odabrati prikazati ili sakriti svoje zarade."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osztd meg a naptáradat csiszolt képként az eszköztár megosztás gombjával. Kiválaszthatod, hogy megjelenítsd vagy elrejtsd a bevételeidet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan kalender Anda sebagai gambar yang halus dengan tombol bagikan di toolbar. Anda dapat memilih untuk menampilkan atau menyembunyikan penghasilan Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deildu dagatalinu þínu sem glæsilegri mynd með deilingarhnappinum í tækjastikunni. Þú getur valið að sýna eða fela tekjur þínar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi il tuo calendario come un'immagine raffinata con il pulsante di condivisione nella barra degli strumenti. Puoi scegliere di mostrare o nascondere i tuoi guadagni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバーの共有ボタンを使用して、カレンダーを洗練された画像として共有します。収入の表示/非表示を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 버튼을 사용하여 캘린더를 깔끔한 이미지로 공유하세요. 수익 표시 여부를 선택할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bendrinkite savo kalendorių kaip šlifuotą vaizdą naudodami pasidalijimo mygtuką įrankių juostoje. Galite pasirinkti rodyti arba slėpti savo pajamas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalies ar savu kalendāru kā pulētu attēlu, izmantojot koplietošanas pogu rīkjoslā. Varat izvēlēties rādīt vai paslēpt savus ienākumus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del kalenderen din som et polert bilde med deleknappen i verktøylinjen. Du kan velge å vise eller skjule inntektene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del je kalender als een gepolijst beeld met de deelknop in de werkbalk. Je kunt ervoor kiezen om je inkomsten weer te geven of verbergen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del kalenderen din som et polert bilde med deleknappen i verktøylinjen. Du kan velge å vise eller skjule inntektene dine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij swój kalendarz jako dopracowany obraz za pomocą przycisku udostępniania na pasku narzędzi. Możesz wybrać, czy chcesz pokazać czy ukryć swoje zarobki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe seu calendário como uma imagem polida usando o botão de compartilhamento na barra de ferramentas. Você pode escolher mostrar ou ocultar seus ganhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partajați calendarul dvs. ca o imagine lustră cu butonul de partajare din bară de instrumente. Puteți alege să afișați sau să ascundeți câștigurile dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поделитесь своим календарем в виде отполированного изображения с помощью кнопки отправки на панели инструментов. Вы можете выбрать, показывать или скрывать свой заработок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdieľajte svoj kalendár ako vyleštený obrázok pomocou tlačidla zdieľania v paneli nástrojov. Môžete si vybrať, či chcete zobraziť alebo skryť svoje príjmy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deli svoj koledar kot poliran posnetek zaslona z gumbom za deljenje v orodni vrstici. Izbiraš si lahko, ali prikazati ali skriti svoje zaslužke."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делите календар као полиран слику помоћу дугмета за дељење у траци са алатима. Можете одабрати да приказујете или сакријете своју зараду."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela din kalender som en polerad bild med delningsknappen i verktygsfältet. Du kan välja att visa eller dölja dina inkomster."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiriki kalenda yako kama picha iliyoboreshwa kwa kutumia kitufe cha kushiriki katika upau wa zana. Unaweza kuchagua kuonyesha au kuficha mapato yako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கருவிப்பட்டিയில் உள்ள பகிர்வு பொத்தான் மூலம் உங்கள் நாட்காட்டியை ஒரு மெருமெரு படமாக பகிரவும். உங்கள் வருமானத்தைக் காட்ட அல்லது மறைக்க நீங்கள் தேர்வு செய்யலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์ปฏิทินของคุณเป็นภาพที่สวยงามโดยใช้ปุ่มแชร์ในแถบเครื่องมือ คุณสามารถเลือกแสดงหรือซ่อนรายได้ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvimini araç çubuğundaki paylaş düğmesiyle cilalı bir görüntü olarak paylaş. Kazançlarını göstermeyi veya gizlemeyi seçebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділіться своїм календарем як відполірованим зображенням за допомогою кнопки поділитися на панелі інструментів. Ви можете вибрати, показувати чи приховувати свої доходи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے کیلنڈر کو ٹول بار میں شیئر بٹن کے ساتھ ایک صاف ستھرے تصویر کے طور پر شیئر کریں۔ آپ اپنی آمدنی کو دکھانا یا چھپانا منتخب کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ lịch của bạn dưới dạng hình ảnh sáng sủa bằng nút chia sẻ trong thanh công cụ. Bạn có thể chọn hiển thị hoặc ẩn thu nhập của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过工具栏中的分享按钮将您的日历分享为精美图像。您可以选择显示或隐藏您的收入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用工具欄中的分享按鈕將您的日曆分享為精美圖像。您可以選擇顯示或隱藏您的收入。"
          }
        }
      }
    },
