    "paywall.upgrade.message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få ubegrænset måneder, avanceret statistik, Wagey AI og mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Monate, erweiterte Statistiken, Wagey AI und mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε απεριόριστους μήνες, προηγμένα στατιστικά, Wagey AI και πολλά άλλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get unlimited months, advanced statistics, Wagey AI, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén meses ilimitados, estadísticas avanzadas, Wagey AI y más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanki rajoittomat kuukaudet, edistyneet tilastot, Wagey AI ja paljon muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez des mois illimités, des statistiques avancées, Wagey AI, et bien plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni mesi illimitati, statistiche avanzate, Wagey AI e molto altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限の月数、高度な統計、Wagey AI など多くの機能を利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 월수, 고급 통계, Wagey AI 등을 이용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få ubegrensede måneder, avansert statistikk, Wagey AI og mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkte maanden, geavanceerde statistieken, Wagey AI en meer."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Få ubegrensa månader, avansert statistikk, Wagey AI og meir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj nieograniczoną liczbę miesięcy, zaawansowane statystyki, Wagey AI i wiele więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha meses ilimitados, estatísticas avançadas, Wagey AI e muito mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obține luni nelimitate, statistici avansate, Wagey AI și multe altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите неограниченные месяцы, расширенную статистику, Wagey AI и многое другое."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få obegränsat antal månader, avancerad statistik, Wagey AI och mer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับเดือนไม่จำกัด สถิติขั้นสูง Wagey AI และอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız aylar, gelişmiş istatistikler, Wagey AI ve daha fazlasını açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте невмежені місяці, розширену статистику, Wagey AI та ще багато чого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận số tháng không giới hạn, thống kê nâng cao, Wagey AI và nhiều hơn nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得无限月份、高级统计、Wagey AI 等更多功能。"
