    "addShift.startFreshConfirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك مدخلات وردية غير محفوظة. امسحها وابدأ من جديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имате незаписани данни за смяна. Изчистете ги и започнете отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অসংরক্ষিত শিফট ডেটা রয়েছে। সেগুলি সাফ করুন এবং নতুন করে শুরু করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens entrades de torn no desades. Esborra-les i comença de nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte neuložené údaje o směně. Vymažte je a začněte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ugemte vaktdata. Tøm dem og start forfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast ungespeicherte Schichtdaten. Lösche sie und fang von vorne an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε μη αποθηκευμένα δεδομένα βάρδιας. Εκκαθαρίστε τα και ξεκινήστε από την αρχή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have unsaved shift inputs. Clear them and start fresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes entradas de turno sin guardar. Bórralas y comienza de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul on salvestamata vahetuse andmeid. Tühjenda need ja alusta uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما دارای ورودی‌های شیفت ذخیره‌نشده هستید. آنها را پاک کنید و از نو شروع کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla on tallentamattomia vuorojen tietoja. Tyhjennä ne ja aloita alusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mayroon kang unsaved shift inputs. Burahin ang mga ito at magsimula ng bago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des données de quart non enregistrées. Effacez-les et recommencez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך קלטי משמרת שלא נשמרו. נקה אותם והתחל מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास असहेजे गए शिफ्ट इनपुट हैं। उन्हें साफ़ करें और नए सिरे से शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imate nespremljene podatke o smjeni. Očistite ih i počnite iznova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem mentett műszakadataid vannak. Töröld őket, és kezdj előről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memiliki input shift yang belum disimpan. Hapus dan mulai dari awal."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert með ósvista vaktargögn. Hreinsa þau og byrja á nýtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai input di turno non salvati. Cancellali e ricomincia da capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されていないシフト入力があります。クリアして最初からやり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 근무 데이터가 있습니다. 지우고 다시 시작하시겠습니까?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turite neišsaugotų pamainos duomenų. Išvalykite juos ir pradėkite iš naujo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
