    "settings.pay.deleteConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this wage setting?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne lønnssettingen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Lohneinstellung wirklich löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar esta configuración de salario?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce paramètre de salaire ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この賃金設定を削除してもよろしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 급여 설정을 삭제하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que deseja deletar esta configuração de salário?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эту тарифную ставку?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze looninstelling wilt verwijderen?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort denna lönesinställning?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette denne lønindstilling?"
          }
        }
      }
    },
    "settings.pay.deleteConfirmationWithShifts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
