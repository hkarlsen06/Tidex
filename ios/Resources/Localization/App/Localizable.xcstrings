        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 급여 설정을 삭제하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne lønnssettingen?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze looninstelling wilt verwijderen?"
