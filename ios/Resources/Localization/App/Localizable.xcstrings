    "resetPassword.success.emailInstructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your email for a reset link. Check your spam folder too."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk e-posten din for en tilbakestillingslenke. Sjekk også spam-mappen."
