    "security.mfa.unenrollDialog.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer be able to use this app for two-factor authentication."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikke lenger kunne bruke denne appen for to-faktor autentisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können diese App nicht mehr für die Zwei-Faktor-Authentifizierung verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrás usar esta aplicación para la autenticación de dos factores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus utiliser cette app pour l'authentification à 2 facteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリを2要素認証に使用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 이 앱을 2단계 인증에 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não poderá mais usar este app para autenticação de dois fatores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не сможете использовать это приложение для двухфакторной аутентификации."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze app niet langer gebruiken voor tweeledige authenticatie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer inte längre att kunna använda denna app för tvåfaktorsautentisering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikke længere kunne bruge denne app til to-faktor godkendelse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrai più utilizzare questa app per l'autenticazione a due fattori."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi enää käyttää tätä sovellusta kaksivaiheiseen todentamiseen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będziesz już mógł używać tej aplikacji do uwierzytelniania dwuskładnikowego."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви більше не зможете використовувати цей додаток для двофакторної автентифікації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将不再能够使用此应用进行双因素认证。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่สามารถใช้แอปนี้สำหรับการยืนยันตัวตนสองขั้นอีกต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không còn có thể sử dụng ứng dụng này cho xác thực hai yếu tố."
          }
        }
      }
    },
