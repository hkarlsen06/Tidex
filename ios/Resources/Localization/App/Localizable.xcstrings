    "subscription.earlySupporter.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for being with us from the start! You have lifetime access to premium features."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du var med fra starten! Du har livstidstilgang til premium-funksjoner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass Sie von Anfang an dabei waren! Sie haben lebenslangen Zugriff auf Premium-Funktionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d'être avec nous depuis le début ! Vous avez un accès à vie aux fonctionnalités premium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por estar con nosotros desde el principio! Tienes acceso de por vida a las funciones premium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per essere stato con noi fin dall'inizio! Hai accesso illimitato alle funzioni premium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je vanaf het begin bij ons bent! Je hebt levenslange toegang tot premiumfuncties."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por estar conosco desde o início! Você tem acesso vitalício aos recursos premium."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du var med från början! Du har livstidstillgång till premiumfunktioner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak fordi du var med fra starten! Du har livstidstilgang til premium-funktioner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos että olit mukana alusta alkaen! Sinulla on elinikäinen pääsy premium-ominaisuuksiin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękuję za to, że byłeś z nami od początku! Masz dożywotni dostęp do funkcji premium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что были с нами с самого начала! У вас есть пожизненный доступ к премиум-функциям."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо, що були з нами з самого початку! У вас є довічний доступ до преміум-функцій."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初からサポートいただきありがとうございます！プレミアム機能に無期限にアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음부터 함께해주셔서 감사합니다! 프리미엄 기능에 대한 평생 액세스 권한이 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您从一开始就支持我们！您拥有高级功能的终身访问权限。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่อยู่กับเราตั้งแต่เริ่มต้น! คุณมีสิทธิ์เข้าถึงฟีเจอร์พรีเมียมตลอดชีวิต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã ở bên chúng tôi từ đầu! Bạn có quyền truy cập suốt đời vào các tính năng cao cấp."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du var med frå starten! Du har livstidstilgang til premium-funksjonar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başından beri bizimle olduğunuz için teşekkürler! Premium özelliklere ömür boyu erişim hakkınız var."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που ήσασταν μαζί μας από την αρχή! Έχετε πρόσβαση ισόβιο σε λειτουργίες premium."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulțumim că ai fost cu noi de la început! Ai acces pe viață la funcțiile premium."
          }
        }
      }
    },
