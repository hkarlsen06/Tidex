        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de Privacidade do Tidex...\n\nLevamos sua privacidade a sério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика конфиденциальности Tidex...\n\nМы серьезно относимся к вашей приватности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
