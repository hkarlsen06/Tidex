    "wagey.showcase.hero.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj vagter, tjek dine indtjening og få svar på spørgsmål – alt med naturligt sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Schichten hinzu, überprüfe deine Verdienste und erhalte Antworten auf Fragen – alles mit natürlicher Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add shifts, check your earnings, and get answers to questions – all with natural language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade turnos, verifica tus ganancias y obtén respuestas – todo con lenguaje natural."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää vuoroja, tarkista tulosi ja saa vastauksia kysymyksiin – kaikki luonnollisella kielellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des postes, vérifiez vos gains et obtenez des réponses – tout en langage naturel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi turni, controlla i tuoi guadagni e ottieni risposte a domande – tutto con linguaggio naturale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト追加、給与確認、質問への回答–すべて自然言語で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트 추가, 수입 확인, 질문에 대한 답변 받기 – 모두 자연어로 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til vakter, sjekk inntekten din og få svar på spørsmål – alt med naturlig språk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg diensten toe, controleer je inkomsten en krijg antwoorden op vragen – alles met natuurlijke taal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj zmiany, sprawdzaj swoje zarobki i uzyskuj odpowiedzi na pytania – wszystko w języku naturalnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione turnos, verifique seus ganhos e obtenha respostas para perguntas – tudo com linguagem natural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте смены, проверяйте заработки и получайте ответы — все с естественным языком."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till skift, kontrollera dina inkomster och få svar på frågor – allt med naturligt språk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มกะ ตรวจสอบรายได้ และรับคำตอบสำหรับคำถาม ทั้งหมดด้วยภาษาธรรมชาติ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте зміни, перевіряйте свій заробіток і отримуйте відповіді на запитання – все з природною мовою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ca, kiểm tra lợi tức của bạn và nhận câu trả lời cho các câu hỏi – tất cả với ngôn ngữ tự nhiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加班次、查看您的收入并获得问题的答案 – 全部使用自然语言。"
          }
        }
      }
    },
