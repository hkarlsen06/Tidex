    "feedback.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us improve by sharing your thoughts"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp oss å bli bedre ved å dele dine tanker"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf uns besser zu werden, indem du deine Gedanken teilst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez-nous à nous améliorer en partageant vos idées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdanos a mejorar compartiendo tus ideas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiutaci a migliorare condividendo i tuoi pensieri"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp oss å bli bedre ved å dele dine tanker"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude-nos a melhorar compartilhando sua opinião"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp oss att förbättras genom att dela dina tankar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp os med at blive bedre ved at dele dine tanker"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auta meitä parantumaan jakamalla ajatuksesi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż nam się ulepszyć, dzieląc się swoimi myślami"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите нам улучшиться, поделившись своими мыслями"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоможіть нам покращитися, поділившись вашими думками"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見をシェアして改善にご協力ください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 공유하여 개선에 도움을 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
