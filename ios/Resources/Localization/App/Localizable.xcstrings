        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw miesięczny cel przychodu w Ustawieniach, aby śledzić swoje postępy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите ежемесячную цель доходов в Настройках, чтобы отслеживать прогресс."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть місячну ціль доходу в Налаштуваннях, щоб відстежувати прогрес."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で月間収入目標を設定して、進捗を追跡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 월간 수입 목표를 설정하여 진행 상황을 추적하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中设置每月收入目标以跟踪您的进度。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเป้าหมายรายได้รายเดือนในการตั้งค่าเพื่อติดตามความคืบหน้าของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt mục tiêu thu nhập hàng tháng trong Cài đặt để theo dõi tiến độ của bạn."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett et månedlig inntektsmål i Innstillingar for å følgja framgangen din."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemenizi izlemek için Ayarlar'da aylık kazanç hedefi belirleyin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε έναν μηνιαίο στόχο κέρδους στις Ρυθμίσεις για να παρακολουθήσετε την πρόοδό σας."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează un obiectiv lunar de venituri în Setări pentru a-ți urmări progresul."
          }
        }
      }
    },
