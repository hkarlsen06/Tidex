    "sharing.manageDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dine skift med venner og kollegaer saa de kan se, naar du arbejder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie Ihre Schichten mit Freunden und Kollegen, damit sie sehen können, wenn Sie arbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your shifts with friends and colleagues so they can see when you work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tus turnos con amigos y compañeros para que vean cuándo trabajas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa vuorosi ystävien ja kollegoiden kanssa, jotta he näkevät, milloin työskentelet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez vos quarts de travail avec des amis et des collègues pour qu'ils voient quand vous travaillez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi i tuoi turni con amici e colleghi per fargli vedere quando lavori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトを友人や同僚と共有して、いつ働くかを見てもらいましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 및 동료와 근무를 공유하여 언제 일하는지 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del vaktene dine med venner og kolleger slik at de kan følge med på når du jobber."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je shifts met vrienden en collega's zodat zij kunnen zien wanneer je werkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj swoje zmiany znajomym i kolegom, aby mogli zobaczyć, kiedy pracujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seus turnos com amigos e colegas para que vejam quando você trabalha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь своим расписанием со друзьями и коллегами, чтобы они видели, когда вы работаете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela dina pass med vänner och kollegor så de kan se när du arbetar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์กะของคุณกับเพื่อนและเพื่อนร่วมงาน เพื่อให้พวกเขาเห็นว่าคุณทำงานเมื่อไร"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діліться своїми змінами з друзями та колегами, щоб вони бачили, коли ви працюєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ ca làm việc của bạn với bạn bè và đồng nghiệp để họ thấy bạn làm việc khi nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与朋友和同事分享你的班次，让他们看到你的工作时间。"
          }
        }
      }
    },
