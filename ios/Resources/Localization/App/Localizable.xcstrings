    "subscription.earlySupporter.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكراً لك لكونك معنا منذ البداية! لديك إمكانية الوصول مدى الحياة إلى المميزات المتقدمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодаря, че сте с нас от самото начало! Имате целживотен достъп до премиум функции."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুরু থেকেই আমাদের সাথে থাকার জন্য ধন্যবাদ! আপনার প্রিমিয়াম বৈশিষ্ট্যগুলিতে আজীবন অ্যাক্সেস রয়েছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gràcies per estar amb nosaltres des del principi! Tens accés permanent a les funcions premium."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Děkujeme, že jste s námi od začátku! Máte celoživotní přístup k prémiových funkcím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak fordi du var med fra starten! Du har livstidstilgang til premium-funktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke, dass Sie von Anfang an dabei waren! Sie haben lebenslangen Zugriff auf Premium-Funktionen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευχαριστούμε που ήσασταν μαζί μας από την αρχή! Έχετε πρόσβαση ισόβιο σε λειτουργίες premium."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for being with us from the start! You have lifetime access to premium features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gracias por estar con nosotros desde el principio! Tienes acceso de por vida a las funciones premium."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aitäh, et olete meist algusest peale! Teil on eluaegne juurdepääs premium-funktsioonidele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از اینکه از ابتدا با ما هستید، متشکریم! شما دسترسی مادام‌العمر به ویژگی‌های پریمیوم دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiitos että olit mukana alusta alkaen! Sinulla on elinikäinen pääsy premium-ominaisuuksiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salamat sa pagiging kasama namin mula pa noong simula! Mayroon kang lifetime access sa premium features."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci d'être avec nous depuis le début ! Vous avez un accès à vie aux fonctionnalités premium."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תודה שהיית איתנו מהתחלה! יש לך גישה תמידית לתכונות פרימיום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआत से हमारे साथ रहने के लिए धन्यवाद! आपके पास प्रीमियम सुविधाओं तक आजीवन पहुंच है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvala što ste bili s nama od početka! Imate doživotni pristup premium značajkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köszönjük, hogy az elején velem voltál! Élethosszig tartó hozzáférésed van a prémium funkciókhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih telah bersama kami sejak awal! Anda memiliki akses seumur hidup ke fitur premium."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk fyrir að vera með okkur frá upphafi! Þú hefur ótímabundinn aðgang að iðunmerkum aðgerðum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per essere stato con noi fin dall'inizio! Hai accesso illimitato alle funzioni premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初からサポートいただきありがとうございます！プレミアム機能に無期限にアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음부터 함께해주셔서 감사합니다! 프리미엄 기능에 대한 평생 액세스 권한이 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dėkojame, kad buvote su mumis nuo pat pradžios! Turite visą gyvenimą prieigą prie premium funkcijų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paldies, ka bijāt ar mums no paša sākuma! Jums ir mūžīga piekļuve premium funkcijām."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk for at du var med fra starten! Du har livstidstilgang til premium-funksjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
