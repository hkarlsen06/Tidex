    "dashboard.payrollDetails.adjustmentNetManualHelp" : {
      "comment" : "Help text under the net or manual option of a pay adjustment.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضاف المبلغ مباشرةً إلى ما تستلمه. لا تُقدَّر أي ضريبة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавя сумата директно към това, което получавате. Не се изчислява данък."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টাকাটি সরাসরি আপনার প্রাপ্তিতে যোগ হয়। কোনো কর অনুমান করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix l'import directament al que reps. No es calcula cap impost."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přičte částku přímo k tomu, co dostanete. Daň se neodhaduje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lægger beløbet direkte til det, du får udbetalt. Der beregnes ikke skat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addiert den Betrag direkt zu deiner Auszahlung. Es wird keine Steuer geschätzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει το ποσό απευθείας σε όσα λαμβάνετε. Δεν υπολογίζεται φόρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the amount directly to what you receive. No tax is estimated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma el importe directamente a lo que recibes. No se estima impuesto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisab summa otse väljamaksele. Maksu ei hinnata."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مبلغ را مستقیم به دریافتی شما اضافه می‌کند. مالیات برآورد نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää summan suoraan saamaasi määrään. Veroa ei arvioida."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktang idinadagdag ang halaga sa matatanggap mo. Walang tinatayang buwis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute directement le montant à votre paiement. Aucun impôt n’est estimé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף את הסכום ישירות למה שתקבל. לא מחושב מס משוער."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राशि सीधे आपकी प्राप्ति में जोड़ता है। कर का अनुमान नहीं लगाया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje iznos izravno onome što primate. Porez se ne procjenjuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összeget közvetlenül hozzáadja a kifizetéshez. Nem becsül adót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan jumlah langsung ke yang Anda terima. Tidak ada perkiraan pajak."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bætir upphæðinni beint við það sem þú færð greitt. Enginn skattur er áætlaður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge l'importo direttamente a quanto ricevi. Nessuna tassa stimata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受取額に直接加算します。税額は見積もりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실수령액에 직접 추가됩니다. 세금은 추정되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma pridedama tiesiai prie išmokamos sumos. Mokesčiai neapskaičiuojami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskaita summu tieši saņemtajai summai. Nodoklis netiek aprēķināts."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger beløpet direkte til det du får utbetalt. Skatt beregnes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt het bedrag direct toe aan wat je ontvangt. Er wordt geen belasting geschat."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg beløpet direkte til det du får utbetalt. Skatt blir ikkje rekna ut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje kwotę bezpośrednio do wypłaty. Podatek nie jest szacowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona o valor diretamente ao que você recebe. Nenhum imposto é estimado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă suma direct la ce primești. Nu se estimează impozit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумма добавляется прямо к выплате. Налог не оценивается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripočíta sumu priamo k tomu, čo dostanete. Daň sa neodhadne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znesek se doda neposredno k izplačilu. Davek se ne oceni."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje iznos direktno na ono što primate. Porez se ne procenjuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger beloppet direkt till det du får utbetalt. Ingen skatt beräknas."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huongeza kiasi moja kwa moja kwenye unachopokea. Hakuna kodi inayokadiriwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொகை நேரடியாக நீங்கள் பெறுவதில் சேர்க்கப்படும். வரி கணிக்கப்படாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มจำนวนเงินเข้าในยอดที่คุณได้รับโดยตรง ไม่มีการประเมินภาษี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutarı doğrudan elinize geçene ekler. Vergi tahmin edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає суму прямо до вашої виплати. Податок не оцінюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رقم براہِ راست آپ کی وصولی میں شامل ہوتی ہے۔ ٹیکس کا اندازہ نہیں لگایا جاتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cộng trực tiếp số tiền vào khoản bạn nhận. Không ước tính thuế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金额直接计入实发。不会估算税额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額直接加到實領金額，不估算稅額。"
          }
        }
      }
    },
