    "monthLimit.deleteExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add shifts in %@, shifts in %@ must be deleted."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til vakter i %@, må vaktene i %@ slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Vakten in %@ hinzuzufügen, müssen Vakten in %@ gelöscht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter des vagues en %@, les vagues en %@ doivent être supprimées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir vacaciónes en %@, se deben eliminar las vacaciónes en %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere turni in %@, i turni in %@ devono essere eliminati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til vakter i %@, må vaktene i %@ slettes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar vácuas em %@, as vácuas em %@ devem ser deletadas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att lägga till vakter i %@, måste vakter i %@ tas bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tilføje vakter i %@, skal vakter i %@ slettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktoja lisätäksesi kuussa %@, vakat kuukaudessa %@ on poistettava."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać zmiany w %@, zmiany w %@ muszą być usunięte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить смены в %@, смены в %@ должны быть удалены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб додати зміни в %@, необхідно видалити зміни в %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のシフトを追加するには、%@のシフトを削除する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이동을 추가하려면 %@의 이동을 삭제해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在 %@ 中添加班次，必须删除 %@ 中的班次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเพิ่มกะใน %@ จะต้องลบกะใน %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thêm ca làm việc trong %@, phải xóa các ca làm việc trong %@."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til vakter i %@, må vaktene i %@ slettast."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içine vardiya eklemek için %@ içindeki vardiyalar silinmelidir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να προσθέσετε βάρδιες στο %@, οι βάρδιες στο %@ πρέπει να διαγραφούν."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a adăuga schimburi în %@, schimburile din %@ trebuie șterse."
          }
        }
      }
    },
