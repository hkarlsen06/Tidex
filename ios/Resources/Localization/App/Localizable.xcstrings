          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取るには、設定アプリで有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 설정 앱에서 활성화하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative-as no app de Configurações"
          }
        },
