    "Tests verify offline sync functionality according to Phase 8 test plan.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testene verifiserer offline synkroniseringsfunksjonalitet i henhold til fase 8-testplanen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests überprüfen die Offline-Synchronisierungsfunktionalität gemäß Phase-8-Testplan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tests vérifient la fonctionnalité de synchronisation hors ligne conformément au plan de test de la phase 8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pruebas verifican la funcionalidad de sincronización sin conexión según el plan de prueba de la Fase 8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I test verificano la funzionalità di sincronizzazione offline secondo il piano di test della Fase 8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verifiëren offline synchronisatiefunctionaliteit volgens het testplan van fase 8."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os testes verificam a funcionalidade de sincronização offline de acordo com o plano de testes da Fase 8."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testerna verifierar offline-synkroniseringsfunktionalitet enligt testplanen för fas 8."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verificerer offline synkroniseringsfunktionalitet i henhold til fase 8-testplanen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testit varmistavat offline-synkronointitoiminnon vaiheen 8 testsuunnitelman mukaisesti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testy weryfikują funkcjonalność synchronizacji offline zgodnie z planem testów fazy 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тесты проверяют функциональность автономной синхронизации в соответствии с планом тестирования этапа 8."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тести перевіряють функціональність автономної синхронізації відповідно до плану тестування фази 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストはフェーズ8テスト計画に従ったオフラインシンク機能を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트는 8단계 테스트 계획에 따른 오프라인 동기화 기능을 검증합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试验证了根据第8阶段测试计划的离线同步功能。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทดสอบตรวจสอบฟังก์ชันการซิงค์แบบออฟไลน์ตามแผนการทดสอบเฟส 8"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài kiểm tra xác minh chức năng đồng bộ hóa ngoại tuyến theo kế hoạch kiểm tra Giai đoạn 8."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Testene verifiserer offline synkroniseringsfunksjonalitet i henhold til fase 8-testplanen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testler, Faz 8 test planına göre çevrimdışı senkronizasyon işlevselliğini doğrular."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δοκιμές επαληθεύουν τη λειτουργία σύγχρονης εργασίας χωρίς σύνδεση σύμφωνα με το σχέδιο δοκιμής Φάσης 8."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Testele verifică funcționalitatea de sincronizare offline în conformitate cu planul de testare din faza 8."
          }
        }
      }
    },
