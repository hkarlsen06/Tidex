    "friends.chat.composer.safetyFilter" : {
      "comment" : "Error in the chat composer when a message is blocked by the content filter and is not sent.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرسال هذه الرسالة لأنها تحتوي على محتوى محظور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
