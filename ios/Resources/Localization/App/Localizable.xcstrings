          "stringUnit": {
            "state": "translated",
            "value": "Vilkårene våre har blitt oppdatert siden du sist godtok dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onze voorwaarden zijn bijgewerkt sinds je ze voor het laatst hebt geaccepteerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasze warunki zostały zaktualizowane od ostatniej akceptacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nossos termos foram atualizados desde sua última aceitação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наши условия были обновлены с момента вашего последнего согласия"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Våra villkor har uppdaterats sedan du senast godkände dem"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เงื่อนไขของเราได้รับการอัปเดตตั้งแต่คุณยอมรับครั้งสุดท้าย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наші умови оновлені з моменту вашого останнього прийняття"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các điều khoản của chúng tôi đã được cập nhật kể từ lần cuối bạn chấp nhận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们的条款自您上次接受后已更新"
          }
        }
      }
    },
    "acceptTerms.updated.explanation": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har opdateret vores servicevilkår og privatlivspolitik. Gennemse ændringerne og accepter de nye vilkår for at fortsætte med at bruge Tidex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben unsere Nutzungsbedingungen und Datenschutzrichtlinie aktualisiert. Bitte überprüfen Sie die Änderungen und akzeptieren Sie die neuen Bedingungen, um Tidex weiterhin zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have updated our Terms of Service and Privacy Policy. Please review the changes and accept the new terms to continue using Tidex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos actualizado nuestros Términos de Servicio y Política de Privacidad. Revisa los cambios y acepta los nuevos términos para continuar usando Tidex."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olemme päivittäneet palveluehdot ja tietosuojakäytäntöä. Tarkista muutokset ja hyväksy uudet ehdot jatkaaksesi Tidexin käyttöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons mis à jour nos Conditions d'utilisation et notre Politique de confidentialité. Veuillez examiner les modifications et accepter les nouvelles conditions pour continuer à utiliser Tidex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo aggiornato i nostri Termini di servizio e l'Informativa sulla privacy. Rivedi le modifiche e accetta i nuovi termini per continuare a usare Tidex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約とプライバシーポリシーが更新されました。変更内容を確認し、新しい利用規約に同意してTidexの使用を続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이용약관 및 개인정보처리방침이 업데이트되었습니다. 변경사항을 검토한 후 새 약관에 동의하여 Tidex를 계속 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har oppdatert våre vilkår for bruk og personvernerklæring. Vennligst les gjennom endringene og godta de nye vilkårene for å fortsette å bruke Tidex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben onze Servicevoorwaarden en ons Privacybeleid bijgewerkt. Controleer de wijzigingen en accepteer de nieuwe voorwaarden om Tidex te blijven gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizowaliśmy nasze Warunki usługi i Politykę prywatności. Przejrzyj zmiany i zaakceptuj nowe warunki, aby kontynuować korzystanie z Tidex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizamos nossos Termos de Serviço e Política de Privacidade. Revise as alterações e aceite os novos termos para continuar usando o Tidex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы обновили наши Условия обслуживания и Политику конфиденциальности. Пожалуйста, проверьте изменения и примите новые условия для продолжения использования Tidex."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har uppdaterat våra användarvillkor och sekretesspolicy. Granska ändringarna och acceptera de nya villkoren för att fortsätta använda Tidex."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราได้อัปเดตข้อกำหนดการให้บริการและนโยบายความเป็นส่วนตัว โปรดตรวจสอบการเปลี่ยนแปลงและยอมรับเงื่อนไขใหม่เพื่อใช้ Tidex ต่อไป"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми оновили наші Умови обслуговування та Політику конфіденційності. Будь ласка, перегляньте зміни і прийміть нові умови, щоб продовжити використання Tidex."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã cập nhật Điều khoản Dịch vụ và Chính sách Bảo mật. Vui lòng xem xét các thay đổi và chấp nhận các điều khoản mới để tiếp tục sử dụng Tidex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已更新服务条款和隐私政策。请查看更改并接受新条款以继续使用 Tidex。"
          }
        }
      }
    },
