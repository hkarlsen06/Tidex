    "sharing.addFriend.sharesRightAwayWithEarnings" : {
      "comment" : "Note under the add friend form when Show earnings is on. Adding a friend starts sharing your shifts and earnings immediately, with no request step.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشخص الذي تضيفه يرى نوبات عملك وأرباحك فورًا. يمكنك إيقاف المشاركة في أي وقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Човекът, когото добавите, веднага вижда смените и приходите ви. Можете да спрете споделянето по всяко време."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যাকে যোগ করবেন, তিনি আপনার শিফট ও উপার্জন সঙ্গে সঙ্গেই দেখতে পাবেন। যেকোনো সময় শেয়ার করা বন্ধ করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona que afegeixis veurà els teus torns i els teus ingressos de seguida. Pots deixar de compartir-ho en qualsevol moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba, kterou přidáte, uvidí vaše směny a výdělky okamžitě. Sdílení můžete kdykoli zastavit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den person, du tilføjer, kan se dine vagter og din indtjening med det samme. Du kan stoppe delingen når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person, die du hinzufügst, sieht deine Schichten und Einnahmen sofort. Du kannst die Freigabe jederzeit beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άτομο που προσθέτεις βλέπει αμέσως τις βάρδιες και τις αποδοχές σου. Μπορείς να διακόψεις την κοινοποίηση ανά πάσα στιγμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person you add sees your shifts and earnings right away. You can stop sharing at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona que añadas verá tus turnos e ingresos de inmediato. Puedes dejar de compartirlos en cualquier momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inimene, kelle lisad, näeb su vahetusi ja teenistust kohe. Jagamise saad igal ajal lõpetada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فردی که اضافه می‌کنید، شیفت‌ها و درآمد شما را بلافاصله می‌بیند. هر زمان بخواهید می‌توانید اشتراک‌گذاری را متوقف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilö, jonka lisäät, näkee työvuorosi ja ansiosi heti. Voit lopettaa jakamisen milloin tahansa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makikita agad ng taong idinadagdag mo ang mga shift at kinikita mo. Maaari mong ihinto ang pagbabahagi anumang oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne que vous ajoutez voit immédiatement vos shifts et vos revenus. Vous pouvez arrêter le partage à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האדם שתוסיף יראה מיד את המשמרות ואת ההכנסות שלך. אפשר להפסיק את השיתוף בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस व्यक्ति को आप जोड़ते हैं, वह आपकी शिफ्टें और कमाई तुरंत देख सकता है। आप कभी भी शेयर करना बंद कर सकते हैं।"
