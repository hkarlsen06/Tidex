    "settings.pay.manage_jobs.active_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بأرشفة أماكن العمل القديمة هنا. لا يمكن أرشفة مكان العمل الافتراضي وآخر مكان عمل نشط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивирайте старите работни места тук. Работното място по подразбиране и последното активно работно място не могат да бъдат архивирани."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরানো কর্মক্ষেত্র এখানে সংরক্ষণ করুন। ডিফল্ট এবং সর্বশেষ সক্রিয় কর্মক্ষেত্র সংরক্ষণ করা যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arxiva els llocs de treball antics aquí. El lloc de treball per defecte i l'últim actiu no es poden arxivar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde archivujte stará pracovní místa. Výchozí a poslední aktivní pracovní místo nelze archivovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiver gamle arbejdspladser her. Standard og sidste aktive arbejdsplads kan ikke arkiveres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivieren Sie alte Arbeitsstellen hier. Standardarbeitsstelle und zuletzt aktive Arbeitsstelle können nicht archiviert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχειοθετήστε παλιούς χώρους εργασίας εδώ. Ο προεπιλεγμένος και ο τελευταίος ενεργός χώρος εργασίας δεν μπορούν να αρχειοθετηθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive old workplaces here. Default and last active workplace cannot be archived."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva lugares de trabajo antiguos aquí. El lugar de trabajo predeterminado y el último activo no se pueden archivar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiveeri vanad töökohad siin. Vaikimisi ja viimati aktiivset töökohta ei saa arhiveerida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محل‌های کار قدیمی را در اینجا بایگانی کنید. محل کار پیش‌فرض و آخرین محل کار فعال نمی‌تواند بایگانی شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkistoi vanhat työpaikat täältä. Oletusarvoista ja viimeksi aktiivista työpaikkaa ei voi arkistoida."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-archive ang lumang mga lugar ng trabaho dito. Ang default at huling aktibong lugar ng trabaho ay hindi maaaring i-archive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivez les anciens lieux de travail ici. Le lieu de travail par défaut et le dernier lieu de travail actif ne peuvent pas être archivés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ארכיון מקומות עבודה ישנים כאן. לא ניתן לארכיון מקום עבודה ברירת המחדל והאחרון הפעיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुराने कार्यस्थलों को यहां संग्रहीत करें। डिफ़ॉल्ट और अंतिम सक्रिय कार्यस्थल को संग्रहीत नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivirajte stara mjesta rada ovdje. Zadanu i zadnju aktivnu radnju nije moguće arhivirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiválj régi munkahelyeket itt. Az alapértelmezett és az utoljára aktív munkahely nem archiválható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arsipkan tempat kerja lama di sini. Tempat kerja default dan terakhir aktif tidak dapat diarsipkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settu gömul vinnustöðvar inn í skjalasafn hér. Ekki er hægt að setja sjálfgefna og síðast virka vinnustaði inn í skjalasafn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia i vecchi luoghi di lavoro qui. Il luogo di lavoro predefinito e l'ultimo attivo non possono essere archiviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い職場をここでアーカイブしてください。デフォルトおよび最後にアクティブだった職場はアーカイブできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 이전 직장을 보관합니다. 기본 및 마지막 활성 직장은 보관할 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archyvuokite senas darbo vietas čia. Numatytoji ir paskutinė aktyvi darbo vieta negali būti archyvuota."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivējiet vecās darbavietas šeit. Noklusējuma un pēdējā aktīvā darbavieta nevar tikt arhivēta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiver gamle arbeidsplasser her. Standard og siste aktive arbeidsplass kan ikke arkiveres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiveer oude werkpleken hier. Standaard en laatst actieve werkplek kunnen niet worden gearchiveerd."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiver gamle arbeidsplassar her. Standard og siste aktive arbeidsplass kan ikkje arkiverast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwizuj stare miejsca pracy tutaj. Domyślne i ostatnio aktywne miejsce pracy nie można archiwizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquive locais de trabalho antigos aqui. O local padrão e o último ativo não podem ser arquivados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivează aici locurile de muncă vechi. Locul de muncă implicit și cel mai recent activ nu pot fi arhivate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивируйте старые рабочие места здесь. Стандартное и последнее активное рабочее место невозможно архивировать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivujte staré pracoviská tu. Predvolené a posledné aktívne pracovisko nemôžu byť archivované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiviraj stara delovna mesta. Privzetega in zadnje aktivnega delovnega mesta ni mogoče arhivirati."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiviraj stara radna mesta ovde. Podrazumevano i poslednje aktivno radno mesto ne mogu biti arhivirana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivera gamla arbetsplatser här. Standardarbetsplats och senast aktiv arbetsplats kan inte arkiveras."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hifadhi maeneo ya kazi ya zamani hapa. Mahali pa kazi chaguo-msingi na la mwisho linalotumika haliwezi kuhifadhiwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பழைய பணியிடங்களை இங்கே காப்பகப்படுத்தவும். இயல்பு மற்றும் கடைசி செயல்பாட்டில் உள்ள பணியிடம் காப்பகப்படுத்த முடியாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บสถานที่ทำงานเก่าไว้ที่นี่ สถานที่ทำงานเริ่มต้นและสถานที่ทำงานที่ใช้งานล่าสุดไม่สามารถเก็บได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski çalışma yerlerini buraya arşivleyin. Varsayılan ve son aktif çalışma yeri arşivlenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архівуйте старі робочі місця тут. Стандартне та останнє активне робоче місце не можуть бути архівовані."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرانی کام کی جگہوں کو یہاں محفوظ کریں۔ ڈیفالٹ اور آخری فعال کام کی جگہ محفوظ نہیں کی جا سکتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu trữ các nơi làm việc cũ tại đây. Nơi làm việc mặc định và nơi làm việc cuối cùng đang hoạt động không thể được lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此存档旧工作地点。默认和最后活跃的工作地点无法存档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此存檔舊工作地點。預設和最後活躍的工作地點無法存檔。"
          }
        }
      }
    },
