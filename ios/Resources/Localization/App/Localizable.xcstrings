            "value": "Google-kirjautumista ei voitu aloittaa. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la connexion Google. Veuillez réessayer plus tard."
          }
        },
