        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите удалить эту повторяющуюся смену? Все будущие смены будут удалены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste si istí, že chcete odstrániť túto opakujúcu sa zmenu? Všetky budúce zmeny budú odstránené."
