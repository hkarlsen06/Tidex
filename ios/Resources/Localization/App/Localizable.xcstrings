    "supplements.editorHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حساب الملحقات بناءً على أوقات الوردية. التغييرات هنا تنطبق فقط على هذه الوردية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавките се изчисляват на базата на времето на смяната. Промените тук се отнасят само за тази смяна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাপ্লিমেন্ট শিফট সময়ের উপর ভিত্তি করে গণনা করা হয়। এখানে পরিবর্তন শুধুমাত্র এই শিফটের জন্য প্রযোজ্য।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els suplements es calculen segons les hores del torn. Els canvis aquí s'apliquen només a aquest torn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příplatky se počítají na základě času směny. Změny zde se vztahují pouze na tuto směnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillæg beregnes baseret på vaktens tidspunkt. Ændringer her gælder kun for denne vagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuschläge werden basierend auf Schichtzeiten berechnet. Änderungen gelten nur für diese Schicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα συμπληρώματα υπολογίζονται με βάση τα χρονικά όρια της βάρδιας. Οι αλλαγές εδώ ισχύουν μόνο για αυτήν τη βάρδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supplements are calculated based on shift times. Changes here apply only to this shift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los suplementos se calculan según el horario del turno. Los cambios aquí aplican solo a este turno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisatasud arvutatakse vahetuse aja põhjal. Siin tehtud muudatused kehtivad ainult sellele vahetusele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افزودنی‌ها بر اساس زمان شیفت محاسبه می‌شوند. تغییرات در اینجا فقط برای این شیفت اعمال می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisät lasketaan vuoron aikojen perusteella. Tässä tehdyt muutokset koskevat vain tätä vuoroa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga supplement ay kinakalkula batay sa oras ng shift. Ang mga pagbabago dito ay naaangkop lamang sa shift na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suppléments sont calculés en fonction des heures de travail. Les modifications ici s'appliquent uniquement à ce quart."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוספות מחושבות על בסיס זמני משמרת. שינויים כאן חלים רק על משמרת זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुपूरक शिफ्ट के समय के आधार पर गणना की जाती है। यहाँ किए गए परिवर्तन केवल इस शिफ्ट पर लागू होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaci se izračunavaju na temelju vremena smjene. Promjene ovdje primjenjuju se samo na ovu smjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pótlékok a műszak időpontja alapján kerülnek kiszámításra. Az itt végrehajtott módosítások csak erre a műszakra érvényesek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suplemen dihitung berdasarkan waktu shift. Perubahan di sini hanya berlaku untuk shift ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viðbætur eru reiknaðar út frá vaktartímum. Breytingar hér gilda aðeins fyrir þessa vakt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I supplementi vengono calcolati in base all'orario del turno. Le modifiche qui si applicano solo a questo turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補足はシフト時間に基づいて計算されます。ここでの変更はこのシフトにのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수당은 근무 시간을 기준으로 계산됩니다. 여기서의 변경사항은 이 근무에만 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priedai skaičiuojami pagal pamainų laiką. Čia atliekami pakeitimai taikomi tik šiai pamamai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piedevas tiek aprēķinātas uz pamata maiņas laika. Izmaiņas šeit attiecas tikai uz šo maiņu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillegg beregnes basert på vaktens tid. Endringer her gjelder kun for denne vakten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supplements worden berekend op basis van vachttijden. Wijzigingen hier gelden alleen voor deze vacht."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillegg beregnes basert på vaktens tid. Endringer her gjelder kun for denne vakten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatki obliczane są na podstawie czasu zmiany. Zmiany tutaj dotyczą tylko tej zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os suplementos são calculados com base no horário do turno. As alterações aqui se aplicam apenas a este turno."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suplimentele se calculează pe baza orelor schimbului. Modificările aici se aplică doar acestui schimb."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавки рассчитываются на основе времени смены. Изменения здесь применяются только к этой смене."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doplnky sa počítajú na základe času zmeny. Zmeny tu sa vzťahujú len na túto zmenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pribibitki se izračunajo glede na čase izmene. Spremembe tukaj veljajo samo za to izmeno."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaci se obračunavaju na osnovu vremena smene. Izmene ovde važe samo za ovu smenu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillägg beräknas baserat på skifttider. Ändringar här gäller endast för detta skift."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziada inakokotwa kulingana na muda wa zamu. Mabadiliko hapa yanatumika kwa ziada hii tu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிரபூரணங்கள் ஷிஃப்ட் நேரத்தின் அடிப்படையில் கணக்கிடப்படுகின்றன. இங்கே செய்த மாற்றங்கள் இந்த ஷிஃப்டுக்கு மட்டுமே பொருந்தும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนเสริมคำนวณจากเวลากะ การเปลี่ยนแปลงที่นี่ใช้ได้เฉพาะกะนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekler vardiya saatlerine göre hesaplanır. Buradaki değişiklikler yalnızca bu vardiyaya uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавки розраховуються на основі часу зміни. Зміни тут стосуються лише цієї зміни."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضافیوں کا حساب شفٹ کے اوقات کی بنیاد پر لگایا جاتا ہے۔ یہاں تبدیلیاں صرف اس شفٹ پر لاگو ہوتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ cấp được tính dựa trên thời gian ca làm việc. Những thay đổi ở đây chỉ áp dụng cho ca này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "补充根据班次时间计算。此处的更改仅适用于此班次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補助根據班次時間計算。此處的變更僅適用於此班次。"
          }
        }
      }
    },
