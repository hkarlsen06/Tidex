    "settings.pay.editor.editImpact" : {
      "comment" : "Explanation at the top of the edit wage entry sheet about what a correction changes.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تصحيح هذه الفترة إلى إعادة حساب الورديات والدفعات التي تعتمد عليها. بالنسبة لشروط الأجر الجديدة، أضف تغييرًا بدلًا من ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При коригиране на този период се преизчисляват смените и плащанията, свързани с него. За нови условия за заплащане вместо това добавете промяна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সময়কাল সংশোধন করলে এটি ব্যবহার করা শিফট ও পেমেন্টের হিসাব পুনরায় করা হবে। নতুন বেতন-শর্ত হলে পরিবর্তন যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En corregir aquest període, es recalculen els torns i els pagaments que en depenen. Si tens noves condicions salarials, afegeix un canvi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprava tohoto období znovu přepočítá směny a výplaty, které ho využívají. Pro nové mzdové podmínky místo toho přidejte změnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du retter denne periode, genberegnes de vagter og udbetalinger, der bruger den. Tilføj i stedet en ændring, hvis du har nye lønvilkår."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Korrektur dieses Zeitraums werden die darauf basierenden Schichten und Auszahlungen neu berechnet. Bei neuen Vergütungsbedingungen füge stattdessen eine Änderung hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διόρθωση αυτής της περιόδου επανυπολογίζει τις βάρδιες και τις πληρωμές που τη χρησιμοποιούν. Για νέους όρους αμοιβής, προσθέστε μια αλλαγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correcting this period recalculates the shifts and payouts that use it. For new pay terms, add a change instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregir este período recalcula los turnos y pagos que lo utilizan. Para nuevas condiciones salariales, añada un cambio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle perioodi korrigeerimisel arvutatakse seda kasutavad vahetused ja väljamaksed uuesti. Uute palgatingimuste korral lisa selle asemel muudatus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصلاح این دوره، شیفت‌ها و پرداخت‌هایی را که از آن استفاده می‌کنند دوباره محاسبه می‌کند. برای شرایط پرداخت جدید، به‌جای آن یک تغییر اضافه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän jakson korjaaminen laskee sitä käyttävät työvuorot ja maksut uudelleen. Jos palkkaehtosi ovat muuttuneet, lisää sen sijaan muutos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pagwawasto sa panahong ito ay muling kakalkula sa mga shift at bayad na nakabatay rito. Para sa mga bagong tuntunin sa sahod, magdagdag na lang ng pagbabago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La correction de cette période recalcule les shifts et les paiements qui s’y réfèrent. Pour de nouvelles conditions de rémunération, ajoutez plutôt une modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיקון תקופה זו יוביל לחישוב מחדש של המשמרות והתשלומים המשתמשים בה. אם מדובר בתנאי שכר חדשים, הוסיפו שינוי במקום זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस अवधि को सही करने पर इसका उपयोग करने वाली शिफ्ट और भुगतान फिर से गणना किए जाएंगे। नई वेतन शर्तों के लिए इसके बजाय बदलाव जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispravljanjem ovog razdoblja ponovno se izračunavaju smjene i isplate koje ga koriste. Za nove uvjete plaće umjesto toga dodajte promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen időszak javítása újraszámolja az azt használó műszakokat és kifizetéseket. Új bérezési feltételek esetén inkább adj hozzá módosítást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengoreksi periode ini akan menghitung ulang shift dan pembayaran yang menggunakannya. Untuk ketentuan gaji baru, tambahkan perubahan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú leiðréttir þetta tímabil eru vaktir og útborganir sem nota það endurreiknaðar. Fyrir ný launakjör skaltu bæta við breytingu í staðinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La correzione di questo periodo ricalcola i turni e i pagamenti che lo utilizzano. Per nuove condizioni retributive, aggiungi invece una modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間を修正すると、それを使用する勤務と支給額が再計算されます。新しい給与条件には、代わりに変更を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간을 수정하면 해당 기간을 사용하는 근무와 지급액이 다시 계산됩니다. 새 급여 조건이라면 대신 변경 사항을 추가하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ištaisius šį laikotarpį, iš naujo apskaičiuojamos jį naudojančios pamainos ir išmokos. Jei turite naujas atlygio sąlygas, pridėkite pakeitimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī perioda labošana pārrēķinās maiņas un izmaksas, kurās tas tiek izmantots. Jauniem samaksas nosacījumiem tā vietā pievieno izmaiņas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du korrigerer denne perioden, beregnes vaktene og utbetalingene som bruker den på nytt. Legg til en endring hvis du har fått nye lønnsvilkår."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je deze periode corrigeert, worden de diensten en uitbetalingen die hiervan gebruikmaken opnieuw berekend. Voeg voor nieuwe loonvoorwaarden een wijziging toe."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du korrigerer denne perioden, blir vaktene og utbetalingane for perioden rekna ut på nytt. For nye lønnsvilkår kan du heller leggje til ei endring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skorygowanie tego okresu spowoduje ponowne przeliczenie zmian i wypłat, które z niego korzystają. W przypadku nowych warunków wynagrodzenia dodaj zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigir este período recalcula os turnos e pagamentos que o utilizam. Para novos termos salariais, adicione uma alteração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corectarea acestei perioade recalculează turele și plățile care o folosesc. Pentru noi condiții salariale, adaugă în schimb o modificare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправление этого периода приведёт к перерасчёту смен и выплат, в которых он используется. Если у вас новые условия оплаты, вместо этого добавьте изменение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprava tohto obdobia prepočíta pracovné zmeny a výplaty, ktoré z neho vychádzajú. Ak máte nové mzdové podmienky, namiesto toho pridajte zmenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popravek tega obdobja znova izračuna izmene in izplačila, ki temeljijo na njem. Če imate nove pogoje plačila, raje dodajte spremembo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispravkom ovog perioda ponovo će se izračunati smene i isplate koje ga koriste. Za nove uslove zarade dodajte promenu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du korrigerar den här perioden beräknas passen och utbetalningarna som använder den om. Lägg i stället till en ändring för nya lönevillkor."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusahihisha kipindi hiki kutahesabu upya zamu na malipo yanayokitumia. Kwa masharti mapya ya malipo, ongeza mabadiliko badala yake."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் காலத்தைச் சரிசெய்தால், அதைப் பயன்படுத்தும் ஷிப்ட்களும் கொடுப்பனவுகளும் மறுகணக்கிடப்படும். புதிய ஊதிய விதிமுறைகளுக்கு, அதற்குப் பதிலாக ஒரு மாற்றத்தைச் சேர்க்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแก้ไขช่วงเวลานี้จะคำนวณกะและการจ่ายเงินที่ใช้ช่วงเวลานี้ใหม่ หากเป็นเงื่อนไขค่าจ้างใหม่ ให้เพิ่มการเปลี่ยนแปลงแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dönemi düzeltmek, bu dönemi kullanan vardiyaları ve ödemeleri yeniden hesaplar. Yeni ücret koşulları için bunun yerine bir değişiklik ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виправлення цього періоду повторно розрахує робочі зміни та виплати, у яких він використовується. Для нових умов оплати натомість додайте зміну."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس مدت کی اصلاح کرنے سے اسے استعمال کرنے والی شفٹوں اور ادائیگیوں کا دوبارہ حساب کیا جائے گا۔ نئی اجرت کی شرائط کے لیے اس کے بجائے تبدیلی شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc điều chỉnh kỳ này sẽ tính lại các ca làm và khoản chi trả sử dụng kỳ đó. Nếu có điều khoản lương mới, hãy thêm một thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更正此期间会重新计算使用该期间的班次和付款。如有新的薪资条款，请改为添加一项更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更正此期間會重新計算使用此期間的班次和薪資發放。若有新的薪資條件，請改為新增變更。"
          }
        }
      }
    },
