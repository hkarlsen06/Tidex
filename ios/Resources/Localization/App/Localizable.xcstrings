          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen eigne tillegg. Trykk + for å leggja til."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel ek yok. Eklemek için + tuşuna basın."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς προσαρμοσμένα επιδόματα. Πατήστε + για προσθήκη."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără suplimente personalizate. Apăsați + pentru a adăuga."
          }
        }
      }
    },
    "settings.pay.editor.supplementsTariff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplements follow the tariff agreement and cannot be changed manually"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg følger tariffavtalen og kan ikke endres manuelt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschläge folgen der Tarifvereinbarung und können nicht manuell geändert werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments suivent l'accord tarifaire et ne peuvent pas être modifiés manuellement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los complementos siguen el convenio tarifario y no pueden modificarse manualmente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi seguono l'accordo tariffario e non possono essere modificati manualmente"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen volgen de cao en kunnen niet handmatig worden gewijzigd"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os adicionais seguem o acordo tarifário e não podem ser alterados manualmente"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg följer kollektivavtalet och kan inte ändras manuellt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg følger tariffaftalen og kan ikke ændres manuelt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisäykset noudattavat työehtosopimusta eikä niitä voi muuttaa manuaalisesti"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki wynikają z umowy taryfowej i nie można ich zmienić ręcznie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки следуют тарифному соглашению и не могут быть изменены вручную"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки відповідають тарифній угоді та не можуть бути змінені вручну"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当は団体協約に従っており、手動で変更することはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 단체협약을 따르므로 수동으로 변경할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补贴遵循团体协议，无法手动修改"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบี้ยเพิ่มเติมปฏิบัติตามข้อตกลงอัตราค่าจ้างและไม่สามารถเปลี่ยนแปลงได้ด้วยตนเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ cấp tuân theo thỏa thuận lương và không thể thay đổi thủ công"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg følgjer tariffavtalen og kan ikkje endrast manuelt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekler toplu sözleşmeye göre belirlenmiştir ve el ile değiştirilemez"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επιδόματα ακολουθούν τη συλλογική σύμβαση και δεν μπορούν να αλλαχθούν χειручειρίως"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplimentele urmăresc acordul tarifar și nu pot fi modificate manual"
          }
        }
      }
    },
