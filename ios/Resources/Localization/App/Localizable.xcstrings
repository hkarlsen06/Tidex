    "Tests verify offline sync functionality according to Phase 8 test plan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests überprüfen die Offline-Synchronisierungsfunktionalität gemäß Testplan Phase 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tests vérifient la fonctionnalité de synchronisation hors ligne selon le plan de test Phase 8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pruebas verifican la funcionalidad de sincronización sin conexión según el plan de pruebas de Fase 8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I test verificano la funzionalità di sincronizzazione offline secondo il piano di test della Fase 8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verifiëren offline synchronisatiefunctionaliteit volgens het Phase 8 testplan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os testes verificam a funcionalidade de sincronização offline de acordo com o plano de testes da Fase 8."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester verifiserer frakoblet synkroniseringsfunksjonalitet i henhold til testplan fase 8."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Testane verifierar funksjonen for offline-synkronisering i samsvar med testplanen for fase 8."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester verifierar offline-synkfunktionalitet enligt testplan för fas 8."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verificerer offline-synkroniseringsfunktionalitet i henhold til fase 8 testplan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testit vahvistavat offline-synkronointitoiminnon vaatimuksiltaan Phase 8 -testissuunnitelmaa vastaavasti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testy sprawdzają funkcjonalność synchronizacji offline zgodnie z planem testów fazy 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тесты проверяют функциональность автономной синхронизации в соответствии с планом тестирования Phase 8."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тести перевіряють функціональність автономної синхронізації відповідно до плану тестування Фази 8."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testler, Faz 8 test planına göre çevrimdışı senkronizasyon işlevselliğini doğrular."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δοκιμές επαληθεύουν τη λειτουργικότητα αποσυνδεδεμένου συγχρονισμού σύμφωνα με το σχέδιο δοκιμών Phase 8."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Testele verifică funcționalitatea sincronizării offline conform planului de testare Phase 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストはPhase 8テスト計画に従ってオフライン同期機能を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트는 Phase 8 테스트 계획에 따라 오프라인 동기화 기능을 검증합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试根据第8阶段测试计划验证离线同步功能。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทดสอบตรวจสอบฟังก์ชันการซิงค์แบบออฟไลน์ตามแผนการทดสอบเฟส 8"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài kiểm tra xác minh chức năng đồng bộ ngoại tuyến theo kế hoạch kiểm tra Giai đoạn 8."
          }
        }
      }
    },
