    "settings.pay.editor.fromDateHelp": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne lønnen gælder for alle vakter fra og med denne datoen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Lohn gilt für alle Schichten ab diesem Datum"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο μισθός ισχύει για όλες τις βάρδιες από αυτή την ημερομηνία και μετά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wage applies to all shifts from this date onwards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salario se aplica a todos los turnos a partir de esta fecha"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palkka koskee kaikkia vuoroja tästä päivämäärästä eteenpäin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce salaire s'applique à tous les quarts à partir de cette date"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo salario si applica a tutti i turni da questa data in poi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この給与はこの日付以降のすべてのシフトに適用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 급여는 이 날짜부터 모든 근무에 적용됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne lønnen gjelder for alle vakter fra og med denne datoen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit loon geldt voor alle diensten vanaf deze datum"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne lønna gjeld for alle vakter frå og med denne datoen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta stawka wynagrodzenia obowiązuje wszystkie dyżury od tej daty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salário se aplica a todos os turnos a partir desta data"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest salariu se aplică tuturor schimburilor de la această dată în continuare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта зарплата применяется ко всем сменам с этой даты"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna lön gäller för alla skift från och med detta datum"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เงินเดือนนี้ใช้กับกะงานทั้งหมดตั้งแต่วันนี้เป็นต้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu maaş bu tarihten itibaren tüm vardiyalar için geçerlidir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця заробітна плата застосовується до всіх змін з цієї дати та далі"
