        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adı 3-20 karakter olmalı ve yalnızca küçük harf, rakam veya alt çizgi içermelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
