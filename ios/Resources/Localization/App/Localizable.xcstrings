    "calendar.subscription.active.description" : {
      "comment" : "Description on the calendar sync settings screen when sync is on. Tidex shifts and events appear in the user's calendar app.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر Tidex في تطبيق التقويم ويتم تحديثه تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex се показва в приложението ви за календар и се обновява автоматично."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex আপনার ক্যালেন্ডার অ্যাপে দেখানো হচ্ছে এবং স্বয়ংক্রিয়ভাবে আপডেট হচ্ছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex es mostra a la teva app de calendari i s'actualitza automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se zobrazuje v aplikaci Kalendář a automaticky se aktualizuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex vises i din kalenderapp og opdateres automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex wird in deiner Kalender-App angezeigt und automatisch aktualisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tidex εμφανίζεται στην εφαρμογή ημερολογίου σας και ενημερώνεται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex shows shifts and events from the past 18 months and next 6 months in your calendar app, with automatic updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se muestra en tu app de calendario y se actualiza automáticamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex kuvatakse sinu kalendrirakenduses ja uueneb automaatselt."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex در برنامه تقویم شما نمایش داده می‌شود و خودکار به‌روزرسانی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex näkyy kalenterisovelluksessasi ja päivittyy automaattisesti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapakita ang Tidex sa iyong calendar app at awtomatikong naa-update."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex est affiché dans votre app Calendrier et se met à jour automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex מוצג באפליקציית היומן שלך ומתעדכן אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex आपके कैलेंडर ऐप में दिखता है और अपने-आप अपडेट होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se prikazuje u vašoj aplikaciji Kalendar i automatski se ažurira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Tidex megjelenik a naptárappban, és automatikusan frissül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex ditampilkan di aplikasi kalender Anda dan diperbarui secara otomatis."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex er sýnt í dagatalsappinu þínu og uppfærist sjálfkrafa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex è mostrato nella tua app Calendario e si aggiorna automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidexはカレンダーアプリに表示され、自動で更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex가 캘린더 앱에 표시되며 자동으로 업데이트됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Tidex“ rodoma jūsų kalendoriaus programoje ir atsinaujina automatiškai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex tiek rādīts jūsu kalendāra lietotnē un atjauninās automātiski."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex viser vakter og hendelser fra de siste 18 månedene og de neste 6 månedene i kalenderappen din, med automatiske oppdateringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex wordt weergegeven in je agenda-app en automatisch bijgewerkt."
          }
        },
        "nn" : {
          "stringUnit" : {
