            "value" : "Tekrarlanan vardiyalar yalnızca seçilen tarihlerde kaldırılır. Diğer tarihler aynı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторювані зміни видаляються лише у вибрані дати. В інші дати вони залишаються без змін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دہرائی جانے والی شفٹیں صرف منتخب تاریخوں پر ہٹائی جاتی ہیں۔ ان کی دیگر تاریخیں جوں کی توں رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ca lặp lại chỉ được xóa vào những ngày đã chọn. Các ngày khác vẫn giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复班次仅会在选定日期删除，其他日期保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定班次只會在所選日期移除。其他日期會維持不變。"
          }
        }
      }
    },
