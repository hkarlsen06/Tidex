        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidexのプライバシーポリシー...\n\nお客様のプライバシーを大切にしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidex 개인정보처리방침...\n\n개인정보 보호를 중요하게 생각합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de Privacidade do Tidex...\n\nLevamos sua privacidade a sério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика конфиденциальности Tidex...\n\nМы серьезно относимся к вашей приватности."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacybeleid voor Tidex...\n\nWij nemen uw privacy serieus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekretesspolicy för Tidex...\n\nVi tar din integritet på allvar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatlivspolitik for Tidex...\n\nVi tager dit privatliv alvorligt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informativa sulla privacy di Tidex...\n\nProteggiamo seriamente la tua privacy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidexin tietosuojakäytäntö...\n\nPidämme yksityisyyttäsi tärkeänä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polityka prywatności dla Tidex...\n\nChronimy twoją prywatność."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Політика приватності для Tidex...\n\nМи серйозно ставимося до вашої приватності."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidex隐私政策...\n\n我们认真对待您的隐私。"
