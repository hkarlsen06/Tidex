    "security.mfa.unenrollDialog.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن من استخدام هذا التطبيق للمصادقة الثنائية بعد الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма да можете повече да използвате това приложение за двуфакторно удостоверяване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি আর দ্বি-ফ্যাক্টর প্রমাণীকরণের জন্য এই অ্যাপটি ব্যবহার করতে পারবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja no podràs utilitzar aquesta aplicació per a l'autenticació de dos factors."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už nebudete moci tuto aplikaci používat pro dvoustupňové ověřování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil ikke længere kunne bruge denne app til to-faktor godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst diese App nicht mehr für die Zwei-Faktor-Authentifizierung verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θα μπορείτε πλέον να χρησιμοποιήσετε αυτήν την εφαρμογή για ταυτοποίηση δύο παραγόντων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will no longer be able to use this app for two-factor authentication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podrás usar esta aplicación para la autenticación de dos factores."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei saa enam seda rakendust kaheosamulise autentimise jaoks kasutada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیگر نمی‌توانید از این برنامه برای احراز هویت دو مرحله‌ای استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi enää käyttää tätä sovellusta kaksivaiheiseen autentikointiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mo na maaaring gamitin ang app na ito para sa two-factor authentication."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez plus utiliser cette app pour l'authentification à deux facteurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא תוכל עוד להשתמש באפליקציה זו לאימות דו-שלבי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इस ऐप को दो-कारक प्रमाणीकरण के लिए अब नहीं रख सकेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više nećete moći koristiti ovu aplikaciju za autentifikaciju s dva faktora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt az alkalmazást már nem tudja használni kétfaktoros hitelesítéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak akan lagi dapat menggunakan aplikasi ini untuk autentikasi dua faktor."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú munt ekki lengur geta notað þetta forrit fyrir tvíþrepa auðkenningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
