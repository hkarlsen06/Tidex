    "settings.pay.editor.savedTariff" : {
      "comment" : "Note in the wage entry editor when saved rates are in use. Explains what updating from the agreement replaces.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم المعدلات المحفوظة في هذه الفترة. يؤدي التحديث من الاتفاقية إلى استبدال الأجور والبدلات وقواعد العمل الإضافي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използват се ставките, запазени за този период. Актуализирането от споразумението заменя заплатите, добавките и правилата за извънреден труд."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সময়কালে সংরক্ষিত হার ব্যবহার করা হচ্ছে। চুক্তি থেকে আপডেট করলে মজুরি, ভাতা এবং ওভারটাইমের নিয়ম প্রতিস্থাপিত হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'utilitzen les tarifes desades per a aquest període. Actualitzar-les segons el conveni substitueix els salaris, els complements i les regles d'hores extres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používají se sazby uložené v tomto období. Aktualizace podle dohody nahradí mzdy, příplatky a pravidla pro přesčasy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger de satser, der er gemt for denne periode. Opdatering fra aftalen erstatter løn, tillæg og regler for overarbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden die in diesem Zeitraum gespeicherten Sätze verwendet. Durch die Aktualisierung aus der Vereinbarung werden Löhne, Zuschläge und Überstundenregeln ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιούνται οι αποθηκευμένες σε αυτή την περίοδο τιμές. Η ενημέρωση από τη συμφωνία αντικαθιστά τις αποδοχές, τις προσαυξήσεις και τους κανόνες υπερωριών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using the rates saved in this period. Updating from the agreement replaces wages, supplements and overtime rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan las tarifas guardadas en este período. Actualizar desde el acuerdo reemplaza los salarios, complementos y reglas de horas extra."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutatakse sellele perioodile salvestatud määrasid. Lepingu alusel värskendamine asendab töötasud, lisatasud ja ületunnitöö reeglid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از نرخ‌های ذخیره‌شده در این دوره استفاده می‌شود. به‌روزرسانی از قرارداد، دستمزدها، مزایا و قوانین اضافه‌کاری را جایگزین می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytössä ovat tälle jaksolle tallennetut palkkatasot. Sopimuksesta päivittäminen korvaa palkat, lisät ja ylityösäännöt."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ang mga rate na naka-save sa panahong ito. Ang pag-update mula sa kasunduan ay papalitan ang sahod, mga dagdag-bayad at mga panuntunan sa overtime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les taux enregistrés pour cette période. La mise à jour depuis l’accord remplace les salaires, suppléments et règles d’heures supplémentaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעשה שימוש בתעריפים שנשמרו בתקופה זו. עדכון מההסכם יחליף את השכר, התוספות וכללי השעות הנוספות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस अवधि में सहेजी गई दरों का उपयोग हो रहा है। समझौते से अपडेट करने पर वेतन, भत्ते और ओवरटाइम के नियम बदल जाएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koriste se stope spremljene za ovo razdoblje. Ažuriranje prema ugovoru zamjenjuje plaće, dodatke i pravila za prekovremeni rad."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ebben az időszakban mentett díjakat használja. A megállapodás alapján történő frissítés lecseréli a béreket, pótlékokat és túlóraszabályokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan tarif yang tersimpan dalam periode ini. Memperbarui berdasarkan perjanjian akan mengganti upah, tunjangan, dan aturan lembur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notar taxta sem vistaðir eru fyrir þetta tímabil. Uppfærsla samkvæmt kjarasamningi kemur í stað launa, álagsgreiðslna og reglna um yfirvinnu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzo delle tariffe salvate in questo periodo. L'aggiornamento dall'accordo sostituisce retribuzioni, maggiorazioni e regole sullo straordinario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間に保存された料率を使用しています。契約から更新すると、賃金、手当、時間外労働のルールが置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간에 저장된 요율을 사용 중입니다. 협약에서 업데이트하면 급여, 수당 및 초과 근무 규칙이 대체됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojami šiame laikotarpyje išsaugoti tarifai. Atnaujinus pagal susitarimą, bus pakeistos algos, priemokos ir viršvalandžių taisyklės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek izmantotas šajā periodā saglabātās likmes. Atjaunināšana no vienošanās aizstāj algas, piemaksas un virsstundu noteikumus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker satsene som er lagret i denne perioden. Oppdatering fra avtalen erstatter lønn, tillegg og overtidsregler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de tarieven die in deze periode zijn opgeslagen. Bijwerken vanuit de overeenkomst vervangt lonen, toeslagen en regels voor overwerk."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukar satsane som er lagra i denne perioden. Oppdatering frå avtalen erstattar lønn, tillegg og overtidsreglar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzystasz ze stawek zapisanych w tym okresie. Aktualizacja na podstawie umowy zastępuje zasady dotyczące wynagrodzenia, dodatków i nadgodzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando os valores salvos neste período. Atualizar a partir do acordo substitui salários, adicionais e regras de horas extras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se folosesc tarifele salvate în această perioadă. Actualizarea din acord înlocuiește salariile, sporurile și regulile privind orele suplimentare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используются ставки, сохранённые для этого периода. Обновление по соглашению заменит оплату труда, доплаты и правила сверхурочной работы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používajú sa sadzby uložené v tomto období. Aktualizácia podľa kolektívnej zmluvy nahradí mzdy, príplatky a pravidlá nadčasov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabljene so stopnje, shranjene za to obdobje. Posodobitev po kolektivni pogodbi nadomesti plače, dodatke in pravila za nadurno delo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koriste se stope sačuvane za ovaj period. Ažuriranje prema kolektivnom ugovoru zamenjuje zarade, dodatke i pravila za prekovremeni rad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder satserna som sparats för den här perioden. En uppdatering från avtalet ersätter löner, tillägg och övertidsregler."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inatumia viwango vilivyohifadhiwa katika kipindi hiki. Kusasisha kutoka kwenye makubaliano hubadilisha mishahara, nyongeza na kanuni za muda wa ziada."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் காலத்தில் சேமிக்கப்பட்ட விகிதங்கள் பயன்படுத்தப்படுகின்றன. ஒப்பந்தத்திலிருந்து புதுப்பிப்பது ஊதியம், கூடுதல் கொடுப்பனவுகள் மற்றும் கூடுதல் நேர விதிகளை மாற்றும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้อัตราที่บันทึกไว้ในช่วงเวลานี้ การอัปเดตจากข้อตกลงจะแทนที่ค่าจ้าง เงินเพิ่ม และกฎการทำงานล่วงเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dönemde kaydedilen oranlar kullanılıyor. Sözleşmeden güncellemek ücretleri, ek ödemeleri ve fazla mesai kurallarını değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуються ставки, збережені для цього періоду. Оновлення з угоди замінює зарплату, доплати й правила оплати понаднормових годин."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس مدت میں محفوظ شرحیں استعمال ہو رہی ہیں۔ معاہدے سے اپ ڈیٹ کرنے پر اجرت، اضافی ادائیگیاں اور اوور ٹائم کے قواعد بدل جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang sử dụng các mức đã lưu trong kỳ này. Cập nhật từ thỏa thuận sẽ thay thế tiền lương, phụ cấp và quy tắc làm thêm giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此期间保存的费率。根据协议更新会替换工资、补贴和加班规则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此期間已儲存的費率。從協議更新會取代薪資、津貼和加班規則。"
          }
        }
      }
    },
