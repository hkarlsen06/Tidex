        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 수당을 제거하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要移除此补充吗？"
