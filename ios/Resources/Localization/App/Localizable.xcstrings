        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...böylece gerçekte ne kadar ücret alacağını her zaman bilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...щоб ви завжди знали, скільки фактично отримаєте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…تاکہ آپ ہمیشہ جان سکیں کہ آپ کو حقیقت میں کتنی ادائیگی ملے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...để bạn luôn biết mình thực sự sẽ nhận được bao nhiêu."
          }
        },
