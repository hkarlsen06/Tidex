    "screenshotShare.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your calendar as a polished image with the share button in the toolbar. You can choose to show or hide your earnings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del kalenderen din som et polert bilde med deleknappen i verktøylinjen. Du kan velge å vise eller skjule inntektene dine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deinen Kalender als poliertes Bild mit dem Share-Button in der Symbolleiste. Du kannst wählen, deine Einnahmen anzuzeigen oder auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre calendrier comme une image soignée avec le bouton de partage dans la barre d'outils. Vous pouvez choisir d'afficher ou de masquer vos revenus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu calendario como una imagen pulida con el botón de compartir en la barra de herramientas. Puedes elegir mostrar u ocultar tus ganancias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il tuo calendario come un'immagine raffinata usando il pulsante di condivisione nella barra degli strumenti. Puoi scegliere di mostrare o nascondere i tuoi guadagni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je kalender als een gepolijste afbeelding met de deelknop in de werkbalk. Je kunt ervoor kiezen om je inkomsten wel of niet weer te geven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu calendário como uma imagem polida usando o botão de compartilhamento na barra de ferramentas. Você pode escolher mostrar ou ocultar seus ganhos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela din kalender som en polerad bild med delningsknappen i verktygsfältet. Du kan välja att visa eller dölja dina inkomster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dit kalender som et poleret billede med delingsknappen i værktøjslinjen. Du kan vælge at vise eller skjule dine indtjening."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa kalenterisi muodikkaana kuvana jakopainikkeella työkalurivissä. Voit valita, näytetäänkö vai piilotetaanko tulosi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij swój kalendarz jako elegancki obraz za pomocą przycisku udostępniania na pasku narzędzi. Możesz wybrać, czy pokazać lub ukryć swoje zarobki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь своим календарем в виде красивого изображения с помощью кнопки поделиться на панели инструментов. Вы можете выбрать, показывать или скрывать свой доход."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться своїм календарем як відполірованим зображенням за допомогою кнопки поділення в панелі інструментів. Ви можете вибрати, показувати чи приховувати ваші заробітки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーの共有ボタンを使って、カレンダーを洗練された画像として共有できます。収入の表示/非表示を選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 모음의 공유 버튼으로 캘린더를 멋진 이미지로 공유하세요. 수익을 표시하거나 숨기도록 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
