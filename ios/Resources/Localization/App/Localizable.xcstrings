    "addShift.submitRequirements.eventSameDay" : {
      "comment" : "Shown under an event's time fields, and in the list of missing fields, when the end time is not after the start time. Timed events must start and end on the same day.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن ينتهي الحدث في وقت لاحق من اليوم نفسه. لا يمكن أن يمتد إلى ما بعد منتصف الليل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Събитието трябва да приключва по-късно същия ден. То не може да продължава след полунощ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ইভেন্টকে একই দিনে পরে শেষ হতে হবে। এটি মধ্যরাত পেরিয়ে চলতে পারবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esdeveniment ha d'acabar més tard el mateix dia. No pot passar de mitjanit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Událost musí skončit později tentýž den. Nemůže pokračovat přes půlnoc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En begivenhed skal slutte senere samme dag. Den kan ikke gå over midnat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ereignis muss noch am selben Tag enden. Es darf nicht über Mitternacht hinausgehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα συμβάν πρέπει να ολοκληρώνεται αργότερα την ίδια ημέρα. Δεν μπορεί να διαρκεί μετά τα μεσάνυχτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An event must end later the same day. It can't run past midnight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un evento debe terminar más tarde el mismo día. No puede pasar de medianoche."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sündmus peab lõppema hiljem samal päeval. See ei tohi ulatuda üle südaöö."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رویداد باید همان روز، دیرتر به پایان برسد. نمی‌تواند از نیمه‌شب عبور کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapahtuman on päätyttävä myöhemmin samana päivänä. Se ei voi jatkua yli keskiyön."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat magtapos ang event sa parehong araw, pagkatapos ng oras ng pagsisimula. Hindi ito maaaring lumampas ng hatinggabi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un événement doit se terminer plus tard le même jour. Il ne peut pas dépasser minuit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אירוע חייב להסתיים מאוחר יותר באותו יום. הוא לא יכול להימשך מעבר לחצות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी इवेंट का समापन उसी दिन बाद में होना चाहिए। यह आधी रात के बाद तक नहीं चल सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Događaj mora završiti kasnije istog dana. Ne može trajati nakon ponoći."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eseménynek ugyanazon a napon később kell véget érnie. Nem tarthat éjfélen túl."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acara harus berakhir lebih lambat pada hari yang sama. Acara tidak dapat melewati tengah malam."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viðburður verður að ljúka síðar sama dag. Hann má ekki ná yfir miðnætti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un evento deve terminare più tardi lo stesso giorno. Non può protrarsi oltre la mezzanotte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントは同じ日の後の時間に終了する必要があります。深夜をまたぐことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트는 같은 날 더 늦은 시간에 종료되어야 합니다. 자정을 넘길 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvykis turi baigtis vėliau tą pačią dieną. Jis negali tęstis po vidurnakčio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasākumam jābeidzas vēlāk tajā pašā dienā. Tas nevar turpināties pēc pusnakts."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hendelse må slutte senere samme dag. Den kan ikke gå over midnatt."
          }
        },
