            "state": "translated",
            "value": "For å motta varsler må du aktivere dem i Innstillinger-appen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Benachrichtigungen in den Einstellungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, habilítalas en la app de Configuración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez-les dans l'application Paramètres"
          }
        },
