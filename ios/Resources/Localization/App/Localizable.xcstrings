    "data.export.pdf.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer vaktuoversigt, summer efter type og totale lontal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Schichtübersicht, Summen nach Typ und Lohnzusammenfassung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιλαμβάνει επισκόπηση βάρδιας, σύνολα ανά τύπο και περίληψη μισθών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes shift overview, totals by type, and wage summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye resumen de vacas, totales por tipo y resumen salarial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältää vuorojen yleiskatsauksen, tyypin mukaiset summat ja palkkiyhteenvedon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut l'aperçu des vagues, les totaux par type et le résumé salarial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include panoramica turni, totali per tipo e riepilogo stipendiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト概要、タイプ別の合計、および賃金サマリーが含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교대 근무 개요, 유형별 합계 및 급여 요약이 포함됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje przegląd zmian, sumy według typu i podsumowanie wynagrodzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui visão geral de vagas, totais por tipo e resumo salarial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Include prezentare generală a vactelor, totaluri pe tip și rezumat salarial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает обзор смен, итоги по типам и сводку по зарплате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderar vaktöversikt, summor per typ och lönesummering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมภาพรวมกะ ผลรวมตามประเภท และสรุปเงินเดือน"
