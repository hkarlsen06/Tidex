          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak verbinding met internet om delen te beheren. Opgeslagen vrienden blijven zichtbaar."
          }
        },
        "nn" : {
          "stringUnit" : {
