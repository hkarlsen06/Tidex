    "profile.dangerZone.deleteAccount.dialogDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv SLET for at bekræfte. Alle data vil blive slettet permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib LÖSCHEN ein, um zu bestätigen. Alle Daten werden dauerhaft entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type DELETE to confirm. All data will be permanently removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe ELIMINAR para confirmar. Todos los datos se eliminarán permanentemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita POISTA vahvistaaksesi. Kaikki tiedot poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez SUPPRIMER pour confirmer. Toutes les données seront supprimées définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita ELIMINA per confermare. Tutti i dati saranno rimossi permanentemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DELETE と入力して確認してください。すべてのデータが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DELETE를 입력하여 확인하세요. 모든 데이터가 영구적으로 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv SLETT for å bekrefte. Alle data vil bli fjernet permanent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ VERWIJDEREN ter bevestiging. Alle gegevens worden permanent verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz USUŃ, aby potwierdzić. Wszystkie dane zostaną trwale usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite DELETAR para confirmar. Todos os dados serão removidos permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите DELETE для подтверждения. Все данные будут навсегда удалены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv RADERA för att bekräfta. All data kommer att raderas permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ ลบ เพื่อยืนยัน ข้อมูลทั้งหมดจะถูกลบอย่างถาวร"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ВИДАЛИТИ для підтвердження. Усі дані будуть назавжди вилучені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập XÓA để xác nhận. Tất cả dữ liệu sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入DELETE以确认。所有数据将被永久删除。"
          }
        }
      }
    },
