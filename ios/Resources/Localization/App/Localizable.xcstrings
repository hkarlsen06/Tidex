    "settings.pay.break.methodDesc.baseOnly": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fratrækker pause kun fra grundløn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht Pause nur vom Grundlohn ab"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί την παύση μόνο από τη βασική αποδοχή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deducts break only from base wage"
          }
