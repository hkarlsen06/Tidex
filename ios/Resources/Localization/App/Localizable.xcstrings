    "shifts.virtualConversionInfo" : {
      "comment" : "Info note in shift details when editing one date of a recurring shift. Saving makes a separate shift for that date.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستؤدي التغييرات إلى إنشاء نوبة عمل جديدة واستبعاد هذا التاريخ من النوبة المتكررة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промените ще създадат нова смяна и ще изключат тази дата от повтарящата се смяна"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিবর্তনগুলি একটি নতুন শিফট তৈরি করবে এবং এই তারিখটি পুনরাবৃত্ত শিফট থেকে বাদ দেবে"
          }
        },
        "ca" : {
          "stringUnit" : {
