    "settings.pay.editor.tariffUnavailable" : {
      "comment" : "Error when tariff rates cannot be loaded, for example while offline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدلات التعرفة لهذا التاريخ غير متاحة. حاول مرة أخرى عند الاتصال بالإنترنت، أو أدخل أجرك بالساعة المتفق عليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарифните ставки за тази дата не са налични. Опитайте отново, когато сте свързани с интернет, или въведете договореното си почасово възнаграждение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই তারিখের ট্যারিফ হার পাওয়া যাচ্ছে না। সংযুক্ত থাকা অবস্থায় আবার চেষ্টা করুন, অথবা চুক্তিবদ্ধ ঘণ্টাপ্রতি মজুরি লিখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tarifes del conveni per a aquesta data no estan disponibles. Torna-ho a provar quan tinguis connexió o introdueix el teu salari per hora acordat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
