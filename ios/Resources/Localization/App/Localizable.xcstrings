        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauza se nejdřív odečte ze základní mzdy, pak podle potřeby z nejnižšího příplatku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausen trækkes først fra grundlønnen, derefter fra det laveste tillæg om nødvendigt."
