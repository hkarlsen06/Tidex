    "acceptTerms.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, you must read and accept our Terms of Service and Privacy Policy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fortsette må du lese og godta våre vilkår for bruk og personvernerklæring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fortzufahren, müssen Sie unsere Nutzungsbedingungen und Datenschutzrichtlinie lesen und akzeptieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, debes leer y aceptar nuestros Términos de Servicio y Política de Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, vous devez lire et accepter nos Conditions d'utilisation et notre Politique de confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するには、利用規約とプライバシーポリシーを読んで同意する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 이용약관 및 개인정보처리방침을 읽고 동의해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, você deve ler e aceitar nossos Termos de Serviço e Política de Privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, прочитайте и примите наши Условия обслуживания и Политику конфиденциальности."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet onze Servicevoorwaarden en Privacybeleid lezen en accepteren om door te gaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att fortsätta måste du läsa och acceptera våra användarvillkor och sekretesspolicy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at fortsætte skal du læse og acceptere vores servicevilkår og privatlivspolitik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare, devi leggere e accettare i nostri Termini di servizio e l'Informativa sulla privacy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkaaksesi sinun on luettava ja hyväksyttävä palveluehdot ja tietosuojakäytäntö."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, musisz przeczytać i zaakceptować nasze Warunki usługi i Politykę prywatności."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, ви повинні прочитати і прийняти наші Умови обслуговування та Політику конфіденційності."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要继续，您必须阅读并接受我们的服务条款和隐私政策。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการดำเนินการต่อ คุณต้องอ่านและยอมรับข้อกำหนดการให้บริการและนโยบายความเป็นส่วนตัวของเรา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tiếp tục, bạn phải đọc và chấp nhận Điều khoản Dịch vụ và Chính sách Bảo mật của chúng tôi."
          }
        }
      }
    },
