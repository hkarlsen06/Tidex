    "profile.errors.usernameInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يتكون اسم المستخدم من 3 إلى 20 حرفًا وأن يحتوي فقط على أحرف صغيرة أو أرقام أو شرطات سفلية."
