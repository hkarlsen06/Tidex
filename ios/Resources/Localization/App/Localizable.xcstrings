    "shifts.recurring.stopAfterDateConfirmMessage" : {
      "comment" : "Message in the confirmation dialog for ending a recurring shift. %@ is a formatted date such as 3 March 2025.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبقي هذا الورديات السابقة في تقويمك، لكنه سيزيل التكرارات المستقبلية لهذه الوردية المتكررة بعد %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това запазва миналите смени в календара ви, но премахва бъдещите повторения на тази повтаряща се смяна след %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি আপনার ক্যালেন্ডারে আগের শিফটগুলো রাখবে, তবে %@-এর পর এই পুনরাবৃত্ত শিফটের ভবিষ্যৎ পুনরাবৃত্তি মুছে দেবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això manté els torns passats al teu calendari, però elimina les repeticions futures d'aquest torn recurrent després de %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minulé směny zůstanou v kalendáři, ale budoucí opakování této směny se po %@ odstraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette beholder tidligere vagter i din kalender, men fjerner fremtidige gentagelser for denne faste vagt efter %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch bleiben frühere Schichten in deinem Kalender, aber zukünftige Wiederholungen dieser wiederkehrenden Schicht werden nach %@ entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό διατηρεί τις προηγούμενες βάρδιες στο ημερολόγιό σας, αλλά αφαιρεί τις μελλοντικές επαναλήψεις αυτής της επαναλαμβανόμενης βάρδιας μετά τις %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This keeps past shifts in your calendar, but removes future repeats from this recurring shift after %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto mantiene los turnos anteriores en tu calendario, pero elimina futuras repeticiones de este turno recurrente después de %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See jätab varasemad vahetused sinu kalendrisse alles, kuid eemaldab selle korduva vahetuse tulevased kordused pärast %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار شیفت‌های گذشته را در تقویم شما نگه می‌دارد، اما تکرارهای آینده این شیفت تکراری را بعد از %@ حذف می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä säilyttää aiemmat vuorot kalenterissasi, mutta poistaa tämän toistuvan vuoron tulevat toistot %@ jälkeen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapanatili nito ang mga nakaraang shift sa iyong kalendaryo, pero inaalis ang mga susunod na pag-uulit ng umuulit na shift na ito pagkatapos ng %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela conserve les shifts passés dans votre calendrier, mais supprime les répétitions futures de ce shift récurrent après %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כך משמרות עבר יישארו בלוח השנה שלך, אבל חזרות עתידיות של משמרת חוזרת זו יוסרו אחרי %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे पिछली शिफ्टें आपके कैलेंडर में रहेंगी, लेकिन %@ के बाद इस आवर्ती शिफ्ट की भविष्य की पुनरावृत्तियां हट जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
