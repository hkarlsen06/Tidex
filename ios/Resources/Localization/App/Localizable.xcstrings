    "common.error.noLocalData" : {
      "comment" : "Error when the device has no synced data yet, for example on first launch.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد بيانات على هذا الجهاز حتى الآن. انتظر حتى تكتمل المزامنة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още няма данни на това устройство. Изчакайте синхронизирането да завърши."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে এখনও কোনো ডেটা নেই। সিঙ্ক সম্পূর্ণ হওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no hi ha dades en aquest dispositiu. Espera que acabi la sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto zařízení zatím nejsou žádná data. Počkejte na dokončení synchronizace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er endnu ingen data på denne enhed. Vent, indtil synkroniseringen er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät sind noch keine Daten vorhanden. Warte, bis die Synchronisierung abgeschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν ακόμη δεδομένα σε αυτή τη συσκευή. Περιμένετε να ολοκληρωθεί ο συγχρονισμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No data on this device yet. Wait for sync to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay datos en este dispositivo. Espera a que termine la sincronización."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selles seadmes pole veel andmeid. Oota sünkroonimise lõpuni."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز داده‌ای روی این دستگاه نیست. صبر کنید همگام‌سازی تمام شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä laitteella ei ole vielä tietoja. Odota synkronoinnin valmistumista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pang data sa device na ito. Hintaying matapos ang pag-sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune donnée ne se trouve encore sur cet appareil. Attendez la fin de la synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין עדיין נתונים במכשיר הזה. המתן לסיום הסנכרון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर अभी तक कोई डेटा नहीं है। सिंक पूरा होने तक प्रतीक्षा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ovom uređaju još nema podataka. Pričekajte da se sinkronizacija dovrši."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen az eszközön még nincsenek adatok. Várd meg a szinkronizálás befejezését."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada data di perangkat ini. Tunggu hingga sinkronisasi selesai."
