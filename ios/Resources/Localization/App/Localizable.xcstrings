    "settings.pay.timeline.infoTip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدد إدخالات الراتب الراتب والعلاوات المطبقة على الورديات في فترات مختلفة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записите на заплати определят коя заплата и приложения се прилагат за смени в различни периоди."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেতনের এন্ট্রিগুলি নির্ধারণ করে যে বিভিন্ন সময়ের শিফটে কোন বেতন এবং ভাতা প্রযোজ্য।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrades de salari determinen quina paga i complements s'apliquen als torns en diferents períodes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznamy o mzdě určují, která výplata a příplatky se vztahují na směny v různých obdobích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønningsopgørelser bestemmer, hvilken løn og tillæg der gælder for vagter i forskellige perioder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lohneinträge bestimmen, welcher Lohn und welche Zuschläge für Schichten in verschiedenen Zeiträumen gelten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εγγραφές μισθού καθορίζουν ποια αποδοχή και επιδόματα ισχύουν για τις βάρδιες σε διαφορετικές περιόδους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wage entries determine which pay and supplements apply to shifts in different periods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas salariales determinan qué pago y complementos se aplican a los turnos en diferentes períodos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palgakanded määravad, milline palk ja lisatasud kehtivad vahetustele erinevatel perioodidel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورودی‌های حقوقی تعیین می‌کنند کدام حقوق و مزایا برای شیفت‌ها در دوره‌های مختلف اعمال می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palkkakirjaukset määrittävät, mikä palkka ja lisät koskevat vuoroja eri ajanjaksoilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga entry ng sahod ay tumutukoy kung aling bayad at mga dagdag ang nalalapat sa mga shift sa iba't ibang panahon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées de salaire déterminent la rémunération et les suppléments applicables aux quarts de travail au cours de différentes périodes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכי משכורת קובעים איזו משכורת וקצבאות חלים על משמרות בתקופות שונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेतन प्रविष्टियां निर्धारित करती हैं कि विभिन्न अवधियों में शिफ्ट के लिए कौन से वेतन और भत्ते लागू होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unosi plaće određuju koju plaću i naknade primjenjiti na smjene u različitim periodima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetési bejegyzések határozzák meg, hogy mely bérek és kiegészítések vonatkoznak a különböző időszakok műszakjaira."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entri gaji menentukan gaji dan tunjangan mana yang berlaku untuk shift di periode berbeda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launafærslur ákvarða hvaða laun og framlög eiga við um vaktir á mismunandi tímabilum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci di stipendio determinano quale paga e quali integrazioni si applicano ai turni in diversi periodi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給与記録は、異なる期間のシフトに適用される給与と手当を決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "급여 항목은 다양한 기간의 근무에 적용되는 급여와 수당을 결정합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algos įrašai nustato, kuri alga ir priedai taikomi skirtingų laikotarpių pamainoms."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algu ieraksti nosaka, kura alga un piemaksas attiecas uz maiņām dažādos periodos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønnsoppføringer bestemmer hvilken lønn og tillegg som gjelder for vakter i ulike perioder."
