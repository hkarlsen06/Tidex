    "profile.emailChange.confirmationMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من صندوق الوارد الخاص بك لكلا عنواني البريد الإلكتروني. يجب عليك النقر على الروابط في كلا البريدين لإكمال التغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете пощата си за двата имейл адреса. Трябва да кликнете върху връзките в двата имейла, за да завършите промяната."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উভয় ইমেল ঠিকানার জন্য আপনার ইনবক্স চেক করুন। পরিবর্তন সম্পূর্ণ করতে আপনাকে উভয় ইমেলে লিঙ্ক ক্লিক করতে হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova la teva bústia per a ambdues adreces de correu electrònic. Has de fer clic als enllaços de tots dos correus electrònics per completar el canvi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte svou doručenou poštu na obě e-mailové adresy. Musíte kliknout na odkazy v obou e-mailech, abyste dokončili změnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek din indbakke for begge e-mailadresser. Du skal klikke på linkene i begge e-mails for at fuldføre ændringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe deinen Posteingang für beide E-Mail-Adressen. Du musst auf die Links in beiden E-Mails klicken, um die Änderung abzuschließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχει τα εισερχόμενά σου για αμφότερες τις διευθύνσεις ηλεκτρονικού ταχυδρομείου. Πρέπει να κάνεις κλικ στους συνδέσμους και στα δύο μηνύματα ηλεκτρονικού ταχυδρομείου για να ολοκληρώσεις την αλλαγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your inbox for both email addresses. You must click the links in both emails to complete the change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tu bandeja de entrada para ambas direcciones de correo. Debes hacer clic en los enlaces en ambos correos para completar el cambio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolli mõlema e-posti aadressi sisendkasti. Pead klikkima linke mõlemas e-postis, et muudatus lõpule viia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صندوق ورودی خود را برای هر دو آدرس ایمیل بررسی کنید. برای تکمیل تغییر باید بر روی پیوندهای هر دو ایمیل کلیک کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista saapuneet viestit molemmille sähköpostiosoitteille. Sinun on napsautettava linkkejä molemmissa sähköpostiviesteissä muutoksen loppuunsaattamiseksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang iyong inbox para sa parehong email addresses. Dapat mong i-click ang mga link sa parehong emails upang makumpleto ang pagbabago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre boîte de réception pour les deux adresses e-mail. Vous devez cliquer sur les liens dans les deux e-mails pour terminer la modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדוק את תיבת הדוא\"ל שלך לשתי כתובות הדוא\"ל. עליך ללחוץ על הקישורים בשתי ההודעות כדי להשלים את השינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों ईमेल पतों के लिए अपने इनबॉक्स की जांच करें। परिवर्तन पूरा करने के लिए आपको दोनों ईमेल में लिंक पर क्लिक करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite inbox za obje e-mail adrese. Morate kliknuti na linkove u oba e-maila kako biste dovršili promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizze a postaládáját mindkét e-mail cím esetében. Mindkét e-mailben kattintson a linkekre a módosítás befejezéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa kotak masuk Anda untuk kedua alamat email. Anda harus mengklik tautan di kedua email untuk menyelesaikan perubahan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athugaðu innhólfið þitt fyrir bæði netföng. Þú verður að smella á tengla í báðum netpóstum til að ljúka breytingunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la tua casella di posta per entrambi gli indirizzi email. Devi fare clic sui link in entrambi i messaggi per completare la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のメールアドレスの受信箱を確認してください。両方のメールのリンクをクリックして変更を完了する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 이메일 주소의 수신함을 확인하세요. 변경을 완료하려면 두 이메일의 링크를 모두 클릭해야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patikrinkite abiejų el. pašto adresų gautų žinučių aplanką. Turite spustelėti nuorodas abiejose el. laiškuose, kad baigtumėte keitimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbaudiet savu iesūtni abām e-pasta adresēm. Jums jānoklikšķina uz saitēm abos e-pastos, lai pabeigtu izmaiņu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk innboksen din for begge e-postadressene. Du må klikke på lenkene i begge e-postene for å fullføre endringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je inbox voor beide e-mailadressen. Je moet op de links in beide e-mails klikken om de wijziging af te ronden."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk innboksen din for begge e-postadressene. Du må klikke på lenkene i begge e-postene for å fullføre endringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź swoją skrzynkę odbiorczą dla obu adresów e-mail. Musisz kliknąć łącza w obu wiadomościach e-mail, aby ukończyć zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua caixa de entrada para ambos os endereços de e-mail. Você deve clicar nos links em ambos os e-mails para concluir a alteração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
