        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tauko vähennetään ensin peruspalkasta, sitten tarvittaessa pienimmästä lisästä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pahinga ay ibinabawas muna sa batayang sahod, saka sa pinakamababang dagdag kung kailangan."
          }
        },
        "fr" : {
