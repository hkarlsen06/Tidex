        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, habilítalas en la app de Configuración"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ilmoitukset käyttöön Asetukset-sovelluksessa saadaksesi ilmoituksia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez-les dans l'application Paramètres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere notifiche, abilitale nell'app Impostazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取るには、設定アプリで有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 설정 앱에서 활성화하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å motta varsler må du aktivere dem i Innstillinger-appen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om meldingen te ontvangen, schakel ze in in de app Instellingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odbierać powiadomienia, włącz je w aplikacji Ustawienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative-as no app de Configurações"
