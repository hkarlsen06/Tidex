    "events.notifications.timed_picker.description" : {
      "comment" : "Help text in the reminder picker for events with a start time. The user picks how long before the event to be reminded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر قبل كم من الوقت من الحدث تريد أن يصلك إشعار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете колко време преди събитието да бъдете уведомени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইভেন্টের কত আগে বিজ্ঞপ্তি পেতে চান তা বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quant temps abans de l'esdeveniment vols rebre l'avís."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho před událostí chcete dostat oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg hvor længe før din begivenhed du vil varsles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange vor dem Ereignis du benachrichtigt werden möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πόσο νωρίτερα θέλετε να ειδοποιηθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how long before your event you want to be notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto antes de tu evento quieres recibir una notificación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali, kui kaua enne sündmust soovid teavitust saada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشخص کنید چه مدت قبل از رویداد اعلان دریافت کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, kuinka kauan ennen tapahtumaa haluat ilmoituksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano katagal bago ang iyong event ka aabisuhan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez combien de temps avant votre événement vous voulez être notifié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר כמה זמן לפני האירוע תרצה לקבל התראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि इवेंट से कितनी देर पहले आप सूचना पाना चाहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite koliko prije događaja želite primiti obavijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki, mennyivel az esemény előtt kérsz értesítést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih berapa lama sebelum acara Anda ingin diberi tahu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldu hve löngu fyrir viðburðinn þú vilt fá tilkynningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quanto tempo prima dell'evento vuoi ricevere una notifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定のどれくらい前に通知するかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트 전에 언제 알림을 받을지 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite, prieš kiek laiko iki įvykio norite gauti pranešimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlieties, cik ilgi pirms notikuma vēlaties saņemt paziņojumu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvor lenge før hendelsen du vil bli varslet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe lang voor je gebeurtenis je een melding wilt ontvangen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vel kor lenge før hendinga du vil bli varsla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak długo przed wydarzeniem chcesz otrzymać powiadomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha com quanto tempo antes do evento você quer ser notificado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți cu cât timp înainte de eveniment doriți să fiți notificat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, за сколько до события вас уведомить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, ako dlho pred udalosťou chcete dostať upozornenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite, koliko časa pred dogodkom želite biti obveščeni."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izaberite koliko pre događaja želite obaveštenje."
          }
        },
        "sv" : {
