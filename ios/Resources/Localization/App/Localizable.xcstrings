    "sharing.confirm.stopSharingMyShifts.mutual" : {
      "comment" : "Message in the confirmation for no longer sharing shifts with a friend, when sharing goes both ways. %@ is the friend's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوف تتوقف عن مشاركة نوباتك مع %@. سيظل بإمكانك رؤية النوبات التي يشاركها معك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще спреш да споделяш смените си с %@. Все още ще виждаш смените, които те споделят с теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি %@-এর সাথে আপনার শিফট শেয়ার করা বন্ধ করবেন। তারা আপনার সাথে যে শিফট শেয়ার করে, সেগুলো আপনি এখনও দেখতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixaràs de compartir els teus torns amb %@. Continuaràs veient els torns que comparteixen amb tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestanete sdílet své směny s %@. Směny, které s vámi sdílí, stále uvidíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stopper med at dele dine vagter med %@. Du kan stadig se vagter, de deler med dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst deine Schichten nicht mehr mit %@ teilen. Ihre mit dir geteilten Schichten wirst du weiterhin sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σταματήσετε να κοινοποιείτε τις βάρδιές σας στον/στην %@. Θα εξακολουθείτε να βλέπετε τις βάρδιες που σας κοινοποιεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will stop sharing your shifts with %@. You will still see shifts they share with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejarás de compartir tus turnos con %@. Seguirás viendo los turnos que comparta contigo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa lõpetad oma vahetuste jagamise kasutajaga %@. Näed endiselt vahetusi, mida nad sinuga jagavad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراک‌گذاری شیفت‌های شما با %@ متوقف می‌شود. همچنان شیفت‌هایی را که با شما به اشتراک می‌گذارند می‌بینید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopetat vuorojesi jakamisen käyttäjälle %@. Näet silti vuorot, jotka hän jakaa kanssasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hihinto ka sa pagbabahagi ng mga shift mo kay %@. Makikita mo pa rin ang mga shift na ibinabahagi nila sa iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
