    "settings.pay.deleteImpact" : {
      "comment" : "Explanation in the wage entry delete confirmation of how deleting changes pay and tax.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُطبَّق الإعدادات السابقة حتى التغيير التالي. وقد يغيّر ذلك كلاً من أجر العمل في هذه الفترة والضريبة في أيام دفعها المجدولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предишните настройки ще се прилагат до следващата промяна. Това може да промени както заплащането за работа през този период, така и данъка за планираните дни на изплащане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগের সেটিংস পরবর্তী পরিবর্তন পর্যন্ত প্রযোজ্য হবে। এতে এই সময়কালের কাজের বেতন এবং নির্ধারিত বেতনদিবসে এর কর—দুটিই বদলাতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració anterior s'aplicarà fins al canvi següent. Això pot canviar tant el pagament del treball d'aquest període com els impostos dels dies de pagament programats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předchozí nastavení budou platit do další změny. To může změnit odměnu za práci v tomto období i daň v jeho naplánovaných dnech výplaty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tidligere indstillinger gælder indtil næste ændring. Det kan ændre både lønnen for arbejde i denne periode og skatten på de planlagte lønningsdage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vorherigen Einstellungen gelten bis zur nächsten Änderung. Dadurch können sich sowohl die Bezahlung für die Arbeit in diesem Zeitraum als auch die Steuer an den geplanten Zahltagen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προηγούμενες ρυθμίσεις θα ισχύουν μέχρι την επόμενη αλλαγή. Αυτό μπορεί να αλλάξει τόσο την αμοιβή για την εργασία σε αυτή την περίοδο όσο και τον φόρο στις προγραμματισμένες ημερομηνίες πληρωμής της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The previous settings will apply until the next change. This can change both pay for work in this period and tax on its scheduled paydays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración anterior se aplicará hasta el próximo cambio. Esto puede cambiar tanto el pago por el trabajo de este período como los impuestos en sus días de pago programados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eelmised seaded kehtivad järgmise muudatuseni. See võib muuta nii selle perioodi töö eest makstavat tasu kui ka kavandatud palgapäevadel arvestatavat maksu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیمات قبلی تا تغییر بعدی اعمال می‌شوند. این تغییر می‌تواند هم حقوق کار در این دوره و هم مالیات روزهای پرداخت برنامه‌ریزی‌شده آن را تغییر دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiemmat asetukset ovat voimassa seuraavaan muutokseen asti. Tämä voi muuttaa sekä tämän jakson työstä maksettavaa palkkaa että sen suunniteltujen palkanmaksupäivien veroja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malalapat ang mga nakaraang setting hanggang sa susunod na pagbabago. Maaari nitong baguhin kapwa ang bayad sa trabahong ginawa sa panahong ito at ang buwis sa mga itinakdang araw ng sahod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages précédents s’appliqueront jusqu’à la prochaine modification. Cela peut modifier à la fois la rémunération du travail effectué pendant cette période et l’impôt prélevé aux jours de paie prévus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההגדרות הקודמות יחולו עד לשינוי הבא. הדבר עשוי לשנות הן את השכר עבור העבודה בתקופה זו והן את המס במועדי התשלום המתוכננים לתקופה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली सेटिंग्स अगले बदलाव तक लागू रहेंगी। इससे इस अवधि में किए गए काम के वेतन और इसके निर्धारित वेतन-दिनों पर लगने वाले कर, दोनों बदल सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prethodne postavke primjenjivat će se do sljedeće promjene. To može promijeniti i plaću za rad u tom razdoblju i porez na planirane dane isplate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A korábbi beállítások a következő módosításig lesznek érvényesek. Ez az időszakra járó bért és a tervezett bérfizetési napokon fizetendő adót is módosíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan sebelumnya akan berlaku hingga perubahan berikutnya. Ini dapat mengubah gaji untuk pekerjaan dalam periode ini dan pajak pada hari pembayaran yang dijadwalkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrri stillingar gilda fram að næstu breytingu. Þetta getur breytt bæði launum fyrir vinnu á þessu tímabili og skatti á áætluðum launadögum tímabilsins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni precedenti si applicheranno fino alla modifica successiva. Questo può modificare sia la retribuzione per il lavoro svolto in questo periodo sia le imposte nei giorni di paga previsti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前の設定は次の変更まで適用されます。このため、この期間の勤務に対する給与と、予定された支給日にかかる税額の両方が変わる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 설정은 다음 변경 시점까지 적용됩니다. 이로 인해 이 기간의 근무 급여와 예정된 급여 지급일의 세금이 모두 변경될 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ankstesni nustatymai bus taikomi iki kito pakeitimo. Tai gali pakeisti ir atlygį už darbą šiuo laikotarpiu, ir mokesčius nustatytomis jo atlyginimo mokėjimo dienomis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iepriekšējie iestatījumi būs spēkā līdz nākamajām izmaiņām. Tas var mainīt gan samaksu par šajā periodā veikto darbu, gan nodokli plānotajās algas izmaksas dienās."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forrige innstillingene gjelder frem til neste endring. Dette kan endre både lønn for arbeid i perioden og skatt på periodens planlagte lønningsdager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vorige instellingen blijven gelden tot de volgende wijziging. Dit kan zowel het loon voor werk in deze periode als de belasting op de geplande betaaldagen ervan wijzigen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dei førre innstillingane gjeld fram til neste endring. Dette kan endre både lønna for arbeid i denne perioden og skatten på dei planlagde lønningsdagane."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprzednie ustawienia będą obowiązywać do następnej zmiany. Może to zmienić zarówno wynagrodzenie za pracę w tym okresie, jak i podatek w zaplanowanych dniach wypłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações anteriores serão aplicadas até a próxima alteração. Isso pode alterar tanto a remuneração pelo trabalho neste período quanto o imposto nas datas de pagamento programadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setările anterioare se vor aplica până la următoarea modificare. Acest lucru poate schimba atât salariul pentru munca din această perioadă, cât și impozitul aferent zilelor de plată programate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущие настройки будут действовать до следующего изменения. Это может изменить как оплату за работу в этот период, так и налог в запланированные дни выплаты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predchádzajúce nastavenia budú platiť do ďalšej zmeny. To môže zmeniť mzdu za prácu v tomto období aj daň uplatnenú v jeho plánovaných výplatných dňoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prejšnje nastavitve bodo veljale do naslednje spremembe. To lahko spremeni tako plačilo za delo v tem obdobju kot tudi davčni odtegljaj ob načrtovanih dnevih izplačila."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prethodna podešavanja važe do sledeće promene. To može promeniti i zaradu za rad u ovom periodu i porez na zakazane dane isplate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tidigare inställningarna gäller fram till nästa ändring. Detta kan ändra både lönen för arbete under denna period och skatten på periodens planerade utbetalningsdagar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mipangilio ya awali itatumika hadi mabadiliko yanayofuata. Hii inaweza kubadilisha malipo ya kazi katika kipindi hiki na kodi katika siku zake za malipo zilizopangwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முந்தைய அமைப்புகள் அடுத்த மாற்றம் வரை அமலில் இருக்கும். இது, இந்தக் காலத்தில் செய்யப்பட்ட வேலைக்கான ஊதியத்தையும், அதன் திட்டமிடப்பட்ட சம்பள நாட்களுக்கான வரியையும் மாற்றலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าก่อนหน้านี้จะมีผลจนกว่าจะมีการเปลี่ยนแปลงครั้งถัดไป ซึ่งอาจเปลี่ยนทั้งค่าจ้างสำหรับการทำงานในช่วงเวลานี้และภาษีในวันจ่ายตามกำหนด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki ayarlar bir sonraki değişikliğe kadar uygulanır. Bu, hem bu dönemdeki çalışma ücretini hem de planlanan ödeme günlerindeki vergiyi değiştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередні налаштування діятимуть до наступної зміни. Це може змінити як оплату за роботу в цей період, так і податок у заплановані дні виплати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پچھلی ترتیبات اگلی تبدیلی تک لاگو رہیں گی۔ اس سے اس مدت کے کام کی اجرت اور اس کی مقررہ ادائیگی کے دنوں پر ٹیکس، دونوں تبدیل ہو سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt trước đó sẽ được áp dụng cho đến lần thay đổi tiếp theo. Điều này có thể thay đổi cả tiền lương cho công việc trong kỳ này và thuế vào các ngày trả lương theo lịch của kỳ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前的设置将一直适用到下次更改。这可能会同时影响本期间的工作薪资以及预定发薪日的税款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先前的設定會套用至下一次變更。這可能會同時影響此期間的工作薪資，以及其預定發薪日的稅額。"
          }
        }
      }
    },
