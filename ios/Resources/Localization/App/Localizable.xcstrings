    "data.export.csv.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معلومات النوبة لكل نوبة بترتيب زمني. يتضمن المجاميع في النهاية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Информация за смяна по смяна в хронологичен ред. Включва суми в края."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কালানুক্রমিক ক্রমে প্রতিটি শিফটে শিফট তথ্য। শেষে মোট অন্তর্ভুক্ত করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informació de vakt per vakt en ordre cronològic. Inclou totals al final."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
