    "profile.emailChange.instructions" : {
      "comment" : "Instructions at the top of the email change sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل عنوان بريدك الإلكتروني الجديد. سنرسل تأكيدًا إلى عنوانك القديم والجديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишете вашия нов имейл адрес. Ще изпратим потвърждение и на стария, и на новия адрес."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নতুন ইমেল ঠিকানা প্রবেশ করুন। আমরা আপনার পুরানো এবং নতুন উভয় ঠিকানায় একটি নিশ্চিতকরণ পাঠাব।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu la teva nova adreça de correu electrònic. T'enviarem una confirmació tant a la teva adreça antiga com a la nova."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte svou novou e-mailovou adresu. Odešleme potvrzení na vaši starou i novou adresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast din nye e-postadresse. Vi sender en bekræftelse til både din gamle og nye adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deine neue E-Mail-Adresse ein. Wir senden eine Bestätigung an deine alte und neue Adresse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισάγετε τη νέα σας διεύθυνση ηλεκτρονικού ταχυδρομείου. Θα στείλουμε μια επιβεβαίωση στη παλιά και τη νέα σας διεύθυνση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your new email address. We'll send a confirmation to both your old and new address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa tu nueva dirección de correo electrónico. Enviaremos una confirmación a tu correo antiguo y nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisesta oma uus e-posti aadress. Saadame kinnituse nii vana kui ka uue aadressi peale."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آدرس ایمیل جدید خود را وارد کنید. ما تأیید را به هر دو آدرس قدیم و جدید ارسال خواهیم کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita uusi sähköpostiosoitteesi. Lähetämme vahvistuksen sekä vanhaan että uuteen osoitteeseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
