        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz jak mówisz. Wagey rozumie wszystkie języki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите так, как вы говорите. Wagey понимает все языки."
