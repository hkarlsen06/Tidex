    "onboarding.wage.tariffHint" : {
      "comment" : "Hint above the Norwegian tariff level list in onboarding. Keep the Norwegian words tariffavtale and lønnstrinn in parentheses so immigrant workers can match them to their contract.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي هذه الأجور من اتفاقية عمل جماعية نرويجية (tariffavtale). اختر الاتفاقية ودرجة الأجر (lønnstrinn) المذكورة في عقد عملك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези ставки са от норвежки колективен трудов договор (tariffavtale). Изберете договора и степента на заплащане (lønnstrinn) от трудовия си договор."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই হারগুলো নরওয়ের একটি যৌথ চুক্তি (tariffavtale) থেকে নেওয়া। আপনার চাকরির চুক্তি অনুযায়ী চুক্তি এবং বেতন স্তর (lønnstrinn) বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquestes tarifes provenen d'un conveni col·lectiu noruec (tariffavtale). Tria el conveni i el nivell salarial (lønnstrinn) del teu contracte de treball."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto sazby pocházejí z norské kolektivní smlouvy (tariffavtale). Vyberte smlouvu a mzdový stupeň (lønnstrinn) podle své pracovní smlouvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satserne kommer fra en norsk overenskomst (tariffavtale). Vælg overenskomsten og løntrinnet (lønnstrinn) fra din ansættelseskontrakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sätze stammen aus einem norwegischen Tarifvertrag (tariffavtale). Wähle den Tarifvertrag und die Lohnstufe (lønnstrinn) aus deinem Arbeitsvertrag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι αμοιβές προέρχονται από νορβηγική συλλογική σύμβαση (tariffavtale). Επιλέξτε τη σύμβαση και το μισθολογικό κλιμάκιο (lønnstrinn) από τη σύμβαση εργασίας σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These rates come from a Norwegian collective agreement (tariffavtale). Pick the agreement and wage level (lønnstrinn) in your employment contract."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas tarifas provienen de un convenio colectivo noruego (tariffavtale). Elige el convenio y el nivel salarial (lønnstrinn) que figuran en tu contrato de trabajo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need määrad pärinevad Norra kollektiivlepingust (tariffavtale). Vali leping ja palgaaste (lønnstrinn) oma töölepingu järgi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نرخ‌ها از یک قرارداد جمعی کار نروژی (tariffavtale) آمده‌اند. قرارداد و پایه حقوق (lønnstrinn) را طبق قرارداد کاری خود انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palkat perustuvat norjalaiseen työehtosopimukseen (tariffavtale). Valitse sopimus ja palkkaluokka (lønnstrinn) työsopimuksesi mukaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galing ang mga rate na ito sa isang collective agreement sa Norway (tariffavtale). Piliin ang kasunduan at antas ng sahod (lønnstrinn) na nasa iyong kontrata sa trabaho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces taux proviennent d'une convention collective norvégienne (tariffavtale). Choisissez la convention et l'échelon salarial (lønnstrinn) indiqués dans votre contrat de travail."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התעריפים האלה לקוחים מהסכם קיבוצי נורווגי (tariffavtale). בחר את ההסכם ואת דרגת השכר (lønnstrinn) שמופיעים בחוזה העבודה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये दरें नॉर्वे के सामूहिक समझौते (tariffavtale) से ली गई हैं। अपने रोज़गार अनुबंध के अनुसार समझौता और वेतन स्तर (lønnstrinn) चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ove satnice potječu iz norveškog kolektivnog ugovora (tariffavtale). Odaberite ugovor i platni razred (lønnstrinn) iz svog ugovora o radu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a bérek egy norvég kollektív szerződésből (tariffavtale) származnak. Válaszd ki a szerződést és a bérfokozatot (lønnstrinn) a munkaszerződésed alapján."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarif ini berasal dari perjanjian kerja bersama Norwegia (tariffavtale). Pilih perjanjian dan tingkat gaji (lønnstrinn) sesuai kontrak kerja Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxtarnir koma úr norskum kjarasamningi (tariffavtale). Veldu samninginn og launaþrepið (lønnstrinn) sem stendur í ráðningarsamningnum þínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste tariffe provengono da un contratto collettivo norvegese (tariffavtale). Scegli il contratto e il livello retributivo (lønnstrinn) indicati nel tuo contratto di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの賃金はノルウェーの労働協約（tariffavtale）に基づいています。雇用契約書に記載された協約と賃金等級（lønnstrinn）を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 임금은 노르웨이 단체협약(tariffavtale)에 따른 것입니다. 근로계약서에 적힌 협약과 임금 등급(lønnstrinn)을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šie tarifai paimti iš Norvegijos kolektyvinės sutarties (tariffavtale). Pasirinkite sutartį ir atlyginimo pakopą (lønnstrinn), nurodytą jūsų darbo sutartyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šīs likmes nāk no Norvēģijas darba koplīguma (tariffavtale). Izvēlieties līgumu un algas pakāpi (lønnstrinn), kas norādīta jūsu darba līgumā."
