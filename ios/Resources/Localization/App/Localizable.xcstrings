    "data.export.calendar.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدر نوبك إلى تطبيق التقويم على جهازك. ينشئ تقويماً مخصصاً \"نوبات Tidex\" يمكنك حذفه في أي وقت لإزالة جميع الأحداث المصدرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортирайте вашите смени в календарното приложение на вашето устройство. Създава специален календар \"Tidex смени\", който можете да изтриете по всяко време, за да премахнете всички експортирани събития."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার শিফটগুলি আপনার ডিভাইসের ক্যালেন্ডার অ্যাপে রপ্তানি করুন। একটি ডেডিকেটেড \"Tidex শিফট\" ক্যালেন্ডার তৈরি করে যা আপনি যেকোনো সময় মুছে ফেলতে পারেন সমস্ত রপ্তানিকৃত ইভেন্ট সরাতে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta les teves vakts a l'aplicació de calendari del dispositiu. Crea un calendari dedicat \"Tidex Vakts\" que pots eliminar en qualsevol moment per eliminar tots els events exportats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte své vakty do aplikace kalendáře vašeho zařízení. Vytvoří vyhrazený kalendář \"Tidex Vakty\", který můžete kdykoli smazat a odstranit všechny exportované události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter vaktene dine til enhedens kalenderapp. Oppretter en dedikeret \"Tidex Vakter\" kalender, som du kan slette når som helst for at fjerne alle eksporterede begivenheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren Sie Ihre Schichten in die Kalender-App Ihres Geräts. Erstellt einen dedizierten Kalender \"Tidex Schichten\", den Sie jederzeit löschen können, um alle exportierten Ereignisse zu entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξάγετε τις vακές σας στην εφαρμογή ημερολογίου της συσκευής σας. Δημιουργεί ένα αποκλειστικό ημερολόγιο \"Tidex Vακές\" που μπορείτε να διαγράψετε οποτεδήποτε για να αφαιρέσετε όλα τα εξαγόμενα γεγονότα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your shifts to your device's calendar app. Creates a dedicated \"Tidex Shifts\" calendar that you can delete anytime to remove all exported events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta tus vakatas al calendario de tu dispositivo. Crea un calendario dedicado \"Tidex Vakat\" que puedes eliminar en cualquier momento para quitar todos los eventos exportados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspordi oma vahetused oma seadme kalendrirakendusesse. Loob spetsiaalse \"Tidex vahetused\" kalendri, mille saad igal ajal kustutada, et eemaldada kõik eksporditud sündmused."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیفت‌های خود را به برنامه تقویم دستگاه صادر کنید. یک تقویم اختصاصی \"شیفت‌های Tidex\" ایجاد می‌کند که می‌توانید در هر زمان حذف کنید تا تمام رویدادهای صادر شده حذف شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vie vuorot laitteesi kalenterisovellukseen. Luo varatun \"Tidex Vuorot\" -kalenterin, jonka voit poistaa milloin tahansa poistaaksesi kaikki viedyt tapahtumat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-export ang iyong shifts sa calendar app ng iyong device. Lumilikha ng dedicated na \"Tidex Shifts\" calendar na maaari mong alisin anumang oras upang tanggalin ang lahat ng na-export na events."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos vactions vers l'app Calendrier de votre appareil. Crée un calendrier dédié \"Tidex Vactions\" que vous pouvez supprimer à tout moment pour retirer tous les événements exportés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייצא את משמרותיך לאפליקציית הליווח של המכשיר. יוצר ליווח ייעודי \"משמרות Tidex\" שתוכל למחוק בכל עת כדי להסיר את כל האירועים המיוצאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी शिफ्ट को अपने डिवाइस के कैलेंडर ऐप में निर्यात करें। एक समर्पित \"Tidex शिफ्ट\" कैलेंडर बनाता है जिसे आप सभी निर्यात की गई घटनाओं को हटाने के लिए किसी भी समय हटा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvezite svoje vakte u aplikaciju kalendara na vašem uređaju. Kreira odvojeni \"Tidex Vakte\" kalendar koji možete obrisati bilo kada da uklonite sve izvezene događaje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportálja műszakait az eszköz naptáralkalmazásába. Létrehoz egy dedikált \"Tidex Műszakok\" naptárat, amely bármikor törölhető az összes exportált esemény eltávolításához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor vakt Anda ke aplikasi kalender perangkat. Membuat kalender \"Tidex Vakter\" khusus yang dapat Anda hapus kapan saja untuk menghapus semua acara yang diekspor."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttu vaktirnar þínar út í dagatalsforrit tækisins. Býr til sérstakt \"Tidex vaktir\" dagatal sem þú getur eytt hvenær sem er til að fjarlægja allar útfluttar atburði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta le tue vakte nell'app calendario del tuo dispositivo. Crea un calendario dedicato \"Tidex Vakte\" che puoi eliminare in qualsiasi momento per rimuovere tutti gli eventi esportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シフトをデバイスのカレンダーアプリにエクスポートします。専用の「Tidex シフト」カレンダーが作成され、いつでも削除してすべてのエクスポート済みイベントを削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근무 일정을 기기의 캘린더 앱으로 내보내세요. 언제든지 삭제할 수 있는 \"Tidex 근무\" 캘린더를 생성하여 모든 내보낸 일정을 제거할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuokite savo pamainas į savo įrenginio kalendoriaus programą. Sukuria dedikuotą \"Tidex Pamainos\" kalendorių, kurį galite bet kada ištrinti, kad pašalintumėte visus eksportuotus įvykius."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportējiet savas maiņas uz jūsu ierīces kalendāra lietotni. Izveido jums pieguvušu \"Tidex maiņas\" kalendāru, ko jūs varat jebkurā laikā dzēst, lai noņemtu visus eksportētos notikumus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter vaktene dine til enhetens kalenderapp. Oppretter en dedikert \"Tidex Vakter\" kalender som du kan slette når som helst for å fjerne alle eksporterte hendelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer je vaken naar de kalender-app van je apparaat. Maakt een speciale \"Tidex Vaken\" kalender aan die je op elk moment kunt verwijderen om alle geëxporteerde evenementen te verwijderen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter vaktene dine til enhetens kalenderapp. Oppretter en dedikert \"Tidex Vakter\" kalender som du kan slette når som helst for å fjerne alle eksporterte hendelser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuj swoje vachty do aplikacji kalendarza na urządzeniu. Tworzy dedykowany kalendarz \"Tidex Vachty\", który możesz usunąć w dowolnym momencie, aby usunąć wszystkie wyeksportowane wydarzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte seus turnos para o aplicativo de calendário do seu dispositivo. Cria um calendário dedicado \"Tidex Turnos\" que você pode deletar a qualquer momento para remover todos os eventos exportados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportă-ți vactele în aplicația calendar a dispozitivului. Creează un calendar dedicat \"Tidex Shifts\" pe care îl poți șterge oricând pentru a elimina toate evenimentele exportate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортируйте свои вахты в календарь устройства. Создает выделенный календарь \"Tidex Вахты\", который вы можете удалить в любое время, чтобы удалить все экспортированные события."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte svoje vakty do aplikácie kalendára svojho zariadenia. Vytvorí vyhradený kalendár \"Tidex Vakty\", ktorý môžete kedykoľvek vymazať, aby ste odstránili všetky exportované udalosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvozite svoje vakte v aplikacijo Koledar na vaši napravi. Ustvari namenski \"Tidex Vakte\" koledar, ki ga lahko kadarkoli izbrišete, da odstranite vse izvožene dogodke."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvezite svoje vakte u aplikaciju kalendara vaše uređaja. Kreira dedicirani kalendar \"Tidex Vakte\" koji možete obrisati bilo kada da uklonite sve izvezene događaje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportera dina vakter till enhetens kalenderapp. Skapar en dedikerad \"Tidex Vakter\"-kalender som du kan ta bort när som helst för att ta bort alla exporterade händelser."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamisha zamu zako kwenye programu ya kalenda ya kifaa chako. Huunda kalenda inayobadilika \"Tidex Zamu\" ambayo unaweza kufuta wakati wowote ili kuondoa matukio yote yaliyohamishwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வேலைகளை உங்கள் சாதனத்தின் நாட்காட்டி பயன்பாட்டிற்கு ஏற்றுமதி செய்யவும். \"Tidex வேலைகள்\" நாட்காட்டি உருவாக்குகிறது, இது அனைத்து ஏற்றுமதி செய்யப்பட்ட நிகழ்வுகளை அகற்ற எப்போது வேண்டுமானாலும் நீக்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งออกเวลาทำงานของคุณไปยังแอปปฏิทินของอุปกรณ์ของคุณ สร้างปฏิทิน \"Tidex Shifts\" ที่อุทิศให้ซึ่งคุณสามารถลบได้ตลอดเวลาเพื่อลบอีเวนต์ที่ส่งออกทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vardiyalarınızı cihazınızın takvim uygulamasına aktarın. Tüm aktarılan etkinlikleri kaldırmak için istediğiniz zaman silebileceğiniz \"Tidex Vardiyaları\" adlı özel bir takvim oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортуйте свої вахти до календарної програми вашого пристрою. Створює спеціальний календар \"Tidex Вахти\", який ви можете видалити будь-коли, щоб видалити всі експортовані eventi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی شفٹوں کو اپنے ڈیوائس کے کیلنڈر ایپ میں برآمد کریں۔ ایک مخصوص \"Tidex شفٹیں\" کیلنڈر بناتا ہے جسے آپ تمام برآمد شدہ ایونٹس کو ہٹانے کے لیے کسی بھی وقت حذف کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xuất các ca làm việc của bạn sang ứng dụng lịch của thiết bị. Tạo một lịch \"Tidex Shifts\" chuyên dụng mà bạn có thể xóa bất kỳ lúc nào để loại bỏ tất cả các sự kiện được xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将您的班次导出到设备的日历应用。创建一个专用的"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將您的班次匯出到您設備的日曆應用程式。建立一個專用的「Tidex班次」日曆，您可以隨時刪除以移除所有匯出的事件。"
          }
        }
      }
    },
