    "profile.imageCrop.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch to zoom, drag to move"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klyp for å zoome, dra for å flytte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zoomen zusammendrücken, zum Verschieben ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para zoom, arrastra para mover"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoomer, glissez pour déplacer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチでズーム、ドラッグで移動"
