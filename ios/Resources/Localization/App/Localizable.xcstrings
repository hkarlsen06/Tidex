    "alerts.storageIssue.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حفظ البيانات في ذاكرة الجهاز. التغييرات الخاصة بك لن يتم حفظها عند إغلاق التطبيق. يرجى إعادة تشغيل التطبيق أو التحقق من ذاكرة الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не може да се запасят данни на устройството. Вашите промени няма да бъдат запазени, когато приложението се затвори. Моля, рестартирайте приложението или проверете хранилището на устройството."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিভাইস স্টোরেজে ডেটা সংরক্ষণ করতে অক্ষম। অ্যাপ বন্ধ হলে আপনার পরিবর্তনগুলি সংরক্ষিত হবে না। অ্যাপটি পুনরায় চালু করুন বা আপনার ডিভাইস স্টোরেজ পরীক্ষা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es poden guardar les dades a l'emmagatzematge del dispositiu. Els canvis no es guardaran quan es tanqui l'aplicació. Reinicia l'aplicació o comprova l'emmagatzematge del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze uložit data do úložiště zařízení. Vaše změny nebudou uloženy při zavření aplikace. Restartujte aplikaci nebo zkontrolujte úložiště zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke gemme data til enhedslager. Dine ændringer gemmes ikke, når appen lukkes. Genstarten appen eller kontroller dit enhedslager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten können nicht auf dem Gerät gespeichert werden. Deine Änderungen werden nicht gespeichert, wenn die App geschlossen wird. Starten Sie die App neu oder überprüfen Sie den Gerätespeicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η αποθήκευση δεδομένων στο χώρο αποθήκευσης της συσκευής. Οι αλλαγές σας δεν θα αποθηκευτούν όταν κλείνει η εφαρμογή. Επανεκκινήστε την εφαρμογή ή ελέγξτε το χώρο αποθήκευσης της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to save data to device storage. Your changes will not be saved when the app closes. Please restart the app or check your device storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden guardar los datos en el almacenamiento del dispositivo. Los cambios no se guardarán cuando cierres la aplicación. Reinicia la aplicación o verifica el almacenamiento del dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andmete salvestamine seadme mällu ei õnnestunud. Sinu muudatused ei salvestu rakenduse sulgemisel. Käivita rakendus uuesti või kontrolli seadme mälu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امکان ذخیره داده‌ها در حافظه دستگاه وجود ندارد. تغییرات شما هنگام بسته شدن برنامه ذخیره نخواهند شد. لطفاً برنامه را دوباره راه‌اندازی کنید یا حافظه دستگاه خود را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietoja ei voi tallentaa laitteen tallennustilaan. Muutoksiasi ei tallenneta, kun sovellus suljetaan. Käynnistä sovellus uudelleen tai tarkista laitteen tallennustila."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maaaring magsave ng data sa device storage. Ang iyong mga pagbabago ay hindi mase-save kapag isinara ang app. Mangyaring i-restart ang app o suriin ang iyong device storage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer les données sur le stockage de l'appareil. Vos modifications ne seront pas sauvegardées à la fermeture de l'application. Redémarrez l'application ou vérifiez le stockage de votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשמור נתונים לאחסון ההתקן. השינויים שלך לא יישמרו כאשר האפליקציה תיסגר. אנא הפעל את האפליקציה מחדש או בדוק את אחסון ההתקן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस स्टोरेज में डेटा सहेजने में असमर्थ। जब ऐप बंद हो तो आपके परिवर्तन सहेजे नहीं जाएंगे। ऐप को पुनः शुरू करें या अपने डिवाइस स्टोरेज की जांच करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće spremiti podatke u memoriju uređaja. Vaše izmjene neće biti spremljene kada se aplikacija zatvori. Molim restartajte aplikaciju ili provjerite memoriju uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült az adatokat az eszköz tárhelyére menteni. A módosítások nem kerülnek mentésre az alkalmazás bezárásakor. Indítsa újra az alkalmazást vagy ellenőrizze az eszköz tárhely-használatát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menyimpan data ke penyimpanan perangkat. Perubahan Anda tidak akan disimpan saat aplikasi ditutup. Mulai ulang aplikasi atau periksa penyimpanan perangkat Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki var hægt að vista gögn á geymslu tækisins. Breytingarnar þínar verða ekki vistaðar þegar appið lokar. Endurræstu appið eða athugaðu geymslu tækisins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare i dati nell'archivio del dispositivo. Le tue modifiche non verranno salvate quando l'app si chiude. Riavvia l'app o controlla l'archivio del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスストレージにデータを保存できません。アプリを閉じるときに変更が保存されません。アプリを再起動するか、デバイスストレージを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 저장소에 데이터를 저장할 수 없습니다. 앱을 닫을 때 변경 사항이 저장되지 않습니다. 앱을 다시 시작하거나 기기 저장소를 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko išsaugoti duomenų į įrenginio saugyklą. Jūsų pakeitimai nebus išsaugoti uždarius programą. Iš naujo paleiskite programą arba patikrinkite jūsų įrenginio saugyklą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevar saglabāt datus ierīces krātuvē. Jūsu izmaiņas netiks saglabātas, aizvērojot lietotni. Lūdzu, restartējiet lietotni vai pārbaudiet ierīces krātuvi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke lagre data til enhetslagring. Endringene dine blir ikke lagret når appen lukkes. Start appen på nytt eller sjekk enhetslagringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan gegevens niet opslaan in apparaatopslag. Uw wijzigingen worden niet opgeslagen wanneer de app sluit. Start de app opnieuw op of controleer uw apparaatopslag."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikkje lagre data til einingslager. Endringane dine blir ikkje lagra når appen lukkar. Start appen på nytt eller sjekk einingslager."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można zapisać danych do pamięci urządzenia. Zmiany nie będą zapisane po zamknięciu aplikacji. Uruchom ponownie aplikację lub sprawdź pamięć urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar dados no armazenamento do dispositivo. Suas alterações não serão salvas quando o aplicativo fechar. Reinicie o aplicativo ou verifique o armazenamento do dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se pot salva datele în memoria dispozitivului. Modificările tale nu vor fi salvate când se închide aplicația. Repornește aplicația sau verifică memoria dispozitivului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается сохранить данные в хранилище устройства. Ваши изменения не будут сохранены при закрытии приложения. Перезагрузите приложение или проверьте хранилище устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie je možné uložiť údaje do úložiska zariadenia. Vaše zmeny sa nebudú uložené, keď sa aplikácia zatvorí. Reštartujte aplikáciu alebo skontrolujte úložisko zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatkov ni mogoče shraniti v pomnilnik naprave. Vaše spremembe ne bodo shranjene ob zaprtju aplikacije. Ponovno zaženite aplikacijo ali preverite pomnilnik naprave."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće sačuvati podatke u memoriju uređaja. Vaše izmene neće biti sačuvane kada se aplikacija zatvori. Pokrenite aplikaciju iznova ili proverite memoriju uređaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte spara data till enhetens lagring. Dina ändringar sparas inte när appen stängs. Starta om appen eller kontrollera enhetens lagring."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiwezi kuokoa data kwa hifadhi ya kifaa. Mabadiliko yako hayatahifadhiwa wakati programu inafungwa. Tafadhali anzisha upya programu au angalia hifadhi ya kifaa chako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சாதன சேமிப்பகத்தில் தரவைச் சேமிக்க முடியவில்லை. ஆப்ப்ளிகேஷன் மூடப்படும் போது உங்கள் மாற்றங்கள் சேமிக்கப்படாது. தயவுசெய்து ஆப்ப்ளிகேஷனை மீண்டுமுயற்சிக்கவும் அல்லது உங்கள் சாதன சேமிப்பகத்தைச் சரிபார்க்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถบันทึกข้อมูลลงในที่จัดเก็บของอุปกรณ์ได้ การเปลี่ยนแปลงของคุณจะไม่ถูกบันทึกเมื่อปิดแอป โปรดเปิดแอปใหม่หรือตรวจสอบที่จัดเก็บของอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veriler cihaz depolama alanına kaydedilemiyor. Uygulama kapandığında değişiklikleriniz kaydedilmeyecektir. Lütfen uygulamayı yeniden başlatın veya cihaz depolama alanınızı kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається зберегти дані у сховище пристрою. Ваші зміни не будуть збережені при закритті програми. Перезавантажте програму або перевірте сховище пристрою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈیوائس سٹوریج میں ڈیٹا محفوظ نہیں کر سکتے۔ جب ایپ بند ہوگی تو آپ کی تبدیلیاں محفوظ نہیں ہوں گی۔ براہ کرم ایپ دوبارہ شروع کریں یا اپنی ڈیوائس سٹوریج چیک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
