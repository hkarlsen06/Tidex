    "sharing.hidden.description" : {
      "comment" : "Footer under the list of hidden friends in the Add friend sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأشخاص الذين تخفيهم يظلون أصدقاءك. لكنهم لا يظهرون في قائمة أصدقائك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хората, които скривате, все още са ваши приятели. Те просто не се показват в списъка ви с приятели."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যাদের লুকান, তারা এখনও আপনার বন্ধু। তারা শুধু আপনার বন্ধুদের তালিকায় দেখা যায় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les persones que ocultes continuen sent amigues teves. Simplement no apareixen a la teva llista d'amics."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidé, které skryjete, zůstávají vašimi přáteli. Jen se nezobrazují ve vašem seznamu přátel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personer, du skjuler, er stadig dine venner. De vises bare ikke på din venneliste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen, die du ausblendest, bleiben deine Freunde. Sie werden nur nicht in deiner Freundesliste angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα άτομα που κρύβετε παραμένουν φίλοι σας. Απλώς δεν εμφανίζονται στη λίστα φίλων σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People you hide are still your friends. They just don't appear in your friends list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas que ocultas siguen siendo tus amigos. Simplemente no aparecen en tu lista de amigos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peidetud inimesed on endiselt sinu sõbrad. Neid lihtsalt ei kuvata sõprade loendis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افرادی که پنهان می‌کنید همچنان دوستان شما هستند. فقط در فهرست دوستانتان نمایش داده نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottamasi henkilöt ovat edelleen ystäviäsi. He eivät vain näy ystävälistallasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaibigan mo pa rin ang mga taong itinatago mo. Hindi lang sila lumalabas sa listahan ng iyong mga kaibigan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes que vous masquez restent vos amis. Elles n'apparaissent simplement pas dans votre liste d'amis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנשים שהסתרתם עדיין חברים שלכם. הם פשוט לא מופיעים ברשימת החברים שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन लोगों को आप छिपाते हैं, वे अब भी आपके मित्र हैं। वे आपकी मित्र सूची में दिखाई नहीं देते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobe koje sakrijete i dalje su vam prijatelji. Samo se ne prikazuju na vašem popisu prijatelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elrejtett személyek továbbra is a barátaid. Csak nem jelennek meg a barátlistádon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang Anda sembunyikan tetap menjadi teman Anda. Mereka hanya tidak muncul di daftar teman."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fólk sem þú felur er enn meðal vina þinna. Það birtist bara ekki á vinalistanum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che nascondi restano comunque tra i tuoi amici. Semplicemente non compaiono nell'elenco amici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示にした人も友達のままです。友達リストに表示されないだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨긴 사람도 여전히 친구입니다. 친구 목록에만 표시되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žmonės, kuriuos slepiate, vis dar yra jūsų draugai. Jie tiesiog nerodomi jūsų draugų sąraše."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilvēki, kurus paslēpjat, joprojām ir jūsu draugi. Viņi vienkārši netiek rādīti jūsu draugu sarakstā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personer du skjuler er fortsatt vennene dine. De vises bare ikke i vennelisten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen die je verbergt, zijn nog steeds je vrienden. Ze verschijnen alleen niet in je vriendenlijst."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personar du skjuler, er framleis venene dine. Dei blir berre ikkje viste i venelista."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby, które ukryjesz, nadal są Twoimi znajomymi. Po prostu nie są widoczne na liście znajomych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas que você oculta continuam sendo suas amigas. Elas apenas não aparecem na sua lista de amigos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoanele pe care le ascunzi rămân prietenii tăi. Doar că nu apar în lista ta de prieteni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые вами люди остаются вашими друзьями. Они просто не отображаются в списке друзей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ľudia, ktorých skryjete, sú stále vašimi priateľmi. Len sa nezobrazujú vo vašom zozname priateľov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osebe, ki jih skrijete, so še vedno vaši prijatelji. Le na vašem seznamu prijateljev niso prikazane."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobe koje sakrijete i dalje su vaši prijatelji. Samo se ne prikazuju na listi prijatelja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personer du döljer är fortfarande dina vänner. De visas bara inte i din vänlista."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watu unaowaficha bado ni marafiki zako. Hawaonekani tu kwenye orodha yako ya marafiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் மறைக்கும் நபர்கள் இன்னும் உங்கள் நண்பர்களே. அவர்கள் உங்கள் நண்பர்கள் பட்டியலில் மட்டும் தோன்றமாட்டார்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่คุณซ่อนไว้ยังคงเป็นเพื่อนของคุณ เพียงแต่จะไม่ปรากฏในรายชื่อเพื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlediğiniz kişiler hâlâ arkadaşlarınızdır. Yalnızca arkadaş listenizde görünmezler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди, яких ви приховали, усе ще є вашими друзями. Вони просто не відображаються у вашому списку друзів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جن لوگوں کو آپ چھپاتے ہیں وہ اب بھی آپ کے دوست ہیں۔ وہ صرف آپ کی دوستوں کی فہرست میں نظر نہیں آتے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những người bạn ẩn vẫn là bạn bè của bạn. Họ chỉ không xuất hiện trong danh sách bạn bè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的用户仍是你的好友，只是不会出现在好友列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你隱藏的人仍是你的朋友，只是不會出現在好友清單中。"
          }
        }
      }
    },
