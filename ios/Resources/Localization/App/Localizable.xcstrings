          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize para desbloquear todos os recursos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновитесь, чтобы разблокировать все функции"
