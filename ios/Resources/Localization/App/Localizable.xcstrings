    "onboarding.mfa.benefit1.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى لو حصل شخص ما على كلمة مرورك، فإنه لا يزال بحاجة إلى هاتفك"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дори ако някой получи вашата парола, все още има нужда от вашия телефон"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ যদি আপনার পাসওয়ার্ড পায়, তবুও তাদের আপনার ফোন প্রয়োজন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara que algú obtingui la teva contrasenya, encara necessita el teu telèfon"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I když někdo získá vaše heslo, stále potřebuje váš telefon"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvom nogen får dit kodeord, har de stadig brug for din telefon"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst wenn jemand dein Passwort erhält, braucht er auch dein Telefon"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα κι αν κάποιος αποκτήσει τον κωδικό πρόσβασής σας, χρειάζεται ακόμα το τηλέφωνό σας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if someone gets your password, they still need your phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso si alguien obtiene tu contraseña, aún necesita tu teléfono"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isegi kui keegi saab sinu parooli, vajavad nad ka sinu telefoni"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتی اگر کسی رمز عبور شما را به دست آورد، باز هم به تلفن شما نیاز دارد"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka joku saaisi salasanasi, tarvitsee silti puhelimesi"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahit na makuha ng iba ang iyong password, kailangan pa rin nila ang iyong telepono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même si quelqu'un obtient votre mot de passe, il a toujours besoin de votre téléphone"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גם אם מישהו יקבל את הסיסמה שלך, הוא עדיין יצטרך את הטלפון שלך"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भले ही कोई आपका पासवर्ड प्राप्त कर ले, फिर भी उन्हें आपके फोन की आवश्यकता है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čak i ako netko dobije tvoju lozinku, trebaju i tvoj telefon"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még ha valaki meg is szerzi a jelszavad, továbbra is szüksége van a telefonodra"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahkan jika seseorang mendapatkan kata sandi Anda, mereka tetap memerlukan ponsel Anda"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jafnvel þó að einhver fái aðgangsorðið þitt, þarf hinn enn símann þinn"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche se qualcuno ottiene la tua password, ha comunque bisogno del tuo telefono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがパスワードを入手しても、彼らはまだあなたの電話が必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 비밀번호를 알아도 휴대폰이 필요합니다"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net jei kas nors sužinos jūsų slaptažodį, jam vis tiek reikia jūsų telefono"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pat ja kāds iegūtu jūsu paroli, viņiem joprojām būtu nepieciešams jūsu telefons"
