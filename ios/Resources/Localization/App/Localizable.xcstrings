    "paywall.shiftLimit.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free plan allows shifts in one month at a time. Upgrade to track shifts across multiple months."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-planen tillater vakter i én måned om gangen. Oppgrader for å spore vakter over flere måneder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Plan ermöglicht Schichten in einem Monat gleichzeitig. Upgrade, um Schichten über mehrere Monate zu verfolgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan gratuit permet les quarts dans un mois à la fois. Passez à la version premium pour suivre les quarts sur plusieurs mois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito permite vueltas en un mes a la vez. Actualiza para rastrear vueltas en varios meses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano gratuito consente vakte in un mese alla volta. Effettua l'upgrade per tracciare vakte su più mesi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gratis abonnement biedt diensten in één maand tegelijk. Upgrade om diensten over meerdere maanden bij te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito permite vakt em um mês por vez. Atualize para rastrear vakt em vários meses."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-planen tillåter vakter under en månad i taget. Uppgradera för att spåra vakter över flera månader."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-planen tillader vakter i én måned ad gangen. Opgrader for at spore vakter over flere måneder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen suunnitelma sallii vuoroja yhdessä kuukaudessa kerrallaan. Päivitä seurataksesi vuoroja useiden kuukausien aikana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan darmowy pozwala na śledzenie wakt w jednym miesiącu na raz. Przejdź na plan płatny, aby śledzić wakty przez wiele miesięcy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный план позволяет отслеживать смены в течение одного месяца. Обновитесь, чтобы отслеживать смены за несколько месяцев."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безплатний план дозволяє вакти протягом одного місяця за раз. Оновіться, щоб стежити вакти протягом кількох місяців."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランでは1度に1ヶ月分のシフトを記録できます。複数月のシフトを追跡するにはアップグレードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 요금제는 한 번에 한 달의 근무만 허용합니다. 업그레이드하여 여러 달에 걸친 근무를 추적하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费计划允许一次追踪一个月的班次。升级后可追踪多个月份的班次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนฟรีอนุญาตให้บันทึกวัคติในหนึ่งเดือนต่อครั้ง อัปเกรดเพื่อติดตามวัคติหลายเดือน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói miễn phí cho phép ca làm việc trong một tháng. Nâng cấp để theo dõi ca làm việc trên nhiều tháng."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-planen tillèt vakter i éin månad om gongen. Oppgrader for å sporé vakter over fleire månader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz plan bir defada bir aylık vakt takibi sağlar. Birden fazla ay boyunca vakt takibi yapmak için yükselt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δωρεάν σχέδιο επιτρέπει βάρδιες σε έναν μήνα τη φορά. Αναβαθμίστε για να παρακολουθείτε βάρδιες σε πολλούς μήνες."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul gratuit permite vachete într-o lună la un moment dat. Fă upgrade pentru a urmări vachete pe mai multe luni."
          }
        }
      }
    },
