    "events.notifications.timed_picker.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر قبل كم من الوقت من الحدث تريد أن يصلك إشعار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете колко време преди събитието да бъдете уведомени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইভেন্টের কত আগে বিজ্ঞপ্তি পেতে চান তা বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quant temps abans de l'esdeveniment vols rebre l'avís."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho před událostí chcete dostat oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg hvor længe før din begivenhed du vil varsles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange vor dem Ereignis du benachrichtigt werden möchtest."
