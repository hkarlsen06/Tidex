          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получать уведомления, включите их в приложении «Параметры»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om meldingen te ontvangen, schakel ze in in de app Instellingen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera dem i Inställningar-appen för att få aviseringar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at modtage notifikationer skal du aktivere dem i Indstillinger-appen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere notifiche, abilitale nell'app Impostazioni"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ilmoitukset käyttöön Asetukset-sovelluksessa saadaksesi ilmoituksia"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
