    "paywall.upgrade.message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få ubegrænsede måneder, avanceret statistik, Wagey AI og meget mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte unbegrenzte Monate, erweiterte Statistiken, Wagey KI und mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get unlimited months, advanced statistics, Wagey AI, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén meses ilimitados, estadísticas avanzadas, Wagey IA y más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanki rajattomasti kuukausia, edistyneet tilastot, Wagey AI ja paljon muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez des mois illimités, des statistiques avancées, Wagey AI, et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni mesi illimitati, statistiche avanzate, Wagey AI e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限の月数、詳細な統計、Wagey AI など。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 월간, 고급 통계, Wagey AI 등을 이용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få ubegrensede måneder, avansert statistikk, Wagey AI og mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkte maanden, geavanceerde statistieken, Wagey AI en meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj nieograniczone miesiące, zaawansowane statystyki, Wagey AI i więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha meses ilimitados, estatísticas avançadas, Wagey AI e muito mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите неограниченные месяцы, расширенную статистику, Wagey AI и многое другое."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få obegränsade månader, avancerad statistik, Wagey AI och mycket mer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับเดือนไม่จำกัด สถิติขั้นสูง Wagey AI และอื่นๆ อีกมากมาย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте необмежені місяці, розширену статистику, Wagey AI та багато іншого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận ca làm việc không giới hạn, thống kê nâng cao, Wagey AI và nhiều hơn nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得无限月份、高级统计、Wagey AI等功能。"
          }
        }
      }
    },
