        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vardiya genel bakışı, türe göre toplamlar ve ücret özetini içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
