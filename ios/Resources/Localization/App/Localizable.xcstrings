    "screenshotShare.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del din kalender som et poleret billede med delingsknappen i værktøjslinjen. Du kan vælge at vise eller skjule dine indtægter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deinen Kalender als poliertes Bild mit der Schaltfläche „Teilen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιράσου το ημερολόγιό σου ως ένα γυαλισμένο εικόνα με το κουμπί κοινοποίησης στη γραμμή εργαλείων. Μπορείς να επιλέξεις να εμφανίσεις ή να αποκρύψεις τα κέρδη σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your calendar as a polished image with the share button in the toolbar. You can choose to show or hide your earnings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu calendario como una imagen pulida con el botón de compartir en la barra de herramientas. Puedes elegir mostrar u ocultar tus ganancias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa kalenterisi kiillotettu kuva jakonapilla työkalurivissä. Voit valita, näytetäänkö vai piilotetaanko tulosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre calendrier comme une image soignée avec le bouton de partage dans la barre d'outils. Vous pouvez choisir d'afficher ou de masquer vos revenus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il tuo calendario come un'immagine raffinata con il pulsante di condivisione nella barra degli strumenti. Puoi scegliere di mostrare o nascondere i tuoi guadagni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーの共有ボタンを使用して、カレンダーを洗練された画像として共有します。収入の表示/非表示を選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 버튼을 사용하여 캘린더를 깔끔한 이미지로 공유하세요. 수익 표시 여부를 선택할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del kalenderen din som et polert bilde med deleknappen i verktøylinjen. Du kan velge å vise eller skjule inntektene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Del je kalender als een gepolijst beeld met de deelknop in de werkbalk. Je kunt ervoor kiezen om je inkomsten weer te geven of verbergen."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Del kalenderen din som et polert bilde med deleknappen i verktøylinjen. Du kan velge å vise eller skjule inntektene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij swój kalendarz jako dopracowany obraz za pomocą przycisku udostępniania na pasku narzędzi. Możesz wybrać, czy chcesz pokazać czy ukryć swoje zarobki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu calendário como uma imagem polida usando o botão de compartilhamento na barra de ferramentas. Você pode escolher mostrar ou ocultar seus ganhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajați calendarul dvs. ca o imagine lustră cu butonul de partajare din bară de instrumente. Puteți alege să afișați sau să ascundeți câștigurile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь своим календарем в виде отполированного изображения с помощью кнопки отправки на панели инструментов. Вы можете выбрать, показывать или скрывать свой заработок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela din kalender som en polerad bild med delningsknappen i verktygsfältet. Du kan välja att visa eller dölja dina inkomster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ปฏิทินของคุณเป็นภาพที่สวยงามโดยใช้ปุ่มแชร์ในแถบเครื่องมือ คุณสามารถเลือกแสดงหรือซ่อนรายได้ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimini araç çubuğundaki paylaş düğmesiyle cilalı bir görüntü olarak paylaş. Kazançlarını göstermeyi veya gizlemeyi seçebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться своїм календарем як відполірованим зображенням за допомогою кнопки поділитися на панелі інструментів. Ви можете вибрати, показувати чи приховувати свої доходи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ lịch của bạn dưới dạng hình ảnh sáng sủa bằng nút chia sẻ trong thanh công cụ. Bạn có thể chọn hiển thị hoặc ẩn thu nhập của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过工具栏中的分享按钮将您的日历分享为精美图像。您可以选择显示或隐藏您的收入。"
          }
        }
      }
    },
