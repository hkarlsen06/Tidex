        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀치하여 확대, 드래그하여 이동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte para ampliar, arraste para mover"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сожмите для масштабирования, перетащите для перемещения"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knijpen om in te zoomen, slepen om te verplaatsen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyp för att zooma, dra för att flytta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knib for at zoome, træk for at flytte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica per ingrandire, trascina per spostare"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähennä nipistämällä, siirrä vetämällä"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch aby przybliżyć, przeciągnij aby przesunąć"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розтискайте для масштабування, тягніть для переміщення"
