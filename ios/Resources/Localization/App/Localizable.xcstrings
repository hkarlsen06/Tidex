    "appearance.calendarAnimation.verticalDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glid op og ned mellem måneder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf und ab zwischen Monaten wechseln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολίσθηση πάνω και κάτω μεταξύ μηνών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide up and down between months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba y abajo entre meses"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liuku ylös ja alas kuukausien välillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez vers le haut et vers le bas entre les mois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorre su e giù tra i mesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の間を上下にスライド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월간 보기에서 위아래로 이동"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Glir opp og ned mellom måneder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif omhoog en omlaag tussen maanden"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Glir opp og ned mellom månader"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj w górę i w dół między miesiącami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima e para baixo entre meses"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează sus și jos între luni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скольжение вверх и вниз между месяцами"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glid upp och ner mellan månader"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนขึ้นและลงระหว่างเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylar arasında yukarı ve aşağı kaydırma yapın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ковзання вгору та вниз між місяцями"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt lên và xuống giữa các tháng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在月份之间向上下滑动"
          }
        }
      }
    },
