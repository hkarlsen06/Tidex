    "shifts.empty.planAhead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can plan shifts ahead, or set up recurring shifts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan planlegge vakter på forhånd, eller sette opp gjentakende vakter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Schichten im Voraus planen oder wiederkehrende Schichten einrichten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez planifier des vactions à l'avance ou configurer des vactions récurrentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes planificar vakts con anticipación o configurar vakts recurrentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi pianificare le vakat in anticipo o impostare vakat ricorrenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan planlegge vakter på forhånd, eller sette opp gjentakende vakter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode planejar turnos com antecedência ou configurar turnos recorrentes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan planera arbetspass i förväg eller ställa in återkommande arbetspass."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan planlegge vakter på forhånd, eller sette opp gjentakende vakter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit suunnitella vuoroja etukäteen tai määrittää toistuvia vuoroja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz planować zmiany z wyprzedzeniem lub ustawić powtarzające się zmiany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете планировать смены заранее или настроить повторяющиеся смены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете планувати зміни заздалегідь або налаштувати повторювані зміни."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトを先に計画するか、固定シフトを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 근무를 계획하거나 반복 근무를 설정할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以提前计划班次，或设置循环班次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถวางแผนการเลื่อนเวลาล่วงหน้าหรือตั้งค่าการเลื่อนเวลาซ้ำได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể lên kế hoạch ca làm việc trước, hoặc thiết lập ca làm việc định kỳ."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan planlegge vakter på forhånd, eller sette opp gjentakende vakter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardiyaları önceden planlayabilir veya tekrarlanan vardiyalar ayarlayabilirsiniz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να προγραμματίσεις βάρδιες εκ των προτέρων, ή να ρυθμίσεις επαναλαμβανόμενες βάρδιες."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți planifica schimburi în avans sau configura schimburi recurente."
          }
        }
      }
    },
