            "value": "Konto konnte nicht getrennt werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déconnecter le compte. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desconectar la cuenta. Intenta de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile disconnettere l'account. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon account niet verbreken. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desconectar a conta. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte koppla från konto. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke afbryde forbindelsen til konto. Prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin irrottaminen epäonnistui. Yritä uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozłączyć konto. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить аккаунт. Пожалуйста, попробуйте еще раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відключити акаунт. Спробуйте ще раз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを切断できませんでした。もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 연결을 해제할 수 없습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法断开账户连接。请重试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตัดการเชื่อมต่อบัญชี โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ngắt kết nối tài khoản. Vui lòng thử lại."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikkje kople frå konto. Prøv igjen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bağlantısı kesilemedi. Lütfen tekrar dene."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποσύνδεση του λογαριασμού. Δοκιμάστε ξανά."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut deconecta contul. Încercați din nou."
          }
        }
      }
    },
