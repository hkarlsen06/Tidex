        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke koble til konto. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon account niet verbinden. Probeer het opnieuw."
          }
        },
