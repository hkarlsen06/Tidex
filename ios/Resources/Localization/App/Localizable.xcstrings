    "dashboard.payrollDetails.estimateHelp" : {
      "comment" : "Help text at the bottom of the payroll details sheet. It tells the user how to check the estimate against their payslip.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن فترة العمل نفسها في قسيمة راتبك. تحقّق أولًا من الساعات المسجلة وإعدادات الأجر، ثم من أي دفعات إضافية أو اقتطاعات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнете същия работен период във фиша си за заплата. Първо проверете отчетените часове и настройките за заплащане, а след това всички допълнителни плащания или удръжки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেতনস্লিপে একই কাজের সময়কাল তুলনা করুন। প্রথমে রেকর্ড করা ঘণ্টা ও বেতন সেটিংস যাচাই করুন, এরপর অতিরিক্ত অর্থপ্রদান বা কর্তন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara el mateix període de treball amb la nòmina. Comprova primer les hores registrades i la configuració salarial, i després els pagaments extra o les deduccions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnejte stejné pracovní období na výplatní pásce. Nejprve zkontrolujte zaznamenané hodiny a nastavení odměňování, potom případné příplatky nebo srážky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign den samme arbejdsperiode på din lønseddel. Tjek først registrerede timer og lønindstillinger og derefter eventuelle ekstra udbetalinger eller fradrag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche denselben Arbeitszeitraum mit deiner Gehaltsabrechnung. Prüfe zuerst die erfassten Stunden und Lohneinstellungen, danach zusätzliche Zahlungen oder Abzüge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνετε την ίδια περίοδο εργασίας στο εκκαθαριστικό σας. Ελέγξτε πρώτα τις καταγεγραμμένες ώρες και τις ρυθμίσεις αποδοχών και, στη συνέχεια, τυχόν επιπλέον πληρωμές ή κρατήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the same work period on your payslip. Check recorded hours and pay settings first, then any extra payments or deductions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare el mismo período de trabajo en su nómina. Compruebe primero las horas registradas y la configuración salarial; después, los pagos extra o las deducciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võrdle sama tööperioodi palgalehel. Kontrolli esmalt registreeritud töötunde ja palgaseadeid, seejärel lisamakseid või kinnipidamisi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همان دوره کاری را در فیش حقوقی‌تان مقایسه کنید. ابتدا ساعات ثبت‌شده و تنظیمات حقوق، سپس پرداخت‌های اضافی یا کسورات را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa samaa työjaksoa palkkalaskelmaasi. Tarkista ensin kirjatut tunnit ja palkka-asetukset, sitten mahdolliset lisämaksut tai vähennykset."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihambing ang parehong panahon ng trabaho sa iyong payslip. Suriin muna ang mga naitalang oras at setting ng sahod, pagkatapos ang anumang dagdag na bayad o kaltas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez la même période de travail sur votre fiche de paie. Vérifiez d’abord les heures enregistrées et les paramètres de rémunération, puis les paiements supplémentaires ou les retenues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השוו את אותה תקופת עבודה בתלוש השכר. בדקו תחילה את השעות שנרשמו ואת הגדרות השכר, ולאחר מכן תשלומים נוספים או ניכויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी वेतन पर्ची पर इसी कार्य अवधि की तुलना करें। पहले दर्ज किए गए घंटों और वेतन सेटिंग्स की जाँच करें, फिर किसी अतिरिक्त भुगतान या कटौती की।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usporedite isto radno razdoblje na platnoj listi. Najprije provjerite evidentirane sate i postavke plaće, a zatim sva dodatna plaćanja ili odbitke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasonlítsd össze ugyanazt a munkavégzési időszakot a bérjegyzékeden. Először ellenőrizd a rögzített órákat és a bérbeállításokat, majd az extra kifizetéseket vagy levonásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan periode kerja yang sama pada slip gaji Anda. Periksa jam kerja yang tercatat dan pengaturan gaji terlebih dahulu, lalu pembayaran tambahan atau potongan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berðu saman sama vinnutímabil á launaseðlinum þínum. Athugaðu fyrst skráðar vinnustundir og launastillingar, síðan aukagreiðslur eða frádrátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta lo stesso periodo di lavoro nella busta paga. Controlla prima le ore registrate e le impostazioni della retribuzione, poi eventuali pagamenti aggiuntivi o detrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給与明細で同じ勤務期間を比較してください。まず記録された勤務時間と給与設定を確認し、次に追加支給や控除を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "급여명세서에서 동일한 근무 기간을 비교하세요. 먼저 기록된 시간과 급여 설정을 확인한 다음, 추가 지급액이나 공제액을 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palyginkite tą patį darbo laikotarpį savo algalapyje. Pirmiausia patikrinkite užregistruotas valandas ir atlygio nustatymus, tada papildomas išmokas ar išskaitas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salīdzini to pašu darba periodu savā algas lapiņā. Vispirms pārbaudi reģistrētās stundas un algas iestatījumus, pēc tam papildu maksājumus vai ieturējumus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign samme arbeidsperiode på lønnsslippen. Sjekk registrerte timer og lønnsinnstillinger først, deretter ekstra utbetalinger eller trekk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk dezelfde werkperiode op je loonstrook. Controleer eerst de geregistreerde uren en looninstellingen en daarna eventuele extra betalingen of inhoudingen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samanlikn den same arbeidsperioden på lønnsslippen. Sjekk registrerte timar og lønnsinnstillingar først, deretter eventuelle ekstra utbetalingar eller trekk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównaj ten sam okres pracy na pasku wypłaty. Najpierw sprawdź zarejestrowane godziny i ustawienia wynagrodzenia, a następnie dodatkowe wypłaty lub potrącenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare o mesmo período de trabalho no seu contracheque. Verifique primeiro as horas registradas e as configurações salariais e, depois, quaisquer pagamentos extras ou descontos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compară aceeași perioadă de lucru de pe fluturașul de salariu. Verifică mai întâi orele înregistrate și setările salariale, apoi orice plăți suplimentare sau deduceri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравните тот же рабочий период в расчётном листке. Сначала проверьте учтённые часы и настройки оплаты, затем дополнительные выплаты или удержания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnajte rovnaké pracovné obdobie na výplatnej páske. Najprv skontrolujte zaznamenané hodiny a mzdové nastavenia, potom prípadné ďalšie platby alebo zrážky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primerjajte isto delovno obdobje na plačilni listi. Najprej preverite zabeležene ure in nastavitve plačila, nato še morebitna dodatna plačila ali odtegljaje."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporedite isti period rada na obračunu zarade. Najpre proverite evidentirane sate i podešavanja zarade, a zatim dodatne isplate ili odbitke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför samma arbetsperiod på lönespecifikationen. Kontrollera först registrerade timmar och löneinställningar, och därefter eventuella extra ersättningar eller avdrag."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linganisha kipindi hicho cha kazi na hati yako ya malipo. Kwanza hakiki saa zilizorekodiwa na mipangilio ya malipo, kisha malipo ya ziada au makato."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சம்பளச் சீட்டில் இதே வேலைக் காலத்தை ஒப்பிடுங்கள். முதலில் பதிவுசெய்யப்பட்ட வேலை நேரங்களையும் ஊதிய அமைப்புகளையும் சரிபார்க்கவும்; பின்னர் கூடுதல் கொடுப்பனவுகள் அல்லது கழிவுகளைச் சரிபார்க்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบช่วงเวลาทำงานเดียวกันในสลิปเงินเดือน ตรวจสอบชั่วโมงที่บันทึกและการตั้งค่าค่าจ้างก่อน จากนั้นตรวจสอบเงินเพิ่มหรือรายการหักอื่นๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı çalışma dönemini maaş bordronuzla karşılaştırın. Önce kaydedilen saatleri ve ücret ayarlarını, ardından ek ödemeleri veya kesintileri kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівняйте такий самий робочий період у розрахунковому листку. Спочатку перевірте відпрацьовані години та налаштування оплати, а потім додаткові виплати або утримання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی تنخواہ کی پرچی پر اسی کام کی مدت کا موازنہ کریں۔ پہلے ریکارڈ شدہ گھنٹوں اور اجرت کی ترتیبات کو چیک کریں، پھر اضافی ادائیگیوں یا کٹوتیوں کو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh cùng kỳ làm việc trên phiếu lương của bạn. Trước tiên, hãy kiểm tra số giờ đã ghi nhận và cài đặt lương, sau đó kiểm tra các khoản thanh toán thêm hoặc khấu trừ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较工资单上相同的工作期间。先检查记录的工时和薪资设置，然后检查额外付款或扣款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較薪資單上的相同工作期間。先檢查已記錄的工時和薪資設定，再檢查任何額外付款或扣款。"
          }
        }
      }
    },
