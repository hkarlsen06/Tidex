    "calendar.subscription.detail.confirmation.message" : {
      "comment" : "Message in the confirmation shown from a shift or event when the user first turns on calendar sync.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم مزامنة Tidex تلقائيًا مع تطبيق التقويم. عند إضافة الورديات والأحداث أو تعديلها أو حذفها في Tidex، سيتم تحديث تطبيق التقويم تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex ще се синхронизира автоматично с приложението ви за календар. Когато добавяте, редактирате или изтривате смени и събития в Tidex, приложението ви за календар се обновява автоматично."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex আপনার ক্যালেন্ডার অ্যাপের সাথে স্বয়ংক্রিয়ভাবে সিঙ্ক হবে। Tidex-এ শিফট ও ইভেন্ট যোগ, সম্পাদনা বা মুছে দিলে আপনার ক্যালেন্ডার অ্যাপও স্বয়ংক্রিয়ভাবে আপডেট হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se sincronitzarà automàticament amb la teva app de calendari. Quan afegeixis, editis o eliminis torns i esdeveniments a Tidex, la teva app de calendari s'actualitzarà automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se bude automaticky synchronizovat s vaší aplikací Kalendář. Když v Tidexu přidáte, upravíte nebo smažete směny a události, aplikace Kalendář se automaticky aktualizuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex synkroniserer automatisk med din kalenderapp. Når du tilføjer, redigerer eller sletter vagter og begivenheder i Tidex, opdateres din kalenderapp automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex wird automatisch mit deiner Kalender-App synchronisiert. Wenn du in Tidex Schichten und Ereignisse hinzufügst, bearbeitest oder löschst, wird deine Kalender-App automatisch aktualisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tidex θα συγχρονίζεται αυτόματα με την εφαρμογή ημερολογίου σας. Όταν προσθέτετε, επεξεργάζεστε ή διαγράφετε βάρδιες και συμβάντα στο Tidex, η εφαρμογή ημερολογίου σας ενημερώνεται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex will sync shifts and events from the past 18 months and next 6 months with your calendar app. When you add, edit, or delete them in Tidex, your calendar app updates automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se sincronizará automáticamente con tu app de calendario. Cuando añadas, edites o elimines turnos y eventos en Tidex, tu app de calendario se actualizará automáticamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex sünkroonib end automaatselt sinu kalendrirakendusega. Kui lisad, muudad või kustutad Tidexis vahetusi ja sündmusi, uueneb ka sinu kalendrirakendus automaatselt."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex به‌طور خودکار با برنامه تقویم شما همگام‌سازی می‌شود. وقتی شیفت‌ها و رویدادها را در Tidex اضافه، ویرایش یا حذف می‌کنید، برنامه تقویم شما خودکار به‌روزرسانی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex synkronoituu automaattisesti kalenterisovelluksesi kanssa. Kun lisäät, muokkaat tai poistat vuoroja ja tapahtumia Tidexissä, kalenterisovelluksesi päivittyy automaattisesti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awtomatikong magsi-sync ang Tidex sa iyong calendar app. Kapag nagdagdag, nag-edit, o nagtanggal ka ng mga shift at event sa Tidex, awtomatikong maa-update ang iyong calendar app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se synchronisera automatiquement avec votre app Calendrier. Quand vous ajoutez, modifiez ou supprimez des shifts et événements dans Tidex, votre app Calendrier se met à jour automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex יסונכרן אוטומטית עם אפליקציית היומן שלך. כשתוסיף, תערוך או תמחק משמרות ואירועים ב-Tidex, אפליקציית היומן שלך תתעדכן אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex आपके कैलेंडर ऐप के साथ अपने-आप सिंक होगा। जब आप Tidex में शिफ्ट और ईवेंट जोड़ते, संपादित करते या हटाते हैं, तो आपका कैलेंडर ऐप अपने-आप अपडेट हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex će se automatski sinkronizirati s vašom aplikacijom Kalendar. Kad u Tidexu dodate, uredite ili izbrišete smjene i događaje, vaša aplikacija Kalendar automatski se ažurira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Tidex automatikusan szinkronizál a naptárappal. Ha műszakokat vagy eseményeket adsz hozzá, szerkesztesz vagy törölsz a Tidexben, a naptárapp automatikusan frissül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex akan otomatis sinkron dengan aplikasi kalender Anda. Saat Anda menambah, mengubah, atau menghapus shift dan acara di Tidex, aplikasi kalender Anda akan diperbarui secara otomatis."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex samstillist sjálfkrafa við dagatalsappið þitt. Þegar þú bætir við, breytir eða eyðir vöktum og viðburðum í Tidex uppfærist dagatalsappið sjálfkrafa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex si sincronizzerà automaticamente con la tua app Calendario. Quando aggiungi, modifichi o elimini turni ed eventi in Tidex, l'app Calendario si aggiorna automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidexはカレンダーアプリと自動で同期されます。Tidexでシフトやイベントを追加、編集、削除すると、カレンダーアプリも自動で更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex는 캘린더 앱과 자동으로 동기화됩니다. Tidex에서 근무와 이벤트를 추가, 수정 또는 삭제하면 캘린더 앱도 자동으로 업데이트됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Tidex“ bus automatiškai sinchronizuojama su jūsų kalendoriaus programa. Kai „Tidex“ pridėsite, redaguosite ar ištrinsite pamainas ir įvykius, kalendoriaus programa atsinaujins automatiškai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex automātiski sinhronizēsies ar jūsu kalendāra lietotni. Kad Tidex pievienosiet, rediģēsiet vai dzēsīsiet maiņas un notikumus, jūsu kalendāra lietotne atjaunināsies automātiski."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex synkroniserer vakter og hendelser fra de siste 18 månedene og de neste 6 månedene med kalenderappen din. Når du legger til, endrer eller sletter dem i Tidex, oppdateres kalenderappen automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex synchroniseert automatisch met je agenda-app. Wanneer je diensten en gebeurtenissen toevoegt, bewerkt of verwijdert in Tidex, wordt je agenda-app automatisch bijgewerkt."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex blir synkronisert automatisk med kalenderappen din. Når du legg til, endrar eller slettar vakter og hendingar i Tidex, blir kalenderappen oppdatert automatisk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex będzie automatycznie synchronizować się z Twoją aplikacją kalendarza. Gdy dodasz, edytujesz lub usuniesz zmiany i wydarzenia w Tidex, aplikacja kalendarza zaktualizuje się automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tidex será sincronizado automaticamente com seu app de calendário. Quando você adicionar, editar ou excluir turnos e eventos no Tidex, seu app de calendário será atualizado automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se va sincroniza automat cu aplicația ta Calendar. Când adaugi, editezi sau ștergi ture și evenimente în Tidex, aplicația Calendar se actualizează automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex будет автоматически синхронизироваться с вашим календарём. Когда вы добавляете, редактируете или удаляете смены и события в Tidex, календарь обновляется автоматически."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex sa bude automaticky synchronizovať s vašou aplikáciou Kalendár. Keď v Tidexe pridáte, upravíte alebo odstránite zmeny a udalosti, vaša aplikácia Kalendár sa automaticky aktualizuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex se bo samodejno sinhroniziral z vašo aplikacijo koledarja. Ko v Tidexu dodate, uredite ali izbrišete izmene in dogodke, se bo vaša aplikacija koledarja samodejno posodobila."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex će se automatski sinhronizovati sa vašom aplikacijom Kalendar. Kada dodate, izmenite ili obrišete smene i događaje u Tidex-u, aplikacija Kalendar se automatski ažurira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex synkas automatiskt med din kalenderapp. När du lägger till, redigerar eller tar bort pass och händelser i Tidex uppdateras kalenderappen automatiskt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex itasawazishwa kiotomatiki na programu yako ya kalenda. Unapoongeza, kuhariri au kufuta zamu na matukio katika Tidex, programu yako ya kalenda husasishwa kiotomatiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex உங்கள் காலண்டர் ஆப்புடன் தானாக ஒத்திசையும். Tidex-ல் நீங்கள் ஷிப்ட்கள் மற்றும் நிகழ்வுகளைச் சேர்க்கும், திருத்தும் அல்லது நீக்கும் போது, உங்கள் காலண்டர் ஆப் தானாகப் புதுப்பிக்கும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex จะซิงค์กับแอปปฏิทินของคุณโดยอัตโนมัติ เมื่อคุณเพิ่ม แก้ไข หรือลบกะและกิจกรรมใน Tidex แอปปฏิทินจะอัปเดตอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex takvim uygulamanızla otomatik olarak senkronize olur. Tidex'te vardiya ve etkinlik eklediğinizde, düzenlediğinizde veya sildiğinizde takvim uygulamanız otomatik güncellenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex автоматично синхронізуватиметься з вашим календарем. Коли ви додаєте, редагуєте або видаляєте зміни й події в Tidex, ваш календар оновлюється автоматично."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex آپ کی کیلنڈر ایپ کے ساتھ خودکار طور پر ہم آہنگ ہو جائے گا۔ جب آپ Tidex میں شفٹس اور ایونٹس شامل، ترمیم یا حذف کریں گے، آپ کی کیلنڈر ایپ خود بخود اپ ڈیٹ ہو جائے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex sẽ tự động đồng bộ với ứng dụng lịch của bạn. Khi bạn thêm, sửa hoặc xóa ca làm và sự kiện trong Tidex, ứng dụng lịch sẽ tự động cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex 将自动与你的日历应用同步。当你在 Tidex 中添加、编辑或删除班次和事件时，日历应用也会自动更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex 會自動與你的行事曆 App 同步。當你在 Tidex 新增、編輯或刪除班次與事件時，行事曆 App 也會自動更新。"
          }
        }
      }
    },
