    "data.export.pdf.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes shift overview, totals by type, and wage summary."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer vaktoversikt, summer per type og totale lønnstall."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Schichtübersicht, Summen nach Typ und Lohnzusammenfassung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye resumen de turnos, totales por tipo y resumen salarial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut l'aperçu des quarts, les totaux par type et le résumé des salaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト概要、タイプ別合計、給与サマリーを含みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트 개요, 유형별 합계, 급여 요약 포함."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui visão geral de turnos, totais por tipo e resumo de salários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор смен, итоги по типам и сводка по зарплате."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevat shift-overzicht, totalen per type en salarissamenvatting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innehåller passöversikt, totaler efter typ och lönebilaga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer skiftoversigt, totaler efter type og lønresumé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include panoramica turni, totali per tipo e riepilogo salari."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältää vuorojen yleiskatsauksen, erittelyt tyypeittäin ja palkkayhteenvedon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawiera przegląd zmian, podsumowania według typu i zestawienie wynagrodzeń."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Включає огляд змін, підсумки за типами та розрахунок заробітної плати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
