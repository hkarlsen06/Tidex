    "settings.pay.editor.dateConflictHelp" : {
      "comment" : "Error under the date picker when another wage entry already has the chosen date.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد تغيير بالفعل في هذا التاريخ. اختر تاريخًا آخر، أو عدّل هذا الإدخال في سجل الأجور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За тази дата вече има промяна. Изберете друга дата или редактирайте този запис в историята на заплащането."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই তারিখে ইতিমধ্যে একটি পরিবর্তন আছে। অন্য তারিখ বেছে নিন, অথবা বেতন-ইতিহাসে সেই এন্ট্রি সম্পাদনা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta data ja té un canvi. Tria'n una altra o edita aquesta entrada a l'historial salarial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto datum již obsahuje změnu. Vyberte jiné datum nebo tuto položku upravte v historii odměňování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne dato har allerede en ændring. Vælg en anden dato, eller rediger posten i lønhistorikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Datum gibt es bereits eine Änderung. Wähle ein anderes Datum oder bearbeite diesen Eintrag in der Lohnhistorie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ημερομηνία έχει ήδη μια αλλαγή. Επιλέξτε άλλη ημερομηνία ή επεξεργαστείτε αυτή την καταχώριση στο ιστορικό αμοιβών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This date already has a change. Choose another date, or edit that entry in pay history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fecha ya tiene un cambio. Elija otra fecha o edite esa entrada en el historial de pagos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellel kuupäeval on muudatus juba olemas. Vali muu kuupäev või muuda seda kirjet palgaajaloos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این تاریخ از قبل تغییری دارد. تاریخ دیگری انتخاب کنید یا آن مورد را در تاریخچه حقوق ویرایش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle päivälle on jo määritetty muutos. Valitse toinen päivä tai muokkaa kyseistä merkintää palkkahistoriassa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May pagbabago na sa petsang ito. Pumili ng ibang petsa, o i-edit ang entry na iyon sa kasaysayan ng sahod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette date comporte déjà une modification. Choisissez une autre date ou modifiez cette entrée dans l’historique des rémunérations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לתאריך הזה כבר יש שינוי. בחרו תאריך אחר, או ערכו את הרשומה הזו בהיסטוריית השכר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस तारीख के लिए पहले से बदलाव है। कोई दूसरी तारीख चुनें या वेतन इतिहास में उस प्रविष्टि को संपादित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj datum već ima promjenu. Odaberite drugi datum ili uredite taj unos u povijesti plaće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehhez a dátumhoz már tartozik módosítás. Válassz másik dátumot, vagy szerkeszd ezt a bejegyzést a bérfizetési előzményekben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanggal ini sudah memiliki perubahan. Pilih tanggal lain, atau edit entri tersebut di riwayat gaji."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi dagsetning er þegar með breytingu. Veldu aðra dagsetningu eða breyttu þeirri færslu í launasögunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa data ha già una modifica. Scegli un'altra data oppure modifica quella voce nella cronologia delle retribuzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日付にはすでに変更があります。別の日付を選ぶか、給与履歴でその記録を編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 날짜에는 이미 변경 사항이 있습니다. 다른 날짜를 선택하거나 급여 내역에서 해당 항목을 수정하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiai datai jau priskirtas pakeitimas. Pasirinkite kitą datą arba redaguokite šį įrašą atlygio istorijoje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šim datumam jau ir veiktas izmaiņas. Izvēlies citu datumu vai rediģē šo ierakstu algu vēsturē."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne datoen har allerede en endring. Velg en annen dato, eller rediger oppføringen i lønnshistorikken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op deze datum is al een wijziging ingesteld. Kies een andere datum of bewerk die invoer in de loonhistorie."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne datoen har allereie ei endring. Vel ein annan dato, eller rediger den oppføringa i lønnshistoria."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla tej daty wprowadzono już zmianę. Wybierz inną datę lub edytuj ten wpis w historii wynagrodzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta data já tem uma alteração. Escolha outra data ou edite esse registro no histórico de pagamentos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această dată are deja o modificare. Alege o altă dată sau editează acea înregistrare în istoricul salarial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой даты уже есть изменение. Выберите другую дату или отредактируйте эту запись в истории оплаты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre tento dátum už existuje zmena. Vyberte iný dátum alebo upravte túto položku v histórii odmeňovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta datum že ima spremembo. Izberite drug datum ali uredite ta vnos v zgodovini plačil."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj datum već ima promenu. Izaberite drugi datum ili izmenite taj unos u istoriji zarade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns redan en ändring för detta datum. Välj ett annat datum eller redigera posten i lönehistoriken."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarehe hii tayari ina mabadiliko. Chagua tarehe nyingine, au hariri ingizo hilo katika historia ya malipo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தேதிக்கு ஏற்கனவே மாற்றம் உள்ளது. வேறு தேதியைத் தேர்ந்தெடுக்கவும் அல்லது அந்தப் பதிவை ஊதிய வரலாற்றில் திருத்தவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันที่นี้มีการเปลี่ยนแปลงอยู่แล้ว เลือกวันที่อื่น หรือแก้ไขรายการนั้นในประวัติค่าจ้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tarihte zaten bir değişiklik var. Başka bir tarih seçin veya bu kaydı ücret geçmişinde düzenleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цієї дати вже є зміна. Виберіть іншу дату або відредагуйте цей запис в історії оплати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس تاریخ پر پہلے ہی ایک تبدیلی موجود ہے۔ کوئی دوسری تاریخ منتخب کریں، یا اجرت کی سرگزشت میں اس اندراج میں ترمیم کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày này đã có một thay đổi. Chọn ngày khác hoặc chỉnh sửa mục đó trong lịch sử lương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此日期已有一项更改。请选择其他日期，或在薪资历史记录中编辑该条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此日期已有變更。請選擇其他日期，或在薪資紀錄中編輯該筆項目。"
          }
        }
      }
    },
