    "settings.pay.editor.breakMethodGuidance" : {
      "comment" : "Advice under the break method picker. Proportional is one of the method options.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت لا تعرف الطريقة التي يستخدمها صاحب العمل، فاختر التناسبية. إنها الخيار المحافظ الأكثر عدلاً وتتجنب التقديرات المتفائلة التي قد تعد بأجر أعلى من الواقع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако не знаете кой метод използва работодателят ви, изберете пропорционален. Това е най-справедливият консервативен вариант и избягва оптимистични оценки, които може да обещаят по-високо заплащане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নিয়োগকর্তা কোন পদ্ধতি ব্যবহার করেন তা না জানলে, আনুপাতিকটি বেছে নিন। এটি সবচেয়ে ন্যায্য সতর্ক বিকল্প এবং অতিরিক্ত বেতনের আশাবাদী হিসাব এড়ায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no saps quin mètode fa servir l'empresa, tria el proporcional. És l'opció conservadora més justa i evita càlculs optimistes que podrien prometre massa sou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud nevíte, kterou metodu váš zaměstnavatel používá, zvolte poměrnou. Je to nejspravedlivější konzervativní volba a vyhne se optimistickým odhadům, které by mohly slibovat vyšší mzdu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du ikke ved, hvilken metode din arbejdsgiver bruger, skal du vælge proportional. Det er den mest retfærdige konservative mulighed og undgår optimistiske estimater, der kan love for høj løn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du nicht weißt, welche Methode dein Arbeitgeber nutzt, wähle proportional. Das ist die fairste konservative Option und vermeidet optimistische Schätzungen, die zu viel Lohn versprechen könnten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεν ξέρετε ποια μέθοδο χρησιμοποιεί ο εργοδότης σας, επιλέξτε αναλογική. Είναι η πιο δίκαιη συντηρητική επιλογή και αποφεύγει αισιόδοξες εκτιμήσεις που μπορεί να υπερεκτιμήσουν την αμοιβή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you do not know which method your employer uses, choose proportional. It is the fairest conservative option and avoids optimistic estimates that could overpromise pay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no sabes qué método usa tu empleador, elige proporcional. Es la opción conservadora más justa y evita estimaciones optimistas que podrían prometer más pago del real."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui sa ei tea, millist meetodit tööandja kasutab, vali proportsionaalne. See on kõige õiglasem konservatiivne valik ja väldib optimistlikke hinnanguid, mis võivad lubada liiga suurt tasu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر نمی‌دانید کارفرمایتان از کدام روش استفاده می‌کند، روش تناسبی را انتخاب کنید. این منصفانه‌ترین گزینه محافظه‌کارانه است و از برآوردهای خوش‌بینانه‌ای که ممکن است وعده پرداخت بیشتری بدهند، جلوگیری می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos et tiedä, mitä menetelmää työnantajasi käyttää, valitse suhteellinen. Se on reiluin varovainen vaihtoehto ja välttää liian optimistiset arviot, jotka voivat luvata liikaa palkkaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung hindi mo alam kung aling paraan ang ginagamit ng employer mo, piliin ang proporsyonal. Ito ang pinaka-makatarungang konserbatibong opsyon at iniiwasan ang masyadong optimistikong tantiya na maaaring magpangako ng sobrang taas na sahod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous ne savez pas quelle méthode votre employeur utilise, choisissez la méthode proportionnelle. C’est l’option prudente la plus juste et elle évite des estimations optimistes qui pourraient surestimer la paie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם אינך יודע באיזו שיטה המעסיק שלך משתמש, בחר בשיטה יחסית. זו האפשרות השמרנית וההוגנת ביותר, והיא מונעת הערכות אופטימיות מדי שעלולות להבטיח שכר גבוה מהצפוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आपको नहीं पता कि आपका नियोक्ता कौन-सी विधि इस्तेमाल करता है, तो आनुपातिक चुनें। यह सबसे उचित सतर्क विकल्प है और ऐसे आशावादी अनुमान से बचाता है जो वेतन का अधिक वादा कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako ne znate koju metodu koristi vaš poslodavac, odaberite proporcionalnu. To je najpravednija konzervativna opcija i izbjegava optimistične procjene koje bi mogle obećati previsoku plaću."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha nem tudja, melyik módszert használja a munkáltatója, válassza az arányosat. Ez a legigazságosabb óvatos lehetőség, és elkerüli a túl optimista becsléseket, amelyek túl magas bért ígérhetnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda tidak tahu metode yang digunakan pemberi kerja Anda, pilih proporsional. Ini opsi konservatif paling adil dan menghindari perkiraan optimistis yang bisa menjanjikan gaji terlalu tinggi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú veist ekki hvaða aðferð vinnuveitandi þinn notar skaltu velja hlutfallslega. Það er sanngjarnasti varfærni kosturinn og forðast bjartsýnar áætlanir sem gætu lofað of háum launum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non sai quale metodo usa il tuo datore di lavoro, scegli quello proporzionale. È l’opzione conservativa più equa ed evita stime ottimistiche che potrebbero promettere una paga troppo alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勤務先の方式が不明なら、比例方式を選んでください。最も公平で保守的な選択で、給与を高く見積もりすぎるのを防げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고용주가 어떤 방식을 쓰는지 모르면 비례식을 선택하세요. 가장 공정한 보수적 선택이며 급여를 과대추정하는 낙관적 계산을 피할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei nežinote, kurį metodą naudoja darbdavys, rinkitės proporcingą. Tai teisingiausias konservatyvus pasirinkimas ir padeda išvengti optimistinių įvertinimų, kurie gali žadėti per didelį atlyginimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja nezināt, kuru metodi izmanto darba devējs, izvēlieties proporcionālo. Tas ir taisnīgākais piesardzīgais variants un palīdz izvairīties no pārāk optimistiskiem aprēķiniem, kas var solīt pārāk lielu algu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du ikke vet hvilken metode arbeidsgiveren bruker, velg proporsjonal. Det er det mest rettferdige konservative valget og unngår optimistiske beregninger som kan love for høy lønn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je niet weet welke methode je werkgever gebruikt, kies dan proportioneel. Dat is de eerlijkste conservatieve optie en voorkomt optimistische schattingen die te veel loon beloven."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss du ikkje veit kva metode arbeidsgivaren brukar, vel proporsjonal. Det er det mest rettferdige konservative valet og unngår optimistiske berekningar som kan love for høg lønn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nie wiesz, której metody używa pracodawca, wybierz proporcjonalną. To najuczciwsza ostrożna opcja i pozwala uniknąć zbyt optymistycznych szacunków wynagrodzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você não souber qual método seu empregador usa, escolha o proporcional. É a opção conservadora mais justa e evita estimativas otimistas que podem prometer um pagamento maior do que o real."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă nu știi ce metodă folosește angajatorul tău, alege proporțional. Este cea mai corectă opțiune conservatoare și evită estimările optimiste care pot promite un salariu prea mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы не знаете, какой метод использует работодатель, выберите пропорциональный. Это самый справедливый консервативный вариант, который помогает избежать завышенных оценок зарплаты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak neviete, ktorú metódu používa zamestnávateľ, zvoľte pomernú. Je to najspravodlivejšia konzervatívna možnosť a vyhne sa optimistickým odhadom, ktoré môžu sľubovať vyššiu mzdu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če ne veste, katero metodo uporablja delodajalec, izberite sorazmerno. To je najbolj poštena konservativna možnost in prepreči preveč optimistične ocene, ki bi lahko obljubljale previsoko plačilo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako ne znate koji metod koristi vaš poslodavac, izaberite proporcionalni. To je najpravednija konzervativna opcija i izbegava optimistične procene koje mogu preceniti zaradu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du inte vet vilken metod din arbetsgivare använder, välj proportionell. Det är det rättvisaste konservativa alternativet och undviker optimistiska uppskattningar som kan lova för hög lön."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usipojua mwajiri wako anatumia njia gani, chagua sawia. Hilo ndilo chaguo la haki zaidi na la tahadhari, na huepuka makadirio ya matumaini yanayoweza kuahidi malipo makubwa kupita kiasi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் பணியாளர் எந்த முறையை பயன்படுத்துகிறார் என்று தெரியாவிட்டால், விகிதாசார முறையைத் தேர்வுசெய்க. இது நியாயமான பாதுகாப்பான தேர்வாகும்; மேலும் அதிக ஊதிய வாக்குறுதி தரக்கூடிய மிகைப்படுத்திய கணிப்புகளைத் தவிர்க்கும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณไม่ทราบว่านายจ้างใช้วิธีใด ให้เลือกแบบสัดส่วน เป็นตัวเลือกแบบอนุรักษ์นิยมที่ยุติธรรมที่สุดและช่วยหลีกเลี่ยงการประเมินที่มองในแง่ดีเกินไปซึ่งอาจทำให้คาดหวังค่าจ้างสูงเกินจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşvereninizin hangi yöntemi kullandığını bilmiyorsanız, orantılıyı seçin. En adil temkinli seçenektir ve ücreti fazla gösterebilecek iyimser tahminleri önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви не знаєте, який метод використовує ваш роботодавець, виберіть пропорційний. Це найсправедливіший консервативний варіант, який уникає надто оптимістичних оцінок, що можуть завищити очікувану оплату."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر آپ نہیں جانتے کہ آپ کا آجر کون سا طریقہ استعمال کرتا ہے، تو متناسب منتخب کریں۔ یہ سب سے منصفانہ محتاط انتخاب ہے اور ایسے پُرامید اندازوں سے بچاتا ہے جو تنخواہ زیادہ دکھا سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn không biết chủ lao động dùng phương pháp nào, hãy chọn tỷ lệ. Đây là lựa chọn thận trọng công bằng nhất và tránh các ước tính lạc quan có thể hứa hẹn mức lương quá cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不知道雇主使用哪种方法，请选择按比例。这是最公平且保守的选项，可避免过于乐观的估算导致薪资承诺过高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不知道雇主使用哪種方法，請選擇按比例。這是最公平且保守的選項，也能避免過於樂觀、可能高估薪資的估算。"
          }
        }
      }
    },
