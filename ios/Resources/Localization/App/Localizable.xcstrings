          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই বার্তাটি পাঠানো যাবে না, কারণ এতে ব্লক করা বিষয়বস্তু রয়েছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest missatge no es pot enviar perquè conté contingut bloquejat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto zprávu nelze odeslat, protože obsahuje blokovaný obsah."
