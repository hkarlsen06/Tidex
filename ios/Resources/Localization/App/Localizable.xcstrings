            "state": "translated",
            "value": "L'application s'affichera toujours en thème sombre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app verrà sempre visualizzata in tema scuro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは常にダークテーマで表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 항상 어두운 테마로 표시됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen vil alltid vises i mørkt tema"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App wordt altijd weergegeven in donker thema"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen vil alltid verta vist i mørkt tema"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja będzie zawsze wyświetlana w ciemnym motywie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo sempre aparecerá com tema escuro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația va apărea întotdeauna în tema întunecată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение всегда будет отображаться в темной теме"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen visas alltid i mörkt tema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะแสดงในธีมมืดเสมอ"
          }
        },
        "tr": {
