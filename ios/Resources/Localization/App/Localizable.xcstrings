    "settings.pay.editor.supplementsTariff" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع البدلات اتفاقية التعرفة ولا يمكن تغييرها يدوياً"
