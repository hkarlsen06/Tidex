        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যবহারকারীর নাম ৩-২০ অক্ষরের হতে হবে এবং শুধু ছোট হাতের অক্ষর, সংখ্যা বা আন্ডারস্কোর থাকতে পারবে।"
