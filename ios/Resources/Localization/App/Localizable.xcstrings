    "stats.charts.employment.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Employment percentage is calculated from your work hours compared to a %@-hour work week."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingsprosent beregnes ut fra dine arbeidstimer sammenlignet med en %@-timers arbeidsuke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beschäftigungsprozentsatz wird aus Ihren Arbeitsstunden im Vergleich zu einer %@-Stunden-Arbeitswoche berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje de empleo se calcula comparando tus horas de trabajo con una semana laboral de %@ horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage d'emploi est calculé à partir de vos heures de travail par rapport à une semaine de %@ heures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雇用率は、%@時間の週と比較したあなたの労働時間から計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고용률은 %@시간 주중 근무 시간과 비교하여 계산됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O percentual de emprego é calculado a partir de suas horas de trabalho comparadas a uma semana de %@ horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент занятости рассчитывается на основе ваших рабочих часов в сравнении с %@-часовой рабочей неделей."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkgelegenheidspercentage wordt berekend op basis van je werkuren vergeleken met een werkweek van %@ uur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anställningsprocenten beräknas från dina arbetstimmar jämfört med en %@-timmars arbetsvecka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansættelsesprocenten beregnes ud fra dine arbejdstimer sammenlignet med en %@-timers arbejdsuge."
          }
        }
      }
    },
    "stats.charts.employment.noData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
