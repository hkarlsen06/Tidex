    "onboarding.personalize.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شيئين فقط سريعين، ثم أنت في"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само две бързи неща, и си готов"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাত্র দুটি দ্রুত জিনিস, তারপর আপনি প্রস্তুত"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només dues coses ràpides, i ja hi ets"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen dvě rychlé věci a už ses v aplikaci"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare to hurtige ting, så er du klar"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur zwei schnelle Dinge, dann bist du dabei"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο δύο γρήγορα πράγματα, και είσαι έτοιμος"
