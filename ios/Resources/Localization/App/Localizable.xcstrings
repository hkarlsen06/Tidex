    "onboarding.welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track shifts. See your pay. No surprises."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer vakter. Se lønna. Ingen overraskelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schichten nachverfolgen. Bezahlung sehen. Keine Überraschungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra turnos. Ve tu pago. Sin sorpresas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les quarts. Voyez votre salaire. Pas de surprises."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフトを追跡。給与を確認。サプライズなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 추적. 급여 확인. 놀라움 없음."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe turnos. Veja seu pagamento. Sem surpresas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте смены. Видьте свой доход. Никаких сюрпризов."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg diensten. Zie je betaling. Geen verrassingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spåra arbetspass. Se din lön. Inga överraskningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer skift. Se din løn. Ingen overraskelser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia i turni. Vedi la tua paga. Nessuna sorpresa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa vuoroja. Näe palkkasi. Ei yllätyksiä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź zmiany. Zobacz swoją pensję. Bez niespodzianek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте зміни. Бачте вашу зарплату. Без несподіванок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪班次。查看您的薪酬。无惊喜。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกกะการทำงาน ดูเงินเดือนของคุณ ไม่มีเซอร์ไพรส์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi ca làm việc. Xem lương của bạn. Không có bất ngờ."
          }
        }
