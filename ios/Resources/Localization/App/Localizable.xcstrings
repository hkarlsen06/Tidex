    "settings.pay.global.payrollDayHelper" : {
      "comment" : "Helper text under the payday setting for a job.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقدّر Tidex المبلغ المستحق عن شهر تقويمي كامل من العمل في الشهر التالي. ينطبق يوم الدفع هذا على جميع الفترات لهذه الوظيفة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex изчислява през следващия месец възнаграждението за цял календарен месец работа. Този ден на изплащане важи за всички периоди за тази работа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex পরের মাসে পুরো একটি ক্যালেন্ডার মাসের কাজের পারিশ্রমিকের আনুমানিক হিসাব করে। এই বেতন প্রদানের দিনটি এই চাকরির সব সময়কালের জন্য প্রযোজ্য।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex estima el pagament d’un mes natural complet de feina per al mes següent. Aquest dia de pagament s’aplica a tots els períodes d’aquesta feina."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex odhaduje výplatu za práci za celý kalendářní měsíc v následujícím měsíci. Tento výplatní den platí pro všechna období tohoto zaměstnání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex estimerer udbetalingen for en hel kalendermåneds arbejde i den følgende måned. Denne lønningsdag gælder for alle perioder for dette job."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex schätzt die Auszahlung für einen ganzen Kalendermonat Arbeit im Folgemonat. Dieser Zahltag gilt für alle Zeiträume dieses Jobs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tidex εκτιμά την πληρωμή για έναν πλήρη ημερολογιακό μήνα εργασίας τον επόμενο μήνα. Αυτή η ημέρα πληρωμής ισχύει για όλες τις περιόδους αυτής της εργασίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex estimates payment for a full calendar month of work in the following month. This payday applies to all periods for this job."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex estima el pago de un mes natural completo de trabajo para el mes siguiente. Este día de pago se aplica a todos los periodos de este empleo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex prognoosib terve kalendrikuu töötasu väljamakset järgmisel kuul. See palgapäev kehtib selle töökoha kõigi perioodide kohta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex مبلغ پرداختی یک ماه کامل تقویمی کار را در ماه بعد برآورد می‌کند. این روز پرداخت برای همه دوره‌های این شغل اعمال می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex arvioi kokonaisen kalenterikuukauden työstä saatavan palkan maksettavaksi seuraavana kuukautena. Tämä palkanmaksupäivä koskee kaikkia tämän työpaikan ajanjaksoja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinatantiya ng Tidex ang bayad para sa isang buong buwan ng trabaho sa kalendaryo, na babayaran sa susunod na buwan. Nalalapat ang petsa ng bayad na ito sa lahat ng panahon ng trabaho para sa trabahong ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex estime le montant versé pour un mois civil complet de travail le mois suivant. Cette date de paie s'applique à toutes les périodes de cet emploi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex מעריכה את התשלום עבור חודש קלנדרי מלא של עבודה בחודש שלאחר מכן. יום התשלום הזה חל על כל התקופות של מקום העבודה הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex अगले महीने पूरे कैलेंडर माह के काम के भुगतान का अनुमान लगाता है। यह वेतन-दिन इस नौकरी की सभी अवधियों पर लागू होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex procjenjuje isplatu za cijeli kalendarski mjesec rada u sljedećem mjesecu. Ovaj se dan isplate primjenjuje na sva razdoblja za ovaj posao."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Tidex a teljes naptári hónapban végzett munka kifizetését a következő hónapban becsüli meg. Ez a fizetési nap a munkahelyhez tartozó összes időszakra vonatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex memperkirakan pembayaran untuk pekerjaan selama satu bulan kalender penuh pada bulan berikutnya. Hari pembayaran ini berlaku untuk semua periode pekerjaan ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex áætlar útborgun fyrir heilan almanaksmánuð af vinnu í mánuðinum á eftir. Þessi útborgunardagur gildir um öll tímabil þessa starfs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex stima la retribuzione per un intero mese solare di lavoro nel mese successivo. Questo giorno di paga si applica a tutti i periodi di questo lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidexは、暦月1か月分の勤務に対する給与を翌月に支払うものとして見積もります。この給料日は、この勤務先のすべての期間に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex는 한 달 전체의 근무에 대한 급여를 다음 달에 추정합니다. 이 급여일은 이 직장의 모든 기간에 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex apskaičiuoja apytikslę išmoką už visą kalendorinį darbo mėnesį, kuri išmokama kitą mėnesį. Ši atlyginimo mokėjimo diena taikoma visiems šios darbovietės laikotarpiams."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex aprēķina samaksu par pilnu kalendāro darba mēnesi nākamajā mēnesī. Šī algas izmaksas diena attiecas uz visiem šīs darba vietas periodiem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex anslår utbetaling for en hel kalendermåned med arbeid i måneden etter. Denne lønningsdagen gjelder alle perioder for jobben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex schat de betaling voor een volledige kalendermaand werk in de daaropvolgende maand. Deze betaaldag geldt voor alle perioden van deze baan."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex anslår utbetaling for ein heil kalendermånad med arbeid i månaden etter. Denne lønningsdagen gjeld alle periodar for denne jobben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex szacuje wynagrodzenie za pełny miesiąc kalendarzowy pracy w kolejnym miesiącu. Ten dzień wypłaty dotyczy wszystkich okresów tej pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Tidex estima o pagamento de um mês-calendário completo de trabalho no mês seguinte. Esta data de pagamento se aplica a todos os períodos deste emprego."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex estimează plata pentru o lună calendaristică întreagă de muncă în luna următoare. Această zi de plată se aplică tuturor perioadelor pentru acest loc de muncă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex рассчитывает выплату за полный календарный месяц работы в следующем месяце. Этот день выплаты применяется ко всем периодам для этого места работы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex odhaduje výplatu za celý kalendárny mesiac práce v nasledujúcom mesiaci. Tento výplatný deň platí pre všetky obdobia tohto pracoviska."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex oceni plačilo za delo v celotnem koledarskem mesecu v naslednjem mesecu. Ta dan izplačila velja za vsa obdobja te službe."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex procenjuje zaradu za ceo kalendarski mesec rada u narednom mesecu. Ovaj dan isplate važi za sve periode za ovaj posao."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex uppskattar utbetalningen för en hel kalendermånads arbete under följande månad. Den här löneutbetalningsdagen gäller alla perioder för jobbet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex hukadiria malipo ya kazi ya mwezi mzima wa kalenda katika mwezi unaofuata. Tarehe hii ya malipo inatumika kwa vipindi vyote vya kazi hii."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex, ஒரு முழு காலண்டர் மாதப் பணிக்கான ஊதியத்தை அடுத்த மாதத்தில் மதிப்பிடுகிறது. இந்த ஊதிய நாள் இந்த வேலைக்கான அனைத்து காலங்களுக்கும் பொருந்தும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex จะประมาณการค่าจ้างสำหรับการทำงานเต็มเดือนปฏิทินในเดือนถัดไป วันจ่ายค่าจ้างนี้ใช้กับทุกงวดของงานนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex, tam bir takvim ayındaki çalışmanın ödemesini bir sonraki ay için tahmin eder. Bu ödeme günü, bu işe ait tüm dönemler için geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex розраховує виплату за повний календарний місяць роботи в наступному місяці. Цей день виплати застосовується до всіх періодів для цієї роботи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex اگلے مہینے میں پورے کیلنڈر مہینے کے کام کی ادائیگی کا تخمینہ لگاتا ہے۔ یہ ادائیگی کا دن اس ملازمت کے تمام ادوار پر لاگو ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex ước tính khoản thanh toán cho một tháng dương lịch làm việc trọn vẹn vào tháng tiếp theo. Ngày trả lương này áp dụng cho tất cả các kỳ của công việc này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex 会在下个月估算完整日历月工作的收入。此发薪日适用于该工作的所有周期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidex 會估算下個月整個曆月工作的薪資。此發薪日適用於此工作的所有期間。"
          }
        }
      }
    },
