    "events.notifications.all_day_picker.description" : {
      "comment" : "Help text in the reminder picker for all-day events. The user sets a time of day and how many days before.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر وقتًا وعدد الأيام قبل الحدث الذي تريد أن يصلك فيه إشعار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете час и колко дни преди събитието да бъдете уведомени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সময় ও ইভেন্টের কত দিন আগে বিজ্ঞপ্তি পেতে চান তা বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria una hora i quants dies abans de l'esdeveniment vols rebre l'avís."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte čas a kolik dní před událostí chcete dostat oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et tidspunkt og hvor mange dage før begivenheden du vil varsles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Uhrzeit und wie viele Tage vor dem Ereignis du benachrichtigt werden möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε ώρα και πόσες μέρες πριν θέλετε να ειδοποιηθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a time and how many days before the event you want to be notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una hora y cuántos días antes del evento quieres recibir una notificación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali kellaaeg ja mitu päeva enne sündmust soovid teavitust saada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زمان و تعداد روزهای قبل از رویداد را برای اعلان انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse aika ja kuinka monta päivää ennen tapahtumaa haluat ilmoituksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumili ng oras at ilang araw bago ang event na gusto mong maabisuhan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une heure et combien de jours avant l’événement vous voulez être notifié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר שעה וכמה ימים לפני האירוע תרצה לקבל התראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय और इवेंट से कितने दिन पहले आप सूचना पाना चाहते हैं, चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite vrijeme i koliko dana prije događaja želite primiti obavijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz időpontot és napok számát, mennyivel az esemény előtt kérsz értesítést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih waktu dan berapa hari sebelum acara Anda ingin diberi tahu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldu tíma og hve mörgum dögum fyrir viðburðinn þú vilt fá tilkynningu."
          }
