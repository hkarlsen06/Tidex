        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās ielādēt jaunākās likmes. Tiek rādītas standarta likmes. Lai atjauninātu, izveidojiet savienojumu ar internetu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke hente de nyeste satsene. Viser standardsatser. Koble til internett for å oppdatere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon de nieuwste tarieven niet laden. Standaardtarieven worden getoond. Maak verbinding met internet om bij te werken."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikkje hente dei nyaste satsane. Viser standardsatsar. Kople til internett for å oppdatere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się pobrać najnowszych stawek. Wyświetlane są stawki standardowe. Połącz się z internetem, aby je zaktualizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar os valores mais recentes. Exibindo valores padrão. Conecte-se à internet para atualizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-au putut încărca cele mai recente tarife. Se afișează tarifele standard. Conectează-te la internet pentru actualizare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить актуальные тарифы. Показаны стандартные ставки. Подключитесь к интернету для обновления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa načítať najnovšie sadzby. Zobrazujú sa štandardné sadzby. Pripojte sa k internetu a aktualizujte ich."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najnovejših tarif ni bilo mogoče naložiti. Prikazane so standardne tarife. Za posodobitev se povežite z internetom."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najnovije tarife nisu učitane. Prikazane su standardne tarife. Povežite se na internet da ih ažurirate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte hämta de senaste satserna. Visar standardsatser. Anslut till internet för att uppdatera."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viwango vya hivi karibuni havikupatikana. Inaonyesha viwango vya kawaida. Unganisha intaneti ili kusasisha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமீபத்திய விகிதங்களைப் பெற முடியவில்லை. நிலையான விகிதங்கள் காட்டப்படுகின்றன. புதுப்பிக்க இணையத்தில் இணையவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดอัตราล่าสุดไม่ได้ กำลังแสดงอัตรามาตรฐาน เชื่อมต่ออินเทอร์เน็ตเพื่ออัปเดต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En güncel ücret tarifeleri yüklenemedi. Standart tarifeler gösteriliyor. Güncellemek için internete bağlan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити актуальні ставки. Показано стандартні ставки. Підключіться до інтернету, щоб оновити їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تازہ ترین شرحیں لوڈ نہیں ہو سکیں۔ معیاری شرحیں دکھائی جا رہی ہیں۔ اپ ڈیٹ کے لیے انٹرنیٹ سے جڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải mức lương mới nhất. Đang hiển thị mức chuẩn. Hãy kết nối Internet để cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载最新费率，现显示标准费率。请联网更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入最新費率，現顯示標準費率。請連接網際網路以更新。"
          }
        }
      }
    },
