    "subscription.earlySupporter.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak fordi du har været med fra starten! Du har permanent adgang til premium-funktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass Sie von Anfang an dabei sind! Sie haben lebenslangen Zugriff auf Premium-Funktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for being with us from the start! You have lifetime access to premium features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por estar con nosotros desde el principio! Tienes acceso de por vida a funciones premium."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos siitä, että olet ollut mukana alusta lähtien! Sinulla on elinikäinen pääsy premium-ominaisuuksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d'être avec nous depuis le début! Vous avez un accès illimité aux fonctionnalités premium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per essere con noi da subito! Hai accesso illimitato alle funzioni premium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初からご利用いただきありがとうございます！プレミアム機能への生涯アクセス権があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음부터 함께해주셔서 감사합니다! 프리미엄 기능에 평생 액세스할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du var med fra starten! Du har livstidstilgang til premium-funksjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dank je dat je van het begin bij ons bent! Je hebt levenslange toegang tot premiumfuncties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za bycie z nami od początku! Masz dostęp na całe życie do funkcji premium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por estar conosco desde o início! Você tem acesso vitalício aos recursos premium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что вы с нами с самого начала! У вас есть пожизненный доступ к премиум-функциям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du är med oss från början! Du har livslång åtkomst till premiumfunktioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่เป็นส่วนหนึ่งของเรามาตั้งแต่เริ่มต้น! คุณมีสิทธิ์เข้าถึงคุณสมบัติพรีเมียมตลอดชีวิต"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо за те, що ви з нами з самого початку! Ви маєте довічний доступ до преміум-функцій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn vì đã ở bên chúng tôi từ đầu! Bạn có quyền truy cập vĩnh viễn tới các tính năng cao cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您从一开始就与我们同行！您拥有高级功能的终身访问权限。"
          }
        }
      }
    },
