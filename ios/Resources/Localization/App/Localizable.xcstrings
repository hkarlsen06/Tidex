          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις χρησιμοποιήσει όλα τα μηνύματα Wagey σου αυτό το μήνα. Τα μηνύματα επαναφέρονται στην αρχή του επόμενου μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've used all your Wagey messages this month. Messages reset at the start of next month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has usado todos tus mensajes Wagey este mes. Los mensajes se restablecen al inicio del próximo mes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
