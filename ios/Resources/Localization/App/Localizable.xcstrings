          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tự động mở ứng dụng Lịch. Hãy sao chép liên kết đăng ký và thêm thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
