    "wagey.emptyState.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me to add shifts, calculate wages, or manage your schedule."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør meg om å legge til vakter, beregne lønn eller administrere timeplanen din."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte mich, Schichten hinzuzufügen, Löhne zu berechnen oder deinen Plan zu verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídeme que añada turnos, calcule salarios o gestione tu horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi d'ajouter des postes, de calculer les salaires ou de gérer votre emploi du temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト追加、給与計算、スケジュール管理をお願いします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트 추가, 임금 계산, 일정 관리를 요청하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça-me para adicionar turnos, calcular salários ou gerenciar seu cronograma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите меня добавить смены, рассчитать зарплату или управлять расписанием."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag me diensten toe te voegen, lonen te berekenen of je schema in te delen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be mig att lägga till skift, beräkna löner eller hantera ditt schema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed mig om at tilføje vagter, beregne løn eller styre din tidsplan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi di aggiungere turni, calcolare salari o gestire il calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä minua lisäämään vuoroja, laskemaan palkkaa tai hallinnoimaan aikatauluasi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś mnie, aby dodać zmiany, obliczyć wynagrodzenie lub zarządzać harmonogramem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросіть мене додати зміни, розрахувати заробітну плату або керувати розкладом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求我添加班次、计算工资或管理您的日程。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ฉันเพิ่มกะ คำนวณค่าจ้าง หรือจัดการตารางเวลาของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu tôi thêm ca làm việc, tính lương hoặc quản lý lịch của bạn."
          }
        }
      }
    },
