    "recurring.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this recurring shift? All future occurrences will be removed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne faste vakten? Alle fremtidige vakter vil bli fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie diese wiederkehrende Schicht löschen möchten? Alle zukünftigen Vorkommen werden entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce quart récurrent ? Tous les quarts futurs seront supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar este turno recurrente? Se eliminarán todas las futuras ocurrencias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare questo turno ricorrente? Tutti gli eventi futuri verranno rimossi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u deze terugkerende dienst wilt verwijderen? Alle toekomstige diensten worden verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir este turno recorrente? Todas as ocorrências futuras serão removidas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort detta återkommande skift? Alla framtida skift kommer att tas bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette denne tilbagevendende vagt? Alle fremtidige vagter vil blive fjernet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa tämän toistuvan vuoron? Kaikki tulevat vuorot poistetaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć tę powtarzającą się zmianę? Wszystkie przyszłe zmiany zostaną usunięte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эту повторяющуюся смену? Все будущие смены будут удалены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цю повторювану зміну? Всі майбутні зміни будуть видалені."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この定期シフトを削除してもよろしいですか？今後のすべてのシフトが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 근무를 삭제하시겠습니까? 모든 향후 근무가 제거됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要删除此重复班次吗？所有未来的班次都将被移除。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือว่าต้องการลบกะประจำนี้ กะในอนาคตทั้งหมดจะถูกลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa ca làm việc định kỳ này không? Tất cả các ca làm việc trong tương lai sẽ bị xóa."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne faste vakten? Alle framtidige vaktar vil bli fjerna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tekrarlanan vardiyayı silmek istediğinizden emin misiniz? Tüm gelecek vardiyalar kaldırılacak."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτήν την περιοδική βάρδια; Όλες οι μελλοντικές βάρδιες θα αφαιρεθούν."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești sigur că vrei să ștergi acest schimb recurent? Toate apariția viitoare vor fi eliminate."
          }
        }
      }
    },
