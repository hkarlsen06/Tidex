    "profile.dangerZone.deleteAccount.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet din konto og alle data permanent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche dein Konto und alle Daten dauerhaft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete your account and all data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu cuenta y todos los datos permanentemente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tilisi ja kaikki tiedot pysyvästi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez définitivement votre compte et toutes vos données"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente il tuo account e tutti i dati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとすべてのデータを完全に削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 및 모든 데이터를 영구적으로 삭제"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett kontoen din og alle data permanent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder je account en alle gegevens permanent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuń swoje konto i wszystkie dane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletar permanentemente sua conta e todos os dados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсегда удалить ваш аккаунт и все данные"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera ditt konto och all data permanent"
          }
        },
