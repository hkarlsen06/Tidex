    "appearance.calendarAnimation.verticalDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide up and down between months"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Glir opp og ned mellom måneder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische auf und ab zwischen Monaten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba y abajo entre meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers le haut et vers le bas entre les mois"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月間を上下にスライド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 사이를 상하로 스와이프"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima e para baixo entre meses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скользите вверх и вниз между месяцами"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif omhoog en omlaag tussen maanden"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjut upp och ned mellan månader"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glid op og ned mellem måneder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su e giù tra i mesi"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liuku ylös ja alas kuukausien välillä"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj się w górę i w dół między miesiącami"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
