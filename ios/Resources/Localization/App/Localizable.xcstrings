    "settings.pay.editor.supplementsTariff" : {
      "comment" : "Note in the supplements section when a tariff agreement controls the supplements.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع البدلات اتفاقية التعرفة ولا يمكن تغييرها يدوياً"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавките следват тарифното споразумение и не могат да се променят ръчно"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাপ্লিমেন্ট ট্যারিফ চুক্তি অনুসরণ করে এবং ম্যানুয়ালি পরিবর্তন করা যায় না"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els suplements segueixen l'acord salarial i no es poden canviar manualment"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příplatky vycházejí z tarifu a nemohou být změněny ručně"
