    "monthLimit.confirmDeleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette alle vagter i %@? Dette kan ikke omgøres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie alle Schichten in %@ löschen möchten? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε σίγουροι ότι θέλετε να διαγράψετε όλες τις βάρδιες στο %@; Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete all shifts in %@? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar todos los turnos en %@? Esto no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa kaikki vuorot kuukaudesta %@? Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer tous les quarts de travail dans %@ ? Cette action ne peut pas être annulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare tutti i turni in %@? Non potrai annullare questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のすべてのシフトを削除してもよろしいですか？この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 모든 근무 시간을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette alle vakter i %@? Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je alle shifts in %@ wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette alle vakter i %@? Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć wszystkie zmiany w %@? Nie można tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja deletar todos os turnos em %@? Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți sigur că doriți să ștergeți toate schimburile din %@? Aceasta nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить все смены в %@? Это невозможно отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera alla pass i %@? Det kan inte ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือว่าต้องการลบทุกเวลาทำงานใน %@? ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki tüm vardiyaları silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити всі зміни в %@? Це не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa tất cả ca làm việc trong %@? Điều này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除 %@ 中的所有班次吗？此操作无法撤销。"
          }
        }
      }
    },
    "monthLimit.couldNotDeleteShifts": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke slette vakter. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakten konnte nicht gelöscht werden. Bitte versuchen Sie es erneut."
