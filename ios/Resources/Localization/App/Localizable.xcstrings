        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете планировать смены заранее или установить повторяющиеся смены."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt shifts van tevoren plannen of terugkerende shifts instellen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
