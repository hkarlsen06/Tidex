        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğal yazın. Wagey vardiyaları ekleyebilir, ücreti tahmin edebilir ve çizelgenizi düzenli tutabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишіть природно. Wagey може додавати зміни, розраховувати зарплату та впорядковувати ваш графік."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرتی طریقے سے لکھیں۔ Wagey شفٹیں شامل کر سکتا ہے، تنخواہ کا تخمینہ لگا سکتا ہے، اور آپ کے شیڈول کو منظم رکھ سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viết một cách tự nhiên. Wagey có thể thêm ca làm việc, ước tính lương và giữ lịch biểu của bạn theo thứ tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
