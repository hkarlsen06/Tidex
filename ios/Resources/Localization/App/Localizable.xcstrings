    "settings.pay.review.dateExplanation" : {
      "comment" : "Explains which date is used for wages and which for tax on the pay review card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الأجور والبدلات والاستراحات والعمل الإضافي تاريخ العمل. وتستخدم الضريبة يوم دفع الراتب المجدول في الشهر التالي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплатите, добавките, почивките и извънредният труд се отчитат според датата на работа. Данъкът се отчита според планирания ден за изплащане през следващия месец."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মজুরি, ভাতা, বিরতি ও ওভারটাইম কাজের তারিখ অনুসরণ করে। কর পরের মাসের নির্ধারিত বেতনদিবস অনুসরণ করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els salaris, els complements, les pauses i les hores extres es basen en la data de treball. Els impostos es basen en el dia de pagament programat del mes següent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mzda, příplatky, přestávky a přesčasy se řídí datem práce. Daň se řídí plánovaným dnem výplaty v následujícím měsíci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løn, tillæg, pauser og overarbejde beregnes ud fra arbejdsdatoen. Skat beregnes ud fra den planlagte lønningsdag i den følgende måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löhne, Zuschläge, Pausen und Überstunden richten sich nach dem Arbeitsdatum. Für die Steuer gilt der geplante Zahltag im Folgemonat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αποδοχές, οι προσαυξήσεις, τα διαλείμματα και οι υπερωρίες βασίζονται στην ημερομηνία εργασίας. Ο φόρος βασίζεται στην προγραμματισμένη ημερομηνία πληρωμής του επόμενου μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wages, supplements, breaks and overtime use the work date. Tax uses the scheduled payday in the following month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los salarios, complementos, descansos y horas extra usan la fecha de trabajo. Los impuestos usan el día de pago programado del mes siguiente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töötasud, lisatasud, pausid ja ületunnid lähtuvad töökuupäevast. Maksu arvestatakse järgmise kuu kavandatud palgapäeva alusel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستمزدها، مزایا، استراحت‌ها و اضافه‌کاری بر اساس تاریخ کار محاسبه می‌شوند. مالیات بر اساس روز پرداخت برنامه‌ریزی‌شده در ماه بعد محاسبه می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palkat, lisät, tauot ja ylityö määräytyvät työpäivän mukaan. Vero määräytyy seuraavan kuukauden suunnitellun palkanmaksupäivän mukaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang sahod, mga dagdag-bayad, pahinga at overtime ay gumagamit ng petsa ng trabaho. Ginagamit ng buwis ang nakaiskedyul na araw ng sahod sa susunod na buwan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les salaires, suppléments, pauses et heures supplémentaires suivent la date de travail. L’impôt suit la date de paie prévue le mois suivant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השכר, התוספות, ההפסקות והשעות הנוספות מחושבים לפי תאריך העבודה. המס מחושב לפי מועד התשלום המתוכנן בחודש שלאחר מכן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेतन, भत्ते, ब्रेक और ओवरटाइम में कार्य तारीख का उपयोग होता है। कर के लिए अगले महीने की निर्धारित वेतन-तारीख का उपयोग होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaća, dodaci, pauze i prekovremeni rad obračunavaju se prema datumu rada. Porez se obračunava prema planiranom danu isplate u sljedećem mjesecu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bérek, pótlékok, szünetek és túlórák a munkavégzés dátumát használják. Az adó a következő hónap tervezett bérfizetési napját veszi alapul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upah, tunjangan, istirahat, dan lembur menggunakan tanggal kerja. Pajak menggunakan tanggal pembayaran yang dijadwalkan pada bulan berikutnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laun, álagsgreiðslur, hlé og yfirvinna miðast við vinnudag. Skattur miðast við áætlaðan launadag í næsta mánuði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retribuzioni, le maggiorazioni, le pause e gli straordinari usano la data di lavoro. Le imposte usano il giorno di paga previsto del mese successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給与、手当、休憩、時間外労働は勤務日に基づきます。税金は翌月の予定支給日に基づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "급여, 수당, 휴게시간 및 초과 근무는 근무일을 기준으로 합니다. 세금은 다음 달의 예정된 급여일을 기준으로 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlygis, priemokos, pertraukos ir viršvalandžiai skaičiuojami pagal darbo datą. Mokesčiai – pagal kitą mėnesį nustatytą atlyginimo mokėjimo dieną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algas, piemaksas, pārtraukumi un virsstundas tiek attiecinātas uz darba datumu. Nodokli aprēķina nākamā mēneša plānotajā algas izmaksas dienā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønn, tillegg, pauser og overtid følger arbeidsdatoen. Skatt følger den planlagte lønningsdagen i måneden etter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loon, toeslagen, pauzes en overwerk gebruiken de werkdatum. Voor de belasting geldt de geplande betaaldag in de volgende maand."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønn, tillegg, pausar og overtid følgjer arbeidsdatoen. Skatt følgjer den planlagde lønningsdagen i månaden etter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wynagrodzenie, dodatki, przerwy i nadgodziny są rozliczane według daty pracy. Podatek jest rozliczany według zaplanowanego dnia wypłaty w następnym miesiącu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salários, adicionais, intervalos e horas extras usam a data de trabalho. O imposto usa o dia de pagamento programado no mês seguinte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salariile, sporurile, pauzele și orele suplimentare folosesc data lucrată. Impozitul folosește ziua de plată programată din luna următoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарплата, доплаты, перерывы и сверхурочные учитываются по дате работы. Налог — по запланированной дате выплаты в следующем месяце."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mzda, príplatky, prestávky a nadčasy sa riadia dátumom práce. Daň sa riadi plánovaným výplatným dňom v nasledujúcom mesiaci."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plače, dodatki, odmori in nadure se določajo glede na datum dela. Davek se obračuna glede na načrtovani dan izplačila v naslednjem mesecu."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarade, dodaci, pauze i prekovremeni rad računaju se prema datumu rada. Porez se računa prema zakazanom danu isplate u narednom mesecu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lön, tillägg, pauser och övertid baseras på arbetsdatumet. Skatten baseras på det planerade utbetalningsdatumet följande månad."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mishahara, nyongeza, mapumziko na muda wa ziada hutumia tarehe ya kazi. Kodi hutumia siku ya malipo iliyopangwa katika mwezi unaofuata."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஊதியம், கூடுதல் கொடுப்பனவுகள், இடைவேளைகள் மற்றும் கூடுதல் நேரம் ஆகியவை வேலைத் தேதியை அடிப்படையாகக் கொண்டவை. வரி, அடுத்த மாதத்தில் திட்டமிடப்பட்ட சம்பள நாளை அடிப்படையாகக் கொண்டது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าจ้าง เงินเพิ่ม เวลาพัก และล่วงเวลาใช้อ้างอิงวันที่ทำงาน ภาษีใช้อ้างอิงวันจ่ายตามกำหนดในเดือนถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretler, ek ödemeler, molalar ve fazla mesai çalışma tarihine göre hesaplanır. Vergi, sonraki aydaki planlanan ödeme gününü esas alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарплата, доплати, перерви та понаднормові години прив’язані до дати роботи. Податок — до запланованого дня виплати наступного місяця."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجرت، اضافی ادائیگیاں، وقفے اور اوور ٹائم کام کی تاریخ پر لاگو ہوتے ہیں۔ ٹیکس اگلے مہینے کے مقررہ تنخواہ کے دن پر لاگو ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền lương, phụ cấp, thời gian nghỉ và làm thêm giờ sử dụng ngày làm việc. Thuế sử dụng ngày trả lương theo lịch vào tháng tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工资、补贴、休息时间和加班按工作日期计算。税款按次月的预定发薪日计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薪資、津貼、休息時間和加班依工作日期計算。稅額依下個月的預定發薪日計算。"
          }
        }
      }
    },
    "settings.pay.review.halfTax" : {
      "comment" : "Note in the shift details pay review when the payout month has half tax.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تضمين خصم ضريبي نصف القيمة لشهر الدفع هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложено е половин данъчно удържане за този месец на изплащане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পেমেন্ট মাসে অর্ধেক কর কর্তন অন্তর্ভুক্ত করা হয়েছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'hi inclou la meitat de la retenció per a aquest mes de pagament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro tento měsíc výplaty se uplatňuje poloviční srážka daně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halvt skattetræk er medregnet for denne udbetalingsmåned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Auszahlungsmonat ist der halbe Steuerabzug berücksichtigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για αυτόν τον μήνα πληρωμής έχει συμπεριληφθεί μισή παρακράτηση φόρου."
          }
        },
        "en" : {
