    "sharing.addFriend.sharesRightAway" : {
      "comment" : "Note under the add friend form. Adding a friend starts sharing your shifts with them immediately, with no request step.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشخص الذي تضيفه يرى نوبات عملك فورًا. يمكنك إيقاف المشاركة في أي وقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Човекът, когото добавите, веднага вижда смените ви. Можете да спрете споделянето по всяко време."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যাকে যোগ করবেন, তিনি আপনার শিফটগুলো সঙ্গে সঙ্গেই দেখতে পাবেন। যেকোনো সময় শেয়ার করা বন্ধ করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona que afegeixis veurà els teus torns de seguida. Pots deixar de compartir-los en qualsevol moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba, kterou přidáte, uvidí vaše směny okamžitě. Sdílení můžete kdykoli zastavit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den person, du tilføjer, kan se dine vagter med det samme. Du kan stoppe delingen når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person, die du hinzufügst, sieht deine Schichten sofort. Du kannst die Freigabe jederzeit beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άτομο που προσθέτεις βλέπει αμέσως τις βάρδιές σου. Μπορείς να διακόψεις την κοινοποίηση ανά πάσα στιγμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The person you add sees your shifts right away. You can stop sharing at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona que añadas verá tus turnos de inmediato. Puedes dejar de compartirlos en cualquier momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inimene, kelle lisad, näeb su vahetusi kohe. Jagamise saad igal ajal lõpetada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فردی که اضافه می‌کنید، شیفت‌های شما را بلافاصله می‌بیند. هر زمان بخواهید می‌توانید اشتراک‌گذاری را متوقف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilö, jonka lisäät, näkee työvuorosi heti. Voit lopettaa jakamisen milloin tahansa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makikita agad ng taong idinadagdag mo ang mga shift mo. Maaari mong ihinto ang pagbabahagi anumang oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne que vous ajoutez voit immédiatement vos shifts. Vous pouvez arrêter le partage à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האדם שתוסיף יראה את המשמרות שלך מיד. אפשר להפסיק את השיתוף בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस व्यक्ति को आप जोड़ते हैं, वह आपकी शिफ्टें तुरंत देख सकता है। आप कभी भी शेयर करना बंद कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba koju dodaš odmah vidi tvoje smjene. Dijeljenje možeš zaustaviti u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzáadott személy azonnal látja a műszakjaidat. A megosztást bármikor leállíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang Anda tambahkan langsung dapat melihat shift Anda. Anda dapat berhenti berbagi kapan saja."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðilinn sem þú bætir við sér vaktirnar þínar strax. Þú getur hætt að deila hvenær sem er."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona che aggiungi vede subito i tuoi turni. Puoi interrompere la condivisione in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加した相手には、すぐにあなたのシフトが表示されます。いつでも共有を停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가한 사람은 내 근무를 바로 볼 수 있습니다. 언제든 공유를 중지할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asmuo, kurį pridėsite, iškart matys jūsų pamainas. Bendrinimą galite bet kada sustabdyti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona, ko pievienosi, uzreiz redzēs tavas maiņas. Kopīgošanu vari pārtraukt jebkurā laikā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen du legger til ser vaktene dine med en gang. Du kan slutte å dele når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De persoon die je toevoegt, ziet je diensten meteen. Je kunt op elk moment stoppen met delen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen du legg til ser vaktene dine med ein gong. Du kan slutte å dele når som helst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba, którą dodasz, od razu zobaczy Twoje zmiany. W każdej chwili możesz przestać je udostępniać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pessoa que você adicionar verá seus turnos imediatamente. Você pode parar de compartilhar a qualquer momento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoana pe care o adaugi îți vede turele imediat. Poți opri partajarea oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавленный вами человек сразу увидит ваши смены. Вы можете прекратить делиться ими в любое время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba, ktorú pridáte, uvidí vaše smeny okamžite. Zdieľanie môžete kedykoľvek zastaviť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oseba, ki jo dodate, bo vaše izmene videla takoj. Deljenje lahko kadar koli prekinete."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba koju dodaš odmah vidi tvoje smene. Deljenje možeš da prekineš u bilo kom trenutku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen du lägger till ser dina arbetspass direkt. Du kan sluta dela när som helst."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mtu unayemuongeza anaona zamu zako mara moja. Unaweza kuacha kushiriki wakati wowote."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் சேர்க்கும் நபர் உங்கள் ஷிப்ட்களை உடனே பார்க்கலாம். எப்போது வேண்டுமானாலும் பகிர்வதை நிறுத்தலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่คุณเพิ่มจะเห็นกะงานของคุณทันที คุณหยุดแชร์ได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklediğiniz kişi vardiyalarınızı hemen görür. Paylaşmayı istediğiniz zaman durdurabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
