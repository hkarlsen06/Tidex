    "profile.emailChange.oauthOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in with Google/Apple. To change your email, first set a password in security settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du logget inn med Google/Apple. For å endre e-post må du først sette et passord i sikkerhetsinnstillingene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben sich mit Google/Apple angemeldet. Um Ihre E-Mail zu ändern, legen Sie zunächst ein Passwort in den Sicherheitseinstellungen fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciaste sesión con Google/Apple. Para cambiar tu correo, primero establece una contraseña en configuración de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous êtes connecté avec Google/Apple. Pour modifier votre e-mail, définissez d'abord un mot de passe dans les paramètres de sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google/Apple でサインインしています。メールアドレスを変更するには、まずセキュリティ設定でパスワードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google/Apple로 로그인했습니다. 이메일을 변경하려면 먼저 보안 설정에서 비밀번호를 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entrou com Google/Apple. Para alterar seu email, primeiro defina uma senha nas configurações de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вошли с помощью Google/Apple. Для изменения адреса электронной почты сначала установите пароль в параметрах безопасности."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent aangemeld met Google/Apple. Om je e-mailadres te wijzigen, stel je eerst een wachtwoord in in de beveiligingsinstellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggade in med Google/Apple. För att ändra din e-post måste du först ange ett lösenord i säkerhetsinställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggede ind med Google/Apple. For at ændre din mail skal du først angive en adgangskode i sikkerhedsindstillinger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai effettuato l'accesso con Google/Apple. Per cambiare la tua email, imposta prima una password nelle impostazioni di sicurezza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjauduit sisään Googlen/Applen kautta. Sähköpostin muuttamiseksi aseta ensin salasana turva-asetuksissa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowałeś się przez Google/Apple. Aby zmienić e-mail, najpierw ustaw hasło w ustawieniach bezpieczeństwa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви увійшли через Google/Apple. Щоб змінити електронну пошту, спочатку встановіть пароль у параметрах безпеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您使用 Google/Apple 登录。要更改电子邮件，请先在安全设置中设置密码。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณลงชื่อเข้าด้วย Google/Apple เพื่อเปลี่ยนอีเมล ให้ตั้งรหัสผ่านในการตั้งค่าความปลอดภัยก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đăng nhập bằng Google/Apple. Để thay đổi email, trước tiên hãy đặt mật khẩu trong cài đặt bảo mật."
          }
        }
      }
    },
