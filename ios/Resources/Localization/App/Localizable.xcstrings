          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există încă date pe acest dispozitiv. Așteaptă finalizarea sincronizării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве пока нет данных. Дождитесь завершения синхронизации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
