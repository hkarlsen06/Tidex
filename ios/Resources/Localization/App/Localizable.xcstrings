        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வேலை மாற்றங்களைச் சேர்க்கவும், உங்கள் வருமானத்தைச் சரிபார்க்கவும், கேள்விகளுக்கு பதிலைப் பெறவும் – அனைத்தும் இயற்கையான மொழியுடன்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มกะ ตรวจสอบรายได้ของคุณ และรับคำตอบคำถาม – ทั้งหมดด้วยภาษาธรรมชาติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vardiya ekle, kazancını kontrol et ve sorulara cevap al – hepsi doğal dillle."
