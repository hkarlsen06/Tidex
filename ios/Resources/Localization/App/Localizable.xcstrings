        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uslovi korišćenja i Politika privatnosti su izmenjeni. Otvorite dokumente ispod, pa prihvatite kada budete spremni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användarvillkoren och integritetspolicyn har ändrats. Öppna dokumenten nedan och godkänn när du är redo."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masharti ya Huduma na Sera ya Faragha zimebadilika. Fungua hati zilizo hapa chini, kisha ukubali ukiwa tayari."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேவை விதிமுறைகள் மற்றும் தனியுரிமைக் கொள்கை மாற்றப்பட்டுள்ளன. கீழே உள்ள ஆவணங்களைத் திறந்து, தயாரானதும் ஏற்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อกำหนดการให้บริการและนโยบายความเป็นส่วนตัวมีการเปลี่ยนแปลง โปรดเปิดเอกสารด้านล่าง แล้วกดยอมรับเมื่อพร้อม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hizmet Şartları ve Gizlilik Politikası değişti. Aşağıdaki belgeleri açın, ardından hazır olduğunuzda kabul edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умови використання та Політика конфіденційності змінилися. Відкрийте документи нижче, а потім прийміть, коли будете готові."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سروس کی شرائط اور رازداری کی پالیسی بدل گئی ہیں۔ نیچے دیے گئے دستاویزات کھولیں، پھر تیار ہونے پر قبول کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều khoản Dịch vụ và Chính sách Quyền riêng tư đã thay đổi. Mở các tài liệu bên dưới rồi chấp nhận khi bạn sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务条款和隐私政策已更新。请先打开下方文档，准备好后再接受。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務條款和隱私政策已變更。請先開啟下方文件，準備好後再接受。"
          }
        }
      }
    },
