          "stringUnit" : {
            "state" : "translated",
            "value" : "Watumiaji waliozuiwa huondolewa kwenye marafiki na gumzo hadi uwatoe kwenye zuio."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தடைநீக்கும் வரை தடுக்கப்பட்ட பயனர்கள் நண்பர்கள் மற்றும் அரட்டையிலிருந்து விலக்கப்படுவர்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ใช้ที่ถูกบล็อกจะไม่อยู่ในเพื่อนและแชทจนกว่าคุณจะเลิกบล็อก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellenen kullanıcılar, engeli kaldırana kadar arkadaşlar ve sohbet dışında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблоковані користувачі не з’являтимуться серед друзів і в чаті, доки ви не розблокуєте їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلاک شدہ صارفین دوستوں اور چیٹ سے باہر رہیں گے جب تک آپ انہیں ان بلاک نہ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người dùng bị chặn sẽ không thể vào danh sách bạn bè và trò chuyện cho đến khi bạn bỏ chặn họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已屏蔽的用户不会出现在好友和聊天中，直到你解除屏蔽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已封鎖的使用者會被排除在好友和聊天之外，直到你解除封鎖。"
          }
        }
      }
    },
