          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنخواہ کی کوئی ترتیب اس تاریخ کا احاطہ نہیں کرتی۔ اس ملازمت کے لیے تنخواہ کی ترتیب مکمل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
