    "settings.pay.break.methodDesc.baseOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deducts break only from base wage"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekker pause kun fra grunnlønn"
