            "state": "translated",
            "value": "You must accept the terms to use Tidex"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må godta vilkårene for å bruke Tidex"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen den Bedingungen zustimmen, um Tidex zu nutzen"
