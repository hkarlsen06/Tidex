    "profile.personalInfo.username.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم فقط ليتمكن الأصدقاء من العثور عليك. أحرف صغيرة وأرقام وشرطات سفلية فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва се само за да могат приятелите да ви намират. Само малки букви, цифри и долни черти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু যাতে বন্ধুরা আপনাকে খুঁজে পায়। শুধু ছোট হাতের অক্ষর, সংখ্যা ও আন্ডারস্কোর।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només perquè els amics et trobin. Només lletres minúscules, números i guions baixos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží jen k tomu, aby vás přátelé našli. Jen malá písmena, čísla a podtržítka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges kun så venner kan finde dig. Kun små bogstaver, tal og understreger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur damit Freunde dich finden können. Nur Kleinbuchstaben, Zahlen und Unterstriche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται μόνο για να μπορούν οι φίλοι να σας βρίσκουν. Μόνο πεζά γράμματα, αριθμοί και κάτω παύλες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only so friends can find you. Lowercase letters, numbers, and underscores only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa solo para que tus amigos te encuentren. Solo letras minúsculas, números y guiones bajos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult selleks, et sõbrad leiaksid sind. Ainult väiketähed, numbrid ja alakriipsud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط برای اینکه دوستان بتوانند شما را پیدا کنند استفاده می‌شود. فقط حروف کوچک، اعداد و زیرخط."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain jotta ystävät löytävät sinut. Vain pienaakkosia, numeroita ja alaviivoja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit lang para mahanap ka ng mga kaibigan. Maliit na titik, numero, at underscore lang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé seulement pour que vos amis puissent vous trouver. Lettres minuscules, chiffres et tirets bas uniquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש רק כדי שחברים יוכלו למצוא אותך. רק אותיות קטנות באנגלית, מספרים וקווים תחתונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ दोस्तों को आपको खोजने के लिए। केवल छोटे अक्षर, अंक और अंडरस्कोर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se samo da vas prijatelji mogu pronaći. Samo mala slova, brojevi i donje crte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak azért használjuk, hogy a barátaid megtaláljanak. Csak kisbetűk, számok és aláhúzás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya agar teman dapat menemukan Anda. Hanya huruf kecil, angka, dan garis bawah."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðeins notað svo vinir geti fundið þig. Aðeins lágstafir, tölur og undirstrik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato solo perché gli amici possano trovarti. Solo lettere minuscole, numeri e trattini bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達があなたを見つけるためだけに使用されます。使用できるのは小文字、数字、アンダースコアのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구가 회원님을 찾을 때만 사용됩니다. 소문자, 숫자, 밑줄만 사용할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojamas tik tam, kad draugai galėtų jus rasti. Tik mažosios raidės, skaičiai ir apatiniai brūkšniai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmanto tikai, lai draugi varētu tevi atrast. Tikai mazie burti, cipari un pasvītras."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes kun for at venner skal kunne finne deg. Kun små bokstaver, tall og understreker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen zodat vrienden je kunnen vinden. Alleen kleine letters, cijfers en underscores."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukt berre for at vener skal finne deg. Berre små bokstavar, tal og understrekar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy tylko do tego, by znajomi mogli Cię znaleźć. Tylko małe litery, cyfry i podkreślenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado só para amigos encontrarem você. Apenas letras minúsculas, números e sublinhados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosit doar pentru ca prietenii să te poată găsi. Doar litere mici, cifre și caractere de subliniere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется только чтобы друзья могли найти вас. Только строчные буквы, цифры и подчёркивания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Len aby si vás priatelia našli. Iba malé písmená, čísla a podčiarkovníky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporablja se le, da te prijatelji najdejo. Samo male črke, številke in podčrtaji."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Služi samo da vas prijatelji mogu pronaći. Samo mala slova, brojevi i donje crte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används bara så att vänner kan hitta dig. Endast små bokstäver, siffror och understreck."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hutumika tu ili marafiki wakupate. Herufi ndogo, nambari na vistari chini pekee."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நண்பர்கள் உங்களை கண்டுபிடிக்க மட்டுமே பயன்படுத்தப்படும். சிறிய எழுத்துகள், எண்கள் மற்றும் அடிக்கோடுகள் மட்டும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อให้เพื่อนค้นหาคุณได้เท่านั้น ใช้ได้เฉพาะตัวพิมพ์เล็ก ตัวเลข และขีดล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaşlarınızın sizi bulması için kullanılır. Yalnızca küçük harf, rakam ve alt çizgi kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібне лише, щоб друзі могли вас знайти. Тільки малі літери, цифри та підкреслення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف اس لیے استعمال ہوتا ہے تاکہ دوست آپ کو ڈھونڈ سکیں۔ صرف چھوٹے حروف، اعداد، اور انڈر اسکور۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ để bạn bè tìm thấy bạn. Chỉ dùng chữ thường, số và dấu gạch dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于让朋友找到你。只能用小写字母、数字和下划线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅用於讓朋友找到你。只能用小寫字母、數字和底線。"
          }
        }
      }
    },
