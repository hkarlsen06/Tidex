        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just two quick things, then you're in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dos cosas rápidas y ya estás dentro"
          }
