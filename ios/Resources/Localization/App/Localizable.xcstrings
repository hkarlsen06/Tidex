            "value" : "আপনার নতুন ইমেল ঠিকানা প্রবেশ করুন। আমরা আপনার পুরানো এবং নতুন উভয় ঠিকানায় একটি নিশ্চিতকরণ পাঠাব।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu la teva nova adreça de correu electrònic. T'enviarem una confirmació tant a la teva adreça antiga com a la nova."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte svou novou e-mailovou adresu. Odešleme potvrzení na vaši starou i novou adresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast din nye e-postadresse. Vi sender en bekræftelse til både din gamle og nye adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deine neue E-Mail-Adresse ein. Wir senden eine Bestätigung an deine alte und neue Adresse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισάγετε τη νέα σας διεύθυνση ηλεκτρονικού ταχυδρομείου. Θα στείλουμε μια επιβεβαίωση στη παλιά και τη νέα σας διεύθυνση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your new email address. We'll send a confirmation to both your old and new address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa tu nueva dirección de correo electrónico. Enviaremos una confirmación a tu correo antiguo y nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisesta oma uus e-posti aadress. Saadame kinnituse nii vana kui ka uue aadressi peale."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آدرس ایمیل جدید خود را وارد کنید. ما تأیید را به هر دو آدرس قدیم و جدید ارسال خواهیم کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita uusi sähköpostiosoitteesi. Lähetämme vahvistuksen sekä vanhaan että uuteen osoitteeseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilagay ang iyong bagong email address. Magpapadala kami ng bekreftelse sa iyong lumang at bagong address."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez votre nouvelle adresse e-mail. Nous enverrons une confirmation à votre ancienne et nouvelle adresse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזן את כתובת הדוא\"ל החדשה שלך. נשלח אישור לכתובתך הישנה והחדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना नया ईमेल पता दर्ज करें। हम आपके पुराने और नए दोनों पतों पर पुष्टि भेजेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite vašu novu e-mail adresu. Poslat ćemo potvrdu na vašu staru i novu adresu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írja be az új e-mail címet. Megerősítést küldünk mind a régi, mind az új címre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan alamat email baru Anda. Kami akan mengirim konfirmasi ke alamat lama dan baru Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sláðu inn nýja netfangið þitt. Við munum senda staðfestingu á bæði gömlu og nýju heimilisföngin þín."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il tuo nuovo indirizzo email. Ti invieremo una conferma sia al tuo indirizzo vecchio che a quello nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいメールアドレスを入力してください。確認メールを古いアドレスと新しいアドレスの両方に送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 이메일 주소를 입력하세요. 이전 주소와 새 주소 모두에 확인 이메일을 보내드립니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite savo naują el. pašto adresą. Patvirtinimą išsime į jūsų seną ir naują adresą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ievadiet savu jauno e-pasta adresi. Mēs nosūtīsim apstiprinājumu uz jūsu veco un jauno adresi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn din nye e-postadresse. Vi sender en bekreftelse til både den gamle og nye adressen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer je nieuwe e-mailadres in. We sturen een bevestiging naar zowel je oude als nieuwe adres."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn din nye e-postadresse. Vi sender ein bekreftelse til både den gamle og nye adressen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz swój nowy adres e-mail. Wyślemy potwierdzenie na stary i nowy adres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite seu novo endereço de email. Enviaremos uma confirmação para seu endereço antigo e novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți noua adresă de e-mail. Vom trimite o confirmare la ambele adrese, cea veche și cea nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите новый адрес электронной почты. Мы отправим подтверждение на оба адреса — старый и новый."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte svoju novú e-mailovú adresu. Pošleme potvrdenie na vašu starú aj novú adresu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vpiši svoj novi e-poštni naslov. Poslali bomo potrditev na tvoj stari in novi naslov."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite vašu novu e-mail adresu. Poslacemo potvrdu na staru i novu adresu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange din nya e-postadress. Vi skickar en bekräftelse till både din gamla och nya adress."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingiza anwani yako mpya ya barua pepe. Tutakutumia uthibitisho kwa anwani yako ya zamani na mpya."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் புதிய மின்னஞ்சல் முகவரியை உள்ளிடவும். உங்கள் பழைய மற்றும் புதிய முகவரிக்கு உறுதிப்படுத்தல் அனுப்பப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนที่อยู่อีเมลใหม่ของคุณ เราจะส่งการยืนยันไปยังทั้งที่อยู่เก่าและใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni e-posta adresinizi girin. Eski ve yeni adresinize bir onay göndereceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть вашу нову адресу електронної пошти. Ми надішлемо підтвердження на стару й нову адресу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا نیا ای میل پتہ درج کریں۔ ہم آپ کے پرانے اور نئے دونوں پتوں پر تصدیق بھیجیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập địa chỉ email mới của bạn. Chúng tôi sẽ gửi xác nhận đến cả địa chỉ cũ và mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入您的新电子邮件地址。我们将向您的旧地址和新地址发送确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入你的新電郵地址。我們會向你的舊電郵和新電郵地址發送確認。"
          }
        }
      }
    },
