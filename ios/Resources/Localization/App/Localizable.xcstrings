    "profile.dangerZone.deleteAccount.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet din konto og alle data permanent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und alle Daten dauerhaft löschen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάγραψε μόνιμα τον λογαριασμό σου και όλα τα δεδομένα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete your account and all data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu cuenta y todos los datos permanentemente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tilisi ja kaikki tiedot pysyvästi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez définitivement votre compte et toutes les données"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente il tuo account e tutti i dati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと全データを永久に削除します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 및 모든 데이터 영구 삭제"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett kontoen din og alle data permanent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder je account en alle gegevens permanent"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett kontoen din og alle data permanent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuń swoje konto i wszystkie dane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletar sua conta e todos os dados permanentemente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge permanent contul și toate datele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удалить ваш аккаунт и все данные"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta permanent bort ditt konto och all data"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีของคุณและข้อมูลทั้งหมดอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızı ve tüm verilerinizi kalıcı olarak silin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постійно видаліть свій обліковий запис і всі дані"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn tài khoản và tất cả dữ liệu của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除你的账户和所有数据"
          }
        }
      }
    },
    "profile.dangerZone.deleteAccount.dialogDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv SLET for at bekræfte. Alle data vil blive fjernet permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib LÖSCHEN ein zur Bestätigung. Alle Daten werden dauerhaft gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολόγησε ΔΙΑΓΡΑΦΗ για επιβεβαίωση. Όλα τα δεδομένα θα αφαιρεθούν μόνιμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type DELETE to confirm. All data will be permanently removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe ELIMINAR para confirmar. Todos los datos se eliminarán permanentemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita POISTA vahvistaaksesi. Kaikki tiedot poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez SUPPRIMER pour confirmer. Toutes les données seront supprimées définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi ELIMINA per confermare. Tutti i dati verranno rimossi permanentemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を確認するには「削除」と入力してください。すべてのデータが永久に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 입력하여 확인하세요. 모든 데이터가 영구적으로 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv SLETT for å bekrefte. Alle data vil bli fjernet permanent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ VERWIJDEREN ter bevestiging. Alle gegevens worden permanent verwijderd."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv SLETT for å bekrefte. Alle data vil bli fjernet permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz USUŃ, aby potwierdzić. Wszystkie dane zostaną trwale usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite DELETAR para confirmar. Todos os dados serão removidos permanentemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastează ȘTERGE pentru a confirma. Toate datele vor fi șterse permanent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите УДАЛИТЬ для подтверждения. Все данные будут удалены безвозвратно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv TA BORT för att bekräfta. All data kommer att tas bort permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ ลบ เพื่อยืนยัน ข้อมูลทั้งหมดจะถูกลบอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak için SİL yazın. Tüm veriler kalıcı olarak kaldırılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ВИДАЛИТИ для підтвердження. Усі дані будуть видалені назавжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập XÓA để xác nhận. Tất cả dữ liệu sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 DELETE 以确认。所有数据将被永久删除。"
          }
        }
      }
    },
