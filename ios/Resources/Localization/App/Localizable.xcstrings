          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetyt käyttäjät pysyvät poissa kavereista ja chatista, kunnes poistat eston."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi makakasama ang mga naka-block na user sa mga kaibigan at chat hanggang i-unblock mo sila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilisateurs bloqués restent hors des amis et du chat jusqu’à ce que vous les débloquiez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמשים חסומים יישארו מחוץ לחברים ולצ'אט עד שתבטל את החסימה שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
