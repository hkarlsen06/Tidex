          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому пристрої ще немає даних. Дочекайтеся завершення синхронізації."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
