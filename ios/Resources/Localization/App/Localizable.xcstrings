            "state": "translated",
            "value": "이 날짜는 반복 근무에서 제외됩니다. 근무가 더 이상 표시되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne datoen blir ekskludert fra den faste vakten. Vakten vil ikke lenger vises."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze datum wordt uitgesloten van de terugkerende shift. De shift verschijnt niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta data zostanie wykluczona z powtarzającego się dyżuru. Dyżur nie będzie już widoczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta data será excluída do turno recorrente. O turno não aparecerá mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта дата будет исключена из повторяющейся смены. Смена больше не будет отображаться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta datum kommer att uteslutas från det återkommande skiftet. Skiftet visas inte längre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้จะถูก除外จากกะการทำงานที่เกิดซ้ำ กะการทำงานจะไม่ปรากฏขึ้นอีก"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дата буде виключена з повторюваної зміни. Змін більше не буде видно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày này sẽ bị loại khỏi ca làm việc định kỳ. Ca làm việc sẽ không còn hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日期将从循环班次中排除。班次将不再显示。"
          }
        }
      }
    },
