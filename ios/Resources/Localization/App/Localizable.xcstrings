          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique seu e-mail para um link de redefinição. Verifique também sua pasta de spam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте электронную почту на наличие ссылки сброса. Проверьте также папку спама."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer uw e-mail voor een reset-link. Controleer ook uw spammap."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera din e-post för en återställningslänk. Kontrollera även skräppostmappen."
