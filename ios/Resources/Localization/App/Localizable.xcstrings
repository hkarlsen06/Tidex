    "wagey.limitReached.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد استخدمت جميع رسائل Wagey الخاصة بك هذا الشهر. تُعاد تعيين الرسائل في بداية الشهر القادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвал си всички твои Wagey съобщения тази месец. Съобщенията се нулират в началото на следващия месец."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি এই মাসে আপনার সমস্ত Wagey বার্তা ব্যবহার করেছেন। বার্তাগুলি পরের মাসের শুরুতে পুনরায় সেট হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has utilitzat tots els teus missatges Wagey aquest mes. Els missatges es restableixen al començament del següent mes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyčerpali jste všechny své zprávy Wagey tento měsíc. Zprávy se resetují na začátku příštího měsíce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brugt alle dine Wagey-beskeder denne måned. Beskeder nulstilles ved begyndelsen af næste måned."
