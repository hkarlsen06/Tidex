    "settings.pay.timeline.infoTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wage entries determine which pay and supplements apply to shifts in different periods."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lønnsoppføringer bestemmer hvilken lønn og tillegg som gjelder for vakter i ulike perioder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohneinträge bestimmen, welcher Lohn und welche Zuschläge für Schichten in verschiedenen Zeiträumen gelten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas salariales determinan qué salario y suplementos aplican a los turnos en diferentes períodos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées de salaire déterminent quels salaires et suppléments s'appliquent aux quarts de travail à différentes périodes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与情報により、異なる期間のシフトに適用される給与と手当が決定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여 항목은 다양한 기간의 근무에 적용되는 급여 및 보조금을 결정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As entradas de salário determinam quais pagamentos e suplementos se aplicam aos turnos em diferentes períodos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи о зарплате определяют, какие оклады и надбавки применяются к смене в разные периоды."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salarisgegevens bepalen welke betaling en toeslagen van toepassing zijn op shifts in verschillende perioden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Löneposter avgör vilken lön och tillägg som gäller för pass under olika perioder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Loenindtastninger bestemmer, hvilken loen og tillaegg der gaelder for skift i forskellige perioder."
          }
        }
      }
    },
