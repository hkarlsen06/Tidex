    "data.export.about.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten er optimeret til A4-stående format og inkluderer automatiske sidetal og genereringstidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der PDF-Bericht ist für das A4-Hochformat optimiert und enthält automatische Seitenzahlen und einen Generierungszeitstempel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναφορά PDF είναι βελτιστοποιημένη για μορφή A4 σε κατακόρυφο προσανατολισμό και περιλαμβάνει αυτόματους αριθμούς σελίδας και χρονοσφραγίδα δημιουργίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF report is optimized for A4 portrait format and includes automatic page numbers and generation timestamp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe PDF está optimizado para formato A4 vertical e incluye números de página automáticos y marca de tiempo de generación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-raportti on optimoitu A4-muotoon pystysuunnassa ja sisältää automaattiset sivunumerot ja generoinnin aikaleiman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport PDF est optimisé pour le format A4 portrait et inclut les numéros de page automatiques et l'horodatage de génération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rapporto PDF è ottimizzato per il formato A4 verticale e include numeri di pagina automatici e timestamp di generazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFレポートはA4縦向き形式に最適化されており、自動ページ番号と生成タイムスタンプが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 보고서는 A4 세로 형식으로 최적화되었으며 자동 페이지 번호와 생성 타임스탬프가 포함됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten er optimalisert for A4-portrettformat og inkluderer automatisk sidetall og genereringstidspunkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het PDF-rapport is geoptimaliseerd voor A4-staandformaat en bevat automatische paginanummers en generatietijdstempel."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten er optimalisert for A4-portrettformat og inneheld automatisk sidetall og genereringstidspunkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raport PDF jest zoptymalizowany dla formatu A4 w orientacji pionowej i zawiera automatyczne numery stron oraz znacznik czasu generowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório PDF é otimizado para formato A4 em retrato e inclui numeração automática de páginas e timestamp de geração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportul PDF este optimizat pentru formatul portret A4 și include automat numerotarea paginilor și timestamp-ul de generare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-отчет оптимизирован для формата A4 в портретной ориентации и включает автоматические номера страниц и время создания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten är optimerad för A4-porträttformat och innehåller automatiska sidnummer och genereringstidstämpel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงาน PDF ถูกปรับให้เหมาะสมสำหรับรูปแบบ A4 แนวตั้ง และรวมหมายเลขหน้าและเวลาสร้างอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF raporu A4 dikey format için optimize edilmiştir ve otomatik sayfa numaraları ile oluşturma zaman damgasını içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-звіт оптимізований для формату A4 в портретній орієнтації та містить автоматичні номери сторінок і часову мітку генерування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo PDF được tối ưu hóa cho định dạng A4 chân dung và bao gồm số trang tự động và dấu thời gian tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF报告已针对A4竖向格式进行优化，并包含自动页码和生成时间戳。"
          }
        }
      }
    },
