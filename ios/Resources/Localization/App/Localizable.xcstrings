    "shifts.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this shift? This cannot be undone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne vakten? Dette kan ikke angres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie diese Schicht löschen möchten? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer cette vaction ? Cette action ne peut pas être annulée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar esta vaca? Esto no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare questa vakt? Questa azione non può essere annullata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze vak wilt verwijderen? Dit kan niet ongedaan gemaakt worden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja deletar este turno? Isso não pode ser desfeito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera detta skift? Det går inte att ångra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette denne vagt? Dette kan ikke fortrydes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa tämän vuoron? Tätä ei voi peruuttaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć tę zmianę? Nie będzie można tego cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эту смену? Это действие невозможно отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цю зміну? Це не можна скасувати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシフトを削除してもよろしいですか?この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 근무를 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除此班次吗?此操作无法撤销。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือว่าต้องการลบกะการทำงานนี้? ไม่สามารถเลิกทำได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa ca làm việc này không? Điều này không thể hoàn tác."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne vakten? Dette kan ikkje angras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vardiyayı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτή τη βάρδια; Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești sigur că vrei să ștergi acest schimb? Aceasta nu poate fi anulată."
          }
        }
      }
    },
