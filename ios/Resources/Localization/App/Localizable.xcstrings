    "supplements.deleteRuleMessage": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil fjerne dette tillæg?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie diesen Zuschlag entfernen möchten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove this supplement?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar este suplemento?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa tämän lisän?"
