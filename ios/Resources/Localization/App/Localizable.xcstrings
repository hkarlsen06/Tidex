          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en grundløn, før du opretter vagter for dette job."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Grundlohn hinzu, bevor du Schichten für diesen Job erstellst."
