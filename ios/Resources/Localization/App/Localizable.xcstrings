        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือว่าต้องการลบส่วนเสริมนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa phụ cấp này không?"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne dette tillegget?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eki kaldırmak istediğinizden emin misiniz?"
