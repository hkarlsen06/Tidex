    "settings.pay.error.deletionChanged" : {
      "comment" : "Error when job data changed between opening and confirming the delete dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت هذه الوظيفة أو سجلها. راجع تفاصيل الحذف مرة أخرى قبل التأكيد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работата или историята ѝ са променени. Прегледайте отново подробностите за изтриването, преди да потвърдите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই চাকরি বা এর ইতিহাস পরিবর্তিত হয়েছে। নিশ্চিত করার আগে মুছে ফেলার বিবরণ আবার পর্যালোচনা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta feina o el seu historial ha canviat. Revisa els detalls de l’eliminació abans de confirmar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zaměstnání nebo jeho historie se změnily. Před potvrzením znovu zkontrolujte podrobnosti smazání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette job eller dets historik er blevet ændret. Gennemgå slettelsesoplysningerne igen, før du bekræfter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Job oder seine Historie wurde geändert. Überprüfe die Löschdetails erneut, bevor du bestätigst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εργασία ή το ιστορικό της έχει αλλάξει. Ελέγξτε ξανά τις λεπτομέρειες διαγραφής πριν επιβεβαιώσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This job or its history has changed. Review the deletion details again before confirming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este empleo o su historial ha cambiado. Revisa de nuevo los detalles de eliminación antes de confirmar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töökoht või selle ajalugu on muutunud. Enne kinnitamist vaata kustutamise üksikasjad uuesti üle."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این شغل یا سوابق آن تغییر کرده است. پیش از تأیید، دوباره جزئیات حذف را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työpaikkaa tai sen historiaa on muutettu. Tarkista poistotiedot uudelleen ennen vahvistamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbago ang trabahong ito o ang kasaysayan nito. Suriing muli ang mga detalye ng pagbura bago kumpirmahin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet emploi ou son historique a changé. Vérifiez à nouveau les détails de la suppression avant de confirmer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקום העבודה או ההיסטוריה שלו השתנו. בדוק שוב את פרטי המחיקה לפני האישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस नौकरी या इसके इतिहास में बदलाव हुआ है। पुष्टि करने से पहले हटाने का विवरण फिर से देखें।"
