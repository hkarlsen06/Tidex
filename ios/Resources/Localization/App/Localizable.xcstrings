        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当は労働協約に従い、手動で変更することはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 단체협약을 따르므로 수동으로 변경할 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os adicionais seguem o acordo tarifário e não podem ser alterados manualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки соответствуют тарифному соглашению и не могут быть изменены вручную"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen volgen de cao en kunnen niet handmatig worden gewijzigd"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägg följer avtalet och kan inte ändras manuellt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillæg følger takstaftalen og kan ikke ændres manuelt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi seguono l'accordo tariffario e non possono essere modificati manualmente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisät noudattavat työehtosopimusta eikä niitä voi muuttaa manuaalisesti"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki wynikają z umowy taryfowej i nie mogą być zmieniane ręcznie"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надбавки відповідають тарифній угоді та не можуть змінюватися вручну"
          }
        },
        "zh-Hans": {
          "stringUnit": {
