    "subscription.errors.restoreFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not restore purchases. Please try again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gjenopprette kjøp. Prøv igjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe konnten nicht wiederhergestellt werden. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer les achats. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar las compras. Inténtalo de nuevo."
