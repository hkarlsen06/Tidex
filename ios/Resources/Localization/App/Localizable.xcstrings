    "paywall.shiftLimit.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free plan allows shifts in one month at a time. Upgrade to track shifts across multiple months."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-planen tillater vakter i én måned om gangen. Oppgrader for å spore vakter over flere måneder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Plan erlaubt Schichten für einen Monat auf einmal. Upgrade durchführen, um Schichten über mehrere Monate zu verfolgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito permite turnos en un mes a la vez. Actualiza para registrar turnos en varios meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan gratuit permet des quarts sur un mois à la fois. Passez à la version supérieure pour suivre les quarts sur plusieurs mois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランでは1ヶ月分のシフトのみ可能です。複数月のシフト追跡にアップグレード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 요금제는 한 번에 1개월의 근무만 허용합니다. 여러 개월에 걸쳐 근무를 추적하려면 업그레이드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Plano gratuito permite turnos em um mês por vez. Atualize para rastrear turnos em vários meses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный план позволяет отслеживать смены в течение одного месяца. Обновитесь, чтобы отслеживать смены за несколько месяцев."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gratis abonnement maakt diensten in één maand tegelijk mogelijk. Upgrade om diensten over meerdere maanden bij te houden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisplanen tillåter arbetspass under en månad i taget. Uppgradera för att spåra arbetspass under flera månader."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis plan tillader skift i en måned ad gangen. Opgrader for at registrere skift over flere måneder."
          }
        }
      }
    },
