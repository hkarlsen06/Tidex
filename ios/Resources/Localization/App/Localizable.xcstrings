    "onboarding.welcome.subtitle" : {
      "comment" : "Subtitle on the onboarding welcome screen. It continues the sentence in the title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...لتعرف دائمًا ما ستحصل عليه فعليًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...за да знаеш винаги колко реално ще ти платят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...যাতে আপনি সবসময় জানেন, আসলে কত বেতন পাবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...perquè sempre sàpigues què cobraràs realment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…abyste vždy věděli, kolik skutečně dostanete zaplaceno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...så du altid ved, hvad du faktisk får udbetalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…damit du immer weißt, was du tatsächlich ausgezahlt bekommst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ώστε να ξέρεις πάντα τι θα πληρωθείς πραγματικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...so you always know what you will actually get paid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...para que siempre sepas cuánto cobrarás realmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…et sa alati teaksid, mida sulle tegelikult makstakse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...تا همیشه بدانید واقعاً چقدر حقوق می‌گیرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...joten tiedät aina, mitä sinulle oikeasti maksetaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...para lagi mong alam kung magkano talaga ang matatanggap mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…pour toujours savoir ce que vous serez réellement payé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...כך שתמיד תדע כמה באמת תקבל"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...ताकि आप हमेशा जानें कि आपको वास्तव में कितना भुगतान मिलेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...kako biste uvijek znali koliko ćete stvarno biti plaćeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…így mindig tudod, mennyit kapsz ténylegesen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...jadi Anda selalu tahu berapa yang benar-benar akan Anda terima."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…svo þú vitir alltaf hvað þú færð í raun greitt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...così sai sempre quanto verrai effettivamente pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…だから実際の手取りがいつでも分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...그래서 실제로 얼마를 받는지 항상 알 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…kad visada žinotumėte, kiek iš tikrųjų gausite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...lai tu vienmēr zinātu, ko patiesībā saņemsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…så du alltid vet hva du faktisk får utbetalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...zodat je altijd weet wat je echt uitbetaald krijgt."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…så du alltid veit kva du faktisk får utbetalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...aby zawsze wiedzieć, ile faktycznie dostaniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...para você sempre saber quanto realmente vai receber."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...ca să știi mereu cât vei fi plătit de fapt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...чтобы вы всегда знали, сколько вам на самом деле заплатят."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…aby ste vždy vedeli, čo skutočne dostanete vyplatené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...da vedno veš, koliko boš dejansko dobil plačano."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...tako da uvek znaš koliko ćeš zaista biti plaćen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…så du alltid vet vad du faktiskt får utbetalt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...ili ujue kila mara unacholipwa hasa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...அதனால் உங்களுக்கு உண்மையில் எவ்வளவு சம்பளம் கிடைக்கும் என்று எப்போதும் தெரியும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...เพื่อให้คุณรู้เสมอว่าคุณจะได้รับเงินจริงเท่าไร"
