    "wagey.showcase.features.naturalLanguage.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som du taler. Wagey forstår alle sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib, wie du sprichst. Wagey versteht alle Sprachen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψε όπως μιλάς. Ο Wagey καταλαβαίνει όλες τις γλώσσες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write as you speak. Wagey understands all languages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe como hablas. Wagey entiende todos los idiomas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita kuten puhut. Wagey ymmärtää kaikki kielet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez comme vous parlez. Wagey comprend toutes les langues."
          }
        },
