    "settings.pay.editor.supplementsEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No custom supplements. Tap + to add."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egendefinerte tillegg. Trykk + for å legge til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine benutzerdefinierten Zuschläge. Tippe +, um hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun supplément personnalisé. Appuyez sur + pour en ajouter."
          }
        },
        "es": {
          "stringUnit": {
