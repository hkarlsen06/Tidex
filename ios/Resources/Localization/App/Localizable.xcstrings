    "liveActivity.pushStart.alertBody" : {
      "comment" : "Body of the notification the server sends when a shift starts and a Live Activity begins.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض مناوبتك الجارية الآن كنشاط مباشر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущата ви смяна вече се показва като Live Activity."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার চলমান শিফট এখন লাইভ অ্যাক্টিভিটি হিসেবে দেখানো হচ্ছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu torn en curs ara es mostra com una activitat en viu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše probíhající směna se nyní zobrazuje jako živá aktivita."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din igangværende vagt vises nu som en liveaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine laufende Schicht wird jetzt als Live-Aktivität angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τρέχουσα βάρδιά σας εμφανίζεται τώρα ως Ζωντανή Δραστηριότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your ongoing shift is now shown as a Live Activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu turno en curso ahora se muestra como una Actividad en Vivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie käimasolev vahetus kuvatakse nüüd reaalajas tegevusena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیفت در حال انجام شما اکنون به‌صورت Live Activity نمایش داده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnissä oleva vuorosi näkyy nyt Live Activityna."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapakita na ngayon bilang Live Activity ang kasalukuyan mong shift."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre service en cours est désormais affiché comme une activité en direct."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשמרת הפעילה שלך מוצגת כעת כפעילות חיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी चल रही शिफ्ट अब लाइव गतिविधि के रूप में दिखाई जा रही है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša trenutačna smjena sada se prikazuje kao Aktivnost uživo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folyamatban lévő műszakod mostantól élő tevékenységként jelenik meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift yang sedang berlangsung kini ditampilkan sebagai Aktivitas Langsung."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yfirstandandi vaktin þín birtist nú sem lifandi virkni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo turno in corso è ora mostrato come Attività in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中の勤務がライブアクティビティとして表示されるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 근무가 이제 라이브 활동으로 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų vykstanti pamaina dabar rodoma kaip „Live Activity“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tava pašreizējā maiņa tagad tiek rādīta kā tiešraides aktivitāte."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den pågående vakten vises nå som en liveaktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lopende dienst wordt nu weergegeven als een liveactiviteit."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den pågåande vakta blir no vist som ein liveaktivitet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja trwająca zmiana jest teraz widoczna jako Live Activity."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu turno em andamento agora é exibido como uma Atividade ao Vivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tura în desfășurare este acum afișată ca Activitate live."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая смена теперь отображается как Live Activity."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša prebiehajúca zmena sa teraz zobrazuje ako Živá aktivita."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša trenutna izmena je zdaj prikazana kot dejavnost v živo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša tekuća smena se sada prikazuje kao Aktivnost uživo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt pågående pass visas nu som en liveaktivitet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamu yako inayoendelea sasa inaonyeshwa kama Shughuli ya Moja kwa Moja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் நடப்பு ஷிப்ட் இப்போது Live Activity ஆக காட்டப்படுகிறது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กะงานที่กำลังดำเนินอยู่ของคุณแสดงเป็นกิจกรรมสดแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam eden vardiyanız artık Canlı Etkinlik olarak gösteriliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша поточна зміна тепер відображається як Live Activity."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی جاری شفٹ اب لائیو ایکٹیویٹی کے طور پر دکھائی جا رہی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca làm đang diễn ra của bạn hiện được hiển thị dưới dạng Hoạt động trực tiếp."
          }
        },
        "zh-Hans" : {
