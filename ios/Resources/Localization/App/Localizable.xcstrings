        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete pokračovať, musíte si prečítať a akceptovať naše Podmienky používania a Zásady ochrany osobných údajov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za nadaljevanje moraš prebrati in sprejeti naše Pogoje uporabe in Politiko zasebnosti."
