    "profile.emailChange.oauthOnlyHint" : {
      "comment" : "Hint in profile settings for users who signed in with Google or Apple. They must set a password before they can change email.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد قمت بتسجيل الدخول باستخدام Google/Apple. لتغيير بريدك الإلكتروني، يجب أولاً تعيين كلمة مرور في إعدادات الأمان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влязохте с Google/Apple. За да промените имейла, първо задайте парола в настройките за сигурност."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি Google/Apple দিয়ে সাইন ইন করেছেন। ইমেল পরিবর্তন করতে, প্রথমে নিরাপত্তা সেটিংসে একটি পাসওয়ার্ড সেট করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas iniciar sessió amb Google/Apple. Per canviar el teu correu electrònic, primer estableix una contrasenya a la configuració de seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlásili jste se přes Google/Apple. Chcete-li změnit e-mail, nejdříve si nastavte heslo v nastavení zabezpečení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du loggede ind med Google/Apple. For at ændre din e-mail skal du først angive en adgangskode i sikkerhedsindstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich mit Google/Apple angemeldet. Um deine E-Mail zu ändern, lege zuerst ein Passwort in den Sicherheitseinstellungen fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθήκατε με Google/Apple. Για να αλλάξετε το email, ορίστε πρώτα έναν κωδικό πρόσβασης στις ρυθμίσεις ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You signed in with Google/Apple. To change your email, first set a password in security settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciaste sesión con Google/Apple. Para cambiar tu correo, primero establece una contraseña en la configuración de seguridad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa logisid sisse Google/Apple kaudu. E-posti muutmiseks määra esmalt parool turvaseadetes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما با Google/Apple وارد شدید. برای تغییر ایمیل، ابتدا در تنظیمات امنیتی رمزعبور تنظیم کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjauduit sisään Google/Applen kautta. Vaihtaaksesi sähköpostia, aseta ensin salasana turva-asetuksissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nag-sign in ka gamit ang Google/Apple. Upang baguhin ang iyong email, una ay magtakda ng password sa security settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes connecté avec Google/Apple. Pour changer votre e-mail, définissez d'abord un mot de passe dans les paramètres de sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נכנסת עם Google/Apple. לשינוי הדוא\"ל, תחילה הגדר סיסמה בהגדרות ההשכלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप Google/Apple से साइन इन करते हैं। अपना ईमेल बदलने के लिए, पहले सुरक्षा सेटिंग में एक पासवर्ड सेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavili ste se s Googleom/Appleom. Za promjenu e-maila prvo postavite lozinku u postavkama sigurnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google/Apple segítségével jelentkezett be. Az e-mail módosításához először állítson be egy jelszót a biztonsági beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda masuk dengan Google/Apple. Untuk mengubah email, terlebih dahulu atur kata sandi di pengaturan keamanan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú skráðir þig inn með Google/Apple. Til að breyta netfangi vertu fyrst að stilla lykilorð í öryggisstillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato l'accesso con Google/Apple. Per cambiare email, prima imposta una password nelle impostazioni di sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google/Appleでサインインしました。メールアドレスを変更するには、まずセキュリティ設定でパスワードを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google/Apple로 로그인했습니다. 이메일을 변경하려면 먼저 보안 설정에서 비밀번호를 설정하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs prisijungėte naudodami Google/Apple. Norėdami keisti el. paštą, pirmiausia nustatykite slaptažodį saugos nustatymuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs pierakstījāties ar Google/Apple. Lai mainītu e-pastu, vispirms iestatiet paroli drošības iestatījumos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du logget inn med Google/Apple. For å endre e-post må du først sette et passord i sikkerhetsinnstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt je aangemeld met Google/Apple. Om je e-mail te wijzigen, stel je eerst een wachtwoord in via beveiligingsinstellingen."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du logga inn med Google/Apple. For å endre e-post må du først setja eit passord i sikkerhetsinnstillingane."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalogowałeś się przez Google/Apple. Aby zmienić e-mail, najpierw ustaw hasło w ustawieniach bezpieczeństwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se conectou com Google/Apple. Para alterar seu email, primeiro defina uma senha nas configurações de segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V-ați conectat cu Google/Apple. Pentru a schimba e-mailul, setați mai întâi o parolă în setările de securitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вошли через Google/Apple. Чтобы изменить электронную почту, сначала установите пароль в параметрах безопасности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlásili ste sa cez Google/Apple. Na zmenu e-mailu si najskôr nastavte heslo v nastaveniach zabezpečenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavljeni si se z Google/Apple. Za spremembo e-pošte moraš najprej nastaviti geslo v varnostnih nastavitvah."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavio/la si se sa Google/Apple. Da biste promenili e-mail, prvo postavite lozinku u sigurnosnim postavkama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du loggade in med Google/Apple. För att ändra e-post måste du först ställa in ett lösenord i säkerhetsinställningarna."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulijisajili kwa kutumia Google/Apple. Ili kubadilisha barua pepe, kwanza weka nenosiri katika mipangilio ya usalama."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் Google/Apple மூலம் உள்நுழைந்தீர்கள். மின்னஞ்சலை மாற்ற, முதலில் பாதுகாப்பு அமைப்புகளில் கடவுச்சொல்லை அமைக்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเข้าสู่ระบบด้วย Google/Apple หากต้องการเปลี่ยนอีเมล ให้ตั้งรหัสผ่านในการตั้งค่าความปลอดภัยก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google/Apple ile giriş yaptınız. E-postayı değiştirmek için önce güvenlik ayarlarında bir şifre belirleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви увійшли через Google/Apple. Щоб змінити електронну пошту, спочатку встановіть пароль у параметрах безпеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ نے Google/Apple کے ساتھ سائن ان کیا۔ ای میل تبدیل کرنے کے لیے، پہلے سیکیورٹی سیٹنگز میں پاس ورڈ سیٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đăng nhập bằng Google/Apple. Để thay đổi email, trước tiên hãy đặt mật khẩu trong cài đặt bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您使用 Google/Apple 登录。要更改电子邮件，请先在安全设置中设置密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你使用 Google/Apple 登入。若要變更電郵，請先在安全設定中設定密碼。"
          }
        }
      }
    },
