    "appearance.calendarAnimation.verticalDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزلق لأعلى وأسفل بين الأشهر"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плъзгане нагоре и надолу между месеци"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাসের মধ্যে উপরে এবং নিচে স্লাইড করুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca amunt i avall entre mesos"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posun nahoru a dolů mezi měsíci"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glid op og ned mellem måneder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf und ab zwischen Monaten wechseln"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ολίσθηση πάνω και κάτω μεταξύ μηνών"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slide up and down between months"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba y abajo entre meses"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libiseb üles ja alla kuude vahel"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغزش بالا و پایین بین ماه‌ها"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liuku ylös ja alas kuukausien välillä"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-slide pataas at pababa sa pagitan ng mga buwan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez vers le haut et vers le bas entre les mois"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק למעלה ולמטה בין חודשים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महीनों के बीच ऊपर और नीचे स्लाइड करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klizi gore i dolje između mjeseci"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csúszás fel és le a hónapok között"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser naik dan turun antar bulan"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renna upp og niður milli mánaða"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorre su e giù tra i mesi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月の間を上下にスライド"
