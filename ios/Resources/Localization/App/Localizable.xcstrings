    "Create a new share between two users. The owner's shifts will be visible to the viewer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine neue Freigabe zwischen zwei Benutzern. Die Schichten des Inhabers sind für den Betrachter sichtbar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en ny deling mellom to brukere. Eierens skift vil være synlige for viseren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear un nuevo compartimiento entre dos usuarios. Los turnos del propietario serán visibles para el espectador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer un nouveau partage entre deux utilisateurs. Les quarts de l'propriétaire seront visibles au spectateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人のユーザー間で新しい共有を作成します。オーナーのシフトが閲覧者に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사용자 간에 새 공유를 만듭니다. 소유자의 근무가 시청자에게 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um novo compartilhamento entre dois usuários. Os turnos do proprietário serão visíveis para o visualizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новый общий доступ между двумя пользователями. Смены владельца будут видны зрителю."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nieuw delen tussen twee gebruikers. De shifts van de eigenaar zullen zichtbaar zijn voor de viewer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en ny delning mellan två användare. Ägarens skift blir synliga för visaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ny deling mellem to brugere. Ejerens skift vil være synlige for seeren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nuova condivisione tra due utenti. I turni del proprietario saranno visibili al visualizzatore."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uusi jako kahden käyttäjän välille. Omistajan vuorot näkyvät katsoojalle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz nowe udostępnienie między dwoma użytkownikami. Zmiany właściciela będą widoczne dla użytkownika przeglądającego."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть новий обмін між двома користувачами. Зміни власника будуть видні переглядачу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两个用户之间创建新的共享。所有者的班次将对查看者可见。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างการแบ่งปันระหว่างสองผู้ใช้ กะของเจ้าของจะมองเห็นได้โดยผู้ดู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo chia sẻ mới giữa hai người dùng. Các ca làm việc của chủ sở hữu sẽ hiển thị cho người xem."
          }
        }
      }
    },
