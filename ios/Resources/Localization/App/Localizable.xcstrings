    "settings.pay.timeline.infoTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wage entries determine which pay and supplements apply to shifts in different periods."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lønnsoppføringer bestemmer hvilken lønn og tillegg som gjelder for vakter i ulike perioder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohneinträge bestimmen, welcher Lohn und welche Zuschläge für Schichten in verschiedenen Zeiträumen gelten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées de salaire déterminent la rémunération et les suppléments applicables aux quarts de travail au cours de différentes périodes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas salariales determinan qué pago y complementos se aplican a los turnos en diferentes períodos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci di stipendio determinano quale paga e quali integrazioni si applicano ai turni in diversi periodi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loongegevens bepalen welke bezoldiging en toeslagen van toepassing zijn op diensten in verschillende perioden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de salário determinam qual salário e complementos se aplicam aos turnos em diferentes períodos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lönposter bestämmer vilken lön och tillägg som gäller för skift under olika perioder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lønningsopgørelser bestemmer, hvilken løn og tillæg der gælder for vagter i forskellige perioder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palkkakirjaukset määrittävät, mikä palkka ja lisät koskevat vuoroja eri ajanjaksoilla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy płacowe określają, która płaca i dodatki dotyczą zmian w różnych okresach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи о зарплате определяют, какая оплата и надбавки применяются к сменам в разные периоды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи про зарплату визначають, яка заробітна плата та надбавки застосовуються до змін у різні періоди."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与記録は、異なる期間のシフトに適用される給与と手当を決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여 항목은 다양한 기간의 근무에 적용되는 급여와 수당을 결정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "薪资记录确定在不同时期班次适用的薪资和补贴。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเงินเดือนกำหนดว่าเงินเดือนและเบี้ยประกอบใดที่ใช้กับกะในช่วงเวลาต่างๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục lương xác định lương và phụ cấp nào áp dụng cho ca làm việc trong các khoảng thời gian khác nhau."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lønnsoppføringgar bestemmer kva lønn og tillegg som gjeld for vakter i ulike periodar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret girişleri, farklı dönemlerde vardiyalara hangi ücret ve eklerin uygulanacağını belirler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εγγραφές μισθού καθορίζουν ποια αποδοχή και επιδόματα ισχύουν για τις βάρδιες σε διαφορετικές περιόδους."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrările salariale determină ce plată și suplimente se aplică schimburilor în diferite perioade."
          }
        }
      }
    },
