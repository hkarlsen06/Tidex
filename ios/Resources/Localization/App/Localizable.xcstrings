          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer vaktuoversigt, summer efter type og totale lontal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältää vuorojen yleiskatsauksen, tyypin mukaiset summat ja palkkiyhteenvedon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje przegląd zmian, sumy według typu i podsumowanie wynagrodzeń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает обзор смен, итоги по типам и сводку по зарплате."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Включає огляд змін, підсумки за типами та зведення з оплати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
