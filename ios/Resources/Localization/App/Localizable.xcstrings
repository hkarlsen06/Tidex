        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppléments servent à calculer la rémunération supplémentaire pour les heures inconvenantes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I supplementi vengono utilizzati per calcolare la paga extra per orari scomodi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当は不都合な時間帯の追加給与の計算に使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당은 불편한 시간에 대한 추가 급여를 계산하는 데 사용됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillegg brukes til å beregne ekstra lønn for arbeid på ubekvemme tider"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toeslagen worden gebruikt om extra betaling voor ongunstige uren te berekenen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki służą do obliczenia dodatkowej płacy za trudne godziny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionais são usados para calcular pagamento extra por horas inconvenientes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
