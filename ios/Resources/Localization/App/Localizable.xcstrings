    "settings.pay.error.cannotDeleteWorkplaceWithHistory.message" : {
      "comment" : "Alert message when a job with history cannot be deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي هذه الوظيفة على ورديات أو تعديلات على الأجور. أرشِفها بدلًا من ذلك، أو انقلها أو احذفها أولًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази работа има смени или корекции на заплащането. Вместо това я архивирайте или първо ги преместете или изтрийте."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই চাকরিতে শিফট বা বেতন সমন্বয় রয়েছে। পরিবর্তে এটি আর্কাইভ করুন, অথবা আগে সেগুলো স্থানান্তর বা মুছে ফেলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta feina té torns o ajustos de nòmina. Arxiva-la en lloc d’eliminar-la, o mou-los o elimina’ls primer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zaměstnání obsahuje směny nebo úpravy mzdy. Místo smazání ho archivujte, případně tyto položky nejprve přesuňte nebo smažte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette job har vagter eller lønjusteringer. Arkivér det i stedet, eller flyt eller slet dem først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Job gibt es Schichten oder Lohnanpassungen. Archiviere ihn stattdessen oder verschiebe bzw. lösche sie zuerst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η εργασία έχει βάρδιες ή μισθολογικές προσαρμογές. Αρχειοθετήστε την ή μετακινήστε ή διαγράψτε πρώτα τις βάρδιες και τις προσαρμογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This job has shifts or payroll adjustments. Archive it instead, or move or delete them first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este empleo tiene turnos o ajustes de nómina. Archívalo en su lugar, o muévelos o elimínalos primero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle töökohaga on seotud vahetusi või palgakorrektsioone. Arhiveeri see töökoht või teisalda või kustuta need enne."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این شغل دارای شیفت‌ها یا اصلاحات پرداخت است. به‌جای حذف، آن را بایگانی کنید یا ابتدا آن‌ها را جابه‌جا یا حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä työpaikalla on työvuoroja tai palkankorjauksia. Arkistoi työpaikka tai siirrä tai poista ne ensin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May mga shift o pagsasaayos sa sahod ang trabahong ito. I-archive ito sa halip, o ilipat o burahin muna ang mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet emploi comporte des services ou des ajustements de paie. Archivez-le plutôt, ou déplacez-les ou supprimez-les d'abord."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למקום העבודה הזה יש משמרות או התאמות שכר. העבר אותו לארכיון, או העבר או מחק אותן קודם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस नौकरी में शिफ्ट या वेतन समायोजन हैं। इसके बजाय इसे आर्काइव करें, या पहले उन्हें स्थानांतरित करें या हटाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj posao ima smjene ili prilagodbe plaće. Umjesto toga ga arhivirajte ili ih najprije premjestite ili izbrišite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehhez a munkahelyhez műszakok vagy bérkorrekciók tartoznak. Inkább archiváld, vagy előbb helyezd át, illetve töröld ezeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan ini memiliki shift atau penyesuaian pembayaran. Arsipkan pekerjaan ini, atau pindahkan atau hapus shift dan penyesuaian tersebut terlebih dahulu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta starf inniheldur vaktir eða launaleiðréttingar. Settu það frekar í geymslu eða færðu vaktirnar og launaleiðréttingarnar eða eyddu þeim fyrst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo lavoro ha turni o rettifiche di paga. Archivialo invece, oppure spostali o eliminali prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この勤務先にはシフトまたは給与調整の履歴があります。代わりにアーカイブするか、先にそれらを移動または削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 직장에 근무 기록 또는 급여 조정 내역이 있습니다. 대신 보관하거나, 먼저 이동 또는 삭제하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši darbovietė turi pamainų arba atlygio koregavimų. Verčiau ją suarchyvuokite arba pirmiausia perkelkite ar ištrinkite juos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šai darba vietai ir maiņas vai algas korekcijas. Tā vietā arhivējiet to vai vispirms pārvietojiet vai dzēsiet šīs maiņas un korekcijas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne jobben har vakter eller lønnsjusteringer. Arkiver den i stedet, eller flytt eller slett dem først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze baan heeft diensten of loonaanpassingen. Archiveer de baan in plaats daarvan, of verplaats of verwijder die eerst."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne jobben har vakter eller lønsjusteringar. Arkiver han i staden, eller flytt eller slett dei først."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta praca ma zmiany lub korekty wynagrodzenia. Zamiast tego zarchiwizuj ją albo najpierw przenieś je lub usuń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este emprego tem turnos ou ajustes salariais. Arquive-o ou mova esses itens ou exclua-os primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest loc de muncă are ture sau ajustări salariale. Arhivează-l sau mută-le ori șterge-le mai întâi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого места работы есть смены или корректировки оплаты. Вместо удаления заархивируйте его либо сначала переместите или удалите их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto pracovisko obsahuje pracovné zmeny alebo úpravy mzdy. Namiesto odstránenia ho archivujte, alebo ich najprv presuňte či odstráňte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta služba ima izmene ali prilagoditve plačila. Namesto tega jo arhivirajte ali pa jih najprej premaknite oziroma izbrišite."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj posao ima smene ili korekcije zarade. Umesto toga ga arhivirajte ili ih prvo premestite ili obrišite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här jobbet har arbetspass eller lönejusteringar. Arkivera det i stället, eller flytta eller radera dem först."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazi hii ina zamu au marekebisho ya malipo. Iweke kwenye kumbukumbu badala yake, au uzihamishe au uzifute kwanza."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த வேலையில் ஷிப்ட்கள் அல்லது ஊதியச் சரிசெய்தல்கள் உள்ளன. அதற்குப் பதிலாக காப்பகப்படுத்தவும் அல்லது அவற்றை முதலில் நகர்த்தவும் அல்லது நீக்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานนี้มีกะหรือการปรับค่าจ้าง ให้เก็บถาวรแทน หรือลบหรือย้ายรายการเหล่านั้นก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işte vardiyalar veya bordro düzeltmeleri var. Bunun yerine arşivleyin ya da önce bunları taşıyın veya silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця робота має зміни або коригування оплати. Натомість заархівуйте її або спочатку перемістіть чи видаліть їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ملازمت میں شفٹیں یا پے رول ایڈجسٹمنٹس موجود ہیں۔ اسے حذف کرنے کے بجائے آرکائیو کریں، یا پہلے انہیں منتقل یا حذف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc này có ca làm hoặc điều chỉnh lương. Thay vào đó, hãy lưu trữ công việc hoặc di chuyển hay xóa chúng trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作包含班次或薪资调整。请改为将其归档，或先移动或删除这些记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作有班次或薪資調整。請改為封存，或先移動或刪除這些項目。"
          }
        }
      }
    },
