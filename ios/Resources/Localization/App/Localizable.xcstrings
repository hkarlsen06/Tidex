          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vključuje pregled vakt, skupne vrednosti po vrsti in povzetek plač."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
