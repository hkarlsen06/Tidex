    "push.failure.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift reminders won't work until this is resolved. Check your notification settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktpåminnelser vil ikke fungere før dette er løst. Sjekk varslingsinnstillingene dine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schichterinnerungen funktionieren erst, wenn dies behoben ist. Überprüfen Sie Ihre Benachrichtigungseinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de turno no funcionarán hasta resolver esto. Verifica tu configuración de notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels de quart ne fonctionneront pas tant que ce problème n'est pas résolu. Vérifiez vos paramètres de notification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この問題が解決されるまで、シフトリマインダーは機能しません。通知設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문제가 해결될 때까지 근무 알림이 작동하지 않습니다. 알림 설정을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes de turno não funcionarão até resolver isso. Verifique suas configurações de notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания о смене не будут работать до разрешения проблемы. Проверьте настройки уведомлений."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienstremindersmeldingen werken niet totdat dit is opgelost. Controleer uw instellingen voor meldingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiftreminders fungerar inte förrän detta är löst. Kontrollera dina meddelandeinställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiftepåmindelser fungerer ikke, før dette er løst. Kontroller dine meddelelsesindstillinger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria degli turni non funzioneranno finché questo non sarà risolto. Controlla le impostazioni di notifica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoron muistutukset eivät toimi, kunnes ongelma on ratkaistu. Tarkista ilmoitusasetukset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia o zmianach nie będą działać dopóki nie rozwiążesz tego. Sprawdź ustawienia powiadomień."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування про зміни не будуть працювати, доки це не буде вирішено. Перевірте параметри сповіщень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在解决此问题之前，班次提醒将无法工作。检查您的通知设置。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนกะจะไม่ทำงานจนกว่าปัญหานี้จะแก้ไข ตรวจสอบการตั้งค่าการแจ้งเตือนของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc nhở ca làm việc sẽ không hoạt động cho đến khi điều này được giải quyết. Kiểm tra cài đặt thông báo của bạn."
          }
        }
      }
    },
