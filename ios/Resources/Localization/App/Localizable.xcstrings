    "stats.charts.employment.info" : {
      "comment" : "Info text for the employment percentage chart. %@ is the number of hours in a full work week, for example 37.5.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حساب نسبة الوظيفة من ساعات عملك مقارنة بأسبوع عمل %@ ساعات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процентът на заетост се изчислява от твоите работни часове в сравнение с %@-часова работна седмица."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিয়োগ শতাংশ আপনার কাজের ঘন্টার তুলনায় একটি %@-ঘন্টার কর্মসপ্তাহ থেকে গণনা করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El percentatge d'ocupació es calcula a partir de les teves hores de treball comparades amb una setmana laboral de %@ hores."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procento pracovního poměru se počítá na základě vašich pracovních hodin ve srovnání s %@-hodinový pracovní týden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillingsprocenten beregnes ud fra dine arbejdstimer sammenlignet med en %@-timers arbejdsuge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anstellungsquote wird berechnet aus deinen Arbeitsstunden im Vergleich zu einer %@-Stunden-Arbeitswoche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ποσοστιαία απασχόληση υπολογίζεται από τις ώρες εργασίας σας σε σχέση με μια %@-ωρη εργάσιμη εβδομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Employment percentage is calculated from your work hours compared to a %@-hour work week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El porcentaje de contratación se calcula a partir de tus horas de trabajo en comparación con una semana laboral de %@ horas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töösuhe protsent arvutatakse sinu töötundide alusel võrreldes %@-tunnise töönädalaga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درصد استخدام بر اساس ساعات کاری شما در مقایسه با یک هفته کاری %@ ساعتی محاسبه می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
