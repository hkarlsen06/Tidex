    "monthLimit.confirmDeleteMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في حذف جميع الورديات في %@؟ لا يمكن التراجع عن هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурни ли сте, че искате да изтриете всички смени в %@? Това не може да бъде отменено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কি নিশ্চিত যে আপনি %@ এ সমস্ত শিফট মুছতে চান? এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esteu segur que voleu eliminar totes les jornades a %@? Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete smazat všechny směny v %@? Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil slette alle vagter i %@? Dette kan ikke omgøres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie alle Schichten in %@ löschen möchten? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε σίγουροι ότι θέλετε να διαγράψετε όλες τις βάρδιες στο %@; Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete all shifts in %@? This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que deseas eliminar todos los turnos en %@? Esto no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas oled kindel, et soovid kustutada kõik vahetused kuus %@? Seda ei saa tagasi võtta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می‌خواهید تمام شیفت‌های %@ را حذف کنید؟ این کار قابل بازگشت نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varma, että haluat poistaa kaikki vuorot kuukaudesta %@? Tätä ei voi kumota."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurado ka na bang gusto mong tanggalin ang lahat ng shift sa %@? Hindi na ito mababawi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir supprimer tous les quarts de travail dans %@ ? Cette action ne peut pas être annulée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שברצונך למחוק את כל המשמרות ב-%@? לא ניתן לבטל זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप %@ में सभी शिफ्ट हटाना चाहते हैं? इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li sigurni da želite obrisati sve smjene u %@? Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan törölni szeretné az összes műszakot ebben: %@? Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda yakin ingin menghapus semua shift di %@? Ini tidak dapat dibatalkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ertu viss um að þú viljir eyða öllum vöktum í %@? Þetta er ekki hægt að afturkalla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler eliminare tutti i turni in %@? Non potrai annullare questa azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のすべてのシフトを削除してもよろしいですか？この操作は元に戻すことができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 모든 근무 시간을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar tikrai norite ištrinti visus pasikeitimus iš %@? Šio veiksmo negalima atšaukti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai tiešām vēlaties dzēst visas maiņas %@? To nevar atsaukt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette alle vakter i %@? Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je alle shifts in %@ wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette alle vakter i %@? Dette kan ikke angres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz usunąć wszystkie zmiany w %@? Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja deletar todos os turnos em %@? Isso não pode ser desfeito."
          }
        },
        "ro" : {
