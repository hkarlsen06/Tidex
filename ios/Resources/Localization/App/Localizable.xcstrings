    "legal.privacyPolicyContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy for Tidex...\n\nWe take your privacy seriously."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personvernerklæring for Tidex...\n\nVi tar personvernet ditt på alvor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzrichtlinie für Tidex...\n\nWir nehmen deine Privatsphäre ernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidad de Tidex...\n\nTomamos tu privacidad en serio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
