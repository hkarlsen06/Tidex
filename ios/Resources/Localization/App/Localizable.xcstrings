    "Create a new share between two users. The owner's shifts will be visible to the viewer.": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en ny deling mellom to brukere. Eierens skift vil være synlige for viseren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie einen neuen Share zwischen zwei Benutzern. Die Schichten des Eigentümers sind für den Betrachter sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un nouveau partage entre deux utilisateurs. Les quarts de l'propriétaire seront visibles par le spectateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuevo intercambio entre dos usuarios. Los turnos del propietario serán visibles para el espectador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nuova condivisione tra due utenti. I turni del proprietario saranno visibili al visualizzatore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nieuwe share tussen twee gebruikers. De shifts van de eigenaar zijn zichtbaar voor de kijker."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um novo compartilhamento entre dois usuários. Os turnos do proprietário serão visíveis para o visualizador."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en ny delning mellan två användare. Ägarens skift kommer att vara synliga för visaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ny deling mellem to brugere. Ejerens skift vil være synlige for seeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uusi jako kahden käyttäjän välille. Omistajan vuorot ovat näkyvissä katsoijalle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz nową współdzielenie między dwoma użytkownikami. Zmiany właściciela będą widoczne dla przeglądającego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую общую папку между двумя пользователями. Смены владельца будут видны зрителю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть нову спільну папку між двома користувачами. Зміни власника будуть видимі переглядачу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人のユーザー間で新しい共有を作成します。オーナーのシフトはビューアーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사용자 간의 새로운 공유를 만듭니다. 소유자의 근무 시간이 보기 권한이 있는 사용자에게 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两个用户之间创建新的共享。所有者的班次将对查看者可见。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างการแชร์ใหม่ระหว่างผู้ใช้สองคน วัคซ์ของเจ้าของจะมองเห็นได้สำหรับผู้ดู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo một lần chia sẻ mới giữa hai người dùng. Các ca làm việc của chủ sở hữu sẽ hiển thị cho người xem."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en ny deling mellom to brukere. Eierens skift vil være synlige for viseren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kullanıcı arasında yeni bir paylaşım oluşturun. Sahibin vardiyaları görüntüleyiciye görünür olacaktır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε μια νέα κοινή χρήση μεταξύ δύο χρηστών. Οι βάρδιες του ιδιοκτήτη θα είναι ορατές στον θεατή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează o partajare nouă între doi utilizatori. Schimburile proprietarului vor fi vizibile pentru vizualizator."
          }
        }
      }
    },
