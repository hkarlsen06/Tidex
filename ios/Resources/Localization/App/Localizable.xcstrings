    "Create a new share between two users. The owner's shifts will be visible to the viewer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine neue Freigabe zwischen zwei Benutzern. Die Schichten des Inhabers sind für den Betrachter sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer un nouveau partage entre deux utilisateurs. Les quarts de travail du propriétaire seront visibles au spectateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear un nuevo intercambio entre dos usuarios. Los turnos del propietario serán visibles para el observador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nuova condivisione tra due utenti. I turni del proprietario saranno visibili al visualizzatore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nieuw delen tussen twee gebruikers. De diensten van de eigenaar zijn zichtbaar voor de viewer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar um novo compartilhamento entre dois usuários. Os turnos do proprietário serão visíveis para o visualizador."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en ny deling mellom to brukere. Eieres skift vil være synlige for visningsprogrammet."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett ein ny deling mellom to brukarar. Vaktene til eigaren vil vere synlege for visaren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en ny delning mellan två användare. Ägarens skift kommer att vara synliga för betraktaren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ny deling mellem to brugere. Ejerens vakter vil være synlige for seeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uusi jako kahden käyttäjän välille. Omistajan vuorot ovat näkyvissä katsojalleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz nowe udostępnienie między dwoma użytkownikami. Zmiany właściciela będą widoczne dla przeglądającego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую общую папку между двумя пользователями. Смены владельца будут видны зрителю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть новий доступ між двома користувачами. Зміни власника будуть видимі глядачу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kullanıcı arasında yeni bir paylaşım oluşturun. Sahibinin vardiyaları görüntüleyiciye görünür olacaktır."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε μια νέα κοινή χρήση μεταξύ δύο χρηστών. Οι βάρδιες του ιδιοκτήτη θα είναι ορατές στον θεατή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează o nouă partajare între doi utilizatori. Schimburile proprietarului vor fi vizibile vizionatorului."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人のユーザー間で新しい共有を作成します。オーナーのシフトはビューアーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사용자 간에 새로운 공유를 만듭니다. 소유자의 근무 일정이 뷰어에게 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两个用户之间创建新的共享。所有者的班次将对查看者可见。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างการแชร์ใหม่ระหว่างสองผู้ใช้ กะการทำงานของเจ้าของจะปรากฏให้ผู้ดูเห็น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo chia sẻ mới giữa hai người dùng. Ca làm việc của chủ sở hữu sẽ hiển thị cho người xem."
          }
        }
      }
    },
