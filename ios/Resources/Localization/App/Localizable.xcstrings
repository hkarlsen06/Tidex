    "calendar.subscription.open_fallback.message" : {
      "comment" : "Error shown when the Calendar app could not be opened automatically. The user copies the link instead.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر فتح التقويم تلقائيًا. انسخ رابط الاشتراك وأضِفه يدويًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Календар не можа да се отвори автоматично. Копирайте линка за абонамент и го добавете ръчно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যালেন্ডার স্বয়ংক্রিয়ভাবে খোলা যায়নি। সাবস্ক্রিপশন লিংক কপি করে হাতে যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut obrir Calendari automàticament. Copia l'enllaç de subscripció i afegeix-lo manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendář nešlo otevřít automaticky. Zkopírujte odkaz na odběr a přidejte ho ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender kunne ikke åbnes automatisk. Kopiér abonnementslinket, og tilføj det manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender konnte nicht automatisch geöffnet werden. Kopiere den Abolink und füge ihn manuell hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό το αυτόματο άνοιγμα του Ημερολογίου. Αντιγράψτε τον σύνδεσμο συνδρομής και προσθέστε τον χειροκίνητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar could not be opened automatically. Copy the subscription link and add it manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir Calendario automáticamente. Copia el enlace de suscripción y añádelo manualmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendrit ei saanud automaatselt avada. Kopeeri tellimislink ja lisa see käsitsi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقویم به‌صورت خودکار باز نشد. لینک اشتراک را کپی کرده و آن را دستی اضافه کنید."
          }
