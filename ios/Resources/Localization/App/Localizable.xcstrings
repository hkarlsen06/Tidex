    "wagey.showcase.features.quickActions.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أو عدّل أو احذف نوبات برسالة بسيطة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавяйте, редактирайте или изтривайте смени с просто съобщение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সহজ বার্তার মাধ্যমে শিফট যোগ করুন, সম্পাদনা করুন বা মুছুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix, edita o suprimeix torns amb un simple missatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávejte, upravujte nebo odstraňujte směny jednoduchou zprávou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj, rediger eller slet vagter med en simpel besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Schichten hinzu, bearbeite oder lösche sie mit einer einfachen Nachricht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε, επεξεργαστείτε ή διαγράψτε βάρδιες με ένα απλό μήνυμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add, edit, or delete shifts with a simple message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade, edita o elimina turnos con un mensaje simple."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisage, muutke või kustutage vahetusi lihtsa sõnumiga."
