          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்தில் இன்னும் தரவு இல்லை. ஒத்திசைவு முடியும் வரை காத்திருக்கவும்."
