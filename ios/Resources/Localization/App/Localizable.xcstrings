    "signup.emailSent.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the link in the email to confirm your account. Check your spam folder too."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på lenken i e-posten for å bekrefte kontoen din. Sjekk også spam-mappen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf den Link in der E-Mail, um Ihr Konto zu bestätigen. Überprüfen Sie auch Ihren Spam-Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le lien dans l'e-mail pour confirmer votre compte. Vérifiez aussi votre dossier spam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el enlace del correo electrónico para confirmar tu cuenta. Comprueba también la carpeta de spam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul link nell'e-mail per confermare il tuo account. Controlla anche la cartella spam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de link in de e-mail om je account te bevestigen. Controleer ook je spammap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no link no e-mail para confirmar sua conta. Verifique também a pasta de spam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på länken i e-posten för att bekräfta ditt konto. Kontrollera även din skräpmapp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på linket i e-mailen for at bekræfte din konto. Tjek også din spam-mappe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa sähköpostissa olevaa linkkiä vahvistaaksesi tilisi. Tarkista myös roskapostikansio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij link w e-mailu, aby potwierdzić swoje konto. Sprawdź również folder spam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на ссылку в письме, чтобы подтвердить учетную запись. Проверьте также папку спама."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть посилання в електронному листі, щоб підтвердити свій обліковий запис. Перевірте також папку спаму."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール内のリンクをクリックしてアカウントを確認してください。迷惑メールフォルダも確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일의 링크를 클릭하여 계정을 확인하세요. 스팸 폴더도 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击电子邮件中的链接确认您的账户。也请检查您的垃圾邮件文件夹。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกลิงก์ในอีเมลเพื่อยืนยันบัญชีของคุณ ตรวจสอบโฟลเดอร์สแปมด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào liên kết trong e-mail để xác nhận tài khoản của bạn. Kiểm tra thư mục spam của bạn."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på lenken i e-posten for å bekrefte kontoen din. Sjekk også spam-mappen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızı onaylamak için e-postadaki bağlantıya tıklayın. Spam klasörünü de kontrol edin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στον σύνδεσμο στο ηλεκτρονικό ταχυδρομείο για να επιβεβαιώσετε τον λογαριασμό σας. Ελέγξτε επίσης τον φάκελο ανεπιθύμητης αλληλογραφίας."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dă clic pe legătura din e-mail pentru a confirma contul. Verifică și folderul spam."
          }
        }
      }
    },
