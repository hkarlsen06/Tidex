    "profile.emailChange.confirmationMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your inbox for both email addresses. You must click the links in both emails to complete the change."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk innboksen din for begge e-postadressene. Du må klikke på lenkene i begge e-postene for å fullføre endringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihren Posteingang für beide E-Mail-Adressen. Sie müssen die Links in beiden E-Mails anklicken, um die Änderung abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu bandeja de entrada en ambas direcciones de correo. Debes hacer clic en los enlaces en ambos correos para completar el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre boîte de réception pour les deux adresses e-mail. Vous devez cliquer sur les liens dans les deux e-mails pour finaliser la modification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のメールアドレスの受信箱を確認してください。変更を完了するには両方のメール内のリンクをクリックする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 이메일 주소 모두 받은편지함을 확인하세요. 변경을 완료하려면 두 이메일의 링크를 모두 클릭해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua caixa de entrada para ambos os endereços de email. Você deve clicar nos links em ambos os emails para concluir a alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте входящие оба адреса электронной почты. Вы должны щелкнуть ссылки в обоих письмах для завершения изменения."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je inbox voor beide e-mailadressen. Je moet op de links in beide e-mails klikken om de wijziging af te ronden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera din inkorg för båda e-postadresserna. Du måste klicka på länkarna i båda e-postmeddelanden för att slutföra ändringen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek din indbakke for begge mailadresser. Du skal klikke linkene i begge mails for at fuldføre ændringen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la posta in arrivo per entrambi gli indirizzi email. Devi fare clic sui link in entrambi i messaggi per completare la modifica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista saapuneet kansiot molemmista sähköpostiosoitteista. Sinun on napsautettava linkkejä molemmissa sähköpostiviesteissä muutoksen suorittamiseksi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź skrzynkę odbiorczą na obu adresach e-mail. Musisz kliknąć linki w obu wiadomościach aby ukończyć zmianę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте вхідну папку обох адрес електронної пошти. Ви повинні натиснути посилання в обох листах для завершення змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查两个电子邮件地址的收件箱。您必须点击两封电子邮件中的链接才能完成更改。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบกล่องขาเข้าของคุณสำหรับอีเมลทั้งสอง คุณต้องคลิกลิงก์ในอีเมลทั้งสองเพื่อให้การเปลี่ยนแปลงเสร็จสิ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra hộp thư của cả hai địa chỉ email. Bạn phải nhấp vào liên kết trong cả hai email để hoàn thành thay đổi."
          }
        }
      }
    },
