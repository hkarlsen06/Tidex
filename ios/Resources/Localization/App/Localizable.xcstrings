    "recurring.deleteConfirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في حذف هذه الوردية المتكررة؟ سيتم إزالة جميع الورديات القادمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурен ли си, че искаш да изтриеш тази повтаряща се смяна? Всички бъдещи смени ще бъдат премахнати."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কি নিশ্চিত যে আপনি এই পুনরাবৃত্ত শিফটটি মুছতে চান? সমস্ত ভবিষ্যত ঘটনা সরানো হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estàs segur que vols eliminar aquesta vaga recurrent? Totes les futures ocurrències s'eliminaran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete smazat tuto opakující se směnu? Všechny budoucí výskyty budou odstraněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil slette denne tilbagevendende vagt? Alle fremtidige vagter vil blive fjernet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie diese wiederkehrende Schicht löschen möchten? Alle zukünftigen Vorkommen werden entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτήν την περιοδική βάρδια; Όλες οι μελλοντικές βάρδιες θα αφαιρεθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this recurring shift? All future occurrences will be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que deseas eliminar este turno recurrente? Se eliminarán todas las futuras ocurrencias."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oled kindel, et soovid seda kordusvahti kustutada? Kõik tulevased vahid eemaldatakse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می‌خواهید این شیفت تکراری را حذف کنید؟ تمام وقایع آینده حذف خواهند شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varma, että haluat poistaa tämän toistuvan vuoron? Kaikki tulevat vuorot poistetaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurado ka na ba na gusto mong burahin ang recurring shift na ito? Lahat ng susunod na occurrence ay aalisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir supprimer ce quart récurrent ? Tous les quarts futurs seront supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שברצונך למחוק משמרת זו החוזרת על עצמה? כל המשמרות העתידיות יוסרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप इस आवर्ती शिफ्ट को हटाना चाहते हैं? सभी भविष्य की शिफ्ट हटा दी जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurno želiš obrisati ovu redovnu smjenu? Svi budući okresni bit će uklonjeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan törölni szeretné ezt az ismétlődő műszakot? Minden jövőbeli előfordulás eltávolításra kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda yakin ingin menghapus shift berulang ini? Semua kejadian di masa depan akan dihapus."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ertu viss um að þú viljir eyða þessari endurteknu vakt? Allar framtíðarvaktir verða fjarlægðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler eliminare questo turno ricorrente? Tutti gli eventi futuri verranno rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この定期シフトを削除してもよろしいですか？今後のすべてのシフトが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 반복 근무를 삭제하시겠습니까? 모든 향후 근무가 제거됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar tikrai norite ištrinti šią pasikartojančią saugą? Visi būsimi pasikartojimas bus pašalinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai tiešām vēlies dzēst šo regulāro maiņu? Tiks noņemtas visas nākotnes maiņas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette denne faste vakten? Alle fremtidige vakter vil bli fjernet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet u zeker dat u deze terugkerende dienst wilt verwijderen? Alle toekomstige diensten worden verwijderd."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette denne faste vakten? Alle framtidige vaktar vil bli fjerna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz usunąć tę powtarzającą się zmianę? Wszystkie przyszłe zmiany zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja excluir este turno recorrente? Todas as ocorrências futuras serão removidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ești sigur că vrei să ștergi acest schimb recurent? Toate apariția viitoare vor fi eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите удалить эту повторяющуюся смену? Все будущие смены будут удалены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naozaj chcete vymazať túto pravidelne sa opakujúcu zmenu? Všetky budúce výskyty budú odstránené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali si prepričan/-a, da želiš izbrisati to ponavljajočo se izmeno? Vse prihodnje izmene bodo odstranjene."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li sigurni da želite obrisati ovu stalnu smenu? Sve budućnosti će biti uklonjene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill ta bort detta återkommande skift? Alla framtida skift kommer att tas bort."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je, una uhakika kwamba unataka kufuta kazi hii ya mara kwa mara? Matukio yote ya siku zijazo yataondolewa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த மீண்டும் வரும் ஷிப்ட்டை நீக்க விரும்பிறீர்களா? எல்லா ভविष்य ஷிப்ட்டுகளும் அகற்றப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือว่าต้องการลบกะประจำนี้ กะในอนาคตทั้งหมดจะถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tekrarlanan vardiyayı silmek istediğinizden emin misiniz? Tüm gelecek vardiyalar kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що хочете видалити цю повторювану зміну? Всі майбутні зміни будуть видалені."
          }
