    "wagey.showcase.hero.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add shifts, check your earnings, and get answers to questions – all with natural language."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til vakter, sjekk inntekten din og få svar på spørsmål – alt med naturlig språk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Schichten hinzu, überprüfe deine Verdienste und erhalte Antworten auf Fragen – alles mit natürlicher Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade turnos, verifica tus ganancias y obtén respuestas – todo con lenguaje natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des postes, vérifiez vos gains et obtenez des réponses – tout en langage naturel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シフト追加、給与確認、質問への回答–すべて自然言語で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시프트 추가, 수입 확인, 질문에 대한 답변 받기 – 모두 자연어로 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione turnos, verifique seus ganhos e obtenha respostas para perguntas – tudo com linguagem natural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте смены, проверяйте заработки и получайте ответы — все с естественным языком."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg diensten toe, controleer je inkomsten en krijg antwoorden op vragen – alles met natuurlijke taal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till skift, kontrollera dina inkomster och få svar på frågor – allt med naturligt språk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj vagter, tjek dine indtjening og få svar på spørgsmål – alt med naturligt sprog."
          }
        }
      }
    },
