    "resetPassword.success.passwordUpdatedInstructions": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit password er opdateret. Du kan nu logge ind med dit nye password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Passwort wurde aktualisiert. Sie können sich jetzt mit Ihrem neuen Passwort anmelden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σας έχει ενημερωθεί. Μπορείτε τώρα να συνδεθείτε με τον νέο κωδικό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has been updated. You can now log in with your new password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña ha sido actualizada. Ahora puedes iniciar sesión con tu nueva contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanasi on päivitetty. Voit nyt kirjautua uudella salasanallasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe a été mis à jour. Vous pouvez maintenant vous connecter avec votre nouveau mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua password è stata aggiornata. Puoi ora accedere con la tua nuova password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが更新されました。新しいパスワードでログインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 업데이트되었습니다. 이제 새 비밀번호로 로그인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet ditt er oppdatert. Du kan nå logge inn med det nye passordet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw wachtwoord is bijgewerkt. U kunt zich nu aanmelden met uw nieuwe wachtwoord."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet ditt er oppdatert. Du kan no logge inn med det nye passordet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło zostało zaktualizowane. Możesz teraz zalogować się nowym hasłem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua senha foi atualizada. Agora você pode fazer login com sua nova senha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola dvs. a fost actualizată. Puteți acum să vă conectați cu noua parolă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль обновлен. Теперь вы можете войти с новым паролем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt lösenord har uppdaterats. Du kan nu logga in med ditt nya lösenord."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านของคุณได้รับการอัปเดต คุณสามารถเข้าสู่ระบบด้วยรหัสผ่านใหม่ได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifren Güncellendi. Şimdi Yeni Şifrenle Giriş Yapabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль оновлено. Тепер ви можете увійти за допомогою нового пароля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu của bạn đã được cập nhật. Bây giờ bạn có thể đăng nhập bằng mật khẩu mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的密码已更新。您现在可以使用新密码登录。"
          }
        }
      }
