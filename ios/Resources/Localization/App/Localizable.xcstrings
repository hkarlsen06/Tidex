    "stats.charts.employment.info": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansættelsesprocenten beregnes ud fra dine arbejdstimer sammenlignet med en %@-timers arbejdsuge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beschäftigungsprozentsatz wird aus Ihren Arbeitsstunden im Vergleich zu einer %@-Stunden-Arbeitswoche berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Employment percentage is calculated from your work hours compared to a %@-hour work week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje de empleo se calcula comparando tus horas de trabajo con una semana laboral de %@ horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työllisyysprosentti lasketaan työntuntejasi verrattuna %@-tuntiseen työviikkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage d'emploi est calculé à partir de vos heures de travail par rapport à une semaine de %@ heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale di impiego è calcolata dalle tue ore di lavoro rispetto a una settimana lavorativa di %@ ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雇用率は、%@時間の週と比較したあなたの労働時間から計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고용률은 %@시간 주중 근무 시간과 비교하여 계산됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingsprosent beregnes ut fra dine arbeidstimer sammenlignet med en %@-timers arbeidsuke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkgelegenheidspercentage wordt berekend op basis van je werkuren vergeleken met een werkweek van %@ uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent zatrudnienia jest obliczany na podstawie Twoich godzin pracy w stosunku do tygodnia pracy wynoszącego %@ godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O percentual de emprego é calculado a partir de suas horas de trabalho comparadas a uma semana de %@ horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент занятости рассчитывается на основе ваших рабочих часов в сравнении с %@-часовой рабочей неделей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anställningsprocenten beräknas från dina arbetstimmar jämfört med en %@-timmars arbetsvecka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปอร์เซ็นต์การจ้างงานคำนวณจากชั่วโมงการทำงานของคุณเมื่อเทียบกับสัปดาห์การทำงาน %@ ชั่วโมง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток зайнятості розраховується на основі ваших робочих годин у порівнянні з %@-годинним робочим тижнем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ lệ việc làm được tính từ số giờ làm việc của bạn so với tuần làm việc %@ giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就业百分比根据您的工作时数与%@小时/周的工作周进行计算。"
          }
        }
      }
    },
