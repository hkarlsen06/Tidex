        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додајте смене, проверите своју зараду и добијте одговоре на питања – све са природним језиком."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till skift, kontrollera dina inkomster och få svar på frågor – allt med naturligt språk."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeza zamu, angalia mapato yako, na pata majibu ya maswali – yote kwa lugha asilia."
