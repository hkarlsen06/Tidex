    "verification.offline.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet to verify your subscription status."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til internett for å bekrefte abonnementet ditt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Internet, um deinen Abonnementstatus zu überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para verificar tu suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Internet pour vérifier votre statut d'abonnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続してサブスクリプションを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에 연결하여 구독 상태를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para verificar seu status de assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к интернету, чтобы проверить статус подписки."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind met internet om je abonnementsstatus te verifiëren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till internet för att verifiera din prenumerationsstatus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind til internettet for at bekræfte dit abonnementsstatus."
          }
        }
      }
    },
