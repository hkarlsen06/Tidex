    "Tests verify offline sync functionality according to Phase 8 test plan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests überprüfen die Offline-Synchronisierungsfunktionalität gemäß Phase 8 Testplan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testene verifiserer offline synkroniseringsfunksjonalitet i henhold til fase 8-testplanen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pruebas verifican la funcionalidad de sincronización sin conexión según el plan de prueba Fase 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tests vérifient la fonctionnalité de synchronisation hors ligne selon le plan de test Phase 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストはPhase 8テスト計画に従ってオフライン同期機能を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트는 Phase 8 테스트 계획에 따라 오프라인 동기화 기능을 검증합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os testes verificam a funcionalidade de sincronização offline de acordo com o plano de testes da Fase 8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тесты проверяют функциональность автономной синхронизации согласно плану тестирования этапа 8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verifiëren offline sync functionaliteit volgens fase 8 testplan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester verifierar synkfunktionalitet offline enligt testplan för fas 8."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verificerer offline synkroniseringsfunktionalitet i henhold til fase 8 testplan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I test verificano la funzionalità di sincronizzazione offline secondo il piano di test Fase 8."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testit vahvistavat offline-synkronointitoiminnon vaatimukseltenhmukaisen toiminnan vaiheen 8 testisuunnitelman mukaisesti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testy weryfikują funkcjonalność synchronizacji offline zgodnie z planem testów Fazy 8."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тести перевіряють функціональність офлайн-синхронізації відповідно до плану тестів Фази 8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试根据第 8 阶段测试计划验证离线同步功能。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests verify offline sync functionality according to Phase 8 test plan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài kiểm tra xác minh chức năng đồng bộ ngoại tuyến theo kế hoạch kiểm tra Giai đoạn 8."
          }
        }
      }
    },
