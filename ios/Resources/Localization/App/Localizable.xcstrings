    "onboarding.supplements.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الإضافات لحساب الأجر الإضافي للساعات غير المناسبة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надбавките се използват за изчисляване на допълнителни премии за неудобни часове"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অসুবিধাজনক সময়ে অতিরিক্ত বেতন গণনা করতে সাপ্লিমেন্ট ব্যবহার করা হয়"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els complements s'utilitzen per calcular el pagament extra per a hores incòmodes"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příplatky se používají k výpočtu přidané mzdy za nepohodlné pracovní doby"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillæg bruges til at beregne ekstra løn for arbejde på ubekvemme tidspunkter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuschläge werden verwendet, um Extravergütung für ungünstige Arbeitszeiten zu berechnen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα επιδόματα χρησιμοποιούνται για τον υπολογισμό επιπλέον μισθού για ενοχλητικές ώρες"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supplements are used to calculate extra pay for inconvenient hours"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los suplementos se utilizan para calcular el pago adicional por horas inconvenientes"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisatasusid kasutatakse ebamugavate tundide lisapalga arvutamiseks"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمک‌هزینه برای محاسبه دستمزد اضافی برای ساعات نامناسب استفاده می‌شود"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisäyksiä käytetään lasketaan ylimääräistä palkkaa epäkäytännöllisillä tunneilla"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga dagdag ay ginagamit upang kalkulahin ang dagdag na bayad para sa hindi komportableng oras"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suppléments sont utilisés pour calculer la rémunération supplémentaire pour les heures inconvenantes"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוספות משמשות לחישוב שכר נוסף לשעות לא נוחות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भत्तों का उपयोग असुविधाजनक समय के लिए अतिरिक्त वेतन की गणना करने के लिए किया जाता है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaci se koriste za izračun dodatne plaće za neugodan radni vremenski raspored"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pótlékok az alkalmatlan időpontokban végzett munka extra fizetésének kiszámítására szolgálnak"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjangan digunakan untuk menghitung gaji tambahan untuk jam kerja yang tidak nyaman"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillögur eru notaðar til að reikna aukalaun fyrir óþægileg tímatöl"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I supplementi vengono utilizzati per calcolare la retribuzione aggiuntiva per orari scomodi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手当は不便な時間帯の追加給与を計算するために使用されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수당은 불편한 시간대의 추가 급여를 계산하는 데 사용됩니다"
