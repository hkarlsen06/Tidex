    "settings.pay.jobActions.archiveConfirmMessage" : {
      "comment" : "Message in the archive job confirmation. Explains that archived jobs stay in history.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الوظائف المؤرشفة في السجل، لكن لا يمكن استخدامها لورديات جديدة حتى استعادتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивираните работи остават в историята, но не могат да се използват за нови смени, докато не бъдат възстановени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আর্কাইভ করা কাজ ইতিহাসে থাকবে, তবে পুনরুদ্ধার না করা পর্যন্ত নতুন শিফটে ব্যবহার করা যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les feines arxivades es mantenen a l'historial, però no es poden fer servir per a torns nous fins que es restaurin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivované práce zůstanou v historii, ale nepůjdou použít pro nové směny, dokud je neobnovíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiverede job bliver i historikken, men kan ikke bruges til nye vagter, før de gendannes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivierte Jobs bleiben im Verlauf, können aber bis zur Wiederherstellung nicht für neue Schichten verwendet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αρχειοθετημένες δουλειές παραμένουν στο ιστορικό, αλλά δεν μπορούν να χρησιμοποιηθούν για νέες βάρδιες μέχρι να αποκατασταθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archived jobs stay in history, but cannot be used for new shifts until restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los trabajos archivados quedan en el historial, pero no pueden usarse para turnos nuevos hasta restaurarlos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhiveeritud töökohad jäävad ajalukku, kuid neid ei saa uute vahetuste jaoks kasutada enne taastamist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغل‌های بایگانی‌شده در سابقه می‌مانند، اما تا زمان بازیابی برای شیفت‌های جدید قابل استفاده نیستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkistoidut työpaikat säilyvät historiassa, mutta niitä ei voi käyttää uusiin vuoroihin ennen palauttamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatili sa history ang mga naka-archive na trabaho, pero hindi magagamit sa mga bagong shift hangga't hindi naibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les emplois archivés restent dans l’historique, mais ne peuvent pas être utilisés pour de nouveaux services avant restauration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבודות בארכיון נשארות בהיסטוריה, אבל אי אפשר להשתמש בהן למשמרות חדשות עד לשחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संग्रहित नौकरियाँ इतिहास में रहती हैं, लेकिन बहाल होने तक नई शिफ्ट के लिए इस्तेमाल नहीं की जा सकतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivirani poslovi ostaju u povijesti, ali se ne mogu koristiti za nove smjene dok se ne vrate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az archivált munkák megmaradnak az előzményekben, de visszaállításig nem használhatók új műszakokhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan yang diarsipkan tetap ada di riwayat, tetapi tidak bisa dipakai untuk shift baru sampai dipulihkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinna í safni helst í ferlinum, en ekki er hægt að nota hana í nýjar vaktir fyrr en hún er endurheimt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I lavori archiviati restano nella cronologia, ma non possono essere usati per nuovi turni finché non vengono ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブした仕事は履歴に残りますが、復元するまで新しいシフトには使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관된 일터는 기록에 남지만, 복원 전까지 새 근무에는 사용할 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archyvuoti darbai lieka istorijoje, bet negali būti naudojami naujoms pamainoms, kol neatkuriami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivētie darbi paliek vēsturē, bet tos nevar izmantot jaunām maiņām, līdz tie tiek atjaunoti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiverte jobber blir liggende i historikken, men kan ikke brukes for nye vakter før de gjenopprettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gearchiveerde banen blijven in de geschiedenis, maar kunnen pas na herstel voor nieuwe diensten worden gebruikt."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiverte jobbar blir verande i historikken, men kan ikkje brukast til nye vakter før dei blir gjenoppretta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarchiwizowane prace pozostają w historii, ale nie można ich używać do nowych zmian, dopóki nie zostaną przywrócone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhos arquivados ficam no histórico, mas não podem ser usados em novos turnos até serem restaurados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locurile de muncă arhivate rămân în istoric, dar nu pot fi folosite pentru ture noi până sunt restaurate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивные работы остаются в истории, но их нельзя использовать для новых смен, пока они не будут восстановлены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivované práce zostanú v histórii, ale nepôjdu použiť na nové zmeny, kým ich neobnovíte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivirane službe ostanejo v zgodovini, vendar jih ni mogoče uporabljati za nove izmene, dokler jih ne obnoviš."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivirani poslovi ostaju u istoriji, ali ne mogu da se koriste za nove smene dok se ne vrate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiverade jobb finns kvar i historiken men kan inte användas för nya pass förrän de återställs."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazi zilizohifadhiwa hubaki kwenye historia, lakini haziwezi kutumika kwa zamu mpya hadi zirejeshwe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காப்பகப்படுத்திய வேலைகள் வரலாற்றில் இருக்கும், ஆனால் மீட்டமைக்கும் வரை புதிய ஷிப்ட்களுக்கு பயன்படுத்த முடியாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานที่เก็บเข้าคลังจะยังอยู่ในประวัติ แต่จะใช้กับกะใหม่ไม่ได้จนกว่าจะกู้คืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivlenen işler geçmişte kalır, ancak geri yüklenene kadar yeni vardiyalarda kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архівовані роботи лишаються в історії, але не можуть використовуватись для нових змін, доки їх не відновити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ شدہ ملازمتیں ہسٹری میں رہتی ہیں، لیکن بحال ہونے تک نئی شفٹوں کے لیے استعمال نہیں ہو سکتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc đã lưu trữ vẫn còn trong lịch sử, nhưng không thể dùng cho ca làm mới đến khi được khôi phục."
          }
        },
