    "onboarding.success.reassurance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can adjust wages, supplements, and tax anytime."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan justere lønn, tillegg og skatt når som helst."
          }
        },
        "de": {
