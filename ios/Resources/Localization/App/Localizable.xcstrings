      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk automatisk pause fra vakter over en viss længde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausenzeit automatisch von Schichten über einer bestimmten Länge abziehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
