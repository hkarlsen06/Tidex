    "profile.dangerZone.deleteAccount.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف حسابك وجميع بيانتك بشكل دائم"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трайно изтриване на вашия акаунт и всички данни"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্ট এবং সমস্ত ডেটা স্থায়ীভাবে মুছুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimeix permanentment el teu compte i totes les dades"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale smazat svůj účet a všechna data"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet din konto og alle data permanent"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle Daten dauerhaft löschen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάγραψε μόνιμα τον λογαριασμό σου και όλα τα δεδομένα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete your account and all data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tu cuenta y todos los datos permanentemente"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kustuta oma konto ja kõik andmed jäädavalt"
