          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמשת בכל הודעות ה-Wagey שלך החודש הזה. ההודעות מתאפסות בתחילת החודש הבא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने इस महीने अपने सभी Wagey संदेशों का उपयोग कर लिया है। संदेश अगले महीने की शुरुआत में रीसेट हो जाएंगे।"
