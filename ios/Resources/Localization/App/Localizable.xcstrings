    "appearance.info.darkActive": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen vil altid vises i mørkt tema"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird immer im dunklen Design angezeigt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή θα εμφανίζεται πάντα με σκοτεινό θέμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App will always appear in dark theme"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación siempre aparecerá en tema oscuro"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus näytetään aina tummassa teemassa"
          }
        },
        "fr": {
