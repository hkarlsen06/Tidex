    "dashboard.comingSoonDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're working on building a fully native iOS app. Stay tuned!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi jobber med å bygge en fullstendig native iOS-app. Følg med!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir arbeiten an einer vollständig nativen iOS-App. Bleiben Sie dran!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous travaillons sur la création d'une application iOS entièrement native. Restez à l'écoute!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos trabajando en la construcción de una aplicación iOS completamente nativa. ¡Estén atentos!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo lavorando alla creazione di un'app iOS completamente nativa. Restate sintonizzati!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We werken aan het bouwen van een volledig native iOS-app. Volg ons!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos trabalhando na construção de um aplicativo iOS totalmente nativo. Fique atento!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi arbetar med att bygga en helt native iOS-app. Håll utkik!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi arbejder på at bygge en fuldt native iOS-app. Følg med!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehitämme täysin nativia iOS-sovellusta. Pysy kuulolla!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracujemy nad budową w pełni natywnej aplikacji iOS. Bądź czujny!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы работаем над созданием полностью собственного приложения iOS. Следите за обновлениями!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми працюємо над створенням повнофункціонального нативного додатка для iOS. Стежте за новинами!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なネイティブiOSアプリの構築に取り組んでいます。乞うご期待!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전한 네이티브 iOS 앱을 개발하고 있습니다. 계속 지켜봐 주세요!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们正在开发一个完全原生的 iOS 应用。敬请期待！"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรากำลังสร้างแอพ iOS แบบเนทีฟที่สมบูรณ์ อยู่เชื่อมตัวไว้!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đang xây dựng một ứng dụng iOS hoàn toàn native. Chúc mừng!"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi jobber med å bygge en fullstendig native iOS-app. Følg med!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen native bir iOS uygulaması oluşturmak için çalışıyoruz. Bizi takip edin!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εργαζόμαστε για την κατασκευή μιας πλήρως native εφαρμογής iOS. Παραμείνετε συντονισμένοι!"
          }
        },
        "ro": {
