    "Create a new share between two users. The owner's shifts will be visible to the viewer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء مشاركة جديدة بين مستخدمين. ستكون نوبات المالك مرئية للمشاهد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте ново споделяне между двама потребители. Смените на собственика ще бъдат видими за зрителя."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুজন ব্যবহারকারীর মধ্যে একটি নতুন ভাগাভাগি তৈরি করুন। মালিকের শিফটগুলি দর্শকের কাছে দৃশ্যমান হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una nova compartició entre dos usuaris. Els torns del propietari seran visibles per a l'espectador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte nové sdílení mezi dvěma uživateli. Směny vlastníka budou viditelné pro prohlížeče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en ny deling mellem to brugere. Ejerens vakter vil være synlige for seeren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie eine neue Freigabe zwischen zwei Benutzern. Die Schichten des Inhabers sind für den Betrachter sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε μια νέα κοινή χρήση μεταξύ δύο χρηστών. Οι βάρδιες του ιδιοκτήτη θα είναι ορατές στον θεατή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a new share between two users. The owner's shifts will be visible to the viewer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear un nuevo intercambio entre dos usuarios. Los turnos del propietario serán visibles para el observador."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loo uus jagamine kahe kasutaja vahel. Omaniku vahetused on vaatajale nähtavad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک اشتراک جدید بین دو کاربر ایجاد کنید. شیفت‌های مالک برای بیننده قابل مشاهده خواهند بود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo uusi jako kahden käyttäjän välille. Omistajan vuorot ovat näkyvissä katsojalleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumikha ng bagong pagbabahagi sa pagitan ng dalawang gumagamit. Ang mga vakt ng may-ari ay makikita ng viewer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer un nouveau partage entre deux utilisateurs. Les quarts de travail du propriétaire seront visibles au spectateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צור שיתוף חדש בין שני משתמשים. משמרות של הבעלים יהיו גלויות למצפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो उपयोगकर्ताओं के बीच एक नया साझा बनाएं। मालिक की शिफ्ट दर्शक को दिखाई देगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreiraj novo dijeljenje između dva korisnika. Vremenske periode vlasnika bit će vidljive pregledniku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új megosztás létrehozása két felhasználó között. A tulajdonos váltásai láthatóak lesznek a megtekintő számára."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat pembagian baru antara dua pengguna. Shift pemilik akan terlihat oleh penampil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búðu til nýja deilingu milli tveggja notenda. Vaktir eigandans verða sýnilegar fyrir áhorfandann."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una nuova condivisione tra due utenti. I turni del proprietario saranno visibili al visualizzatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2人のユーザー間で新しい共有を作成します。オーナーのシフトはビューアーに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 사용자 간에 새로운 공유를 만듭니다. 소유자의 근무 일정이 뷰어에게 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukurkite naują bendrinimą tarp dviejų naudotojų. Savininko valandos bus matomos žiūrovui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izveidojiet jaunu koplietošanu starp diviem lietotājiem. Īpašnieka maiņas būs redzamas skatītājam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprett en ny deling mellom to brukere. Eieres skift vil være synlige for visningsprogrammet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een nieuw delen tussen twee gebruikers. De diensten van de eigenaar zijn zichtbaar voor de viewer."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprett ein ny deling mellom to brukarar. Vaktene til eigaren vil vere synlege for visaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz nowe udostępnienie między dwoma użytkownikami. Zmiany właściciela będą widoczne dla przeglądającego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criar um novo compartilhamento entre dois usuários. Os turnos do proprietário serão visíveis para o visualizador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o nouă partajare între doi utilizatori. Schimburile proprietarului vor fi vizibile vizionatorului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте новую общую папку между двумя пользователями. Смены владельца будут видны зрителю."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte nové zdieľanie medzi dvoma používateľmi. Smeny vlastníka budú viditeľné pre používateľa s právom čítania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvari novo skupno rabo med dvema uporabnikoma. Vahovne spremembe lastnika bodo vidne pregledniku."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreiraj novu deljenje između dva korisnika. Vakte vlasnika će biti vidljive pregledniku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa en ny delning mellan två användare. Ägarens skift kommer att vara synliga för betraktaren."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unda mgawanyiko mpya kati ya watumiaji wawili. Vakt za mmiliki zitakuwa zinaonekana kwa mtazamaji."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரண்டு பயனர்களுக்கு இடையே ஒரு புதிய பகிர்வை உருவாக்கவும். உரிமையாளரின் மாற்றங்கள் பார்வையாளருக்குத் தெரியும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างการแชร์ใหม่ระหว่างสองผู้ใช้ กะการทำงานของเจ้าของจะปรากฏให้ผู้ดูเห็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki kullanıcı arasında yeni bir paylaşım oluşturun. Sahibinin vardiyaları görüntüleyiciye görünür olacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть новий доступ між двома користувачами. Зміни власника будуть видимі глядачу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دو صارفین کے درمیان نیا شیئر بنائیں۔ مالک کی شفٹیں دیکھنے والے کے لیے نظر آئیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo chia sẻ mới giữa hai người dùng. Ca làm việc của chủ sở hữu sẽ hiển thị cho người xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在两个用户之间创建新的共享。所有者的班次将对查看者可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在兩個用戶之間建立新的共享。擁有者的班次將對查看者可見。"
          }
        }
      }
    },
