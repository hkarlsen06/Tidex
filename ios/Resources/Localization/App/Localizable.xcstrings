        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja excluir este turno recorrente? Todas as ocorrências futuras serão excluídas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
