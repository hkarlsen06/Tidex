    "userMenu.logoutEverywhereConfirmDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will sign you out from all devices, including this one. You will need to log in again on each device."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut fra alle enheter, inkludert denne. Du må logge inn igjen på hver enhet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies meldet dich von allen Geräten ab, einschließlich diesem. Du musst dich auf jedem Gerät erneut anmelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnectera de tous les appareils, y compris celui-ci. Vous devrez vous reconnecter sur chaque appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará tu sesión en todos los dispositivos, incluido este. Tendrás que iniciar sesión nuevamente en cada dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ti disconnetterà da tutti i dispositivi, incluso questo. Dovrai accedere di nuovo su ogni dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit logt je uit op alle apparaten, inclusief deze. Je moet je opnieuw aanmelden op elk apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desconectará você de todos os dispositivos, inclusive este. Você precisará fazer login novamente em cada dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta loggar ut dig från alla enheter, inklusive denna. Du måste logga in igen på varje enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger dig ud fra alle enheder, herunder denne. Du skal logge ind igen på hver enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa sinut ulos kaikista laitteista, mukaan lukien tämä. Sinun on kirjauduttava uudelleen jokaiselle laitteelle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wyloguje Cię ze wszystkich urządzeń, w tym tego. Będziesz musiał zalogować się ponownie na każdym urządzeniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это выведет вас со всех устройств, включая это. Вам нужно будет снова войти на каждом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це розійме вас зі всіх пристроїв, включаючи цей. Вам потрібно буде ввійти знову на кожному пристрої."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションにより、このデバイスを含むすべてのデバイスからログアウトされます。各デバイスで再度ログインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기(이 기기 포함)에서 로그아웃됩니다. 각 기기에서 다시 로그인해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将在所有设备上注销您，包括此设备。您需要在每个设备上重新登录。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลงชื่อออกจากอุปกรณ์ทั้งหมด รวมถึงอุปกรณ์นี้ คุณจะต้องเข้าสู่ระบบอีกครั้งบนอุปกรณ์แต่ละเครื่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ đăng xuất bạn khỏi tất cả các thiết bị, bao gồm cả thiết bị này. Bạn sẽ cần phải đăng nhập lại trên mỗi thiết bị."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut frå alle einingar, inkludert denne. Du må logge inn igjen på kvar eining."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem sizi tüm cihazlardan, bu cihazı da dahil ederek, oturumunuzu kapatacaktır. Her cihazda tekrar oturum açmanız gerekecektir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα σας αποσυνδέσει από όλες τις συσκευές, συμπεριλαμβανομένης αυτής. Θα πρέπει να συνδεθείτε ξανά σε κάθε συσκευή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta te va deconecta de pe toate dispozitivele, inclusiv acesta. Va trebui să te conectezi din nou pe fiecare dispozitiv."
          }
        }
      }
    },
