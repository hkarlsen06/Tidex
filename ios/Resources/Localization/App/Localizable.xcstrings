    "supplements.deleteRuleMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove this supplement?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne dette tillegget?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher, dass du diesen Zuschlag entfernen möchtest?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce supplément?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar este suplemento?"
