    "settings.pay.period.example" : {
      "comment" : "Pay settings: example of the current pay period. Arguments are short dates: period start, period end, payday. Example: Work from 16 Aug to 15 Sep is paid on 25 Sep.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدفع أجور العمل من %1$@ إلى %2$@ في %3$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работата от %1$@ до %2$@ се изплаща на %3$@."
