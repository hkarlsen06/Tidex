    "settings.pay.jobActions.deleteHistoryConfirmMessage" : {
      "comment" : "Confirmation for deleting a job with all its data. %1$@ is the job name. %2$@ to %5$@ are counts of shifts, recurring schedules, payroll adjustments and pay-rate records. Keep the line breaks.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف “%1$@” وكل سجله؟\n\nالورديات: %2$@\nالجداول المتكررة: %3$@\nتعديلات الرواتب: %4$@\nسجلات معدل الأجر: %5$@\n\nلا يمكن التراجع عن هذا. ستتغير الأرباح السابقة والإحصاءات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се изтрие ли „%1$@“ и цялата му история?\n\nСмени: %2$@\nПовтарящи се графици: %3$@\nКорекции на заплащането: %4$@\nЗаписи за ставки: %5$@\n\nТова не може да бъде отменено. Миналите приходи и статистиката ще се променят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” এবং এর সব ইতিহাস মুছবেন?\n\nশিফট: %2$@\nপুনরাবৃত্ত সময়সূচি: %3$@\nবেতন সমন্বয়: %4$@\nবেতনের হারের রেকর্ড: %5$@\n\nএটি পূর্বাবস্থায় ফেরানো যাবে না। আগের আয় ও পরিসংখ্যান পরিবর্তিত হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols eliminar «%1$@» i tot el seu historial?\n\nTorns: %2$@\nHoraris recurrents: %3$@\nAjustos de nòmina: %4$@\nRegistres de tarifa salarial: %5$@\n\nAixò no es pot desfer. Els ingressos i les estadístiques anteriors canviaran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat „%1$@“ a celou jeho historii?\n\nSměny: %2$@\nOpakované rozvrhy: %3$@\nMzdové úpravy: %4$@\nZáznamy o mzdových sazbách: %5$@\n\nTuto akci nelze vrátit zpět. Minulé výdělky a statistiky se změní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet “%1$@” og al dets historik?\n\nVagter: %2$@\nGentagne skemaer: %3$@\nLønjusteringer: %4$@\nLønsatsposter: %5$@\n\nDette kan ikke fortrydes. Tidligere indtjening og statistik vil ændre sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ und den gesamten Verlauf löschen?\n\nSchichten: %2$@\nWiederkehrende Zeitpläne: %3$@\nLohnanpassungen: %4$@\nLohnsatz-Einträge: %5$@\n\nDies kann nicht rückgängig gemacht werden. Frühere Einnahmen und Statistiken ändern sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγραφή του «%1$@» και όλου του ιστορικού του;\n\nΒάρδιες: %2$@\nΕπαναλαμβανόμενα προγράμματα: %3$@\nΠροσαρμογές μισθοδοσίας: %4$@\nΕγγραφές αμοιβής: %5$@\n\nΑυτό δεν μπορεί να αναιρεθεί. Τα προηγούμενα κέρδη και τα στατιστικά θα αλλάξουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete “%1$@” and all its history?\n\nShifts: %2$@\nRecurring schedules: %3$@\nPayroll adjustments: %4$@\nPay-rate records: %5$@\n\nThis cannot be undone. Past earnings and statistics will change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar “%1$@” y todo su historial?\n\nTurnos: %2$@\nHorarios recurrentes: %3$@\nAjustes de nómina: %4$@\nRegistros de tarifa salarial: %5$@\n\nEsto no se puede deshacer. Las ganancias y estadísticas pasadas cambiarán."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas kustutada „%1$@“ ja kogu selle ajalugu?\n\nVahetused: %2$@\nKorduvad graafikud: %3$@\nPalgakorrigeerimised: %4$@\nPalgamäärade kirjed: %5$@\n\nSeda ei saa tagasi võtta. Varasemad tulud ja statistika muutuvad."
