    "push.failure.message" : {
      "comment" : "Message in the alert on the dashboard when push notification registration failed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تعمل تذكيرات الوردية حتى يتم حل هذه المشكلة. تحقق من إعدادات الإخطارات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напомненията за смени няма да работят, докато това не се разреши. Проверете настройките си за известия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সমাধান না হওয়া পর্যন্ত শিফট অনুস্মারক কাজ করবে না। আপনার বিজ্ঞপ্তি সেটিংস চেক করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els recordatoris de torns no funcionaran fins que es resolgui. Comprova la configuració de notificacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornění na směny nebudou fungovat, dokud se tento problém nevyřeší. Zkontrolujte nastavení oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaktpåmindelser vil ikke fungere før dette er løst. Kontroller dine meddelelsesindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schichterinnerungen funktionieren erst nach der Behebung dieses Problems. Überprüfen Sie Ihre Benachrichtigungseinstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι υπενθυμίσεις βάρδιας δεν θα λειτουργούν μέχρι να επιλυθεί αυτό. Ελέγξτε τις ρυθμίσεις ειδοποιήσεών σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift reminders won't work until this is resolved. Check your notification settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios de turnos no funcionarán hasta que se resuelva esto. Comprueba tu configuración de notificaciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahtkonna meeldetuletused ei tööta, kuni see on lahendatud. Kontrolli oma teatiste seadeid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادآوری‌های شیفت تا زمان حل این مسئله کار نمی‌کنند. تنظیمات اطلاع‌رسانی خود را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoron muistutukset eivät toimi ennen kuin tämä on ratkaistu. Tarkista ilmoitusasetuksesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga shift reminders ay hindi gumagana hanggang sa malutas ito. Suriin ang iyong notification settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels de quart ne fonctionneront pas tant que ce problème n'est pas résolu. Vérifiez vos paramètres de notifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תזכוריות משמרות לא יעבדו עד שזה יישמר. בדוק את הגדרות ההודעות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शिफ्ट रिमाइंडर तब तक काम नहीं करेंगे जब तक यह समस्या हल नहीं हो जाती। अपनी सूचना सेटिंग्स जांचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podsjetnici za smjene neće raditi dok se ovo ne riješi. Provjeri svojih postavki obavijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A műszakpromóciók nem működnek, amíg ez nem megoldódik. Ellenőrizze az értesítési beállításokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat shift tidak akan berfungsi sampai ini diselesaikan. Periksa pengaturan notifikasi Anda."
          }
        },
        "is" : {
