    "shifts.empty.planAhead" : {
      "comment" : "Empty state text on the shifts list for a future month. Suggests adding shifts or recurring shifts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تخطيط النوبات مسبقاً، أو إعداد نوبات متكررة."
