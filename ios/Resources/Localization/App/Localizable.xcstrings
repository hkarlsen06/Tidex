    "security.connections.errors.linkFailed": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke forbinde konto. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto konnte nicht verbunden werden. Bitte versuche es erneut."
          }
        },
