    "onboarding.mfa.benefit1.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if someone gets your password, they still need your phone"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv om noen får tak i passordet ditt, trenger de også telefonen din"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst wenn jemand dein Passwort erhält, braucht er auch dein Telefon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si quelqu'un obtient votre mot de passe, il a toujours besoin de votre téléphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso si alguien obtiene tu contraseña, aún necesita tu teléfono"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche se qualcuno ottiene la tua password, ha comunque bisogno del tuo telefono"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook al krijgt iemand je wachtwoord, ze hebben je telefoon nog nodig"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que alguém obtenha sua senha, ainda precisa do seu telefone"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även om någon får ditt lösenord behöver de fortfarande din telefon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvom nogen får dit kodeord, har de stadig brug for din telefon"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikka joku saaisi salasanasi, tarvitsee silti puhelimesi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet jeśli ktoś uzyska Twoje hasło, nadal będzie potrzebować Twojego telefonu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже если кто-то получит ваш пароль, им всё ещё нужен ваш телефон"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть якщо хтось дізнається ваш пароль, їм все одно потрібен ваш телефон"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがパスワードを入手しても、彼らはまだあなたの電話が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 비밀번호를 알아도 휴대폰이 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使别人获得你的密码，他们仍需要你的手机"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ว่าใครบางคนจะได้รหัสผ่านของคุณ พวกเขายังต้องการโทรศัพท์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi ai đó lấy được mật khẩu của bạn, họ vẫn cần điện thoại của bạn"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv om noen får tak i passordet ditt, trenger dei også telefonen din"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi şifreni alsa bile, yine de telefonuna ihtiyacı vardır"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα κι αν κάποιος αποκτήσει τον κωδικό πρόσβασής σας, χρειάζεται ακόμα το τηλέφωνό σας"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiar dacă cineva îți obține parola, mai are nevoie de telefon"
          }
        }
      }
    },
