        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pahinga ay ibinabawas muna sa batayang sahod, saka sa pinakamababang dagdag kung kailangan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
