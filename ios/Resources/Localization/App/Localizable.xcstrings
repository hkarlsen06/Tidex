    "userMenu.logoutEverywhereConfirmDescription" : {
      "comment" : "Message in the dialog for logging out on all devices.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تسجيل خروجك من جميع الأجهزة، بما في ذلك هذا الجهاز. ستحتاج إلى تسجيل الدخول مرة أخرى على كل جهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще те отпишe от всички устройства, включително това. Ще трябва да се впишеш отново на всяко устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সমস্ত ডিভাইস থেকে আপনাকে লগ আউট করবে, এটি সহ। আপনাকে প্রতিটি ডিভাইসে আবার লগ ইন করতে হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això tancarà la sessió a tots els dispositius, inclòs aquest. Hauràs d'iniciar sessió de nou a cada dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se odhlásíte ze všech zařízení, včetně tohoto. Budete se muset znovu přihlásit na každém zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette logger dig ud fra alle enheder, herunder denne. Du skal logge ind igen på hver enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies meldet dich von allen Geräten ab, einschließlich diesem. Du musst dich auf jedem Gerät erneut anmelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα σας αποσυνδέσει από όλες τις συσκευές, συμπεριλαμβανομένης αυτής. Θα πρέπει να συνδεθείτε ξανά σε κάθε συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will sign you out from all devices, including this one. You will need to log in again on each device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto cerrará tu sesión en todos los dispositivos, incluido este. Tendrás que iniciar sesión nuevamente en cada dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See logib sind välja kõigist seadmetest, kaasa arvatud sellest. Pead uuesti sisse logima igal seadmel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار شما را از تمام دستگاه‌ها، از جمله این دستگاه خارج می‌کند. باید دوباره در هر دستگاه وارد شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kirjaa sinut ulos kaikista laitteista, mukaan lukien tämä. Sinun on kirjauduttava uudelleen jokaiselle laitteelle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ito ay magsasalogout sa iyo mula sa lahat ng mga device, kasama ang ito. Kailangan mong magsalogon muli sa bawat device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vous déconnectera de tous les appareils, y compris celui-ci. Vous devrez vous reconnecter sur chaque appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תנתק אותך מכל המכשירים, כולל זה. תצטרך להתחבר שוב בכל מכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपको सभी डिवाइस से लॉग आउट कर देगा, इसी सहित। आपको प्रत्येक डिवाइस पर फिर से लॉग इन करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će vas odjaviti sa svih uređaja, uključujući ovaj. Trebat ćete se ponovno prijaviti na svakom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez minden eszközről kijelentkeztet, beleértve ezt is. Minden eszközön újra be kell majd jelentkezned."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menandatangani Anda keluar dari semua perangkat, termasuk yang ini. Anda perlu masuk lagi di setiap perangkat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta mun skrá þig út frá öllum tækjum, þar með talið þessum. Þú verður að skrá þig inn aftur á hverju tæki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo ti disconnetterà da tutti i dispositivi, incluso questo. Dovrai accedere di nuovo su ogni dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクションにより、このデバイスを含むすべてのデバイスからログアウトされます。各デバイスで再度ログインする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기(이 기기 포함)에서 로그아웃됩니다. 각 기기에서 다시 로그인해야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai jus atsijungs iš visų įrenginių, įskaitant šį. Jums reikės iš naujo prisijungti kiekviename įrenginyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas jūs izrakstīs no visām ierīcēm, ieskaitant šo. Jums būs jāpierakstās no jauna uz katras ierīces."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette logger deg ut fra alle enheter, inkludert denne. Du må logge inn igjen på hver enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit logt je uit op alle apparaten, inclusief deze. Je moet je opnieuw aanmelden op elk apparaat."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette logger deg ut frå alle einingar, inkludert denne. Du må logge inn igjen på kvar eining."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wyloguje Cię ze wszystkich urządzeń, w tym tego. Będziesz musiał zalogować się ponownie na każdym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso desconectará você de todos os dispositivos, inclusive este. Você precisará fazer login novamente em cada dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta te va deconecta de pe toate dispozitivele, inclusiv acesta. Va trebui să te conectezi din nou pe fiecare dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это выведет вас со всех устройств, включая это. Вам нужно будет снова войти на каждом устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto vás odhlási zo všetkých zariadení, vrátane tohto. Budete sa musieť znova prihlásiť na každom zariadení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To te bo odjavilo iz vseh naprav, vključno s to. Na vsaki napravi se boš moral znova prijaviti."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ово ће те одјавити са свих уређаја, укључујући овај. Мораћеш да се поново пријавиш на сваком уређају."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta loggar ut dig från alla enheter, inklusive denna. Du måste logga in igen på varje enhet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hii itakuondoa kutoka kwa vifaa vyote, ikijumuisha hiki. Utahitaji kuingia tena kwenye kila kifaa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது உங்களை அனைத்து சாதனங்கள் உட்பட இந்த சாதனத்திலிருந்தும் வெளியேற்றும். ஒவ்வொரு சாதனத்திலும் மீண்டும் உள்நுழைய வேண்டும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลงชื่อออกจากอุปกรณ์ทั้งหมด รวมถึงอุปกรณ์นี้ คุณจะต้องเข้าสู่ระบบอีกครั้งบนอุปกรณ์แต่ละเครื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem sizi tüm cihazlardan, bu cihazı da dahil ederek, oturumunuzu kapatacaktır. Her cihazda tekrar oturum açmanız gerekecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це розійме вас зі всіх пристроїв, включаючи цей. Вам потрібно буде ввійти знову на кожному пристрої."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ آپ کو تمام ڈیوائسز سے لاگ آؤٹ کرے گا، اس کے ساتھ بھی۔ آپ کو ہر ڈیوائس پر دوبارہ لاگ ان کرنا ہوگا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ đăng xuất bạn khỏi tất cả các thiết bị, bao gồm cả thiết bị này. Bạn sẽ cần phải đăng nhập lại trên mỗi thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将在所有设备上注销您，包括此设备。您需要在每个设备上重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將登出您在所有裝置上的帳號，包括此裝置。您需要在每台裝置上重新登入。"
          }
        }
      }
    },
