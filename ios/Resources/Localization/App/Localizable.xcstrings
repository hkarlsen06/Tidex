        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo due cose veloci, poi sei dentro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと2つ、そしてあなたは準備完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르게 두 가지만 설정하면 완료"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare to raske ting, så er du inne"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog twee snelle dingen, dan ben je erin"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare to raske ting, så er du inne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dwie szybkie rzeczy, a już jesteś w środku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas duas coisas rápidas e pronto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar două lucruri rapide, și ești gata"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всего два быстрых шага, и готово"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara två snabba saker, sedan är du inne"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพียงสองสิ่ง แล้วคุณก็เข้ามาแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece iki hızlı şey, sonra içerdesin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще два швидких кроки, і ви готові"
