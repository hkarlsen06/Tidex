        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام پیام‌های Wagey خود را این ماه استفاده کردید. پیام‌ها در آغاز ماه بعد بازنشانی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet käyttänyt kaikki Wagey-viestisi tässä kuussa. Viestit nollataan seuraavan kuukauden alussa."
