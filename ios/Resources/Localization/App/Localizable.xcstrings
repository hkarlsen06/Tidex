        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa data verrà esclusa dalla vakt ricorrente. La vakt non verrà più visualizzata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne datoen blir ekskludert fra den faste vakten. Vakten vil ikke lenger vises."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta data será excluída do turno recorrente. O turno não será mais exibido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta datum kommer att exkluderas från det återkommande arbetspassen. Arbetspassen visas inte längre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne datoen blir ekskludert fra den faste vakten. Vakten vil ikke lenger vises."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä päivämäärä jätetään pois jaksoittaisesta vuorosta. Vuoro ei näy enää."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta data zostanie wykluczona z powtarzającej się zmiany. Zmiana nie będzie już wyświetlana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта дата будет исключена из повторяющейся смены. Смена больше не будет отображаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дата буде виключена з повторюваної зміни. Зміна більше не буде відображатися."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付は固定シフトから除外されます。シフトは表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜는 반복 근무에서 제외됩니다. 근무가 더 이상 표시되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日期将从循环班次中排除。该班次将不再显示。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่นี้จะถูกแยกออกจากการเลื่อนเวลาปกติ การเลื่อนเวลาจะไม่แสดงอีกต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày này sẽ bị loại trừ khỏi ca làm việc định kỳ. Ca làm việc sẽ không còn hiển thị."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne datoen blir ekskludert fra den faste vakten. Vakten vil ikke lenger vises."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarih tekrarlanan vardiyadan hariç tutulacak. Vardiya artık görünmeyecek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ημερομηνία θα εξαιρεθεί από την επαναλαμβανόμενη βάρδια. Η βάρδια δεν θα εμφανίζεται πλέον."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această dată va fi exclusă din schimbul recurent. Schimbul nu va mai apărea."
          }
        }
      }
    },
