        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduit la pause uniquement du salaire de base"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deduce pausa solo dallo stipendio base"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩を基本給からのみ控除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식을 기본급에서만 차감"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekker pause kun fra grunnlønn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekt pauze alleen af van basisslaris"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekker pause kun frå grunnlønn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odlicza przerwę tylko z stawki podstawowej"
