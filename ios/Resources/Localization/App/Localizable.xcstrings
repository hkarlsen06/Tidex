          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek automatisch pauzetijd af van diensten die langer zijn dan een bepaalde duur"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk automatisk pause fra vakter over ein viss lengde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie potrącaj przerwę z dyżurów powyżej określonej długości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
