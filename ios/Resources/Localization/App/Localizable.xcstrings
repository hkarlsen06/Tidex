    "profile.errors.usernameInvalid" : {
      "comment" : "Validation error for the username field. Usernames are 3 to 20 characters of lowercase letters, numbers and underscores.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يتكون اسم المستخدم من 3 إلى 20 حرفًا وأن يحتوي فقط على أحرف صغيرة أو أرقام أو شرطات سفلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потребителското име трябва да е 3–20 знака и да съдържа само малки букви, цифри или долни черти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যবহারকারীর নাম ৩-২০ অক্ষরের হতে হবে এবং শুধু ছোট হাতের অক্ষর, সংখ্যা বা আন্ডারস্কোর থাকতে পারবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nom d'usuari ha de tenir entre 3 i 20 caràcters i només pot contenir lletres minúscules, números o guions baixos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživatelské jméno musí mít 3–20 znaků a obsahovat jen malá písmena, čísla nebo podtržítka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brugernavnet skal være 3-20 tegn og kun indeholde små bogstaver, tal eller understreger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Benutzername muss 3–20 Zeichen lang sein und darf nur Kleinbuchstaben, Zahlen oder Unterstriche enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όνομα χρήστη πρέπει να είναι 3-20 χαρακτήρες και να περιέχει μόνο πεζά γράμματα, αριθμούς ή κάτω παύλες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Username must be 3-20 characters and contain only lowercase letters, numbers, or underscores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario debe tener entre 3 y 20 caracteres y contener solo letras minúsculas, números o guiones bajos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutajanimi peab olema 3–20 märki ja sisaldama ainult väiketähti, numbreid või alakriipse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام کاربری باید ۳ تا ۲۰ نویسه باشد و فقط شامل حروف کوچک، اعداد یا زیرخط باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttäjänimen on oltava 3–20 merkkiä ja se saa sisältää vain pienaakkosia, numeroita tai alaviivoja."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat 3-20 character ang username at maliit na titik, numero, o underscore lang ang laman nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur doit comporter 3 à 20 caractères et contenir seulement des lettres minuscules, des chiffres ou des tirets bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם המשתמש חייב להכיל 3–20 תווים ורק אותיות קטנות באנגלית, מספרים או קווים תחתונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता नाम 3-20 वर्ण का होना चाहिए और इसमें केवल छोटे अक्षर, अंक या अंडरस्कोर हो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korisničko ime mora imati 3–20 znakova i sadržavati samo mala slova, brojeve ili donje crte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felhasználónév 3–20 karakteres lehet, és csak kisbetűket, számokat vagy aláhúzást tartalmazhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama pengguna harus 3-20 karakter dan hanya boleh berisi huruf kecil, angka, atau garis bawah."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notandanafn verður að vera 3–20 stafir og aðeins innihalda lágstafi, tölur eða undirstrik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente deve avere 3-20 caratteri e contenere solo lettere minuscole, numeri o trattini bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名は3〜20文字で、小文字、数字、アンダースコアのみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름은 3~20자여야 하며 소문자, 숫자, 밑줄만 포함할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudotojo vardas turi būti 3–20 simbolių ir jame gali būti tik mažosios raidės, skaičiai arba apatiniai brūkšniai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
