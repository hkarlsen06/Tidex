    "shifts.virtualConversionInfo": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer opretter en ny vagt og udelukker denne dato fra den tilbagevendende vagt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen erstellen eine neue Schicht und schließen dieses Datum aus der wiederkehrenden Schicht aus"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές θα δημιουργήσουν μια νέα βάρδια και θα αποκλείσουν αυτήν την ημερομηνία από την επαναλαμβανόμενη βάρδια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes will create a new shift and exclude this date from the recurring shift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios crearán un nuevo turno y excluirán esta fecha del turno recurrente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset luovat uuden vuoron ja sulkevat tämän päivämäärän toistuvasta vuorosta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications créeront une nouvelle vacation et excluront cette date de la vacation récurrente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche creeranno un nuovo turno ed escluderanno questa data dal turno ricorrente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更により新しいシフトが作成され、このスケジュールシフトからこの日付が除外されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 새 근무를 만들고 반복 근무에서 이 날짜를 제외합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer oppretter en ny vakt og ekskluderer denne datoen fra den faste vakten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen maken een nieuwe dienst aan en sluiten deze datum uit van de terugkerende dienst"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer oppretter ein ny vakt og ekskluderer denne datoen frå den faste vakten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany utworzą nową zmianę i wykluczą tę datę z cyklicznej zmiany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações criarão um novo turno e excluirão esta data do turno recorrente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările vor crea o nouă vactă și vor exclude această dată din vacta recurentă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения создадут новую смену и исключат эту дату из повторяющейся смены"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar skapar en ny vakt och exkluderar detta datum från den återkommande vakten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงจะสร้างกะใหม่และยกเว้นวันที่นี้จากกะประจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler yeni bir vardiya oluşturacak ve bu tarihi tekrarlanan vardiyadan hariç tutacak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни створять нову змію та виключать цю дату з повторюваної змії"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những thay đổi sẽ tạo một ca làm việc mới và loại trừ ngày này khỏi ca làm việc định kỳ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改将创建新班次并从循环班次中排除此日期"
          }
        }
      }
    },
