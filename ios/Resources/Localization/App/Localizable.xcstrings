    "subscription.choosePlan.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgrader for at låse alle funktioner op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgraden Sie, um alle Funktionen freizuschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to unlock all features"
          }
        },
