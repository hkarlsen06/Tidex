        }
      }
    },
    "common.error.notAuthenticated" : {
      "comment" : "Error when the user's session has ended and they must sign in again.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد سجّلت الخروج. سجّل الدخول مرة أخرى للمتابعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излезли сте от профила си. Влезте отново, за да продължите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি সাইন আউট করেছেন। চালিয়ে যেতে আবার সাইন ইন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has tancat la sessió. Torna a iniciar sessió per continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste odhlášeni. Pro pokračování se znovu přihlaste."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er logget ud. Log ind igen for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist abgemeldet. Melde dich erneut an, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε αποσυνδεθεί. Συνδεθείτε ξανά για να συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're signed out. Sign in again to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has cerrado sesión. Inicia sesión de nuevo para continuar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oled välja logitud. Jätkamiseks logi uuesti sisse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از حساب خارج شده‌اید. برای ادامه دوباره وارد شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet kirjautunut ulos. Jatka kirjautumalla uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-sign out ka. Mag-sign in muli para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes déconnecté. Reconnectez-vous pour continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יצאת מהחשבון. התחבר שוב כדי להמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप साइन आउट हैं। जारी रखने के लिए फिर से साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjavljeni ste. Ponovno se prijavite za nastavak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijelentkeztél. A folytatáshoz jelentkezz be újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda telah keluar. Masuk lagi untuk melanjutkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útskráning tókst. Skráðu þig aftur inn til að halda áfram."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato il logout. Accedi di nuovo per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトされています。続行するには、もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
