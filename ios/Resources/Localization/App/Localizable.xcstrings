    "security.password.setWithPhoneInstructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنرسل لك رمزًا على هاتفك للتحقق من هويتك قبل تعيين كلمة المرور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще изпратим кодът на вашия телефон, за да потвърдим вашата самоличност преди да зададете парола."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাসওয়ার্ড সেট করার আগে আমরা আপনার পরিচয় যাচাই করতে আপনার ফোনে একটি কোড পাঠাব।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviarem un codi al teu telèfon per verificar la teva identitat abans d'establir una contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošleme vám kód na telefon, abychom před nastavením hesla ověřili vaši identitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sender en kode til din telefon for at bekræfte din identitet, før du angiver en adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir senden dir einen Code auf dein Telefon, um deine Identität zu bestätigen, bevor du ein Passwort setzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σας στείλουμε έναν κωδικό στο τηλέφωνό σας για να επιβεβαιώσετε την ταυτότητά σας πριν ορίσετε έναν κωδικό πρόσβασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll send a code to your phone to verify your identity before setting a password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviaremos un código a tu teléfono para verificar tu identidad antes de establecer una contraseña."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
