            "value": "Er du sikker på, at du vil slette denne lønindstilling?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare questa impostazione salariale?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko varma, että haluat poistaa tämän palkkausasetuksen?"
