        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σταματήσετε να βλέπετε τις βάρδιες που κοινοποιεί ο/η %@. Θα εξακολουθεί να βλέπει τις βάρδιες που του/της κοινοποιείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will stop seeing %@'s shared shifts. They can still see shifts you share with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejarás de ver los turnos compartidos de %@. Podrá seguir viendo los turnos que compartas con esa persona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa lõpetad %@ jagatud vahetuste nägemise. Nad näevad endiselt vahetusi, mida sa nendega jagad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیگر شیفت‌های اشتراک‌گذاشته‌شدهٔ %@ را نمی‌بینید. آن‌ها همچنان می‌توانند شیفت‌هایی را که با آن‌ها به اشتراک می‌گذارید ببینند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et enää näe käyttäjän %@ jakamia vuoroja. Hän näkee silti vuorot, jotka jaat hänen kanssaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mo na makikita ang mga shift na ibinabahagi ni %@. Makikita pa rin nila ang mga shift na ibinabahagi mo sa kanila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne verrez plus les shifts partagés par %@. Ils pourront toujours voir les shifts que vous partagez avec eux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תפסיק לראות את המשמרות ש-%@ משתף. הם עדיין יוכלו לראות משמרות שאתה משתף איתם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप %@ की साझा की गई शिफ्ट देखना बंद कर देंगे। वे अब भी आपकी उनके साथ साझा की गई शिफ्ट देख सकेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više nećete vidjeti smjene koje dijeli %@. Oni i dalje mogu vidjeti smjene koje dijelite s njima."
