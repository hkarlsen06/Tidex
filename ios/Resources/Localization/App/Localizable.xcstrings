          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korisničko ime mora imati 3–20 znakova i sadržati samo mala slova, brojeve ili donje crte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användarnamnet måste vara 3–20 tecken och får bara innehålla små bokstäver, siffror eller understreck."
          }
        },
