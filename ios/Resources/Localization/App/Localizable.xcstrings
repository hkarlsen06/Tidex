    "data.export.about.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF report is optimized for A4 portrait format and includes automatic page numbers and generation timestamp."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten er optimalisert for A4-portrettformat og inkluderer automatisk sidetall og genereringstidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der PDF-Bericht ist für A4-Hochformat optimiert und enthält automatische Seitennummern und einen Generierungszeitstempel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe PDF está optimizado para formato A4 vertical e incluye números de página automáticos y marca de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport PDF est optimisé pour le format A4 portrait et inclut la numérotation automatique des pages et l'horodatage de génération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFレポートはA4縦向き形式に最適化されており、自動ページ番号と生成タイムスタンプが含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 보고서는 A4 세로 형식에 최적화되어 있으며 자동 페이지 번호와 생성 타임스탬프가 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório PDF é otimizado para formato A4 retrato e inclui numeração automática de páginas e data de geração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-отчет оптимизирован для формата A4 и включает номера страниц и время создания."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het PDF-rapport is geoptimaliseerd voor A4-portretformaat en bevat automatische paginanummers en generatietijdstempel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten är optimerad för A4-stående format och innehåller automatiska sidnummer och genereringsstämpel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-rapporten er optimeret til A4-portræt-format og inkluderer automatiske sidetal og genereringstidsstempel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il report PDF è ottimizzato per il formato A4 verticale e include numerazione pagine automatica e timestamp di generazione."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-raportti on optimoitu A4-pystymuodossa ja sisältää automaattisen sivunumeroinnin ja luontisäädön."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raport PDF jest zoptymalizowany dla formatu A4 w orientacji pionowej i zawiera automatyczne numery stron i znacznik czasu generowania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-звіт оптимізований для формату A4 на портреті та містить автоматичні номери сторінок і часову мітку генерування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF报告已针对A4竖向格式优化，包括自动页码和生成时间戳。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงาน PDF ปรับให้เหมาะสมสำหรับรูปแบบแนวตั้ง A4 และรวมหมายเลขหน้าอัตโนมัติและเวลาสร้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo PDF được tối ưu hóa cho định dạng A4 ở chế độ dọc và bao gồm số trang tự động và dấu thời gian tạo."
          }
        }
      }
    },
