    "sharing.noSharersDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone shares their shifts with you, they will appear here"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når noen deler vaktene sine med deg, vil de vises her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand seine Schichten mit Ihnen teilt, werden sie hier angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien comparte sus turnos contigo, aparecerán aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu'un partage ses quarts avec vous, ils apparaîtront ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがシフトをあなたと共有すると、ここに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 근무를 공유하면 여기에 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém compartilhar seus turnos com você, eles aparecerão aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда кто-то делится своим расписанием с вами, оно появится здесь"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer iemand zijn shifts met jou deelt, verschijnen ze hier"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon delar sina pass med dig visas de här"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar nogen deler deres skift med dig, vises de her"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno condivide i suoi turni con te, appariranno qui"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku jakaa vuoronsa kanssasi, ne näkyvät täällä"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś udostępni swoją zmianę, pojawi się tutaj"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли хтось поділиться своїми змінами з вами, вони з'являться тут"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当有人与你分享班次时，他们会显示在这里"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีคนแชร์กะของพวกเขากับคุณ พวกเขาจะปรากฏที่นี่"
          }
