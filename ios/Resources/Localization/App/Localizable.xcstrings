        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne lønnssettinga?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme ayarını silmek istediğinizden emin misiniz?"
          }
