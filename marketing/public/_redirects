# Cloudflare Pages: all locales use explicit prefix (/no/, /en/)

# Unprefixed informational paths → English
/terms /en/terms/ 302
/terms/ /en/terms/ 302
/privacy /en/privacy/ 302
/privacy/ /en/privacy/ 302
/support /en/support/ 302
/support/ /en/support/ 302
/security /en/security/ 302
/security/ /en/security/ 302

# Pass through static assets (must come before locale catch-all)
/_next/* /_next/:splat 200
/icons/* /icons/:splat 200
/badges/* /badges/:splat 200
/docs/* /docs/:splat 200
/.well-known/* /.well-known/:splat 200

# Rewrite /en/payroll to serve docs page (always English)
/en/payroll /docs/payroll/ 200
/en/payroll/ /docs/payroll/ 200

# Pass through supported locales
/no/* /no/:splat 200
/en/* /en/:splat 200

# Unsupported locales → English
/:locale/* /en/:splat 302
