{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/lib/*": [
        "../lib/*"
      ],
      "@root/*": [
        "../*"
      ],
      "@components/*": [
        "../components/*"
      ],
      "@ui/*": [
        "../components/ui/*"
      ],
      "@appui/*": [
        "../components/app/*"
      ],
      "@lib/*": [
        "../lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "dist/types/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
