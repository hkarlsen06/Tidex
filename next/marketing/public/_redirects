# Cloudflare Pages: all locales use explicit prefix (/no/, /en/)

# Root paths → Norwegian (default locale)
/ /no/ 302
/terms /no/terms/ 302
/terms/ /no/terms/ 302
/privacy /no/privacy/ 302
/privacy/ /no/privacy/ 302
/security /no/security/ 302
/security/ /no/security/ 302

# Pass through static assets (must come before locale catch-all)
/_next/* /_next/:splat 200
/icons/* /icons/:splat 200

# Pass through supported locales
/no/* /no/:splat 200
/en/* /en/:splat 200

# Unsupported locales → English
/:locale/* /en/:splat 302
