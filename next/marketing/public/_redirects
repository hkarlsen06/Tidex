# Redirect unsupported locales to English for legal and marketing pages
# Cloudflare Pages evaluates redirects before static assets, so we must
# explicitly pass through supported locales (no, en) to avoid redirect loops.
# Rules are matched top-to-bottom; first match wins.

# Pass through supported locales (serve static files normally)
/no/* /no/:splat 200
/en/* /en/:splat 200

# Redirect unsupported locales to English
/:locale/terms/* /en/terms/ 302
/:locale/terms /en/terms/ 302
/:locale/privacy/* /en/privacy/ 302
/:locale/privacy /en/privacy/ 302
/:locale/security/* /en/security/ 302
/:locale/security /en/security/ 302

# Root landing page
/:locale/ /en/ 302
