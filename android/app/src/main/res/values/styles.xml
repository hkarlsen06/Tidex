<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme - Material 3 Dark -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/tidex_brand_blue</item>
        <item name="colorPrimaryDark">@color/tidex_dark_background</item>
        <item name="colorAccent">@color/tidex_brand_blue</item>

        <!-- Material 3 color scheme -->
        <item name="colorOnPrimary">@color/tidex_text_primary</item>
        <item name="colorPrimaryContainer">@color/tidex_surface_primary</item>
        <item name="colorOnPrimaryContainer">@color/tidex_text_primary</item>

        <item name="colorSecondary">@color/tidex_brand_gradient_mid</item>
        <item name="colorOnSecondary">@color/tidex_text_primary</item>

        <item name="colorSurface">@color/tidex_surface_primary</item>
        <item name="colorOnSurface">@color/tidex_text_primary</item>
        <item name="colorSurfaceVariant">@color/tidex_surface_secondary</item>
        <item name="colorOnSurfaceVariant">@color/tidex_text_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/tidex_dark_background</item>
        <item name="colorOnBackground">@color/tidex_text_primary</item>

        <!-- Navigation bar (system) -->
        <item name="android:navigationBarColor">@color/tidex_dark_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Edge-to-edge support -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:colorBackground">@color/tidex_dark_background</item>
        <item name="android:navigationBarColor">@color/tidex_dark_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="windowSplashScreenBackground">@color/tidex_dark_background</item>
    </style>

    <!-- Bottom Navigation styling -->
    <style name="TidexBottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/tidex_tab_bar_background</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@null</item>
    </style>
</resources>