#!/usr/bin/env bash
# Shared locks for agents working in parallel, such as the simulator lock. A
# lock belongs to the worktree that took it, and only that worktree can release
# it.
#
#   scripts/lock run <name> -- <command...>   wait for the lock, run, release
#   scripts/lock acquire <name>               take it for a session of several commands,
#                                              or renew a session this worktree holds
#   scripts/lock release <name>               give back a lock this worktree took
#   scripts/lock status                       list held locks and every shared simulator
#   scripts/lock pool                         list the shared simulators
#
# `simulator` is a pool of shared simulators with one lock each. Taking it
# renews the slot this worktree's session holds, or else takes the first free
# slot, boots its simulator if needed, and waits while every slot is busy.
# Only Shared iPhone is enabled by default. IOS_AGENT_SIMULATORS=2 or 3
# explicitly enables extra slots, which shut down when their locks release.
# `acquire simulator` prints the simulator's name on stdout, as in
# SIM="$(scripts/lock acquire simulator)" && xcrun simctl install "$SIM" ...
# `run simulator` passes AGENT_SIMULATOR_NAME and AGENT_SIMULATOR_UDID to its
# command. A simulator's own name, such as "Shared iPhone 2", takes that slot
# only. `release simulator` releases the slot this worktree's session holds.
#
# The simulator locks are machine-wide, in /tmp/agent-locks (AGENT_SIMULATOR_LOCK_ROOT
# overrides it), because agents from every repo on this Mac share the simulators.
# Tidex and Paeonia each have a copy of this script, so keep the copies
# compatible: the same pool, lock paths, owner line and stale rules. Every other
# lock lives in this repo's git common dir, so all its worktrees see the same ones.
#
# `run` waits while another `run` holds the lock, even one in this worktree,
# because several agents can share a worktree. A worktree's `acquire` session
# lets its later commands in.
#
# A lock taken by `run` is stale once its process has exited. A lock taken by
# `acquire` is stale once nobody has used it for TIDEX_LOCK_TTL_MINUTES
# (default 10). Every `acquire`, and every `run` that enters this worktree's
# session, counts as a use, so start each simulator command with
# `scripts/lock acquire simulator &&`. A session an agent forgot to release
# then frees itself 10 minutes after its last command. A stale lock is taken
# over with a message. Waiting gives up after TIDEX_LOCK_WAIT_MINUTES
# (default 90).
#
# Waiters take a lock in the order they arrived. A waiter that is stopped, by a
# tool timeout for example, keeps its place for 15 minutes, and the same
# request from the same worktree takes it up again. A session that has lasted
# TIDEX_LOCK_SESSION_MINUTES (default 15) gives its lock to the waiters at
# its next `acquire` or `run`, and waits in line to get it back. Another
# worktree has used the simulator by then, so reinstall your app and open your
# Device panel session again.
set -euo pipefail

REPO_LOCK_ROOT="$(git rev-parse --path-format=absolute --git-common-dir)/tidex-locks"
SIMULATOR_LOCK_ROOT="${AGENT_SIMULATOR_LOCK_ROOT:-/tmp/agent-locks}"
OWNER="$(git rev-parse --show-toplevel)"
TTL_SECONDS=$(( ${TIDEX_LOCK_TTL_MINUTES:-10} * 60 ))
WAIT_SECONDS=$(( ${TIDEX_LOCK_WAIT_MINUTES:-90} * 60 ))
SESSION_SECONDS=$(( ${TIDEX_LOCK_SESSION_MINUTES:-15} * 60 ))
# A waiter touches its place in the line on every poll, every 5 seconds.
WAITER_STALE_SECONDS=30
# How long a waiter that stopped keeps its place for the same request.
RESERVED_SECONDS=900

# The shared simulators, as slot lock name|simulator name. The first slot keeps
# the lock name `simulator`, so older copies of this script, which know only
# that lock and Shared iPhone, still stay off it.
SIMULATOR_POOL="simulator|Shared iPhone
simulator-2|Shared iPhone 2
simulator-3|Shared iPhone 3"

SIMULATOR_COUNT="${IOS_AGENT_SIMULATORS:-1}"
case "$SIMULATOR_COUNT" in
  1|2|3) ;;
  *) echo "IOS_AGENT_SIMULATORS must be 1, 2, or 3" >&2; exit 2 ;;
esac

mkdir -p "$REPO_LOCK_ROOT" "$SIMULATOR_LOCK_ROOT"

# Prints the simulator of a slot lock, or nothing for any other lock.
slot_simulator() {
  local slot simulator
  while IFS='|' read -r slot simulator; do
    [ "$slot" = "$1" ] && echo "$simulator"
  done <<<"$SIMULATOR_POOL"
  return 0
}

# Prints the locks that <name> may take, one per line: every slot for
# `simulator`, one slot for a shared simulator's name, else the name itself.
candidates() {
  local slot simulator found=0 index=0
  while IFS='|' read -r slot simulator; do
    index=$((index + 1))
    if { [ "$1" = simulator ] && [ "$index" -le "$SIMULATOR_COUNT" ]; } || [ "$1" = "$simulator" ]; then
      echo "$slot"
      found=1
    fi
  done <<<"$SIMULATOR_POOL"
  [ "$found" -eq 1 ] || echo "$1"
}

lock_dir() {
  if [ -n "$(slot_simulator "$1")" ]; then
    echo "$SIMULATOR_LOCK_ROOT/$1"
  else
    echo "$REPO_LOCK_ROOT/$1"
  fi
}

usage() {
  sed -n '2,39p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

# Prints "owner|pid|started" for a held lock.
read_lock() {
  cat "$(lock_dir "$1")/owner" 2>/dev/null || echo "unknown||0"
}

label() {
  local simulator
  simulator="$(slot_simulator "$1")"
  echo "$1${simulator:+ ($simulator)}"
}

describe() {
  if [ ! -d "$(lock_dir "$1")" ]; then
    echo "$(label "$1"): free, and an agent that asked earlier takes it first"
    return
  fi
  local owner pid started
  IFS='|' read -r owner pid started <<<"$(read_lock "$1")"
  local age=$(( ($(date +%s) - ${started:-0}) / 60 ))
  if [ -n "$pid" ]; then
    echo "$(label "$1"): held by $owner (process $pid) for ${age} min"
  else
    echo "$(label "$1"): held by $owner (session, last used ${age} min ago)"
  fi
}

is_stale() {
  # The taker writes the owner file right after mkdir. A lock that still has
  # none after a minute belongs to a taker that died in between.
  if [ ! -f "$(lock_dir "$1")/owner" ]; then
    [ $(( $(date +%s) - $(modified "$(lock_dir "$1")") )) -gt 60 ]
    return
  fi
  local owner pid started
  IFS='|' read -r owner pid started <<<"$(read_lock "$1")"
  if [ -n "$pid" ]; then
    ! kill -0 "$pid" 2>/dev/null
  else
    [ $(( $(date +%s) - ${started:-0} )) -gt "$TTL_SECONDS" ]
  fi
}

held_by_me() {
  local owner
  IFS='|' read -r owner _ _ <<<"$(read_lock "$1")"
  [ "$owner" = "$OWNER" ]
}

# Several agents can share one worktree, so a lock that another `run` in this
# worktree holds is not ours to enter. Only an `acquire` session is.
session_held_by_me() {
  local owner pid
  IFS='|' read -r owner pid _ <<<"$(read_lock "$1")"
  [ "$owner" = "$OWNER" ] && [ -z "$pid" ]
}

describe_all() {
  local lock text=""
  for lock in $1; do
    text="$text${text:+; }$(describe "$lock")"
  done
  echo "$text"
}

modified() {
  local seconds
  seconds="$(stat -f %m "$1" 2>/dev/null || true)"
  case "$seconds" in
    ''|*[!0-9]*) seconds="$(stat -c %Y "$1" 2>/dev/null || echo 0)" ;;
  esac
  echo "$seconds"
}

# The line of waiters for the locks of one root, in its .waiting directory.
# Each waiting process keeps a place there: a file named by its arrival time
# that holds "owner|the locks it may take" and that it touches on every poll.
# A place nobody has touched for WAITER_STALE_SECONDS belongs to a waiter that
# stopped. It becomes a reservation, which holds nobody up and which the same
# request from the same worktree takes up again within RESERVED_SECONDS.
line_dir() {
  echo "$(dirname "$(lock_dir "$1")")/.waiting"
}

# waiter_ahead <lock> <my place> succeeds when a waiter that arrived earlier
# may take <lock>. With no place, it asks whether another worktree waits for it.
waiter_ahead() {
  local file now age owner wanted
  now="$(date +%s)"
  for file in "$(line_dir "$1")"/[0-9]*-[0-9]*; do
    [ -f "$file" ] && [ "$file" != "$2" ] || continue
    age=$(( now - $(modified "$file") ))
    case "$file" in
      *.reserved)
        [ "$age" -le "$RESERVED_SECONDS" ] || rm -f "$file"
        continue ;;
    esac
    if [ "$age" -gt "$WAITER_STALE_SECONDS" ]; then
      mv "$file" "$file.reserved" 2>/dev/null || true
      continue
    fi
    [ -z "$2" ] || [[ "$file" < "$2" ]] || continue
    owner="" wanted=""
    IFS='|' read -r owner wanted <"$file" || true
    [ -n "$2" ] || [ "$owner" != "$OWNER" ] || continue
    case " $wanted " in
      *" $1 "*) return 0 ;;
    esac
  done
  return 1
}

# Whether this worktree's session on <lock> has had its time while others wait.
session_over() {
  local since
  since="$(cat "$(lock_dir "$1")/since" 2>/dev/null || true)"
  [ -n "$since" ] && [ $(( $(date +%s) - since )) -ge "$SESSION_SECONDS" ] && waiter_ahead "$1" ""
}

# join_line <locks> <seconds to add to the arrival time> sets PLACE to this
# process's place: the one this request left behind when it was stopped, or a
# new one at the end.
join_line() {
  local line file name owner wanted
  line="$(line_dir "${1%% *}")"
  mkdir -p "$line"
  for file in "$line"/[0-9]*-[0-9]*.reserved; do
    [ -f "$file" ] || continue
    owner="" wanted=""
    IFS='|' read -r owner wanted <"$file" || true
    if [ "$owner|$wanted" = "$OWNER|$1" ]; then
      name="$(basename "$file")"
      PLACE="$line/${name%%-*}-$$"
      mv "$file" "$PLACE" 2>/dev/null && return 0
    fi
  done
  PLACE="$line/$(( $(date +%s) + $2 ))-$$"
}

# take <name> <pid or empty> sets TAKEN to the lock it took. Returns 0 when it
# took a free or stale lock, 3 when this worktree already holds one through
# `acquire`.
take() {
  local locks pid="$2" waited=0 lock handed_over=0
  case "$1" in
    'Shared iPhone 2'|simulator-2)
      [ "$SIMULATOR_COUNT" -ge 2 ] || { echo "Shared iPhone 2 requires IOS_AGENT_SIMULATORS=2 or 3" >&2; return 2; } ;;
    'Shared iPhone 3'|simulator-3)
      [ "$SIMULATOR_COUNT" -ge 3 ] || { echo "Shared iPhone 3 requires IOS_AGENT_SIMULATORS=3" >&2; return 2; } ;;
  esac
  # One per line from candidates, one line here.
  # shellcheck disable=SC2046
  locks="$(echo $(candidates "$1"))"
  for lock in $locks; do
    # Checked again right before the lock goes: a `run` of this worktree may have entered the session.
    if session_held_by_me "$lock" && session_over "$lock" && session_held_by_me "$lock"; then
      echo "[lock] $(label "$lock") goes to the agents waiting for it after $(( SESSION_SECONDS / 60 )) min of this session. Waiting in line to get it back. Another worktree will have used it, so reinstall your app and open your Device panel session again." >&2
      rm -rf "$(lock_dir "$lock")"
      handed_over=1
    fi
  done
  # After a hand-over, behind every waiter that is already there, also one that arrived this second.
  join_line "$locks" "$handed_over"
  # A waiter that is stopped leaves the line at once. Its place stays reserved.
  trap 'mv "$PLACE" "$PLACE.reserved" 2>/dev/null || true; exit 143' INT TERM HUP
  while true; do
    for lock in $locks; do
      if session_held_by_me "$lock"; then
        rm -f "$PLACE"
        trap - INT TERM HUP
        TAKEN="$lock"
        return 3
      fi
    done
    # Written again on every poll: it is the heartbeat, and it restores the
    # place if another waiter judged it stale while this Mac slept.
    echo "$OWNER|$locks" >"$PLACE"
    for lock in $locks; do
      if ! waiter_ahead "$lock" "$PLACE" && mkdir "$(lock_dir "$lock")" 2>/dev/null; then
        echo "$OWNER|$pid|$(date +%s)" >"$(lock_dir "$lock")/owner"
        rm -f "$PLACE"
        trap - INT TERM HUP
        TAKEN="$lock"
        return 0
      fi
    done
    for lock in $locks; do
      if ! waiter_ahead "$lock" "$PLACE" && is_stale "$lock"; then
        echo "[lock] taking over a stale lock. $(describe "$lock")" >&2
        rm -rf "$(lock_dir "$lock")"
        continue 2
      fi
    done
    if [ "$waited" -ge "$WAIT_SECONDS" ]; then
      echo "[lock] gave up waiting. $(describe_all "$locks")" >&2
      rm -f "$PLACE"
      exit 1
    fi
    if [ $(( waited % 60 )) -eq 0 ]; then
      echo "[lock] waiting. $(describe_all "$locks")" >&2
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
}

# Sets SIMULATOR_UDID for the simulator of slot <lock> and boots it when shut down.
start_simulator() {
  local simulator state
  simulator="$(slot_simulator "$1")"
  if [ "$1" != simulator ] && command -v ios-agent >/dev/null 2>&1; then
    ios-agent simulator-lease "$simulator" "$TTL_SECONDS"
  fi
  read -r SIMULATOR_UDID state <<<"$(xcrun simctl list devices available -j | python3 -c '
import json, sys
# Read all of stdin before exiting, or simctl dies of SIGPIPE.
runtimes = json.load(sys.stdin)["devices"]
for devices in runtimes.values():
    for device in devices:
        if device["name"] == sys.argv[1]:
            print(device["udid"], device["state"])
            sys.exit()
' "$simulator")"
  if [ -z "$SIMULATOR_UDID" ]; then
    echo "[lock] the shared simulator $simulator does not exist on this Mac. Ask the developer to create it." >&2
    return 1
  fi
  if [ "$state" != Booted ]; then
    echo "[lock] booting $simulator" >&2
    xcrun simctl bootstatus "$SIMULATOR_UDID" -b >/dev/null
  fi
}

shutdown_extra_simulator() {
  local simulator
  case "$1" in
    simulator-2|simulator-3)
      simulator="$(slot_simulator "$1")"
      xcrun simctl shutdown "$simulator" >/dev/null 2>&1 || true ;;
  esac
}

# Marks this worktree's session as used now, so it stays ahead of the TTL.
renew() {
  echo "$OWNER||$(date +%s)" >"$(lock_dir "$1")/owner"
}

# A `run` inside the session hands the lock back when its command ends, but only
# while the lock still names this process. Another worktree may have taken it
# meanwhile, or a second `run` of this worktree may hold it now.
restore_session() {
  local pid
  IFS='|' read -r _ pid _ <<<"$(read_lock "$1")"
  [ "$pid" = "$$" ] && renew "$1"
}

# A `run` releases its lock when its command ends, while the lock still names
# this process.
release_run() {
  local pid
  IFS='|' read -r _ pid _ <<<"$(read_lock "$1")"
  if [ "$pid" = "$$" ]; then
    shutdown_extra_simulator "$1"
    rm -rf "$(lock_dir "$1")"
  fi
}

release() {
  local name="$1" dir lock locks
  locks="$(candidates "$name")"
  [ "$name" != simulator ] || locks="simulator simulator-2 simulator-3"
  if [ -n "$(slot_simulator "${locks%% *}")" ] || [ "$name" = simulator ]; then
    # A slot this worktree's `run` holds belongs to that run, maybe another
    # agent's in this worktree, so only sessions are released.
    for lock in $locks; do
      if session_held_by_me "$lock"; then
        shutdown_extra_simulator "$lock"
        rm -rf "$(lock_dir "$lock")"
      fi
    done
    return 0
  fi
  dir="$(lock_dir "$1")"
  [ -d "$dir" ] || return 0
  if held_by_me "$name"; then
    rm -rf "$dir"
  else
    echo "[lock] not releasing a lock this worktree does not hold. $(describe "$name")" >&2
    return 1
  fi
}

case "${1:-}" in
  run)
    [ $# -ge 4 ] && [ "$3" = "--" ] || usage
    shift
    status=0
    take "$1" "$$" || status=$?
    shift 2
    if [ "$status" -eq 0 ]; then
      trap 'release_run "$TAKEN"' EXIT
    elif [ "$status" -eq 3 ]; then
      # This process holds the session's lock while the command runs, so a
      # command longer than the TTL keeps it. Afterwards it is the session's
      # again, used now.
      echo "$OWNER|$$|$(date +%s)" >"$(lock_dir "$TAKEN")/owner"
      trap 'restore_session "$TAKEN"' EXIT
    else
      exit "$status"
    fi
    if [ -n "$(slot_simulator "$TAKEN")" ]; then
      start_simulator "$TAKEN"
      AGENT_SIMULATOR_NAME="$(slot_simulator "$TAKEN")" AGENT_SIMULATOR_UDID="$SIMULATOR_UDID" "$@"
    else
      "$@"
    fi
    ;;
  acquire)
    [ $# -eq 2 ] || usage
    status=0
    take "$2" "" || status=$?
    [ "$status" -eq 0 ] || [ "$status" -eq 3 ] || exit "$status"
    [ "$status" -eq 3 ] && renew "$TAKEN"
    [ -f "$(lock_dir "$TAKEN")/since" ] || date +%s >"$(lock_dir "$TAKEN")/since"
    if [ -n "$(slot_simulator "$TAKEN")" ]; then
      start_simulator "$TAKEN" || { rm -rf "$(lock_dir "$TAKEN")"; exit 1; }
      slot_simulator "$TAKEN"
    fi
    echo "[lock] $(label "$TAKEN") is held by this worktree. Release it with: scripts/lock release $2" >&2
    ;;
  release)
    [ $# -eq 2 ] || usage
    release "$2"
    ;;
  status)
    # A simulator lock in the repo's own lock dir is left from before the
    # simulator lock became machine-wide, so it is not listed.
    for dir in "$REPO_LOCK_ROOT"/*/; do
      [ -d "$dir" ] || continue
      name="$(basename "$dir")"
      [ "$dir" != "$REPO_LOCK_ROOT/simulator/" ] || continue
      if is_stale "$name"; then
        echo "$(describe "$name") (stale)"
      else
        describe "$name"
      fi
    done
    for name in $(candidates simulator); do
      if [ ! -d "$(lock_dir "$name")" ]; then
        echo "$(label "$name"): free"
      elif is_stale "$name"; then
        echo "$(describe "$name") (stale)"
      else
        describe "$name"
      fi
    done
    for file in "$REPO_LOCK_ROOT"/.waiting/[0-9]*-[0-9]* "$SIMULATOR_LOCK_ROOT"/.waiting/[0-9]*-[0-9]*; do
      [ -f "$file" ] && [ "${file%.reserved}" = "$file" ] || continue
      [ $(( $(date +%s) - $(modified "$file") )) -le "$WAITER_STALE_SECONDS" ] || continue
      owner="" wanted=""
      IFS='|' read -r owner wanted <"$file" || true
      name="$(basename "$file")"
      echo "waiting for $wanted: $owner for $(( ($(date +%s) - ${name%%-*}) / 60 )) min"
    done
    ;;
  pool)
    for slot in $(candidates simulator); do
      slot_simulator "$slot"
    done
    ;;
  *)
    usage
    ;;
esac
