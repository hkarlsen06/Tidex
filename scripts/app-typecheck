#!/usr/bin/env bash
# Type-checks app Swift files against the whole app target, outside the build
# queue. Run it before you queue a build or a test run, so a compile error
# costs seconds instead of a trip through the queue.
#
#   scripts/app-typecheck                  the app files this worktree changed from main
#   scripts/app-typecheck <file.swift>...  those files
#   scripts/app-typecheck --all            every file of the app target
#
# It needs one earlier build in this worktree, passed or failed, for the
# package modules and the asset symbols. It reads the target's files and
# compiler flags from the project on every run, so files you added or deleted
# count. It generates the String Catalog symbols again, so a key you added
# works before the next build. A new image or color gets its symbol only at
# the next build.
#
# It reports errors in the files it checks. A signature you changed can break
# a file you did not touch, which --all and the build catch. Files outside the
# app target, such as tests, are skipped and listed.
#
# Exits 0 when the files compile, 1 on compiler errors, 2 when it cannot run.
set -euo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

exec python3 - "$@" <<'PY'
import glob
import json
import os
import plistlib
import re
import shlex
import subprocess
import sys
import tempfile
import time

PROJECT = "ios/Tidex.xcodeproj"
SCHEME = "App"
# The folder that holds the app target's String Catalogs.
CATALOGS = "ios"
# Xcode's own cache of SDK modules for compiles outside a build, shared by every worktree.
MODULE_CACHE = os.path.expanduser("~/Library/Developer/Xcode/DerivedData/ModuleCache.noindex")
ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()


def stop(message):
    print(f"app-typecheck: {message}", file=sys.stderr)
    sys.exit(2)


def has_build_folder():
    """Whether Xcode has built this worktree's project. Asking Xcode instead would fetch every package first."""
    project = os.path.realpath(os.path.join(ROOT, PROJECT))
    for record in glob.glob(os.path.expanduser("~/Library/Developer/Xcode/DerivedData/*/info.plist")):
        try:
            with open(record, "rb") as stream:
                if os.path.realpath(plistlib.load(stream).get("WorkspacePath", "")) == project:
                    return True
        except (OSError, ValueError):
            pass
    return False


def target_arguments():
    """The compiler arguments Xcode's index uses for the app target: its flags and every Swift file."""
    query = subprocess.Popen(
        ["xcodebuild", "-project", PROJECT, "-scheme", SCHEME, "-configuration", "Debug",
         "-destination", "generic/platform=iOS Simulator", "-showBuildSettingsForIndex", "-json"],
        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    # Xcode prints the same arguments once for each file, about 280 MB in all. The first copy is enough.
    text = ""
    try:
        while chunk := query.stdout.read(1 << 20):
            text += chunk
            match = re.search(r'"swiftASTCommandArguments"\s*:\s*', text)
            if match:
                try:
                    return json.JSONDecoder().raw_decode(text, match.end())[0]
                except ValueError:
                    continue
    finally:
        query.kill()
        query.wait()
    stop(f"Xcode gave no compiler arguments for the {SCHEME} scheme")


def changed_files():
    def git(*arguments):
        return subprocess.run(["git", "-C", ROOT, "-c", "core.quotepath=off", *arguments],
                              capture_output=True, text=True).stdout.splitlines()

    base = (git("merge-base", "HEAD", "main") or ["HEAD"])[0]
    names = (git("diff", "--name-only", "--diff-filter=d", base, "--", "*.swift")
             + git("ls-files", "--others", "--exclude-standard", "--", "*.swift"))
    return [os.path.join(ROOT, name) for name in names]


def without_outputs(arguments):
    """Leaves out the options that write index data and string tables into the build folder."""
    skip = False
    for argument in arguments:
        if skip:
            skip = False
        elif argument in ("-emit-localized-strings-path", "-index-store-path"):
            skip = True
        elif argument not in ("-emit-localized-strings", "-emit-const-values"):
            yield argument


def frontend_command(arguments, sources):
    """One compiler process for the whole target, without its source files."""
    planned = subprocess.run(
        ["xcrun", "swiftc", "-driver-print-jobs", *without_outputs(arguments), "-typecheck",
         "-whole-module-optimization", "-driver-filelist-threshold=999999", "-module-cache-path", MODULE_CACHE],
        capture_output=True, text=True)
    jobs = planned.stdout.splitlines()
    if planned.returncode or len(jobs) != 1:
        stop("the Swift driver did not plan one type-check job.\n" + planned.stderr)
    return [argument for argument in shlex.split(jobs[0]) if argument not in sources]


def current_string_symbols(sources, directory):
    """Swaps in String Catalog symbols generated now, for each catalog edited since the last build."""
    for index, path in enumerate(sources):
        match = re.fullmatch(r"GeneratedStringSymbols_(.+)\.swift", os.path.basename(path))
        catalogs = glob.glob(f"{ROOT}/{CATALOGS}/**/{match[1]}.xcstrings", recursive=True) if match else []
        if len(catalogs) == 1 and os.path.getmtime(catalogs[0]) > os.path.getmtime(path):
            generated = subprocess.run(["xcrun", "xcstringstool", "generate-symbols", "--language", "swift",
                                        "--output-directory", directory, catalogs[0]], capture_output=True, text=True)
            if generated.returncode:
                print(generated.stderr, file=sys.stderr)
                sys.exit(1)
            sources[index] = os.path.join(directory, os.path.basename(path))


everything = "--all" in sys.argv[1:]
requested = [os.path.abspath(path) for path in sys.argv[1:] if path != "--all"] or changed_files()
if not everything and not requested:
    print("app-typecheck: this worktree changed no Swift files")
    sys.exit(0)
NO_BUILD = "this worktree has no build yet. Run a wrapper once. After that this check takes seconds."
if not has_build_folder():
    stop(NO_BUILD)
arguments = target_arguments()
sources = [argument for argument in arguments if argument.endswith(".swift")]
# The symbols a build generates are among the sources, and a build that stopped early has not written them.
if any(not os.path.exists(path) for path in sources if not path.startswith(ROOT + "/")):
    stop(NO_BUILD)
in_target = {os.path.realpath(path): path for path in sources}
if not everything:
    checked = sorted({in_target[os.path.realpath(path)] for path in requested if os.path.realpath(path) in in_target})
    skipped = sorted(os.path.relpath(path, ROOT) for path in requested if os.path.realpath(path) not in in_target)
    if skipped:
        print("Not files of the app target, so not checked: " + ", ".join(skipped))
    if not checked:
        sys.exit(0)
command = frontend_command(arguments, set(sources))
with tempfile.TemporaryDirectory() as temporary:
    current_string_symbols(sources, temporary)
    for option, paths in (("-filelist", sources), ("-primary-filelist", [] if everything else checked)):
        if paths:
            file_list = os.path.join(temporary, option.strip("-"))
            with open(file_list, "w") as stream:
                stream.write("\n".join(paths) + "\n")
            command += [option, file_list]
    started = time.time()
    failed = subprocess.run(command).returncode != 0
scope = "the whole app target" if everything else f"{len(checked)} of {len(sources)} app files"
print(f"app-typecheck: {'errors in' if failed else 'no errors in'} {scope}, "
      f"checked in {time.time() - started:.0f}s")
sys.exit(1 if failed else 0)
PY
